[Unit]
Description=Automaton Agent Orchestrator
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=automaton-agent
Group=automaton-agent
WorkingDirectory=/opt/automaton-agent-orchestrator/current
ExecStart=/opt/automaton-agent-orchestrator/current/Automaton.AgentOrchestrator
Environment=HOME=/var/lib/automaton-agent-orchestrator/home
Environment=CODEX_HOME=/var/lib/automaton-agent-orchestrator/codex
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=DOTNET_NOLOGO=1
Environment=AgentOrchestrator__ProductionMode=true
Environment=AgentOrchestrator__WorkflowPath=/etc/automaton-agent-orchestrator/WORKFLOW.md
EnvironmentFile=/etc/automaton-agent-orchestrator/secrets.env
Restart=on-failure
RestartSec=10s
TimeoutStopSec=120s
KillMode=mixed
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/automaton-agent-orchestrator /opt/automaton-agent-orchestrator
ReadWritePaths=/var/lib/automaton-agent-orchestrator
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=8G
TasksMax=4096
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
