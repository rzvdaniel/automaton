{
  "name": "automaton-vue",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently -k -n docs,site -c green,cyan \"npm:docs:dev\" \"npm:dev\"",
    "build": "vue-tsc -b && vite build && vitepress build docs && node scripts/build-sitemap.mjs",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs --host 127.0.0.1 --port 5175",
    "docs:build": "vitepress build docs && node scripts/build-sitemap.mjs",
    "docs:preview": "vitepress preview docs",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@primevue/themes": "^4.5.4",
    "pinia": "^3.0.4",
    "posthog-js": "^1.258.3",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.4",
    "vue": "^3.5.24",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.6.2",
    "playwright": "^1.60.0",
    "prettier": "^3.7.4",
    "typescript": "~5.9.3",
    "vite": "^6.3.5",
    "vitepress": "^1.6.3",
    "vue-tsc": "^2.2.10",
    "concurrently": "^9.2.1"
  }
}
