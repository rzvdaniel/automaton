{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automaton.monster/schemas/home-card.schema.json",
  "title": "Automaton Home card",
  "description": "The result of an app's home-card Action. Plain text and tones only; Studio draws it. Unknown block types are skipped.",
  "type": "object",
  "required": [
    "status"
  ],
  "properties": {
    "status": {
      "type": "string",
      "maxLength": 80
    },
    "detail": {
      "type": "string",
      "maxLength": 240
    },
    "tone": {
      "enum": [
        "ok",
        "warning",
        "critical",
        "info"
      ]
    },
    "facts": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 40
          },
          "value": {
            "type": "string",
            "maxLength": 120
          }
        },
        "required": [
          "label"
        ],
        "additionalProperties": true
      }
    },
    "alerts": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "enum": [
              "info",
              "warning",
              "critical"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 240
          }
        },
        "required": [
          "severity",
          "text"
        ],
        "additionalProperties": true
      }
    },
    "blocks": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string"
          }
        },
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "fact"
              },
              "label": {
                "type": "string",
                "maxLength": 40
              },
              "value": {
                "type": "string",
                "maxLength": 120
              },
              "note": {
                "type": "string",
                "maxLength": 120
              }
            },
            "required": [
              "type",
              "label",
              "value"
            ],
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "badge"
              },
              "label": {
                "type": "string",
                "maxLength": 40
              },
              "text": {
                "type": "string",
                "maxLength": 40
              },
              "tone": {
                "enum": [
                  "ok",
                  "warning",
                  "critical",
                  "info"
                ]
              },
              "note": {
                "type": "string",
                "maxLength": 120
              }
            },
            "required": [
              "type",
              "label",
              "text",
              "tone"
            ],
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "meter"
              },
              "label": {
                "type": "string",
                "maxLength": 40
              },
              "value": {
                "type": "number",
                "minimum": 0
              },
              "max": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "unit": {
                "type": "string",
                "maxLength": 12
              },
              "warnAt": {
                "type": "number"
              },
              "critAt": {
                "type": "number"
              },
              "note": {
                "type": "string",
                "maxLength": 120
              }
            },
            "required": [
              "type",
              "label",
              "value",
              "max"
            ],
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "counters"
              },
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "maxLength": 40
                    },
                    "value": {
                      "type": [
                        "number",
                        "string"
                      ],
                      "maxLength": 16
                    },
                    "tone": {
                      "enum": [
                        "ok",
                        "warning",
                        "critical",
                        "info"
                      ]
                    }
                  },
                  "required": [
                    "label",
                    "value"
                  ],
                  "additionalProperties": true
                }
              }
            },
            "required": [
              "type",
              "items"
            ],
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "list"
              },
              "rows": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string",
                      "maxLength": 120
                    },
                    "note": {
                      "type": "string",
                      "maxLength": 120
                    },
                    "tone": {
                      "enum": [
                        "ok",
                        "warning",
                        "critical",
                        "info"
                      ]
                    }
                  },
                  "required": [
                    "text"
                  ],
                  "additionalProperties": true
                }
              }
            },
            "required": [
              "type",
              "rows"
            ],
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "alert"
              },
              "severity": {
                "enum": [
                  "info",
                  "warning",
                  "critical"
                ]
              },
              "text": {
                "type": "string",
                "maxLength": 240
              }
            },
            "required": [
              "type",
              "severity",
              "text"
            ],
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "buttons"
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "maxLength": 40
                    },
                    "path": {
                      "type": "string",
                      "pattern": "^/(?!/)[^\\s\\\\]*$",
                      "maxLength": 200
                    }
                  },
                  "required": [
                    "label",
                    "path"
                  ],
                  "additionalProperties": true
                }
              }
            },
            "required": [
              "type",
              "items"
            ],
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "chart"
              },
              "kind": {
                "enum": [
                  "line",
                  "area",
                  "bar",
                  "stacked-bar",
                  "donut",
                  "gauge"
                ]
              },
              "title": {
                "type": "string",
                "maxLength": 40
              },
              "labels": {
                "type": "array",
                "maxItems": 48,
                "items": {
                  "type": "string",
                  "maxLength": 24
                }
              },
              "series": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "maxLength": 40
                    },
                    "tone": {
                      "enum": [
                        "ok",
                        "warning",
                        "critical",
                        "info"
                      ]
                    },
                    "values": {
                      "type": "array",
                      "maxItems": 48,
                      "items": {
                        "type": "number"
                      }
                    }
                  },
                  "required": [
                    "name",
                    "values"
                  ],
                  "additionalProperties": true
                }
              },
              "max": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "type",
              "kind",
              "series"
            ],
            "additionalProperties": true
          },
          {
            "properties": {
              "type": {
                "not": {
                  "enum": [
                    "fact",
                    "badge",
                    "meter",
                    "counters",
                    "list",
                    "alert",
                    "buttons",
                    "chart"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  },
  "examples": [
    {
      "status": "Healthy",
      "detail": "3 sites checked",
      "tone": "ok",
      "blocks": [
        {
          "type": "meter",
          "label": "Disk",
          "value": 61,
          "max": 100,
          "unit": "%",
          "warnAt": 75,
          "critAt": 90
        },
        {
          "type": "counters",
          "items": [
            {
              "label": "Up",
              "value": 12,
              "tone": "ok"
            },
            {
              "label": "Down",
              "value": 1,
              "tone": "critical"
            }
          ]
        },
        {
          "type": "chart",
          "kind": "line",
          "labels": [
            "Mon",
            "Tue",
            "Wed"
          ],
          "series": [
            {
              "name": "Response ms",
              "tone": "info",
              "values": [
                210,
                190,
                240
              ]
            }
          ]
        }
      ]
    }
  ]
}
