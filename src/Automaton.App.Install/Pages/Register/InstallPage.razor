@attribute [AllowAnonymous]
@page "/install"

<Layout>
    <Content Id="register-user">
        <GridRow Justify="RowJustify.Center" Align="RowAlign.Middle" Class="grid-container">
            <GridCol>
                <Form Loading="loading"
                      Model="@InstallViewModel"
                      Layout="@FormLayout.Vertical"
                      OnFinish="OnFinish"
                      OnFinishFailed="OnFinishFailed"
                      Style="width: 400px">

                    <ChildContent>
                        <Title Level="1">Install Automaton</Title>

                        <FormItem Label="Name">
                            <Input @bind-Value="@context.Name" />
                        </FormItem>

                        <FormItem Label="Email">
                            <Input @bind-Value="@context.Email" />
                        </FormItem>

                        <FormItem Label="Password">
                            <InputPassword @bind-Value="@context.Password" />
                        </FormItem>

                        <FormItem Label="Confirm Password">
                            <InputPassword @bind-Value="@context.ConfirmPassword" />
                        </FormItem>

                        <FormItem WrapperColSpan="16">
                            <Button Type="@ButtonType.Primary" HtmlType="submit">
                                Submit
                            </Button>
                        </FormItem>
                    </ChildContent>
                </Form>
            </GridCol>
        </GridRow>
    </Content>
</Layout>

<style>
    #register-user {
        height: 100%;
        background-color: white;
    }

    .grid-container {
        height: 100%;
        background-color: white;
        align-items: center
    }

    .site-layout-content {
        height: 100%;
    }

    .ant-layout {
        height: 100%;
    }

</style>




