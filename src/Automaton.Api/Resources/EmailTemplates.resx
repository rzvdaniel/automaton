  <data name="AutomatonRegisterUser.Subject" xml:space="preserve">
    <value>Welcome to Automaton, {{ Name }}!</value>
  </data>
  <data name="AutomatonAdminNewRegistration.Subject" xml:space="preserve">
    <value>New Automaton registration: {{ Name }}</value>
  </data>
  <data name="AutomatonAdminNewRegistration.Body" xml:space="preserve">
    <value>
&lt;!DOCTYPE html&gt;
&lt;html lang="en"&gt;
&lt;head&gt;
  &lt;meta charset="UTF-8"&gt;
  &lt;meta name="viewport" content="width=device-width, initial-scale=1.0"&gt;
  &lt;meta http-equiv="X-UA-Compatible" content="IE=edge"&gt;
  &lt;title&gt;New registration notification&lt;/title&gt;
  &lt;style&gt;
    body { margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background-color: #f3f4f6; color: #111827; }
    .email-container { max-width: 640px; margin: 0 auto; background-color: #ffffff; }
    .header { background: #111827; padding: 28px 32px; }
    .header h1 { margin: 0; color: #ffffff; font-size: 24px; font-weight: 700; }
    .content { padding: 32px; line-height: 1.6; }
    .details { margin: 24px 0; padding: 20px; background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 12px; }
    .details p { margin: 0 0 10px; }
    .details p:last-child { margin-bottom: 0; }
    .label { font-weight: 700; color: #374151; }
    .button { display: inline-block; margin-top: 8px; padding: 12px 20px; background-color: #2563eb; color: #ffffff !important; text-decoration: none; border-radius: 10px; font-weight: 600; }
    .footer { padding: 0 32px 32px; color: #6b7280; font-size: 13px; }
  &lt;/style&gt;
&lt;/head&gt;
&lt;body&gt;
  &lt;div class="email-container"&gt;
    &lt;div class="header"&gt;
      &lt;h1&gt;New registration notification&lt;/h1&gt;
    &lt;/div&gt;
    &lt;div class="content"&gt;
      &lt;p&gt;A new user just registered in Automaton.&lt;/p&gt;
      &lt;div class="details"&gt;
        &lt;p&gt;&lt;span class="label"&gt;Name:&lt;/span&gt; {{ Name }}&lt;/p&gt;
        &lt;p&gt;&lt;span class="label"&gt;Email:&lt;/span&gt; {{ Email }}&lt;/p&gt;
        &lt;p&gt;&lt;span class="label"&gt;Public username:&lt;/span&gt; {{ PublicUsername }}&lt;/p&gt;
        &lt;p&gt;&lt;span class="label"&gt;Registered at:&lt;/span&gt; {{ RegisteredAtUtc }}&lt;/p&gt;
      &lt;/div&gt;
      &lt;a class="button" href="{{ AdminUsersUrl }}"&gt;Open Admin Users&lt;/a&gt;
    &lt;/div&gt;
    &lt;div class="footer"&gt;
      This message was generated automatically by Automaton.
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/body&gt;
&lt;/html&gt;
    </value>
  </data>
  <data name="AutomatonRegisterUser.Body" xml:space="preserve">
    <value>
&lt;!DOCTYPE html&gt;
&lt;html lang="en"&gt;
&lt;head&gt;
  &lt;meta charset="UTF-8"&gt;
  &lt;meta name="viewport" content="width=device-width, initial-scale=1.0"&gt;
  &lt;meta http-equiv="X-UA-Compatible" content="IE=edge"&gt;
  &lt;title&gt;Welcome to Automaton&lt;/title&gt;
  &lt;style&gt;
    body { margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background-color: #f3f4f6; }
    table { border-spacing: 0; width: 100%; }
    td { padding: 0; }
    img { border: 0; display: block; }
    .email-container { max-width: 600px; margin: 0 auto; background-color: #ffffff; }
    .header { background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%); padding: 40px 30px; text-align: center; }
    .header h1 { color: #ffffff; margin: 0; font-size: 28px; font-weight: 600; }
    .content { padding: 40px 30px; color: #374151; line-height: 1.6; }
    .content h2 { color: #111827; font-size: 24px; margin: 0 0 20px 0; font-weight: 600; }
    .content p { margin: 0 0 16px 0; font-size: 16px; }
    .button { display: inline-block; padding: 14px 32px; margin: 20px 0; background-color: #4F46E5; background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%); color: #ffffff !important; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 16px; box-shadow: 0 4px 6px rgba(79, 70, 229, 0.25); }
    .footer { background-color: #f9fafb; padding: 30px; text-align: center; color: #6b7280; font-size: 14px; border-top: 1px solid #e5e7eb; }
    .footer a { color: #4F46E5; text-decoration: none; }
    .divider { height: 1px; background-color: #e5e7eb; margin: 30px 0; }
    @media only screen and (max-width: 600px) {
      .content { padding: 30px 20px !important; }
      .header { padding: 30px 20px !important; }
      .button { display: block; text-align: center; }
    }
  &lt;/style&gt;
&lt;/head&gt;
&lt;body&gt;
  &lt;table role="presentation" style="width: 100%; background-color: #f3f4f6;"&gt;
    &lt;tr&gt;
      &lt;td align="center" style="padding: 40px 20px;"&gt;
        &lt;table role="presentation" class="email-container"&gt;
          &lt;tr&gt;
            &lt;td class="header"&gt;
              &lt;h1&gt;🚀 Welcome to Automaton&lt;/h1&gt;
            &lt;/td&gt;
          &lt;/tr&gt;
          &lt;tr&gt;
            &lt;td class="content"&gt;
              &lt;h2&gt;Hi {{ Name }},&lt;/h2&gt;
              &lt;p&gt;Welcome aboard! We're thrilled to have you join Automaton. Your account has been successfully created and is ready to use.&lt;/p&gt;
              &lt;p&gt;Automaton is your powerful workflow automation platform. Start creating, automating, and collaborating on projects right away.&lt;/p&gt;
              &lt;center&gt;
                &lt;a href="{{ LoginUrl }}" class="button"&gt;Sign In to Your Account&lt;/a&gt;
              &lt;/center&gt;
              &lt;p style="font-size: 13px; color: #6b7280; margin-top: 8px;"&gt;If the button doesn't work, copy and paste this link into your browser: &lt;a href="{{ LoginUrl }}" style="color: #4F46E5; text-decoration: none; word-break: break-all;"&gt;{{ LoginUrl }}&lt;/a&gt;&lt;/p&gt;
              &lt;div class="divider"&gt;&lt;/div&gt;
              &lt;p style="font-size: 14px; color: #6b7280;"&gt;If you have any questions or need assistance, our support team is here to help at &lt;a href="mailto:{{ SupportEmail }}" style="color: #4F46E5; text-decoration: none;"&gt;{{ SupportEmail }}&lt;/a&gt;.&lt;/p&gt;
            &lt;/td&gt;
          &lt;/tr&gt;
          &lt;tr&gt;
            &lt;td class="footer"&gt;
              &lt;p style="margin: 0 0 10px 0;"&gt;&lt;strong&gt;Automaton&lt;/strong&gt;&lt;/p&gt;
              &lt;p style="margin: 0;"&gt;Workflow automation made simple&lt;/p&gt;
              &lt;p style="margin: 15px 0 0 0; font-size: 12px; color: #9ca3af;"&gt;© 2026 Automaton. All rights reserved.&lt;/p&gt;
            &lt;/td&gt;
          &lt;/tr&gt;
        &lt;/table&gt;
      &lt;/td&gt;
    &lt;/tr&gt;
  &lt;/table&gt;
&lt;/body&gt;
&lt;/html&gt;
    </value>
  </data>
  <data name="AutomatonConfirmEmail.Subject" xml:space="preserve">
    <value>Confirm your Automaton email address</value>
  </data>
  <data name="AutomatonConfirmEmail.Body" xml:space="preserve">
    <value>
&lt;!DOCTYPE html&gt;
&lt;html lang="en"&gt;
&lt;head&gt;
  &lt;meta charset="UTF-8"&gt;
  &lt;meta name="viewport" content="width=device-width, initial-scale=1.0"&gt;
  &lt;meta http-equiv="X-UA-Compatible" content="IE=edge"&gt;
  &lt;title&gt;Confirm Your Email&lt;/title&gt;
  &lt;style&gt;
    body { margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background-color: #f3f4f6; }
    table { border-spacing: 0; width: 100%; }
    td { padding: 0; }
    img { border: 0; display: block; }
    .email-container { max-width: 600px; margin: 0 auto; background-color: #ffffff; }
    .header { background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%); padding: 40px 30px; text-align: center; }
    .header h1 { color: #ffffff; margin: 0; font-size: 28px; font-weight: 600; }
    .content { padding: 40px 30px; color: #374151; line-height: 1.6; }
    .content h2 { color: #111827; font-size: 24px; margin: 0 0 20px 0; font-weight: 600; }
    .content p { margin: 0 0 16px 0; font-size: 16px; }
    .button { display: inline-block; padding: 14px 32px; margin: 20px 0; background-color: #4F46E5; background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%); color: #ffffff !important; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 16px; box-shadow: 0 4px 6px rgba(79, 70, 229, 0.25); }
    .footer { background-color: #f9fafb; padding: 30px; text-align: center; color: #6b7280; font-size: 14px; border-top: 1px solid #e5e7eb; }
    .footer a { color: #4F46E5; text-decoration: none; }
    .divider { height: 1px; background-color: #e5e7eb; margin: 30px 0; }
    @media only screen and (max-width: 600px) {
      .content { padding: 30px 20px !important; }
      .header { padding: 30px 20px !important; }
      .button { display: block; text-align: center; }
    }
  &lt;/style&gt;
&lt;/head&gt;
&lt;body&gt;
  &lt;table role="presentation" style="width: 100%; background-color: #f3f4f6;"&gt;
    &lt;tr&gt;
      &lt;td align="center" style="padding: 40px 20px;"&gt;
        &lt;table role="presentation" class="email-container"&gt;
          &lt;tr&gt;
            &lt;td class="header"&gt;
              &lt;h1&gt;✉️ Confirm Your Email&lt;/h1&gt;
            &lt;/td&gt;
          &lt;/tr&gt;
          &lt;tr&gt;
            &lt;td class="content"&gt;
              &lt;h2&gt;Hi {{ Name }},&lt;/h2&gt;
              &lt;p&gt;Thanks for signing up for Automaton. Please confirm your email address to unlock sensitive actions such as publishing apps, creating API keys, and registering runners.&lt;/p&gt;
              &lt;p&gt;You can still sign in and explore the Studio before confirming, but we recommend confirming now so your account is fully ready.&lt;/p&gt;
              &lt;center&gt;
                &lt;a href="{{ ConfirmationUrl }}" class="button"&gt;Confirm Email&lt;/a&gt;
              &lt;/center&gt;
              &lt;p style="font-size: 13px; color: #6b7280; margin-top: 8px;"&gt;If the button doesn't work, copy and paste this link into your browser: &lt;a href="{{ ConfirmationUrl }}" style="color: #4F46E5; text-decoration: none; word-break: break-all;"&gt;{{ ConfirmationUrl }}&lt;/a&gt;&lt;/p&gt;
              &lt;div class="divider"&gt;&lt;/div&gt;
              &lt;p style="font-size: 14px; color: #6b7280;"&gt;Already confirmed? You can sign in here: &lt;a href="{{ LoginUrl }}" style="color: #4F46E5; text-decoration: none;"&gt;{{ LoginUrl }}&lt;/a&gt;&lt;/p&gt;
              &lt;p style="font-size: 14px; color: #6b7280;"&gt;Need help? Contact us at &lt;a href="mailto:{{ SupportEmail }}" style="color: #4F46E5; text-decoration: none;"&gt;{{ SupportEmail }}&lt;/a&gt;.&lt;/p&gt;
            &lt;/td&gt;
          &lt;/tr&gt;
          &lt;tr&gt;
            &lt;td class="footer"&gt;
              &lt;p style="margin: 0 0 10px 0;"&gt;&lt;strong&gt;Automaton&lt;/strong&gt;&lt;/p&gt;
              &lt;p style="margin: 0;"&gt;Workflow automation made simple&lt;/p&gt;
              &lt;p style="margin: 15px 0 0 0; font-size: 12px; color: #9ca3af;"&gt;© 2026 Automaton. All rights reserved.&lt;/p&gt;
            &lt;/td&gt;
          &lt;/tr&gt;
        &lt;/table&gt;
      &lt;/td&gt;
    &lt;/tr&gt;
  &lt;/table&gt;
&lt;/body&gt;
&lt;/html&gt;
    </value>
  </data>
  <data name="AutomatonProjectInvitation.Subject" xml:space="preserve">
    <value>You’ve been invited to {{ ProjectName }}</value>
  </data>
  <data name="AutomatonProjectInvitation.Body" xml:space="preserve">
    <value>
&lt;!DOCTYPE html&gt;
&lt;html lang="en"&gt;
&lt;head&gt;
  &lt;meta charset="UTF-8"&gt;
  &lt;meta name="viewport" content="width=device-width, initial-scale=1.0"&gt;
  &lt;meta http-equiv="X-UA-Compatible" content="IE=edge"&gt;
  &lt;title&gt;Project Invitation&lt;/title&gt;
  &lt;style&gt;
    body { margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background-color: #f3f4f6; }
    table { border-spacing: 0; width: 100%; }
    td { padding: 0; }
    img { border: 0; display: block; }
    .email-container { max-width: 600px; margin: 0 auto; background-color: #ffffff; }
    .header { background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%); padding: 40px 30px; text-align: center; }
    .header h1 { color: #ffffff; margin: 0; font-size: 28px; font-weight: 600; }
    .content { padding: 40px 30px; color: #374151; line-height: 1.6; }
    .content h2 { color: #111827; font-size: 24px; margin: 0 0 20px 0; font-weight: 600; }
    .content p { margin: 0 0 16px 0; font-size: 16px; }
    .highlight-box { background-color: #f0f9ff; border-left: 4px solid #4F46E5; padding: 20px; margin: 20px 0; border-radius: 4px; }
    .highlight-box p { margin: 0; color: #1e40af; }
    .button { display: inline-block; padding: 14px 32px; margin: 20px 0; background-color: #4F46E5; background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%); color: #ffffff !important; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 16px; box-shadow: 0 4px 6px rgba(79, 70, 229, 0.25); }
    .footer { background-color: #f9fafb; padding: 30px; text-align: center; color: #6b7280; font-size: 14px; border-top: 1px solid #e5e7eb; }
    .footer a { color: #4F46E5; text-decoration: none; }
    .divider { height: 1px; background-color: #e5e7eb; margin: 30px 0; }
    @media only screen and (max-width: 600px) {
      .content { padding: 30px 20px !important; }
      .header { padding: 30px 20px !important; }
      .button { display: block; text-align: center; }
    }
  &lt;/style&gt;
&lt;/head&gt;
&lt;body&gt;
  &lt;table role="presentation" style="width: 100%; background-color: #f3f4f6;"&gt;
    &lt;tr&gt;
      &lt;td align="center" style="padding: 40px 20px;"&gt;
        &lt;table role="presentation" class="email-container"&gt;
          &lt;tr&gt;
            &lt;td class="header"&gt;
              &lt;h1&gt;📋 Project Invitation&lt;/h1&gt;
            &lt;/td&gt;
          &lt;/tr&gt;
          &lt;tr&gt;
            &lt;td class="content"&gt;
              &lt;h2&gt;Hi {{ Name }},&lt;/h2&gt;
              &lt;p&gt;Great news! You've been invited to collaborate on an exciting project.&lt;/p&gt;
              &lt;div class="highlight-box"&gt;
                &lt;p&gt;&lt;strong&gt;Project:&lt;/strong&gt; {{ ProjectName }}&lt;/p&gt;
              &lt;/div&gt;
              &lt;p&gt;Accept this invitation to start working together on {{ ProjectName }}. You'll gain access to all project resources and be able to collaborate with the team.&lt;/p&gt;
              &lt;center&gt;
                &lt;a href="{{ InviteUrl }}" class="button"&gt;Accept Invitation&lt;/a&gt;
              &lt;/center&gt;
              &lt;p style="font-size: 13px; color: #6b7280; margin-top: 8px;"&gt;If the button doesn't work, copy and paste this link into your browser: &lt;a href="{{ InviteUrl }}" style="color: #4F46E5; text-decoration: none; word-break: break-all;"&gt;{{ InviteUrl }}&lt;/a&gt;&lt;/p&gt;
              &lt;div class="divider"&gt;&lt;/div&gt;
              &lt;p style="font-size: 14px; color: #6b7280;"&gt;If you didn't expect this invitation or have concerns, you can safely ignore this email. The invitation will expire if not accepted.&lt;/p&gt;
            &lt;/td&gt;
          &lt;/tr&gt;
          &lt;tr&gt;
            &lt;td class="footer"&gt;
              &lt;p style="margin: 0 0 10px 0;"&gt;&lt;strong&gt;Automaton&lt;/strong&gt;&lt;/p&gt;
              &lt;p style="margin: 0;"&gt;Workflow automation made simple&lt;/p&gt;
              &lt;p style="margin: 15px 0 0 0; font-size: 12px; color: #9ca3af;"&gt;© 2026 Automaton. All rights reserved.&lt;/p&gt;
            &lt;/td&gt;
          &lt;/tr&gt;
        &lt;/table&gt;
      &lt;/td&gt;
    &lt;/tr&gt;
  &lt;/table&gt;
&lt;/body&gt;
&lt;/html&gt;
    </value>
