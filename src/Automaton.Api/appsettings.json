{
  "AiProviders": {
    "MaxConversationHistoryMessages": 30,
    "MaxIterations": 0,
    "MaxConsecutiveFailures": 3,
    "DefaultMaxOutputTokens": 65536,
    "IterationLimits": {
      "Simple": 15,
      "Medium": 25,
      "Large": 40,
      "Enterprise": 60,
      "Autonomous": 500,
      "Planning": 5
    },
    "AppMemory": {
      "SummaryMaxChars": 200,
      "BlockMaxChars": 2400
    },
    "AppInstructions": {
      "MaxTokens": 1000
    },
    "RateLimitRetry": {
      "MaxRetries": 3,
      "InitialDelaySeconds": 30
    },
    "Streaming": {
      "TimeoutMinutes": 5
    }
  },
  "ConnectionStrings": {
    "MySqlConnection": "Server=localhost;Port=3306;Database=automaton;User=Youruser;Password=YourPassword;"
  },
  "AppsTunnel": {
    "TimeoutSeconds": 330
  },
  "MediaStorage": {
    "MaxUploadBytes": 10485760,
    "DefaultQuotaBytes": 262144000
  },
  "MachineContainerResources": {
    "CpuLimitCores": 1.0,
    "MemoryLimitMb": 1024,
    "PidsLimit": 256,
    "SharedMemoryMb": 64,
    "DockerLogMaxSizeMb": 20,
    "DockerLogMaxFiles": 5,
    "MinimumFreeDiskMb": 1024
  },
  "AppFileRules": {
    "Baseline": {
      "SourceExclude": [
        ".env",
        ".env.*",
        ".DS_Store",
        "*.pyc",
        "*.log",
        ".git",
        ".automaton",
        "node_modules",
        "venv",
        ".venv",
        "__pycache__",
        ".vite",
        "coverage",
        "dist"
      ],
      "FrontendExclude": [
        ".env",
        ".env.*",
        ".DS_Store",
        "*.pyc",
        "*.log",
        ".git",
        "node_modules",
        "venv",
        ".venv",
        "__pycache__"
      ],
      "BackendExclude": [
        ".env",
        ".env.*",
        ".DS_Store",
        "*.pyc",
        "*.log",
        ".git",
        "node_modules",
        "venv",
        ".venv",
        "__pycache__"
      ],
      "RemixSourceExclude": [
        ".git",
        ".svn",
        ".hg",
        ".env",
        ".env.*",
        "*.pem",
        "*.key",
        "*.pfx",
        "*.p12",
        "secrets",
        "secrets/**",
        "secrets.json",
        "appsettings.json",
        "appsettings.*.json",
        ".local",
        "*.local.*",
        "private",
        "private/**",
        "uploads",
        "uploads/**",
        "data",
        "data/**",
        "runner",
        "runner/**"
      ],
      "RemixFrontendExclude": [
        ".env",
        ".env.*",
        "*.map",
        "*.pem",
        "*.key",
        "secrets.json",
        "appsettings.json",
        "appsettings.*.json",
        "*.local.*",
        "private",
        "private/**",
        "uploads",
        "uploads/**"
      ]
    }
  },
  "Logging": {
    "File": {
      "Path": "Logs",
      "RetainedFileCountLimit": 14
    },
    "Audit": {
      "RetentionDays": 90
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RequestLogging": {
    "LogSuccessfulRequests": true
  },
  "RateLimiting": {
    "MaxConcurrentMultipartRequests": 2,
    "GlobalAnonymous": {
      "PermitLimit": 200,
      "WindowSeconds": 60
    },
    "GlobalAuthenticated": {
      "PermitLimit": 1000,
      "WindowSeconds": 60
    },
    "AuthLogin": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "AuthRegistration": {
      "PermitLimit": 3,
      "WindowSeconds": 3600
    },
    "AuthForgotPassword": {
      "PermitLimit": 10,
      "WindowSeconds": 3600
    },
    "AuthResendConfirmation": {
      "PermitLimit": 3,
      "WindowSeconds": 3600
    },
    "AuthResetPassword": {
      "PermitLimit": 5,
      "WindowSeconds": 3600
    },
    "AuthRefreshToken": {
      "PermitLimit": 30,
      "WindowSeconds": 300
    },
    "ApiKeyValidation": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "PublicAppControllerExecution": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "PublicAppFlowExecution": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "PublicAppStepExecution": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "DeploymentPackageStorage": {
    "MaximumStoredBytes": 1073741824,
    "MaximumStoredPackages": 100
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:5001",
      "https://localhost:7091",
      "http://localhost:5173",
      "http://localhost:5174"
    ]
  },
  "JwtOptions": {
    "ValidateIssuer": true,
    "Issuer": "https://localhost:7091",
    "ValidateAudience": false,
    "Audience": "Automaton.Studio",
    "SaveToken": false
  },
  "AuthenticationSettings": {
    "HMacSettings": {
      "SecretKey": "YourSecureHmacSecretKey32CharsLong"
    },
    "RsaSettings": {
      "RsaPrivateKey": "<RSAKeyValue>Your RSA Key</RSAKeyValue>",
      "RsaPublicKey": "<RSAKeyValue>Your RSA Key</RSAKeyValue>",
      "IsIssuer": true
    },
    "RedisOptions": {
      "ConnectionString": "localhost",
      "InstanceName": "master"
    }
  },
  "AppConfig": {
    "WebsiteUrl": "http://localhost:5173",
    "ApiUrl": "https://localhost:7091",
    "DatabaseType": "MySql",
    "RefreshTokenLifetime": 4,
    "UserSignUp": true,
    "AiApiEncryptionKey": "YourSecureEncryptionKey32CharsLong"
  },
  "GitHub": {
    "ClientId": "your-github-oauth-client-id",
    "ClientSecret": "your-github-oauth-client-secret",
    "ApiBaseUrl": "https://api-dev.automaton.monster",
    "FrontendUrl": "http://localhost:5173"
  },
  "CloudflareTurnstile": {
    "Enabled": false,
    "AllowBypassWhenNotConfiguredInDevelopment": true,
    "SiteKey": "",
    "SecretKey": ""
  },
  "EmailConfig": {
    "EmailAccount": "your-email@example.com",
    "EmailPassword": "YourEmailPassword",
    "EmailHost": "smtp.example.com",
    "EmailPort": 587,
    "EmailUseSsl": true,
    "SupportEmail": "support@automaton.monster",
    "FromEmail": "hello@automaton.monster",
    "AdminEmail": "admin@automaton.monster",
    "SendEmailsInDevelopment": true
  },
  "WebAppConfig": {
    "CacheMaxAgeSeconds": 86400
  },
  "PublishedApps": {
    "RootPath": "AppData/published-apps",
    "MaximumTotalStorageBytes": 10737418240,
    "MaximumTotalFiles": 100000,
    "PublicBaseUrl": "http://localhost:5173",
    "ApiBaseUrl": "https://localhost:7091",
    "TraefikDynamicConfigRoot": "AppData/traefik-dynamic"
  },
  "SignalR": {
    "ClientTimeoutIntervalMinutes": 5,
    "KeepAliveIntervalSeconds": 15,
    "HandshakeTimeoutSeconds": 30,
    "MaximumReceiveMessageSizeBytes": 1048576
  },
  "Stripe": {
    "SecretKey": "YourStripeSecretKey",
    "PublishableKey": "YourStripePublishableKey",
    "WebhookSecret": "YourStripeWebhookSecret"
  },
  "HostedRunners": {
    "Enabled": false,
    "ServerUrl": "https://api.automaton.monster",
    "DockerImage": "automaton-runner:latest",
    "DockerNetwork": "automaton_runner_network",
    "RuntimeDockerNetwork": "",
    "RuntimePort": 8080,
    "RemoteRuntimePortStart": 20000,
    "RemoteRuntimePortEnd": 20999,
    "DataRoot": "/opt/automaton/hosted-runners"
  },
  "UserPasswordConfig": {
    "RequireDigit": true,
    "RequireLowercase": false,
    "RequireUppercase": false,
    "RequireNonAlphanumeric": false,
    "RequiredLength": 6
  },
  "UserLockoutConfig": {
    "AllowedForNewUsers": true,
    "MaxFailedAccessAttempts": 5,
    "DefaultLockoutTimeSpanMinutes": 15
  },
  "RabbitMq": {
    "Host": "localhost",
    "VirtualHost": "/",
    "Username": "automaton",
    "Password": "automaton"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.MariaDB"
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "ApplicationName": "Automaton.Studio.Server"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
              }
            }
          ]
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log.log",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Information"
        }
      }
    ]
  }
}
