{
  "ConnectionStrings": {
    "MySqlConnection": "Server=mysql;Port=3306;Database=automaton;User=automaton_user;Password=CHANGE_ME_DATABASE_PASSWORD;"
  },
  "MediaStorage": {
    "MaxUploadBytes": 10485760,
    "DefaultQuotaBytes": 262144000
  },
  "Cors": {
    "AllowedOrigins": [
      "https://studio.automaton.monster",
      "https://automaton.monster",
      "https://apps.automaton.monster"
    ]
  },
  "JwtOptions": {
    "ValidateIssuer": true,
    "Issuer": "https://api.automaton.monster",
    "ValidateAudience": false,
    "Audience": "Automaton.Studio",
    "SaveToken": false
  },
  "AppConfig": {
    "WebsiteUrl": "https://studio.automaton.monster",
    "DatabaseType": "MySql",
    "RefreshTokenLifetime": 4,
    "RunnerRefreshTokenLifetime": 36500,
    "UserSignUp": true,
    "AiApiEncryptionKey": "CHANGE_ME_exactly_32_chars_random!"
  },
  "AuthenticationSettings": {
    "HMacSettings": {
      "SecretKey": "CHANGE_ME_32_chars_minimum_random_key"
    },
    "RsaSettings": {
      "RsaPrivateKey": "<RSAKeyValue><Modulus>...</Modulus>...<D>...</D></RSAKeyValue>",
      "RsaPublicKey": "<RSAKeyValue><Modulus>...</Modulus><Exponent>AQAB</Exponent></RSAKeyValue>",
      "IsIssuer": true
    }
  },
  "EmailConfig": {
    "EmailAccount": "you@yourdomain.com",
    "EmailPassword": "your-smtp-password",
    "EmailHost": "smtp.mailgun.org",
    "EmailPort": 587,
    "EmailUseSsl": true,
    "EmailSupport": "support@yourdomain.com",
    "SendEmailsInDevelopment": false
  },
  "Stripe": {
    "SecretKey": "CHANGE_ME_STRIPE_SECRET_KEY",
    "PublishableKey": "CHANGE_ME_STRIPE_PUBLISHABLE_KEY",
    "WebhookSecret": "CHANGE_ME_STRIPE_WEBHOOK_SECRET"
  },
  "HostedRunners": {
    "Enabled": false,
    "DeploymentMode": "dryRun",
    "ServerUrl": "https://api.automaton.monster",
    "DockerImage": "automaton-runner:latest",
    "DockerNetwork": "automaton_runner_network",
    "DataRoot": "/opt/automaton/hosted-runners"
  },
  "Logging": {
    "File": {
      "Path": "/app/logs",
      "RetainedFileCountLimit": 14
    },
    "Audit": {
      "RetentionDays": 90
    }
  },
  "DataProtection": {
    "KeysPath": "/app/data-protection-keys"
  },
  "RequestLogging": {
    "LogSuccessfulRequests": false
  },
  "PublishedApps": {
    "RootPath": "/app/AppData/published-apps",
    "PublicBaseUrl": "https://apps.automaton.monster",
    "ApiBaseUrl": "https://api.automaton.monster"
  },
  "Hetzner": {
    "ApiToken": "CHANGE_ME_HETZNER_API_TOKEN"
  },
  "RabbitMq": {
    "Host": "rabbitmq",
    "VirtualHost": "/",
    "Username": "automaton",
    "Password": "CHANGE_ME_RABBITMQ_PASSWORD"
  }
}
