{
  "ConnectionStrings": {
    "MySqlConnection": "Server=localhost;Port=3306;Database=automaton;User=Youruser;Password=YourPassword;"
  },
  "MediaStorage": {
    "MaxUploadBytes": 10485760,
    "DefaultQuotaBytes": 262144000
  },
  "AppFileRules": {
    "Baseline": {
      "SourceExclude": [
        ".env",
        ".env.*",
        ".DS_Store",
        "*.pyc",
        "*.log",
        ".git",
        ".automaton",
        "node_modules",
        "venv",
        ".venv",
        "__pycache__",
        ".vite",
        "coverage",
        "dist"
      ],
      "FrontendExclude": [
        ".env",
        ".env.*",
        ".DS_Store",
        "*.pyc",
        "*.log",
        ".git",
        "node_modules",
        "venv",
        ".venv",
        "__pycache__"
      ],
      "BackendExclude": [
        ".env",
        ".env.*",
        ".DS_Store",
        "*.pyc",
        "*.log",
        ".git",
        "node_modules",
        "venv",
        ".venv",
        "__pycache__"
      ],
      "RemixSourceExclude": [
        ".env",
        ".env.*",
        "*.pem",
        "*.key",
        "*.pfx",
        "*.p12",
        "secrets",
        "secrets/**",
        "secrets.json",
        "appsettings.json",
        "appsettings.*.json",
        ".local",
        "*.local.*",
        "private",
        "private/**",
        "uploads",
        "uploads/**",
        "data",
        "data/**",
        "runner",
        "runner/**"
      ],
      "RemixFrontendExclude": [
        ".env",
        ".env.*",
        "*.map",
        "*.pem",
        "*.key",
        "secrets.json",
        "appsettings.json",
        "appsettings.*.json",
        "*.local.*",
        "private",
        "private/**",
        "uploads",
        "uploads/**"
      ]
    }
  },
  "Logging": {
    "File": {
      "Path": "Logs",
      "RetainedFileCountLimit": 14
    },
    "Audit": {
      "RetentionDays": 90
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RequestLogging": {
    "LogSuccessfulRequests": true
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7091",
      "http://localhost:5173",
      "http://localhost:5174"
    ]
  },
  "JwtOptions": {
    "ValidateIssuer": true,
    "Issuer": "https://localhost:7091",
    "ValidateAudience": false,
    "Audience": "Automaton.Studio",
    "SaveToken": false
  },
  "AuthenticationSettings": {
    "HMacSettings": {
      "SecretKey": "YourSecureHmacSecretKey32CharsLong"
    },
    "RsaSettings": {
      "RsaPrivateKey": "<RSAKeyValue>Your RSA Key</RSAKeyValue>",
      "RsaPublicKey": "<RSAKeyValue>Your RSA Key</RSAKeyValue>",
      "IsIssuer": true
    },
    "RedisOptions": {
      "ConnectionString": "localhost",
      "InstanceName": "master"
    }
  },
  "AppConfig": {
    "WebsiteUrl": "http://localhost:5173",
    "DatabaseType": "MySql",
    "RefreshTokenLifetime": 4,
    "UserSignUp": true,
    "AiApiEncryptionKey": "YourSecureEncryptionKey32CharsLong"
  },
  "GitHub": {
    "ClientId": "your-github-oauth-client-id",
    "ClientSecret": "your-github-oauth-client-secret",
    "ApiBaseUrl": "https://api-dev.automaton.monster",
    "FrontendUrl": "http://localhost:5173"
  },
  "CloudflareTurnstile": {
    "Enabled": false,
    "AllowBypassWhenNotConfiguredInDevelopment": true,
    "SiteKey": "1x00000000000000000000AA",
    "SecretKey": "1x0000000000000000000000000000000AA"
  },
  "EmailConfig": {
    "EmailAccount": "your-email@example.com",
    "EmailPassword": "YourEmailPassword",
    "EmailHost": "smtp.example.com",
    "EmailPort": 587,
    "EmailUseSsl": true,
    "SupportEmail": "support@automaton.monster",
    "FromEmail": "hello@automaton.monster",
    "AdminEmail": "admin@automaton.monster",
    "SendEmailsInDevelopment": true
  },
  "UserPasswordConfig": {
    "RequireDigit": true,
    "RequireLowercase": false,
    "RequireUppercase": false,
    "RequireNonAlphanumeric": false,
    "RequiredLength": 6
  },
  "Stripe": {
    "SecretKey": "YourStripeSecretKey",
    "PublishableKey": "YourStripePublishableKey",
    "WebhookSecret": "YourStripeWebhookSecret"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5673,
    "VirtualHost": "/",
    "Username": "automaton",
    "Password": "automaton"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "ApplicationName": "Automaton.Api"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
              }
            }
          ]
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log.log",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Information"
        }
      }
    ]
  }
}
