  <data name="AutomatonRegisterUser.Subject" xml:space="preserve">
    <value>Welcome to Automaton, {{ Name }}!</value>
  </data>
  <data name="AutomatonRegisterUser.Body" xml:space="preserve">
    <value>
&lt;!doctype html&gt;
&lt;html&gt;
&lt;head&gt;
  &lt;meta charset="utf-8" /&gt;
  &lt;title&gt;Welcome to Automaton&lt;/title&gt;
&lt;/head&gt;
&lt;body style="font-family: Arial, sans-serif; color: #1f2937;"&gt;
  &lt;h2&gt;Welcome, {{ Name }}!&lt;/h2&gt;
  &lt;p&gt;Your Automaton account is ready.&lt;/p&gt;
  &lt;p&gt;
    You can sign in at: &lt;a href="{{ LoginUrl }}"&gt;{{ LoginUrl }}&lt;/a&gt;
  &lt;/p&gt;
  &lt;p&gt;If you have any questions, reach us at {{ SupportEmail }}.&lt;/p&gt;
&lt;/body&gt;
&lt;/html&gt;
    </value>
  </data>
  <data name="AutomatonProjectInvitation.Subject" xml:space="preserve">
    <value>You’ve been invited to {{ ProjectName }}</value>
  </data>
  <data name="AutomatonProjectInvitation.Body" xml:space="preserve">
    <value>
&lt;!doctype html&gt;
&lt;html&gt;
&lt;head&gt;
  &lt;meta charset="utf-8" /&gt;
  &lt;title&gt;Project Invitation&lt;/title&gt;
&lt;/head&gt;
&lt;body style="font-family: Arial, sans-serif; color: #1f2937;"&gt;
  &lt;h2&gt;Project invitation&lt;/h2&gt;
  &lt;p&gt;Hello {{ Name }},&lt;/p&gt;
  &lt;p&gt;You’ve been invited to join &lt;strong&gt;{{ ProjectName }}&lt;/strong&gt;.&lt;/p&gt;
  &lt;p&gt;
    Accept your invitation here: &lt;a href="{{ InviteUrl }}"&gt;{{ InviteUrl }}&lt;/a&gt;
  &lt;/p&gt;
  &lt;p&gt;If you didn’t expect this email, you can ignore it.&lt;/p&gt;
&lt;/body&gt;
&lt;/html&gt;
    </value>
  </data>
  <data name="AutomatonOrganizationInvitation.Subject" xml:space="preserve">
    <value>You've been invited to {{ OrganizationName }}</value>
  </data>
  <data name="AutomatonOrganizationInvitation.Body" xml:space="preserve">
    <value>
&lt;!doctype html&gt;
&lt;html&gt;
&lt;head&gt;
  &lt;meta charset="utf-8" /&gt;
  &lt;title&gt;Organization Invitation&lt;/title&gt;
&lt;/head&gt;
&lt;body style="font-family: Arial, sans-serif; color: #1f2937;"&gt;
  &lt;h2&gt;Organization Invitation&lt;/h2&gt;
  &lt;p&gt;Hello,&lt;/p&gt;
  &lt;p&gt;&lt;strong&gt;{{ InviterName }}&lt;/strong&gt; has invited you to join the organization &lt;strong&gt;{{ OrganizationName }}&lt;/strong&gt; as a &lt;strong&gt;{{ Role }}&lt;/strong&gt;.&lt;/p&gt;
  {% if RequirePasswordSetup == "true" %}
  &lt;p&gt;Before accepting the invitation, you need to set up your password:&lt;/p&gt;
  &lt;p&gt;&lt;a href="{{ SetupPasswordUrl }}" style="display: inline-block; padding: 10px 20px; background-color: #4CAF50; color: white; text-decoration: none; border-radius: 5px;"&gt;Set Up Password&lt;/a&gt;&lt;/p&gt;
  &lt;p&gt;After setting up your password, accept your invitation here:&lt;/p&gt;
  {% else %}
  &lt;p&gt;Accept your invitation here:&lt;/p&gt;
  {% endif %}
  &lt;p&gt;&lt;a href="{{ InvitationUrl }}" style="display: inline-block; padding: 10px 20px; background-color: #2196F3; color: white; text-decoration: none; border-radius: 5px;"&gt;Accept Invitation&lt;/a&gt;&lt;/p&gt;
  &lt;p&gt;This invitation will expire in {{ ExpirationHours }} hours.&lt;/p&gt;
  &lt;p&gt;If you didn't expect this email, you can safely ignore it.&lt;/p&gt;
  &lt;p&gt;If you have any questions, contact us at {{ SupportEmail }}.&lt;/p&gt;
&lt;/body&gt;
&lt;/html&gt;
    </value>
  </data>
  <data name="AutomatonResetPassword.Body" xml:space="preserve">
    <value>&lt;!DOCTYPE html&gt;
&lt;html&gt;
&lt;head&gt;
    &lt;title&gt;Password Reset for your Automaton account&lt;/title&gt;
    &lt;style&gt;
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
        }
        .container {
            width: 100%;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
            border: 1px solid #ddd;
            border-radius: 10px;
            background-color: #f9f9f9;
        }
        h1 {
            color: #4CAF50;
        }
        .button {
            display: inline-block;
            padding: 10px 20px;
            margin: 10px 0;
            font-size: 16px;
            color: #fff;
            background-color: #4CAF50;
            text-decoration: none;
            border-radius: 5px;
        }
        .button:hover {
            background-color: #45a049;
        }
        ul {
            list-style-type: none;
            padding: 0;
        }
        ul li {
            margin: 5px 0;
        }
    &lt;/style&gt;
&lt;/head&gt;
&lt;body&gt;
    &lt;div class="container"&gt;
        &lt;h1&gt;Hi, {{Name}}!&lt;/h1&gt;
        
        &lt;p&gt;You recently requested to reset your password for your Automaton account at &lt;a href="{{WebsiteUrl}}"&gt;{{WebsiteUrl}}&lt;/a&gt;.&lt;/p&gt;
        
        &lt;p&gt;Please reset your password by visiting the following link:&lt;/p&gt;
        &lt;p&gt;&lt;a href="{{ResetPasswordUrl}}" class="button"&gt;Reset Password&lt;/a&gt;&lt;/p&gt;
        
        &lt;p&gt;This password reset link is valid for the next 24 hours.&lt;/p&gt;
        
        &lt;p&gt;If you have any issues, please contact us at &lt;a href="mailto:{{SupportEmail}}"&gt;{{SupportEmail}}&lt;/a&gt;.&lt;/p&gt;
        
        &lt;p&gt;Best regards,&lt;/p&gt;
        &lt;p&gt;The Automaton Team&lt;/p&gt;
    &lt;/div&gt;
&lt;/body&gt;
&lt;/html&gt;</value>
  </data>
  <data name="AutomatonResetPassword.Subject" xml:space="preserve">
    <value>Reset Password for your Automaton account</value>
  </data>
  <data name="AutomatonResetPasswordConfirmation.Body" xml:space="preserve">
    <value>&lt;!DOCTYPE html&gt;
&lt;html&gt;
&lt;head&gt;
    &lt;title&gt;Password Reset confirmation for your Automaton account&lt;/title&gt;
    &lt;style&gt;
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
        }
        .container {
            width: 100%;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
            border: 1px solid #ddd;
            border-radius: 10px;
            background-color: #f9f9f9;
        }
        h1 {
            color: #4CAF50;
        }
        .button {
            display: inline-block;
            padding: 10px 20px;
            margin: 10px 0;
            font-size: 16px;
            color: #fff;
            background-color: #4CAF50;
            text-decoration: none;
            border-radius: 5px;
        }
        .button:hover {
            background-color: #45a049;
        }
        ul {
            list-style-type: none;
            padding: 0;
        }
        ul li {
            margin: 5px 0;
        }
    &lt;/style&gt;
&lt;/head&gt;
&lt;body&gt;
    &lt;div class="container"&gt;
        &lt;h1&gt;Hi, {{Name}}!&lt;/h1&gt;
        
        &lt;p&gt;You recently reset your password for your Automaton account at &lt;a href="{{WebsiteUrl}}"&gt;{{WebsiteUrl}}&lt;/a&gt;.&lt;/p&gt;
        
        &lt;p&gt;If it wasn't you please contact us at &lt;a href="mailto:{{SupportEmail}}"&gt;{{SupportEmail}}&lt;/a&gt;.&lt;/p&gt;
        
        &lt;p&gt;Best regards,&lt;/p&gt;
        &lt;p&gt;The Automaton Team&lt;/p&gt;
    &lt;/div&gt;
&lt;/body&gt;
&lt;/html&gt;</value>
  </data>
  <data name="AutomatonResetPasswordConfirmation.Subject" xml:space="preserve">
    <value>Password reset confirmation for Automaton account</value>
