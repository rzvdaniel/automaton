  <data name="AutomatonResetPasswordConfirmation.Body" xml:space="preserve">
    <value>&lt;!DOCTYPE html&gt;
&lt;html lang="en"&gt;
&lt;head&gt;
  &lt;meta charset="UTF-8"&gt;
  &lt;meta name="viewport" content="width=device-width, initial-scale=1.0"&gt;
  &lt;meta http-equiv="X-UA-Compatible" content="IE=edge"&gt;
  &lt;title&gt;Password Reset Confirmation&lt;/title&gt;
  &lt;style&gt;
    body { margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background-color: #f3f4f6; }
    table { border-spacing: 0; width: 100%; }
    td { padding: 0; }
    img { border: 0; display: block; }
    .email-container { max-width: 600px; margin: 0 auto; background-color: #ffffff; }
    .header { background: linear-gradient(135deg, #10b981 0%, #059669 100%); padding: 40px 30px; text-align: center; }
    .header h1 { color: #ffffff; margin: 0; font-size: 28px; font-weight: 600; }
    .content { padding: 40px 30px; color: #374151; line-height: 1.6; }
    .content h2 { color: #111827; font-size: 24px; margin: 0 0 20px 0; font-weight: 600; }
    .content p { margin: 0 0 16px 0; font-size: 16px; }
    .success-box { background-color: #d1fae5; border-left: 4px solid #10b981; padding: 20px; margin: 20px 0; border-radius: 4px; }
    .success-box p { margin: 0; color: #065f46; font-weight: 500; }
    .warning-box { background-color: #fef3c7; border-left: 4px solid #f59e0b; padding: 20px; margin: 20px 0; border-radius: 4px; }
    .warning-box p { margin: 0; color: #92400e; font-size: 14px; }
    .footer { background-color: #f9fafb; padding: 30px; text-align: center; color: #6b7280; font-size: 14px; border-top: 1px solid #e5e7eb; }
    .footer a { color: #10b981; text-decoration: none; }
    .divider { height: 1px; background-color: #e5e7eb; margin: 30px 0; }
    @media only screen and (max-width: 600px) {
      .content { padding: 30px 20px !important; }
      .header { padding: 30px 20px !important; }
    }
  &lt;/style&gt;
&lt;/head&gt;
&lt;body&gt;
  &lt;table role="presentation" style="width: 100%; background-color: #f3f4f6;"&gt;
    &lt;tr&gt;
      &lt;td align="center" style="padding: 40px 20px;"&gt;
        &lt;table role="presentation" class="email-container"&gt;
          &lt;tr&gt;
            &lt;td class="header"&gt;
              &lt;h1&gt;✅ Password Updated&lt;/h1&gt;
            &lt;/td&gt;
          &lt;/tr&gt;
          &lt;tr&gt;
            &lt;td class="content"&gt;
              &lt;h2&gt;Hi {{Name}},&lt;/h2&gt;
              &lt;div class="success-box"&gt;
                &lt;p&gt;✓ Your password has been successfully updated.&lt;/p&gt;
              &lt;/div&gt;
              &lt;p&gt;Your Automaton account password was recently changed. You can now sign in with your new password.&lt;/p&gt;
              &lt;div class="warning-box"&gt;
                &lt;p&gt;&lt;strong&gt;Security Alert:&lt;/strong&gt; If you didn't make this change, please contact our support team immediately.&lt;/p&gt;
              &lt;/div&gt;
              &lt;div class="divider"&gt;&lt;/div&gt;
              &lt;p style="font-size: 14px; color: #6b7280;"&gt;For security reasons, if this wasn't you, please contact us at &lt;a href="mailto:{{SupportEmail}}" style="color: #10b981; text-decoration: none;"&gt;{{SupportEmail}}&lt;/a&gt; right away.&lt;/p&gt;
              &lt;p style="font-size: 14px; color: #6b7280;"&gt;You can access your account at &lt;a href="{{WebsiteUrl}}" style="color: #10b981; text-decoration: none;"&gt;{{WebsiteUrl}}&lt;/a&gt;&lt;/p&gt;
            &lt;/td&gt;
          &lt;/tr&gt;
          &lt;tr&gt;
            &lt;td class="footer"&gt;
              &lt;p style="margin: 0 0 10px 0;"&gt;&lt;strong&gt;Automaton&lt;/strong&gt;&lt;/p&gt;
              &lt;p style="margin: 0;"&gt;Workflow automation made simple&lt;/p&gt;
              &lt;p style="margin: 15px 0 0 0; font-size: 12px; color: #9ca3af;"&gt;© 2026 Automaton. All rights reserved.&lt;/p&gt;
            &lt;/td&gt;
          &lt;/tr&gt;
        &lt;/table&gt;
      &lt;/td&gt;
    &lt;/tr&gt;
  &lt;/table&gt;
&lt;/body&gt;
