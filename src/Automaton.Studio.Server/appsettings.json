{
  "ConnectionStrings": {
    "MySqlConnection": "xxxxxxxxxxx"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:5001",
      "https://localhost:7091"
    ]
  },
  "JwtOptions": {
    "ValidateIssuer": true,
    "Issuer": "xxxxxxxxxxx",
    "ValidateAudience": false,
    "Audience": "Automaton.Studio",
    "SaveToken": false
  },
  "AuthenticationSettings": {
    "HMacSettings": {
      "SecretKey": "xxxxxxxxxxx"
    },
    "RsaSettings": {
      "RsaPrivateKey": "xxxxxxxxxxx",
      "RsaPublicKey": "xxxxxxxxxxx",
      "IsIssuer": true
    },
    "RedisOptions": {
      "ConnectionString": "localhost",
      "InstanceName": "master"
    }
  },
  "AppConfig": {
    "WebsiteUrl": "xxxxxxxxxxx",
    "DatabaseType": "MySql",
    "RefreshTokenLifetime": 4,
    "RunnerRefreshTokenLifetime": 36500,
    "UserSignUp": true,
    "AiApiEncryptionKey": "xxxxxxxxxxx"
  },
  "AiProviders": {
    "Providers": {
      "OpenAI": {
        "DefaultModel": "gpt-4o",
        "SupportedModels": [
          "gpt-4o",
          "gpt-4.1",
          "gpt-5",
          "gpt-5-mini",
          "gpt-5-codex",
          "gpt-5.1",
          "gpt-5.1-mini",
          "gpt-5.1-codex-mini"
        ],
        "Enabled": true
      },
      "Anthropic": {
        "DefaultModel": "claude-sonnet-4",
        "SupportedModels": [
          "claude-sonnet-4",
          "claude-haiku-4.5",
          "claude-sonnet-4.5"
        ],
        "Enabled": true
      },
      "Google": {
        "DefaultModel": "gemini-2.5-pro",
        "SupportedModels": [
          "gemini-2.5-pro",
          "gemini-3-pro-preview"
        ],
        "Enabled": true
      }
    }
  },
  "EmailConfig": {
    "EmailApiKey": "xxxxxxxxxxx",
    "EmailApiUrl": "xxxxxxxxxxx",
    "EmailSupport": "xxxxxxxxxxx"
  },
  "UserPasswordConfig": {
    "RequireDigit": true,
    "RequireLowercase": false,
    "RequireUppercase": false,
    "RequireNonAlphanumeric": false,
    "RequiredLength": 6
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.MariaDB"
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "ApplicationName": "Automaton.Studio.Server"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
              }
            }
          ]
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log.log",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Information"
        }
      }
    ]
  }
}
