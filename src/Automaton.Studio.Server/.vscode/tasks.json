{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "stop-automaton-studio-server",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "$process = Get-Process -Name 'Automaton.Studio.Server' -ErrorAction SilentlyContinue; if ($process) { $process | Stop-Process -Force }"
      ],
      "problemMatcher": []
    },
    {
      "label": "build",
      "dependsOn": [
        "stop-automaton-studio-server"
      ],
      "dependsOrder": "sequence",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Automaton.Studio.Server.csproj"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Automaton.Studio.Server.csproj"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
