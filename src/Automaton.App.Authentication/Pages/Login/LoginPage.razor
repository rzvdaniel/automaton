@attribute [AllowAnonymous]
@page "/login"

<Layout>
    <Content>
        <div class="auth-container">
            <!-- Form Panel -->
            <div class="form-panel">
                <div class="form-content">
                    <Form Loading="loading"
                          Model="@Model"
                          Layout="@FormLayout.Vertical"
                          OnFinish="OnFinish"
                          OnFinishFailed="OnFinishFailed"
                          Class="auth-form">

                        <ChildContent>
                            <div class="form-header">
                                <Title Level="1" Class="form-title">Sign in</Title>
                                @if (ConfigurationService.UserSignUp)
                                {
                                    <p class="form-subtitle">
                                        Don't have an account? <a href="/register" class="signup-link">Sign up</a>
                                    </p>
                                }
                            </div>
                           
                            <FormItem Label="Email">
                                <Input @bind-Value="@context.Email" Size="@InputSize.Large" />
                            </FormItem>
                            <FormItem Label="Password">
                                <InputPassword @bind-Value="@context.Password" Size="@InputSize.Large" />
                            </FormItem>
                            <FormItem>
                                <div class="remember-me-container">
                                    <Checkbox @bind-Value="context.RememberMe">Remember me</Checkbox>
                                    <div class="forgot-password">
                                        <a href="Account/ForgotPassword">Forgot your password?</a>
                                    </div>
                                </div>
                            </FormItem>
                            <FormItem>
                                <Button Type="ButtonType.Primary" HtmlType="submit" Size="@ButtonSize.Large" Block>
                                    Sign in
                                </Button>
                            </FormItem>
                        </ChildContent>

                    </Form>
                </div>
            </div>

            <!-- Information Panel -->
            <div class="info-panel">
                <div class="info-content">
                    <div class="brand-section">
                        <h1 class="brand-title">Welcome Back</h1>
                        <p class="brand-subtitle">Continue building powerful automation workflows</p>
                    </div>
                    
                    <div class="hero-visual">
                        <div class="code-editor-mockup">
                            <div class="editor-header">
                                <div class="editor-tabs">
                                    <div class="tab active">workflow.py</div>
                                    <div class="tab">config.json</div>
                                </div>
                            </div>
                            <div class="editor-content">
                                <div class="code-line">
                                    <span class="line-number">1</span>
                                    <span class="code-text">
                                        <span class="keyword">def</span> 
                                        <span class="function">authenticate</span>(<span class="parameter">user</span>):
                                    </span>
                                </div>
                                <div class="code-line">
                                    <span class="line-number">2</span>
                                    <span class="code-text">
                                        &nbsp;&nbsp;<span class="comment"># Secure authentication</span>
                                    </span>
                                </div>
                                <div class="code-line">
                                    <span class="line-number">3</span>
                                    <span class="code-text">
                                        &nbsp;&nbsp;<span class="keyword">validate_credentials</span>(<span class="parameter">user</span>)
                                    </span>
                                </div>
                                <div class="code-line">
                                    <span class="line-number">4</span>
                                    <span class="code-text">
                                        &nbsp;&nbsp;<span class="keyword">start_session</span>()
                                    </span>
                                </div>
                                <div class="code-line">
                                    <span class="line-number">5</span>
                                    <span class="code-text">
                                        &nbsp;&nbsp;<span class="keyword">return</span> <span class="string">"authenticated"</span>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </Content>
</Layout>





