@page "/Account/ForgotPassword"
@attribute [AllowAnonymous]

<PageTitle>Forgot your password?</PageTitle>

<Layout>
    <Content>
        <GridRow Justify="center" Align="center" Class="grid-container">
            <GridCol>

                <Form Loading="loading"
                      Model="@Input"
                      Layout="@FormLayout.Vertical"
                      OnFinish="OnFinish"
                      OnFinishFailed="OnFinishFailed"
                      Style="width: 400px">

                    <ChildContent>

                        <Title Level="1">Forgot your password?</Title>

                        <FormItem Label="Email">
                            <Input @bind-Value="@context.Email" Placeholder="Enter your email" />
                        </FormItem>

                        <FormItem>
                            <Button Type="@ButtonType.Primary" HtmlType="submit">
                                Submit
                            </Button>
                        </FormItem>
                    </ChildContent>
                </Form>

            </GridCol>
        </GridRow>
    </Content>
</Layout>

<style>

    .grid-container {
        height: 100%;
        background-color: white;
        align-items: center
    }

    .site-layout-content {
        height: 100%;
    }

    .ant-layout {
        height: 100%;
    }

</style>
