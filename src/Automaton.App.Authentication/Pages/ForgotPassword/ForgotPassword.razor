@page "/Account/ForgotPassword"
@attribute [AllowAnonymous]

<PageTitle>Forgot your password?</PageTitle>

<Layout>
    <Content>
        <div class="auth-container">
            <div class="auth-content forgot-password-content">
                <!-- Information Panel -->
                <div class="info-panel">
                    <div class="info-content">
                        <div class="brand-section">
                            <div class="brand-icon">
                                <Icon Type="mail" Style="font-size: 48px; color: white;" />
                            </div>
                            <h1 class="brand-title">Reset Password</h1>
                            <p class="brand-subtitle">We'll help you get back to your workflows</p>
                        </div>
                        
                        <div class="help-section">
                            <div class="help-item">
                                <Icon Type="check-circle" Style="color: white;" />
                                <span>Enter your registered email address</span>
                            </div>
                            <div class="help-item">
                                <Icon Type="mail" Style="color: white;" />
                                <span>We'll send you a reset link</span>
                            </div>
                            <div class="help-item">
                                <Icon Type="safety" Style="color: white;" />
                                <span>Your account stays secure</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Form Panel -->
                <div class="form-panel">
                    <div class="form-content">
                        <Form Loading="loading"
                              Model="@Input"
                              Layout="@FormLayout.Vertical"
                              OnFinish="OnFinish"
                              OnFinishFailed="OnFinishFailed"
                              Class="auth-form">

                            <ChildContent>
                                <div class="form-header">
                                    <Title Level="1" Class="form-title">Forgot Password</Title>
                                    <p class="form-subtitle">
                                        Remember your password? <a href="/login" class="signin-link">Sign in</a>
                                    </p>
                                </div>

                                <FormItem Label="Email">
                                    <Input @bind-Value="@context.Email" Placeholder="Enter your email" Size="@InputSize.Large" />
                                </FormItem>

                                <FormItem>
                                    <Button Type="ButtonType.Primary" HtmlType="submit" Size="@ButtonSize.Large" Block>
                                        Send Reset Link
                                    </Button>
                                </FormItem>
                            </ChildContent>
                        </Form>
                    </div>
                </div>
            </div>
        </div>
    </Content>
</Layout>


