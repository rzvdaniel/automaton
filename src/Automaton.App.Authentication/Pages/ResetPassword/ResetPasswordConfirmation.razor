@page "/Account/ResetPasswordConfirmation"
@attribute [AllowAnonymous]

<PageTitle>Reset password confirmation</PageTitle>

<Layout>
    <Content>
        <GridRow Justify="center" Align="center" Class="grid-container">
            <GridCol>

                <Title Level="1">Reset password confirmation</Title>
                <h3>Your password has been reset.</h3>

                <p>
                    <a href="Login">Click here to log in</a>
                </p>

            </GridCol>
        </GridRow>
    </Content>
</Layout>

<style>

    .grid-container {
        height: 100%;
        background-color: white;
        align-items: center;
        text-align: center;
    }

    .site-layout-content {
        height: 100%;
    }

    .ant-layout {
        height: 100%;
    }

</style>
