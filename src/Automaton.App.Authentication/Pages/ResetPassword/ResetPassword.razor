@page "/Account/ResetPassword"
@attribute [AllowAnonymous]

@using System.ComponentModel.DataAnnotations
@using System.Text

<PageTitle>Reset password</PageTitle>

<Layout>
    <Content>
        <div class="auth-container">
            <!-- Form Panel -->
            <div class="form-panel">
                <div class="form-content">
                    <Form Loading="loading"
                          Model="@Input"
                          Layout="@FormLayout.Vertical"
                          OnFinish="OnFinish"
                          OnFinishFailed="OnFinishFailed"
                          Class="auth-form">

                        <ChildContent>
                            <div class="form-header">
                                <Title Level="1" Class="form-title">Reset Password</Title>
                                <p class="form-subtitle">
                                    Enter your new password below
                                </p>
                            </div>

                            <FormItem Label="Email">
                                <Input @bind-Value="Input.Email" Placeholder="Enter your email" Size="@InputSize.Large" />
                            </FormItem>

                            <FormItem Label="Password">
                                <InputPassword @bind-Value="Input.Password" Placeholder="Enter your password" Size="@InputSize.Large" />
                            </FormItem>

                            <FormItem Label="Confirm password">
                                <InputPassword @bind-Value="Input.ConfirmPassword" Placeholder="Confirm your password" Size="@InputSize.Large" />
                            </FormItem>

                            <FormItem>
                                <Button Type="ButtonType.Primary" HtmlType="submit" Size="@ButtonSize.Large" Block>
                                    Update Password
                                </Button>
                            </FormItem>
                        </ChildContent>
                    </Form>
                </div>
            </div>

            <!-- Information Panel -->
            <div class="info-panel">
                <div class="info-content">
                    <div class="brand-section">
                        <h1 class="brand-title">Secure Your Account</h1>
                        <p class="brand-subtitle">Create a strong, memorable password</p>
                    </div>
                    
                    <div class="hero-visual">
                        <div class="security-mockup">
                            <div class="security-header">
                                <div class="security-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                    </svg>
                                </div>
                            </div>
                            <div class="security-body">
                                <div class="security-requirements">
                                    <div class="requirement">
                                        <span class="check-icon">✓</span>
                                        <span>At least 8 characters</span>
                                    </div>
                                    <div class="requirement">
                                        <span class="check-icon">✓</span>
                                        <span>Mix of letters & numbers</span>
                                    </div>
                                    <div class="requirement">
                                        <span class="check-icon">✓</span>
                                        <span>Include special symbols</span>
                                    </div>
                                    <div class="requirement">
                                        <span class="check-icon">✓</span>
                                        <span>Uppercase & lowercase</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="strength-meter">
                            <div class="meter-label">Password Strength</div>
                            <div class="meter-bar">
                                <div class="meter-fill strong"></div>
                            </div>
                            <div class="meter-text">Strong</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </Content>
</Layout>



