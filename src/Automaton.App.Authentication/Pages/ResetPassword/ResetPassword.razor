@page "/Account/ResetPassword"
@attribute [AllowAnonymous]

@using System.ComponentModel.DataAnnotations
@using System.Text

<PageTitle>Reset password</PageTitle>

<Layout>
    <Content>
        <GridRow Justify="RowJustify.Center" Align="RowAlign.Middle" Class="grid-container">
            <GridCol>

                <Form Loading="loading"
                      Model="@Input"
                      Layout="@FormLayout.Vertical"
                      OnFinish="OnFinish"
                      OnFinishFailed="OnFinishFailed" Style="width: 400px">

                    <ChildContent>

                        <Title Level="1">Reset your password.</Title>

                        <FormItem Label="Email">
                            <Input @bind-Value="Input.Email" Placeholder="Enter your email" />
                        </FormItem>

                        <FormItem Label="Password">
                            <InputPassword @bind-Value="Input.Password" Placeholder="Enter your password" />
                        </FormItem>

                        <FormItem Label="Confirm password">
                            <InputPassword @bind-Value="Input.ConfirmPassword" Placeholder="Confirm your password" />
                        </FormItem>

                        <FormItem>
                            <Button Type="ButtonType.Primary" HtmlType="submit">
                                Reset
                            </Button>
                        </FormItem>
                    </ChildContent>
                </Form>

            </GridCol>
        </GridRow>
    </Content>
</Layout>

<style>

    .grid-container {
        height: 100%;
        background-color: white;
        align-items: center;
    }

    .site-layout-content {
        height: 100%;
    }

    .ant-layout {
        height: 100%;
    }

</style>

