@attribute [AllowAnonymous]
@page "/register"

<Layout>
    <Content Id="register-user">
        <div class="auth-container">
            <!-- Information Panel -->
            <div class="info-panel">
                <div class="info-content">
                    <div class="brand-section">
                        <div class="brand-icon">
                            <Icon Type="robot" Style="font-size: 48px; color: white;" />
                        </div>
                        <h1 class="brand-title">Join Automaton</h1>
                        <p class="brand-subtitle">Start automating your workflows today</p>
                    </div>
                    
                    <div class="features-section">
                        <div class="feature-item">
                            <Icon Type="rocket" Style="color: white;" />
                            <span>Get started in minutes</span>
                        </div>
                        <div class="feature-item">
                            <Icon Type="setting" Style="color: white;" />
                            <span>Visual workflow designer</span>
                        </div>
                        <div class="feature-item">
                            <Icon Type="deployment-unit" Style="color: white;" />
                            <span>Deploy anywhere</span>
                        </div>
                        <div class="feature-item">
                            <Icon Type="safety-certificate" Style="color: white;" />
                            <span>Enterprise-grade security</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Form Panel -->
            <div class="form-panel">
                <div class="form-content">
                    <Form Loading="loading"
                          Model="@UserRegisterViewModel"
                          Layout="@FormLayout.Vertical"
                          OnFinish="OnFinish"
                          OnFinishFailed="OnFinishFailed"
                          Class="auth-form">

                        <ChildContent>
                            <div class="form-header">
                                <Title Level="1" Class="form-title">Create Account</Title>
                                <p class="form-subtitle">
                                    Already have an account? <a href="/login" class="signin-link">Sign in</a>
                                </p>
                            </div>

                            <FormItem Label="Name">
                                <Input @bind-Value="@context.Name" Size="@InputSize.Large" />
                            </FormItem>

                            <FormItem Label="Email">
                                <Input @bind-Value="@context.Email" Size="@InputSize.Large" />
                            </FormItem>

                            <FormItem Label="Password">
                                <InputPassword @bind-Value="@context.Password" Size="@InputSize.Large" />
                            </FormItem>

                            <FormItem Label="Confirm Password">
                                <InputPassword @bind-Value="@context.ConfirmPassword" Size="@InputSize.Large" />
                            </FormItem>

                            <FormItem>
                                <Checkbox @bind-Value="@context.AgreeWithTermsPrivacyPolicy">
                                    I agree with <a href="/#" class="terms-link">Terms</a> and <a href="/#" class="terms-link">Privacy Policy</a>
                                </Checkbox>
                            </FormItem>

                            <FormItem>
                                <Button Type="ButtonType.Primary" HtmlType="submit" Size="@ButtonSize.Large" Block>
                                    Create Account
                                </Button>
                            </FormItem>
                        </ChildContent>
                    </Form>
                </div>
            </div>
        </div>
    </Content>
</Layout>






