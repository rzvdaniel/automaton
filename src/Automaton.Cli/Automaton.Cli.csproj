<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>automaton</AssemblyName>
    <RootNamespace>Automaton.Cli</RootNamespace>

    <!-- dotnet tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>automaton</ToolCommandName>
    <PackageId>Automaton.Cli</PackageId>
    <VersionPrefix>1.0</VersionPrefix>
    <Version Condition="'$(Version)' == ''">$(VersionPrefix).$([System.DateTime]::UtcNow.ToString("yyyyMMdd")).$([System.DateTime]::UtcNow.ToString("HHmmss"))</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Authors>Automaton</Authors>
    <Description>Automaton CLI — deploy apps, manage runners, publish versions</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README-NUGET.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="9.0.10" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\shared\ai-guidance\llms.txt">
      <LogicalName>Automaton.Cli.AiGuidance.llms.txt</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\shared\ai-guidance\llms\automaton-cli-install.md">
      <LogicalName>Automaton.Cli.AiGuidance.llms.automaton-cli-install.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\shared\ai-guidance\llms\automaton-backend-controllers.md">
      <LogicalName>Automaton.Cli.AiGuidance.llms.automaton-backend-controllers.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\shared\ai-guidance\llms\automaton-cli-deploy.md">
      <LogicalName>Automaton.Cli.AiGuidance.llms.automaton-cli-deploy.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\shared\ai-guidance\llms\automaton-frontend-structure.md">
      <LogicalName>Automaton.Cli.AiGuidance.llms.automaton-frontend-structure.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\shared\ai-guidance\llms\automaton-starter-prompts.md">
      <LogicalName>Automaton.Cli.AiGuidance.llms.automaton-starter-prompts.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\shared\ai-guidance\templates\AGENTS.md">
      <LogicalName>Automaton.Cli.AiGuidance.templates.AGENTS.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\shared\ai-guidance\templates\instructions.md">
      <LogicalName>Automaton.Cli.AiGuidance.templates.instructions.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\shared\ai-guidance\templates\SKILL.md">
      <LogicalName>Automaton.Cli.AiGuidance.templates.SKILL.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\shared\ai-guidance\templates\adapter.md">
      <LogicalName>Automaton.Cli.AiGuidance.templates.adapter.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\shared\ai-guidance\templates\github-skill.md">
      <LogicalName>Automaton.Cli.AiGuidance.templates.github-skill.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\shared\ai-guidance\templates\gitignore">
      <LogicalName>Automaton.Cli.AiGuidance.templates.gitignore</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="README-NUGET.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
