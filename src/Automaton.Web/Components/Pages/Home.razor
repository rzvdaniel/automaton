@page "/"

<PageTitle>Automaton - Streamline Your Workflows</PageTitle>

<section class="hero">
    <div class="hero-content">
        <h1>Automaton</h1>
        <p class="hero-subtitle">
            The lightweight, cross-platform automation platform that streamlines and orchestrates your software tasks. 
            Build powerful workflows with visual interfaces and Python extensibility.
        </p>
        
        <div class="cta-buttons">
            <a href="https://studio.automaton.monster" class="btn btn-primary" target="_blank">
                🚀 Try Automaton Studio
            </a>
            <a href="https://studio.automaton.monster/docs" class="btn btn-outline" target="_blank">
                📚 Documentation
            </a>
        </div>
        
        <div class="code-preview">
            <pre><code># Simple automation workflow
def process_data(input_file):
    # Load data
    data = read_csv(input_file)
    
    # Transform
    processed = data.transform()
    
    # Export results
    export_results(processed)
    
# Automaton handles the orchestration ⚡</code></pre>
        </div>
    </div>
</section>

<section class="features">
    <div class="features-container">
        <h2 class="section-title">Powerful Automation Made Simple</h2>
        
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon">🧩</div>
                <h3 class="feature-title">Visual Flow Builder</h3>
                <p class="feature-description">
                    Design automation pipelines using a clean, intuitive drag-and-drop interface. 
                    Build complex workflows without writing code.
                </p>
            </div>
            
            <div class="feature-card">
                <div class="feature-icon">🐍</div>
                <h3 class="feature-title">Python Integration</h3>
                <p class="feature-description">
                    Create and embed custom steps using Python code. Full scripting power 
                    when you need it, visual simplicity when you don't.
                </p>
            </div>
            
            <div class="feature-card">
                <div class="feature-icon">🌐</div>
                <h3 class="feature-title">Remote Execution</h3>
                <p class="feature-description">
                    Run workflows on any connected system with compatible runners. 
                    Distribute workloads across your infrastructure.
                </p>
            </div>
            
            <div class="feature-card">
                <div class="feature-icon">🔁</div>
                <h3 class="feature-title">Smart Logic Blocks</h3>
                <p class="feature-description">
                    Use conditionals, loops, HTTP requests, and more. Build sophisticated 
                    automation logic with pre-built components.
                </p>
            </div>
            
            <div class="feature-card">
                <div class="feature-icon">📦</div>
                <h3 class="feature-title">Self-Hosted</h3>
                <p class="feature-description">
                    Deploy on any web server supporting .NET. Keep your automation 
                    workflows under your control and within your infrastructure.
                </p>
            </div>
            
            <div class="feature-card">
                <div class="feature-icon">💾</div>
                <h3 class="feature-title">Persistent Storage</h3>
                <p class="feature-description">
                    Built-in MySQL support for reliable state management and workflow 
                    persistence. Your automation data is always secure.
                </p>
            </div>
        </div>
    </div>
</section>

