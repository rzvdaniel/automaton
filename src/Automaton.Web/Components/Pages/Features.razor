@page "/features"

<PageTitle>Features - Automaton</PageTitle>

<section class="hero" style="min-height: 60vh;">
    <div class="hero-content">
        <h1>Powerful Features</h1>
        <p class="hero-subtitle">
            Everything you need to build, deploy, and manage automation workflows at scale.
        </p>
    </div>
</section>

<section class="features">
    <div class="features-container">
        <h2 class="section-title">Core Capabilities</h2>
        
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon">🎨</div>
                <h3 class="feature-title">Visual Workflow Designer</h3>
                <p class="feature-description">
                    Drag and drop interface for creating complex workflows. Connect steps, 
                    add conditions, and build automation pipelines without writing code. 
                    Perfect for both technical and non-technical users.
                </p>
            </div>
            
            <div class="feature-card">
                <div class="feature-icon">⚡</div>
                <h3 class="feature-title">Custom Python Steps</h3>
                <p class="feature-description">
                    Write custom automation logic in Python. Full access to the Python 
                    ecosystem, libraries, and tools. Mix visual design with powerful 
                    scripting capabilities.
                </p>
            </div>
            
            <div class="feature-card">
                <div class="feature-icon">🔄</div>
                <h3 class="feature-title">Workflow Scheduling</h3>
                <p class="feature-description">
                    Schedule workflows to run automatically at specified times. Support 
                    for cron-like scheduling, recurring tasks, and event-triggered execution.
                </p>
            </div>
            
            <div class="feature-card">
                <div class="feature-icon">📊</div>
                <h3 class="feature-title">Real-time Monitoring</h3>
                <p class="feature-description">
                    Monitor workflow execution in real-time. View logs, track progress, 
                    and debug issues with comprehensive logging and activity tracking.
                </p>
            </div>
            
            <div class="feature-card">
                <div class="feature-icon">🔗</div>
                <h3 class="feature-title">API Integration</h3>
                <p class="feature-description">
                    Built-in HTTP request steps for API calls. Connect to REST APIs, 
                    webhooks, and external services. Handle authentication and data 
                    transformation seamlessly.
                </p>
            </div>
            
            <div class="feature-card">
                <div class="feature-icon">🏗️</div>
                <h3 class="feature-title">Distributed Execution</h3>
                <p class="feature-description">
                    Deploy runners across multiple machines. Execute workflows on remote 
                    systems, distribute workloads, and scale your automation infrastructure.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="features" style="background: var(--darker-bg);">
    <div class="features-container">
        <h2 class="section-title">Enterprise Ready</h2>
        
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon">🔒</div>
                <h3 class="feature-title">Security & Compliance</h3>
                <p class="feature-description">
                    Self-hosted deployment keeps your data secure. API key authentication, 
                    role-based access control, and audit logging for enterprise compliance.
                </p>
            </div>
            
            <div class="feature-card">
                <div class="feature-icon">📈</div>
                <h3 class="feature-title">Scalable Architecture</h3>
                <p class="feature-description">
                    Built on .NET for performance and reliability. MySQL backend for 
                    persistent storage. Scale horizontally by adding more runners.
                </p>
            </div>
            
            <div class="feature-card">
                <div class="feature-icon">🔧</div>
                <h3 class="feature-title">Extensible Platform</h3>
                <p class="feature-description">
                    Create custom steps and reusable components. Build libraries of 
                    automation logic specific to your organization's needs.
                </p>
            </div>
        </div>
        
        <div style="text-align: center; margin-top: 3rem;">
            <a href="https://studio.automaton.monster" class="btn btn-primary" target="_blank">
                🚀 Get Started Now
            </a>
        </div>
    </div>
</section>