@page "/Error"
@using System.Diagnostics
@using Microsoft.AspNetCore.Mvc
@attribute [ResponseCache(Duration = 0, Location = ResponseCacheLocation.None, NoStore = true)]

<PageTitle>Error - Automaton</PageTitle>

<section class="hero" style="min-height: 100vh; display: flex; align-items: center; justify-content: center; text-align: center;">
    <div style="max-width: 600px;">
        <div style="font-size: 4rem; margin-bottom: 1rem;">⚠️</div>
        <h1 style="font-size: 2rem; margin-bottom: 1rem;">Oops! Something went wrong</h1>
        <p style="color: var(--text-muted); margin-bottom: 2rem;">
            We apologize for the inconvenience. An error has occurred while processing your request.
        </p>
        
        @if (ShowRequestId)
        {
            <p style="color: var(--text-muted); margin-bottom: 2rem;">
                <strong>Request ID:</strong> <code style="background: var(--code-bg); padding: 0.2rem 0.5rem; border-radius: 4px;">@RequestId</code>
            </p>
        }
        
        <a href="/" class="btn btn-primary">
            🏠 Back to Home
        </a>
    </div>
</section>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
