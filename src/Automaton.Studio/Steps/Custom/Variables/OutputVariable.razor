@using Automaton.Core.Models;
@using Microsoft.AspNetCore.Components

<FormItem Label="@Variable.Name" Class="variable-label">
	<Row>
		<Col Md="20">
		<div class="string-input-display">
			<span class="string-value">@(Variable.Value?.ToString() ?? "(empty)")</span>
		</div>
		</Col>
		<Col Md="4">
		<div class="variable-actions">
			<Popover Content="@Variable.Description" Trigger="@(new AntDesign.Trigger[] { AntDesign.Trigger.Click })" Class="variable-description">
				<Button Shape="@ButtonShape.Circle" Icon="info" Size="@ButtonSize.Small"></Button>
			</Popover>
			<Popover Content="@Variable.Description" Trigger="@(new AntDesign.Trigger[] { AntDesign.Trigger.Click })" Class="variable-description">
				<Button Shape="@ButtonShape.Circle" Icon="read" Size="@ButtonSize.Small" OnClick="ShowValueModal"></Button>
			</Popover>
		</div>
		</Col>
	</Row>
</FormItem>

<!-- Modal for viewing full value -->
<Modal Title="@($"{Variable.Name}")"
	   @bind-Visible="isValueModalVisible"
	   Width="800">
		<div class="value-viewer">
			<pre>@(Variable.Value?.ToString() ?? "(empty)")</pre>
		</div>
</Modal>

@code {
	[Parameter]
	public StepVariable Variable { get; set; }

	private bool isValueModalVisible = false;

	private void ShowValueModal()
	{
		isValueModalVisible = true;
	}
}

<style>
	.variable-description {
		padding: 4px 0px 0px 4px;
	}

	.variable-label {
		margin: 0px;
		padding: 0px;
	}

	.string-input-display {
		display: flex;
		align-items: center;
		padding: 6px 12px;
		background-color: #fafafa;
		border: 1px solid #d9d9d9;
		border-radius: 4px;
		min-height: 32px;
	}

	.string-value {
		color: #666;
		font-size: 13px;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
		word-break: break-word;
		flex: 1;
	}

	.variable-actions {
		display: flex;
		gap: 4px;
		justify-content: flex-end;
	}

	.value-viewer {
		background-color: #f5f5f5;
		border: 1px solid #e8e8e8;
		border-radius: 4px;
		padding: 12px;
		max-height: 60vh;
		overflow-y: auto;
	}

		.value-viewer pre {
			margin: 0;
			font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
			font-size: 12px;
			line-height: 1.5;
			color: #333;
			white-space: pre-wrap;
			word-wrap: break-word;
		}
</style>
