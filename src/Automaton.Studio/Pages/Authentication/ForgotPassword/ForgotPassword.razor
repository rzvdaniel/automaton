@page "/Account/ForgotPassword"
@attribute [AllowAnonymous]

<PageTitle>Forgot your password?</PageTitle>

<Layout>
    <Content>
        <div class="auth-container">
            <!-- Form Panel -->
            <div class="form-panel">
                <div class="form-content">
                    <Form Loading="loading"
                          Model="@Input"
                          Layout="@FormLayout.Vertical"
                          OnFinish="OnFinish"
                          OnFinishFailed="OnFinishFailed"
                          Class="auth-form">

                        <ChildContent>
                            <div class="form-header">
                                <Title Level="1" Class="form-title">Forgot Password</Title>
                                <p class="form-subtitle">
                                    Remember your password? <a href="/login" class="signin-link">Sign in</a>
                                </p>
                            </div>

                            <FormItem Label="Email">
                                <Input @bind-Value="@context.Email" Placeholder="Enter your email" Size="@InputSize.Large" />
                            </FormItem>

                            <FormItem>
                                <Button Type="ButtonType.Primary" HtmlType="submit" Size="@ButtonSize.Large" Block>
                                    Send Reset Link
                                </Button>
                            </FormItem>
                        </ChildContent>
                    </Form>
                </div>
            </div>

            <!-- Information Panel -->
            <div class="info-panel">
                <div class="info-content">
                    <div class="brand-section">
                        <h1 class="brand-title">Recover Access</h1>
                        <p class="brand-subtitle">We'll help you get back to your workflows</p>
                    </div>
                    
                    <div class="hero-visual">
                        <div class="email-mockup">
                            <div class="email-header">
                                <div class="email-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="2" y="4" width="20" height="16" rx="2"/>
                                        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                                    </svg>
                                </div>
                                <div class="email-title">Password Reset</div>
                            </div>
                            <div class="email-body">
                                <div class="email-text">We've received a request to reset your password.</div>
                                <div class="email-button">Reset Password</div>
                                <div class="email-footer">Link expires in 1 hour</div>
                            </div>
                        </div>
                        
                        <div class="security-badges">
                            <div class="badge">
                                <div class="badge-icon">🔒</div>
                                <div class="badge-text">Secure Process</div>
                            </div>
                            <div class="badge">
                                <div class="badge-icon">⚡</div>
                                <div class="badge-text">Instant Email</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </Content>
</Layout>


