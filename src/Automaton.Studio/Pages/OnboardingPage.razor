@page "/onboarding"
@using Automaton.Studio.Services
@inject NavigationManager NavigationManager
@inject ConfigurationService ConfigService
@inject MessageService MessageService
@inject IJSRuntime JSRuntime

<Layout>
    <Header Class="header">
        <Row>
            <Col Flex=@("none")>
                <Space Size="SpaceSize.Large">
                    <SpaceItem Class="header-item">
                        <Breadcrumb>
                            <BreadcrumbItem Href="/">
                                <Icon Type="home" Width="16" Height="16" />
                                <span>Home</span>
                            </BreadcrumbItem>
                            <BreadcrumbItem>
                                <Icon Type="question-circle" Width="16" Height="16" />
                                <span>Get Started</span>
                            </BreadcrumbItem>
                        </Breadcrumb>
                    </SpaceItem>
                </Space>
            </Col>
            <Col Class="right-actions">
                <Space>
                    <SpaceItem>
                        <Button Type="@ButtonType.Primary" OnClick="@(() => NavigationManager.NavigateTo("/"))">
                            <Icon Type="home" />
                            Back to Dashboard
                        </Button>
                    </SpaceItem>
                </Space>
            </Col>
        </Row>
    </Header>

    <Content Class="content-padding home-content content-background">
        <div class="home-container">
            
            <!-- Header Section -->
            <div class="onboarding-header">
                <div class="onboarding-header-content">
                    <div class="onboarding-header-icon">
                        <Icon Type="question-circle" Style="font-size: 48px; color: white;" />
                    </div>
                    <div class="onboarding-header-text">
                        <Title Level="1" Style="margin-bottom: 8px;">Get Started with Automaton</Title>
                        <Paragraph Class="onboarding-subtitle">
                            Follow these steps to set up your first runner and start automating workflows.
                        </Paragraph>
                    </div>
                </div>
            </div>

            <!-- Description Section -->
            <div class="description-section">
                <div class="description-content">
                    <Paragraph Class="description-text">
                        To execute workflows, you need either our lightweight <strong class="highlight-text">Console Runner</strong> 
                        or the full-featured <strong class="highlight-text">Desktop App</strong>. Choose the option that best fits your needs.
                    </Paragraph>
                </div>
            </div>

            <!-- Two Path Grid -->
            <div class="path-container">
                <!-- Path A: Console Runner (Recommended) -->
                <Card Title="Console Runner" Class="path-card recommended" Bordered="true">
                    <Extra>
                        <span class="recommended-badge">Recommended</span>
                    </Extra>
                    <ChildContent>
                        <div class="recommended-card-content">
                            <div class="card-intro">
                                <Paragraph Class="card-description">
                                    Cross-platform console application that runs your workflows. Perfect for servers, CI/CD, and automation.
                                </Paragraph>
                            </div>

                            <div class="setup-steps">
                                <Title Level="4">Quick Setup:</Title>
                                
                                <div class="step-group">
                                    <div class="step-header">
                                        <span class="step-number">1</span>
                                        <strong>Download & Install</strong>
                                    </div>
                                    <div class="step-content">
                                        <div class="download-buttons">
                                            <Button Type="@ButtonType.Primary" Icon="windows" OnClick="@(() => NavigationManager.NavigateTo("/downloads"))" Size="@ButtonSize.Large">
                                                Download for Your Platform
                                            </Button>
                                        </div>
                                        <Paragraph Type="@TextElementType.Secondary" Style="margin-top: 8px;">
                                            Or use the quick install commands on the Downloads page
                                        </Paragraph>
                                    </div>
                                </div>

                                <div class="step-group">
                                    <div class="step-header">
                                        <span class="step-number">2</span>
                                        <strong>Get API Key</strong>
                                    </div>
                                    <div class="step-content">
                                        <Paragraph>Create an API key with "Runner" scope:</Paragraph>
                                        <Button Icon="key" OnClick="@(() => NavigationManager.NavigateTo("/apikeys"))">
                                            Go to API Keys
                                        </Button>
                                    </div>
                                </div>

                                <div class="step-group">
                                    <div class="step-header">
                                        <span class="step-number">3</span>
                                        <strong>Authenticate & Register</strong>
                                    </div>
                                    <div class="step-content">
                                        <div class="command-example">
                                            <div class="command-display">
                                                <Text Code># Authenticate with your API key</Text><br/>
                                                <Text Code Class="highlight-command">automaton-runner auth --api-key YOUR_API_KEY</Text>
                                                <Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard("automaton-runner auth --api-key YOUR_API_KEY"))" Style="margin-left: 8px;">
                                                    Copy
                                                </Button>
                                            </div>
                                        </div>
                                        <div class="command-example">
                                            <div class="command-display">
                                                <Text Code># Register your runner</Text><br/>
                                                <Text Code Class="highlight-command">automaton-runner register --name "My-Runner"</Text>
                                                <Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard("automaton-runner register --name \"My-Runner\""))" Style="margin-left: 8px;">
                                                    Copy
                                                </Button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="step-group">
                                    <div class="step-header">
                                        <span class="step-number">4</span>
                                        <strong>Start Running</strong>
                                    </div>
                                    <div class="step-content">
                                        <div class="command-example">
                                            <div class="command-display">
                                                <Text Code Class="highlight-command">automaton-runner run --name "My-Runner"</Text>
                                                <Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard("automaton-runner run --name \"My-Runner\""))" Style="margin-left: 8px;">
                                                    Copy
                                                </Button>
                                            </div>
                                        </div>
                                        <Paragraph Type="@TextElementType.Secondary">
                                            Your runner will appear in the Runners page once registered and connected.
                                        </Paragraph>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </ChildContent>
                </Card>

                <!-- Path B: Desktop App -->
                <Card Title="Desktop App" Class="path-card desktop" Bordered="true">
                    <Extra>
                        <Icon Type="appstore" />
                    </Extra>
                    <ChildContent>
                        <div class="desktop-card-content">
                            <div class="card-intro">
                                <h3 class="desktop-subtitle">All-in-One Solution</h3>
                                <Paragraph Class="card-description">
                                    Full desktop application with built-in workflow designer, runner, and management interface.
                                </Paragraph>
                            </div>
                            
                            <div class="desktop-features">
                                <div class="feature-item">
                                    <Icon Type="safety-certificate" Theme="IconThemeType.TwoTone" TwoToneColor="#52c41a" />
                                    <span>Fully Local</span>
                                </div>
                                <div class="feature-item">
                                    <Icon Type="tool" Theme="IconThemeType.TwoTone" TwoToneColor="#52c41a" />
                                    <span>No Setup Required</span>
                                </div>
                                <div class="feature-item">
                                    <Icon Type="thunderbolt" Theme="IconThemeType.TwoTone" TwoToneColor="#52c41a" />
                                    <span>Instant Start</span>
                                </div>
                            </div>
                            
                            <Button Type="@ButtonType.Default" Size="@ButtonSize.Large" OnClick="@DownloadDesktopApp" Class="desktop-download-btn">
                                Download Desktop App
                            </Button>
                        </div>
                    </ChildContent>
                </Card>
            </div>

            <!-- Help Section -->
            <div class="help-section">
                <div class="help-content">
                    <Title Level="3">Need Help?</Title>
                    <div class="help-links">
                        <a href="/docs/troubleshooting" class="help-link" target="_blank">
                            <Icon Type="book" />
                            <span>Documentation</span>
                        </a>
                        <a href="/support" class="help-link" target="_blank">
                            <Icon Type="customer-service" />
                            <span>Support</span>
                        </a>
                        <Button Type="@ButtonType.Link" OnClick="@(() => NavigationManager.NavigateTo("/runners"))" Style="padding: 0;">
                            <Icon Type="play-square" />
                            <span>View Runners</span>
                        </Button>
                    </div>
                </div>
            </div>

        </div>
    </Content>
</Layout>

<style>
    .connection-waiting {
        padding: 16px;
        background: #f6f8fa;
        border: 1px dashed #d0d7de;
        border-radius: 6px;
    }

    .command-display {
        display: flex;
        align-items: center;
        width: 100%;
        margin-bottom: 12px;
    }

    .command-display .ant-typography {
        flex: 1;
        margin-bottom: 0 !important;
    }

    .setup-steps {
        margin-top: 16px;
    }

    .step-group {
        margin-bottom: 24px;
        padding: 16px;
        background: #fafafa;
        border-radius: 6px;
        border-left: 4px solid #1890ff;
    }

    .step-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
    }

    .step-number {
        width: 24px;
        height: 24px;
        background: #1890ff;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 14px;
        flex-shrink: 0;
    }

    .step-content {
        margin-left: 36px;
    }

    .command-example {
        background: #f6f8fa;
        border: 1px solid #e1e4e8;
        border-radius: 6px;
        padding: 12px;
        margin: 8px 0;
        font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
    }

    .highlight-command {
        color: #0366d6 !important;
        font-weight: 600 !important;
    }

    .download-buttons {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin: 12px 0;
    }
</style>

@code {
    private async Task DownloadDesktopApp()
    {
        NavigationManager.NavigateTo($"{ConfigService.BaseUrl}/downloads/desktop", true);
    }

    private async Task CopyToClipboard(string text)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
            await MessageService.SuccessAsync("Command copied to clipboard");
        }
        catch
        {
            await MessageService.WarningAsync("Could not copy to clipboard. Please copy manually.");
        }
    }
}
