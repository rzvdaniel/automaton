@page "/onboarding"
@using Automaton.Studio.Services
@inject NavigationManager NavigationManager
@inject ConfigurationService ConfigService

<Layout>
    <Header Class="header">
        <Row>
            <Col Flex=@("none")>
                <Space Size="SpaceSize.Large">
                    <SpaceItem Class="header-item">
                        <Breadcrumb>
                            <BreadcrumbItem Href="/">
                                <Icon Type="home" Width="16" Height="16" />
                                <span>Home</span>
                            </BreadcrumbItem>
                            <BreadcrumbItem>
                                <Icon Type="question-circle" Width="16" Height="16" />
                                <span>Get Started</span>
                            </BreadcrumbItem>
                        </Breadcrumb>
                    </SpaceItem>
                </Space>
            </Col>
            <Col Class="right-actions">
                <Space>
                    <SpaceItem>
                        <Button Type="@ButtonType.Primary" OnClick="@(() => NavigationManager.NavigateTo("/"))">
                            <Icon Type="home" />
                            Back to Dashboard
                        </Button>
                    </SpaceItem>
                </Space>
            </Col>
        </Row>
    </Header>

    <Content Class="content-padding home-content content-background">
        <div class="home-container">
            
            <!-- Header Section -->
            <div class="onboarding-header">
                <div class="onboarding-header-content">
                    <div class="onboarding-header-icon">
                        <Icon Type="question-circle" Style="font-size: 48px; color: white;" />
                    </div>
                    <div class="onboarding-header-text">
                        <Title Level="1" Style="margin-bottom: 8px;">Get Started with Automaton</Title>
                        <Paragraph Class="onboarding-subtitle">
                            Follow these steps to set up your first runner and start automating workflows.
                        </Paragraph>
                    </div>
                </div>
            </div>

            <!-- Description Section -->
            <div class="description-section">
                <div class="description-content">
                    <Paragraph Class="description-text">
                        To execute workflows, you need either our lightweight <strong class="highlight-text">Console Runner</strong> 
                        or the full-featured <strong class="highlight-text">Desktop App</strong>. Choose the option that best fits your needs.
                    </Paragraph>
                </div>
            </div>

            <!-- Two Path Grid -->
            <div class="path-container">
                <!-- Path A: Console Runner (Recommended) -->
                <Card Title="Console Runner" Class="path-card recommended" Bordered="true">
                    <Extra>
                        <span class="recommended-badge">Recommended</span>
                    </Extra>
                    <ChildContent>
                        <div class="recommended-card-content">
                            <div class="recommended-main-content">
                                <div class="card-intro">
                                    <h3 class="runner-subtitle">Cross-Platform Solution</h3>
                                    <Paragraph Class="card-description">
                                        Cross-platform console application that runs your workflows. Perfect for servers, CI/CD, and automation.
                                    </Paragraph>
                                </div>

                                <div class="runner-features">
                                    <div class="feature-item">
                                        <Icon Type="global" Theme="IconThemeType.TwoTone" TwoToneColor="#1890ff" />
                                        <span>Cross-Platform</span>
                                    </div>
                                    <div class="feature-item">
                                        <Icon Type="code" Theme="IconThemeType.TwoTone" TwoToneColor="#1890ff" />
                                        <span>Lightweight</span>
                                    </div>
                                    <div class="feature-item">
                                        <Icon Type="cloud" Theme="IconThemeType.TwoTone" TwoToneColor="#1890ff" />
                                        <span>Server Ready</span>
                                    </div>
                                    <div class="feature-item">
                                        <Icon Type="api" Theme="IconThemeType.TwoTone" TwoToneColor="#1890ff" />
                                        <span>CI/CD Friendly</span>
                                    </div>
                                </div>
                            </div>
                            
                            <Button Type="@ButtonType.Primary" Size="@ButtonSize.Large" OnClick="@(() => NavigationManager.NavigateTo("/downloads-runner"))" Class="runner-download-btn">
                                <Icon Type="download" />
                                Download & Install
                            </Button>
                        </div>
                    </ChildContent>
                </Card>

                <!-- Path B: Desktop App -->
                <Card Title="Desktop App" Class="path-card desktop" Bordered="true">
                    <Extra>
                        <Icon Type="appstore" />
                    </Extra>
                    <ChildContent>
                        <div class="desktop-card-content">
                            <div class="desktop-main-content">
                                <div class="card-intro">
                                    <h3 class="desktop-subtitle">All-in-One Solution</h3>
                                    <Paragraph Class="card-description">
                                        Full desktop application with built-in workflow designer, runner, and management interface.
                                    </Paragraph>
                                </div>
                                
                                <div class="desktop-features">
                                    <div class="feature-item">
                                        <Icon Type="safety-certificate" Theme="IconThemeType.TwoTone" TwoToneColor="#52c41a" />
                                        <span>Fully Local</span>
                                    </div>
                                    <div class="feature-item">
                                        <Icon Type="tool" Theme="IconThemeType.TwoTone" TwoToneColor="#52c41a" />
                                        <span>No Setup Required</span>
                                    </div>
                                    <div class="feature-item">
                                        <Icon Type="thunderbolt" Theme="IconThemeType.TwoTone" TwoToneColor="#52c41a" />
                                        <span>Instant Start</span>
                                    </div>
                                    <div class="feature-item">
                                        <Icon Type="edit" Theme="IconThemeType.TwoTone" TwoToneColor="#52c41a" />
                                        <span>Built-in Designer</span>
                                    </div>
                                </div>
                            </div>
                            
                            <Button Type="@ButtonType.Default" Size="@ButtonSize.Large" OnClick="@(() => NavigationManager.NavigateTo("/downloads-desktop"))" Class="desktop-download-btn">
                                <Icon Type="download" />
                                Download Desktop App
                            </Button>
                        </div>
                    </ChildContent>
                </Card>
            </div>

            <!-- Help Section -->
            <div class="help-section">
                <div class="help-content">
                    <Title Level="3">Need Help?</Title>
                    <div class="help-links">
                        <a href="/docs/troubleshooting" class="help-link" target="_blank">
                            <Icon Type="book" />
                            <span>Documentation</span>
                        </a>
                        <a href="/support" class="help-link" target="_blank">
                            <Icon Type="customer-service" />
                            <span>Support</span>
                        </a>
                        <Button Type="@ButtonType.Link" OnClick="@(() => NavigationManager.NavigateTo("/runners"))" Style="padding: 0;">
                            <Icon Type="play-square" />
                            <span>View Runners</span>
                        </Button>
                    </div>
                </div>
            </div>

        </div>
    </Content>
</Layout>

@code {
    private void DownloadDesktopApp()
    {
        NavigationManager.NavigateTo($"{ConfigService.BaseUrl}/downloads/desktop", true);
    }
}

<style>
    .path-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
        gap: 24px;
        margin: 32px 0;
    }

    .path-card {
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .path-card.recommended {
        border: 2px solid #1890ff;
        position: relative;
    }

    .path-card.desktop {
        border: 1px solid #d9d9d9;
    }

    .recommended-badge {
        background: #1890ff;
        color: white;
        padding: 4px 12px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: 600;
    }

    .recommended-card-content,
    .desktop-card-content {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 8px;
    }

    .recommended-main-content,
    .desktop-main-content {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .card-intro {
        margin-bottom: 16px;
    }

    .runner-subtitle,
    .desktop-subtitle {
        font-size: 18px;
        font-weight: 600;
        color: #1890ff;
        margin: 0 0 8px 0;
    }

    .desktop-subtitle {
        color: #52c41a;
    }

    .card-description {
        color: #666;
        margin-bottom: 16px !important;
        line-height: 1.6;
    }

    .runner-features,
    .desktop-features {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin: 16px 0;
        padding: 20px 16px;
        background: #f8f9fa;
        border-radius: 8px;
        flex: 1;
    }

    .desktop-features {
        background: #f6ffed;
    }

    .feature-item {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 14px;
        color: #595959;
        font-weight: 500;
    }

    .runner-download-btn,
    .desktop-download-btn {
        width: 100%;
        margin-top: 16px;
        border-radius: 8px;
        height: 48px;
        font-size: 16px;
        font-weight: 600;
    }

    .runner-download-btn {
        background: #1890ff;
        border-color: #1890ff;
    }

    .runner-download-btn:hover {
        background: #40a9ff;
        border-color: #40a9ff;
    }

    .desktop-download-btn {
        background: #722ed1;
        border-color: #722ed1;
        color: white;
    }

    .desktop-download-btn:hover {
        background: #9254de;
        border-color: #9254de;
    }

    @@media (max-width: 768px) {
        .path-container {
            grid-template-columns: 1fr;
            gap: 16px;
        }
    }
</style>