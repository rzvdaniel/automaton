@page "/onboarding"
@using Automaton.Studio.Services
@inject NavigationManager NavigationManager
@inject ConfigurationService ConfigService

<style>
    .home-content {
        min-height: auto;
        padding-bottom: 40px;
    }

    .home-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px 40px 24px;
    }

    /* Header section */
    .onboarding-header {
        margin-bottom: 32px;
        padding: 24px 0;
    }

    .onboarding-header-content {
        display: flex;
        align-items: center;
        gap: 24px;
    }

    .onboarding-header-icon {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 80px;
        height: 80px;
        background-color: #52c41a;
        border-radius: 16px;
    }

    .onboarding-header-text {
        flex: 1;
    }

    .onboarding-subtitle {
        font-size: 16px;
        color: #666;
        margin-bottom: 0;
    }

    /* Step cards */
    .setup-step-card {
        border: 2px solid #1890ff;
        background: linear-gradient(135deg, #f0f9ff 0%, #ffffff 100%);
    }

    .setup-step-card .ant-card-head-title {
        color: #1890ff;
        font-weight: 600;
    }

    .download-options {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .download-option {
        display: flex;
        align-items: center;
        font-size: 14px;
        padding: 4px 0;
    }

    /* Sample workflows */
    .sample-workflows-card .ant-card-head-title {
        color: #52c41a;
        font-weight: 600;
    }

    .sample-card {
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .sample-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-bottom: 16px;
    }

    .sample-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 50px;
        height: 50px;
        background: #f8f9fa;
        border-radius: 12px;
        margin: 0 auto;
    }

    .sample-info {
        text-align: center;
    }

    .sample-info h4 {
        margin-bottom: 8px;
        color: #262626;
    }

    .sample-actions {
        margin-top: auto;
    }

    /* Learning concepts */
    .learning-card .ant-card-head-title {
        color: #722ed1;
        font-weight: 600;
    }

    .concept-item {
        padding: 16px 0;
    }

    .concept-header {
        display: flex;
        align-items: center;
        margin-bottom: 12px;
    }

    .concept-header h4 {
        margin-bottom: 0;
    }

    /* Next steps */
    .next-steps-card .ant-card-head-title {
        color: #52c41a;
        font-weight: 600;
    }

    .next-step-section {
        padding: 8px 0;
    }

    .next-step-section h4 {
        margin-bottom: 12px;
        color: #262626;
    }

    /* Card styling */
    .setup-step-card,
    .sample-workflows-card,
    .learning-card,
    .next-steps-card {
        margin-bottom: 24px;
    }

    /* Responsive design */
    @@media (max-width: 768px) {
        .onboarding-header-content {
            flex-direction: column;
            text-align: center;
        }
        
        .concept-header {
            flex-direction: column;
            text-align: center;
            gap: 8px;
        }
        
        .next-step-section {
            text-align: center;
            margin-bottom: 24px;
        }
    }
</style>

<Layout>
    <Header Class="header">
        <Row>
            <Col Flex=@("none")>
                <Space Size="SpaceSize.Large">
                    <SpaceItem Class="header-item">
                        <Breadcrumb>
                            <BreadcrumbItem Href="/">
                                <Icon Type="home" Width="16" Height="16" />
                                <span>Home</span>
                            </BreadcrumbItem>
                            <BreadcrumbItem>
                                <Icon Type="question-circle" Width="16" Height="16" />
                                <span>Get Started</span>
                            </BreadcrumbItem>
                        </Breadcrumb>
                    </SpaceItem>
                </Space>
            </Col>
            <Col Class="right-actions">
                <Space>
                    <SpaceItem>
                        <Button Type="@ButtonType.Primary" OnClick="@(() => NavigationManager.NavigateTo("/"))">
                            <Icon Type="home" />
                            Back to Dashboard
                        </Button>
                    </SpaceItem>
                </Space>
            </Col>
        </Row>
    </Header>

    <Content Class="content-padding home-content content-background">
        <div class="home-container">
            
            <!-- Header Section -->
            <div class="onboarding-header">
                <div class="onboarding-header-content">
                    <div class="onboarding-header-icon">
                        <Icon Type="rocket" Style="font-size: 48px; color: white;" />
                    </div>
                    <div class="onboarding-header-text">
                        <Title Level="1" Style="margin-bottom: 8px;">Welcome to Automaton!</Title>
                        <Paragraph Class="onboarding-subtitle">
                            Let's get you started with workflow automation in just a few steps
                        </Paragraph>
                    </div>
                </div>
            </div>

            <!-- Step 1: Download & Setup -->
            <Card Class="setup-step-card" Style="margin-bottom: 24px;">
                <TitleTemplate>
                    <Icon Type="download" Style="margin-right: 8px;" />
                    <span>Step 1: Download & Setup</span>
                </TitleTemplate>
                <ChildContent>
                    <Row Gutter="24" Align="RowAlign.Middle">
                        <Col Span="16">
                            <Paragraph Style="font-size: 16px; margin-bottom: 16px;">
                                <strong>Choose your automation solution</strong> to start executing workflows:
                            </Paragraph>
                            <div class="download-options">
                                <div class="download-option">
                                    <Icon Type="code" Style="color: #1890ff; margin-right: 8px;" />
                                    <strong>Console Runner</strong> - Cross-platform, perfect for production
                                </div>
                                <div class="download-option">
                                    <Icon Type="appstore" Style="color: #722ed1; margin-right: 8px;" />
                                    <strong>Desktop App</strong> - All-in-one with visual designer
                                </div>
                            </div>
                        </Col>
                        <Col Span="8" Style="text-align: center;">
                            <Button Type="@ButtonType.Primary" Size="@ButtonSize.Large" OnClick="@(() => NavigationManager.NavigateTo("/downloads-hub"))" Style="width: 100%; height: 56px;">
                                <Icon Type="download" />
                                Choose Download Option
                            </Button>
                        </Col>
                    </Row>
                </ChildContent>
            </Card>

            <!-- Step 2: Try Sample Workflows -->
            <Card Class="sample-workflows-card" Style="margin-bottom: 24px;">
                <TitleTemplate>
                    <Icon Type="play-circle" Style="margin-right: 8px;" />
                    <span>Step 2: Try Sample Workflows</span>
                </TitleTemplate>
                <ChildContent>
                    <Paragraph Style="font-size: 16px; margin-bottom: 20px;">
                        <strong>Start with pre-built examples</strong> to learn how Automaton works:
                    </Paragraph>
                    
                    <Row Gutter="16">
                        <Col Span="8">
                            <Card Class="sample-card" Bordered="true" Hoverable="true">
                                <div class="sample-content">
                                    <div class="sample-icon">
                                        <Icon Type="notification" Style="font-size: 24px; color: #52c41a;" />
                                    </div>
                                    <div class="sample-info">
                                        <Title Level="4">Hello World</Title>
                                        <Paragraph>Simple workflow that displays a message. Perfect for testing your setup.</Paragraph>
                                    </div>
                                </div>
                                <div class="sample-actions">
                                    <Button Type="@ButtonType.Primary" Block="true" OnClick="@(() => CreateSampleWorkflow("hello-world"))">
                                        <Icon Type="plus" />
                                        Check Sample
                                    </Button>
                                </div>
                            </Card>
                        </Col>
                        
                        <Col Span="8">
                            <Card Class="sample-card" Bordered="true" Hoverable="true">
                                <div class="sample-content">
                                    <div class="sample-icon">
                                        <Icon Type="file-text" Style="font-size: 24px; color: #1890ff;" />
                                    </div>
                                    <div class="sample-info">
                                        <Title Level="4">File Operations</Title>
                                        <Paragraph>Create, read, and process files. Learn basic file handling automation.</Paragraph>
                                    </div>
                                </div>
                                <div class="sample-actions">
                                    <Button Type="@ButtonType.Primary" Block="true" OnClick="@(() => CreateSampleWorkflow("file-operations"))">
                                        <Icon Type="plus" />
                                    Check Sample
                                    </Button>
                                </div>
                            </Card>
                        </Col>
                        
                        <Col Span="8">
                            <Card Class="sample-card" Bordered="true" Hoverable="true">
                                <div class="sample-content">
                                    <div class="sample-icon">
                                        <Icon Type="api" Style="font-size: 24px; color: #722ed1;" />
                                    </div>
                                    <div class="sample-info">
                                        <Title Level="4">API Integration</Title>
                                        <Paragraph>Call REST APIs and process responses. Great for web automation.</Paragraph>
                                    </div>
                                </div>
                                <div class="sample-actions">
                                    <Button Type="@ButtonType.Primary" Block="true" OnClick="@(() => CreateSampleWorkflow("api-integration"))">
                                        <Icon Type="plus" />
                                    Check Sample
                                    </Button>
                                </div>
                            </Card>
                        </Col>
                    </Row>
                </ChildContent>
            </Card>

            <!-- Step 3: Learn Core Concepts -->
            <Card Class="learning-card" Style="margin-bottom: 24px;">
                <TitleTemplate>
                    <Icon Type="book" Style="margin-right: 8px;" />
                    <span>Step 3: Learn Core Concepts</span>
                </TitleTemplate>
                <ChildContent>
                    <Row Gutter="24">
                        <Col Span="8">
                            <div class="concept-item">
                                <div class="concept-header">
                                    <Icon Type="profile" Style="font-size: 24px; color: #1890ff; margin-right: 12px;" />
                                    <Title Level="4">Workflows</Title>
                                </div>
                                <Paragraph>Automated processes made up of connected steps that execute in sequence.</Paragraph>
                                <Button Type="@ButtonType.Link" OnClick="@(() => NavigationManager.NavigateTo("/flows"))" Style="padding: 0;">
                                    <Icon Type="arrow-right" />
                                    View Workflows
                                </Button>
                            </div>
                        </Col>
                        
                        <Col Span="8">
                            <div class="concept-item">
                                <div class="concept-header">
                                    <Icon Type="play-square" Style="font-size: 24px; color: #52c41a; margin-right: 12px;" />
                                    <Title Level="4">Runners</Title>
                                </div>
                                <Paragraph>Agents that execute your workflows on different machines or environments.</Paragraph>
                                <Button Type="@ButtonType.Link" OnClick="@(() => NavigationManager.NavigateTo("/runners"))" Style="padding: 0;">
                                    <Icon Type="arrow-right" />
                                    View Runners
                                </Button>
                            </div>
                        </Col>
                        
                        <Col Span="8">
                            <div class="concept-item">
                                <div class="concept-header">
                                    <Icon Type="experiment" Style="font-size: 24px; color: #722ed1; margin-right: 12px;" />
                                    <Title Level="4">Steps</Title>
                                </div>
                                <Paragraph>Individual actions in a workflow - from simple tasks to complex operations.</Paragraph>
                                <Button Type="@ButtonType.Link" OnClick="@(() => NavigationManager.NavigateTo("/customsteps"))" Style="padding: 0;">
                                    <Icon Type="arrow-right" />
                                    Browse Steps
                                </Button>
                            </div>
                        </Col>
                    </Row>
                </ChildContent>
            </Card>

            <!-- Step 4: Next Steps -->
            <Card Class="next-steps-card">
                <TitleTemplate>
                    <Icon Type="rocket" Style="margin-right: 8px;" />
                    <span>Step 4: Ready for More?</span>
                </TitleTemplate>
                <ChildContent>
                    <Row Gutter="24">
                        <Col Span="12">
                            <div class="next-step-section">
                                <Title Level="4">🎨 Create Your First Workflow</Title>
                                <Paragraph>
                                    Now that you understand the basics, create a workflow tailored to your specific needs.
                                </Paragraph>
                                <Space>
                                    <SpaceItem>
                                        <Button Type="@ButtonType.Primary" OnClick="@(() => NavigationManager.NavigateTo("/flows"))">
                                            <Icon Type="plus" />
                                            Create Workflow
                                        </Button>
                                    </SpaceItem>
                                    <SpaceItem>
                                        <Button OnClick="@(() => NavigationManager.NavigateTo("/customsteps"))">
                                            <Icon Type="experiment" />
                                            Browse Steps
                                        </Button>
                                    </SpaceItem>
                                </Space>
                            </div>
                        </Col>
                        
                        <Col Span="12">
                            <div class="next-step-section">
                                <Title Level="4">⚙️ Advanced Features</Title>
                                <Paragraph>
                                    Explore advanced features like API integration, scheduling, and custom step creation.
                                </Paragraph>
                                <Space>
                                    <SpaceItem>
                                        <Button OnClick="@(() => NavigationManager.NavigateTo("/apikeys"))">
                                            <Icon Type="key" />
                                            API Keys
                                        </Button>
                                    </SpaceItem>
                                    <SpaceItem>
                                        <Button OnClick="@OpenDocumentation">
                                            <Icon Type="book" />
                                            Documentation
                                        </Button>
                                    </SpaceItem>
                                </Space>
                            </div>
                        </Col>
                    </Row>

                    <Alert Type="@AlertType.Success" ShowIcon="true" Style="margin-top: 20px;">
                        <MessageTemplate>
                            <strong>🎉 Congratulations!</strong> You're ready to start automating with Automaton. Need help? Check our documentation or join the community!
                        </MessageTemplate>
                    </Alert>
                </ChildContent>
            </Card>
        </div>
    </Content>
</Layout>

@code {
    private void CreateSampleWorkflow(string sampleType)
    {
        // TODO: Implement sample workflow creation
        // This would create a pre-built workflow based on the sample type
        NavigationManager.NavigateTo($"/flows"); // For now, just go to flows page
    }
    
    private void OpenDocumentation()
    {
        // TODO: Open documentation in new tab
        NavigationManager.NavigateTo("https://docs.automaton.dev", true);
    }
}