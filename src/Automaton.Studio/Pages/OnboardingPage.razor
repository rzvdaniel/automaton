@page "/onboarding"
@using Automaton.Studio.Services
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject ConfigurationService ConfigService
@inject OnboardingService OnboardingService
@inject MessageService MessageService
@inject IJSRuntime JSRuntime
@implements IDisposable

<Layout>
    <Header Class="header">
        <Row>
            <Col Flex=@("none")>
                <Space Size="SpaceSize.Large">
                    <SpaceItem Class="header-item">
                        <Breadcrumb>
                            <BreadcrumbItem Href="/">
                                <Icon Type="home" Width="16" Height="16" />
                                <span>Home</span>
                            </BreadcrumbItem>
                            <BreadcrumbItem>
                                <Icon Type="question-circle" Width="16" Height="16" />
                                <span>Get Started</span>
                            </BreadcrumbItem>
                        </Breadcrumb>
                    </SpaceItem>
                </Space>
            </Col>
            <Col Class="right-actions">
                <Space>
                    <SpaceItem>
                        <Button Type="@ButtonType.Text" OnClick="@SkipOnboarding">
                            Skip for now
                        </Button>
                    </SpaceItem>
                    <SpaceItem>
                        <Button Type="@ButtonType.Text" OnClick="@GoToFlows">
                            Already set up? Go to Flows ?
                        </Button>
                    </SpaceItem>
                </Space>
            </Col>
        </Row>
    </Header>

    <Content Class="content-padding home-content content-background">
        <div class="home-container">
            
            <!-- Header Section -->
            <div class="onboarding-header">
                <div class="onboarding-header-content">
                    <div class="onboarding-header-icon">
                        <Icon Type="question-circle" Style="font-size: 48px; color: white;" />
                    </div>
                    <div class="onboarding-header-text">
                        <Title Level="1" Style="margin-bottom: 8px;">Get Started with Automaton</Title>
                        <Paragraph Class="onboarding-subtitle">
                            Let's get you set up to automate your first workflow in just a few minutes.
                        </Paragraph>
                    </div>
                </div>
            </div>

            <!-- Description Section -->
            <div class="description-section">
                <div class="description-content">
                    <Paragraph Class="description-text">
                        Because your workflows are executed securely on your computer, we need you to install a small 
                        <strong class="highlight-text">Agent</strong> or our dedicated <strong class="highlight-text">Desktop App</strong> 
                        to get started. You have two paths to success!
                    </Paragraph>
                </div>
            </div>

            <!-- Two Path Grid -->
            <div class="path-container">
                <!-- Path A: Web App + Local Agent -->
                <Card Title="Web App + Agent" Class="path-card recommended" Bordered="true">
                    <Extra>
                        <span class="recommended-badge">Recommended</span>
                    </Extra>
                    <ChildContent>
                        <div class="recommended-card-content">
                            <div class="recommended-main-content">
                                <div class="card-intro">
                                    <Paragraph Class="card-description">
                                        Use our powerful web interface to manage your workflows from anywhere, executed securely on your machines via a lightweight local agent.
                                    </Paragraph>
                                </div>

                                <Steps Direction="StepsDirection.Vertical" Current="@currentStep">
                                    <Step Title="Download and Install the Agent" Status="@step1Status">
                                        <DescriptionTemplate>
                                            <div>
                                                <p>This small program runs in the background on your computer to execute flows from the web app.</p>
                                                <div class="download-buttons">
                                                    <Button Type="@ButtonType.Primary" Icon="windows" OnClick="@(() => DownloadAgent("windows"))">Windows</Button>
                                                    <Button Icon="apple" OnClick="@(() => DownloadAgent("macos"))">macOS</Button>
                                                    <Button Icon="linux" OnClick="@(() => DownloadAgent("linux"))">Linux</Button>
                                                </div>
                                                <div class="installation-instructions">
                                                    <Collapse>
                                                        <Panel Header="Installation Instructions">
                                                            <ol>
                                                                <li>Run the downloaded installer</li>
                                                                <li>Follow the prompts to complete installation</li>
                                                                <li>Launch the Automaton Agent from your start menu/applications folder</li>
                                                            </ol>
                                                        </Panel>
                                                    </Collapse>
                                                </div>
                                            </div>
                                        </DescriptionTemplate>
                                    </Step>
                                    <Step Title="Connect your Agent" Status="@step2Status">
                                        <DescriptionTemplate>
                                            <div>
                                                <p>Run this command on your local machine to start the agent:</p>
                                                @if (!agentConnected)
                                                {
                                                    <div class="connection-waiting">
                                                        <div class="command-display">
                                                            <Text Code>automaton-agent --connect @ConfigService.BaseUrl</Text>
                                                            <Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyCommand($"automaton-agent --connect {ConfigService.BaseUrl}", "Agent connection command"))" Style="margin-left: 8px;">
                                                                Copy
                                                            </Button>
                                                        </div>
                                                        <div class="connection-status">
                                                            <Spin /> Waiting for Agent to connect...
                                                            <div style="margin-top: 8px;">
                                                                <Button Type="@ButtonType.Link" Size="@ButtonSize.Small" OnClick="@RefreshConnectionStatus" Loading="@isRefreshing">
                                                                    <Icon Type="reload" Style="margin-right: 4px;" />
                                                                    Refresh Status
                                                                </Button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="connection-success">
                                                        <div class="connection-status">
                                                            <Icon Type="check-circle" Theme="IconThemeType.TwoTone" TwoToneColor="#52c41a" /> Success! Your Agent is connected.
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </DescriptionTemplate>
                                    </Step>
                                </Steps>
                            </div>
                            
                            @if (agentConnected)
                            {
                                <Button Type="@ButtonType.Primary" OnClick="@CompleteOnboarding" Size="@ButtonSize.Large" Class="run-sample-btn">Get Started with Flows</Button>
                            }
                        </div>
                    </ChildContent>
                </Card>

                <!-- Path B: Desktop App -->
                <Card Title="Desktop App" Class="path-card desktop" Bordered="true">
                    <Extra>
                        <Icon Type="appstore" />
                    </Extra>
                    <ChildContent>
                        <div class="desktop-card-content">
                            <div class="desktop-main-content">
                                <div class="card-intro">
                                    <h3 class="desktop-subtitle">The All-in-One Solution</h3>
                                    <Paragraph Class="card-description">
                                        For a fully local experience with no agent to manage, download our standalone desktop application. 
                                        It includes everything you need in a single package.
                                    </Paragraph>
                                </div>
                                
                                <div class="desktop-features">
                                    <div class="feature-item">
                                        <Icon Type="safety-certificate" Theme="IconThemeType.TwoTone" TwoToneColor="#52c41a" />
                                        <span>Fully Local</span>
                                    </div>
                                    <div class="feature-item">
                                        <Icon Type="tool" Theme="IconThemeType.TwoTone" TwoToneColor="#52c41a" />
                                        <span>No Setup Required</span>
                                    </div>
                                    <div class="feature-item">
                                        <Icon Type="thunderbolt" Theme="IconThemeType.TwoTone" TwoToneColor="#52c41a" />
                                        <span>Instant Start</span>
                                    </div>
                                </div>
                            </div>
                            
                            <Button Type="@ButtonType.Default" Size="@ButtonSize.Large" OnClick="@DownloadDesktopApp" Class="desktop-download-btn">
                                Download Desktop App
                            </Button>
                        </div>
                    </ChildContent>
                </Card>
            </div>

            <!-- Help Section -->
            <div class="help-section">
                <div class="help-content">
                    <Title Level="3">Need Help?</Title>
                    <div class="help-links">
                        <a href="/docs/troubleshooting" class="help-link" target="_blank">
                            <Icon Type="book" />
                            <span>Documentation</span>
                        </a>
                        <a href="/support" class="help-link" target="_blank">
                            <Icon Type="customer-service" />
                            <span>Support</span>
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </Content>
</Layout>

<style>
    .connection-waiting {
        padding: 16px;
        background: #f6f8fa;
        border: 1px dashed #d0d7de;
        border-radius: 6px;
    }

    .command-display {
        display: flex;
        align-items: center;
        width: 100%;
        margin-bottom: 12px;
    }

    .command-display .ant-typography {
        flex: 1;
        margin-bottom: 0 !important;
    }

    .connection-status {
        color: #666;
        font-style: italic;
    }
</style>

<script>
    window.setupPageVisibilityDetection = (dotNetRef) => {
        const handleVisibilityChange = () => {
            const isVisible = !document.hidden;
            dotNetRef.invokeMethodAsync('OnPageVisibilityChanged', isVisible);
        };

        document.addEventListener('visibilitychange', handleVisibilityChange);
        
        // Cleanup function (called when page unloads)
        window.addEventListener('beforeunload', () => {
            document.removeEventListener('visibilitychange', handleVisibilityChange);
            dotNetRef.dispose();
        });
    };
</script>

@code {
    private int currentStep = 0;
    private StepsStatus step1Status = StepsStatus.Process;
    private StepsStatus step2Status = StepsStatus.Wait;
    private bool agentConnected = false;
    private bool isRefreshing = false;
    
    // Smart polling with exponential backoff - much better than 3-second fixed interval
    private System.Timers.Timer? connectionCheckTimer;
    private int pollingAttempts = 0;
    private readonly int[] pollingIntervals = { 5000, 10000, 20000, 30000, 60000, 120000 }; // 5s, 10s, 20s, 30s, 60s, 120s
    private bool isPageVisible = true;

    protected override async Task OnInitializedAsync()
    {
        // Set up page visibility detection to pause polling when tab inactive
        await SetupPageVisibilityDetection();
        
        // Start with initial check
        await CheckAgentConnectionOnce();
        
        // Set up intelligent polling as fallback
        StartSmartPolling();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Do initial check immediately
            await CheckAgentConnectionOnce();
        }
    }

    private async Task CheckAgentConnectionOnce()
    {
        try
        {
            var agentSetupComplete = await OnboardingService.CheckAndCompleteAgentSetupAsync();
            
            if (agentSetupComplete && !agentConnected)
            {
                agentConnected = true;
                currentStep = 1;
                step1Status = StepsStatus.Finish;
                step2Status = StepsStatus.Finish;
                StopPolling(); // Stop polling once connected
                await InvokeAsync(StateHasChanged);
            }
        }
        catch
        {
            // Connection failed or service unavailable, continue checking
        }
    }

    private void StartSmartPolling()
    {
        if (agentConnected) return; // Don't poll if already connected
        
        var interval = GetNextPollingInterval();
        connectionCheckTimer = new System.Timers.Timer(interval);
        connectionCheckTimer.Elapsed += async (sender, e) =>
        {
            if (!isPageVisible) return; // Don't poll when page is not visible
            
            await CheckAgentConnectionOnce();
            
            if (!agentConnected)
            {
                // Restart timer with longer interval (exponential backoff)
                connectionCheckTimer.Stop();
                connectionCheckTimer.Interval = GetNextPollingInterval();
                connectionCheckTimer.Start();
            }
        };
        connectionCheckTimer.AutoReset = false; // Manual restart for interval changes
        connectionCheckTimer.Start();
    }

    private int GetNextPollingInterval()
    {
        // Use exponential backoff - starts fast, then slows down
        if (pollingAttempts < pollingIntervals.Length)
        {
            return pollingIntervals[pollingAttempts++];
        }
        return pollingIntervals[^1]; // Use longest interval (2 minutes) after all attempts
    }

    private void StopPolling()
    {
        connectionCheckTimer?.Stop();
        connectionCheckTimer?.Dispose();
        connectionCheckTimer = null;
    }

    private async Task RefreshConnectionStatus()
    {
        if (isRefreshing) return;
        
        isRefreshing = true;
        StateHasChanged();
        
        try
        {
            // Reset polling attempts for more frequent checks after manual refresh
            pollingAttempts = Math.Max(0, pollingAttempts - 2);
            await CheckAgentConnectionOnce();
            
            // Restart polling with faster interval after manual refresh
            if (!agentConnected)
            {
                StopPolling();
                StartSmartPolling();
            }
        }
        finally
        {
            isRefreshing = false;
            StateHasChanged();
        }
    }

    // Page Visibility API - pause polling when tab is not active
    private async Task SetupPageVisibilityDetection()
    {
        await JSRuntime.InvokeVoidAsync("setupPageVisibilityDetection", 
            DotNetObjectReference.Create(this));
    }

    [JSInvokable]
    public void OnPageVisibilityChanged(bool visible)
    {
        isPageVisible = visible;
        if (visible && !agentConnected && connectionCheckTimer == null)
        {
            // Restart polling when page becomes visible
            StartSmartPolling();
        }
        else if (!visible)
        {
            // Stop polling when page is hidden to save resources
            StopPolling();
        }
    }

    private async Task DownloadAgent(string platform)
    {
        // Mark step 1 as completed when user clicks download
        step1Status = StepsStatus.Finish;
        step2Status = StepsStatus.Process;
        StateHasChanged();

        string downloadUrl = platform switch
        {
            "windows" => $"{ConfigService.BaseUrl}/downloads/automaton-agent-setup.exe",
            "macos" => $"{ConfigService.BaseUrl}/downloads/automaton-agent.dmg",
            "linux" => $"{ConfigService.BaseUrl}/downloads/automaton-agent.deb",
            _ => ""
        };
        
        // Track the download action
        await OnboardingService.HandleDownloadActionAsync($"agent-{platform}");
        
        if (!string.IsNullOrEmpty(downloadUrl))
        {
            NavigationManager.NavigateTo(downloadUrl, true);
        }
    }

    private async Task DownloadDesktopApp()
    {
        // Track the download action and mark onboarding as completed
        await OnboardingService.HandleDownloadActionAsync("desktop-app");
        
        NavigationManager.NavigateTo($"{ConfigService.BaseUrl}/downloads/desktop", true);
        
        // Navigate to flows after a short delay to allow download to start
        await Task.Delay(1000);
        NavigationManager.NavigateTo("/flows");
    }

    private async Task CompleteOnboarding()
    {
        await OnboardingService.MarkOnboardingCompletedAsync();
        NavigationManager.NavigateTo("/");
    }

    private async Task SkipOnboarding()
    {
        await OnboardingService.SkipOnboardingTemporarilyAsync(24); // Skip for 24 hours
        NavigationManager.NavigateTo("/");
    }

    private async Task GoToFlows()
    {
        await OnboardingService.MarkOnboardingCompletedAsync();
        NavigationManager.NavigateTo("/flows");
    }

    private async Task CopyCommand(string command, string description)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", command);
            await MessageService.SuccessAsync($"{description} copied to clipboard");
        }
        catch
        {
            await MessageService.WarningAsync("Could not copy to clipboard. Please copy manually.");
        }
    }

    public void Dispose()
    {
        // Stop polling and clean up resources
        StopPolling();
    }
}
