@page "/onboarding"
@using Automaton.Studio.Services
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject ConfigurationService ConfigService
@implements IDisposable

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<Layout>
    <Header Class="header">
        <Row>
            <Col>
               <Space Direction="SpaceDirection.Horizontal">
                    <SpaceItem><span style="font-size: 20px"><b>Onboarding</b></span></SpaceItem>
                </Space>
            </Col>
            <Col Class="right-actions">
                <!-- Right side content -->
            </Col>
        </Row>
    </Header>

    <Content>
        <div class="onboarding-wrapper">
            <div class="onboarding-container">
                
                <!-- Hero Section -->
                <div class="hero-section">
                    <Title Level="1" Class="hero-title">Welcome to Automaton!</Title>
                    <Paragraph Class="hero-subtitle">Let's get you set up to automate your first workflow.</Paragraph>
                </div>

                <div class="hero-description">
                    <Paragraph Class="description-text">
                        Because your workflows are executed securely on your computer, we need you to install a small 
                        <strong class="highlight-text">Agent</strong> or our dedicated <strong class="highlight-text">Desktop App</strong> 
                        to get started. You have two paths to success!
                    </Paragraph>
                </div>

                <!-- Two Path Grid -->
                <div class="path-container">
                    <!-- Path A: Web App + Local Agent -->
                    <Card Title="Web App + Agent" Class="path-card recommended">
                        <Extra>
                            <span class="recommended-badge">Recommended</span>
                        </Extra>
                        <ChildContent>
                            <div class="card-intro">
                                <Paragraph Class="card-description">
                                    Use our powerful web interface to manage your workflows from anywhere, executed securely on your machines via a lightweight local agent.
                                </Paragraph>
                            </div>

                            <Steps Direction="StepsDirection.Vertical" Current="@currentStep">
                                <Step Title="Download and Install the Agent" Status="@step1Status">
                                    <DescriptionTemplate>
                                        <div>
                                            <p>This small program runs in the background on your computer to execute flows from the web app.</p>
                                            <div class="download-buttons">
                                                <Button Type="@ButtonType.Primary" Icon="windows" OnClick="@(() => DownloadAgent("windows"))">Windows</Button>
                                                <Button Icon="apple" OnClick="@(() => DownloadAgent("macos"))">macOS</Button>
                                                <Button Icon="linux" OnClick="@(() => DownloadAgent("linux"))">Linux</Button>
                                            </div>
                                            <div class="installation-instructions">
                                                <Collapse>
                                                    <Panel Header="Installation Instructions">
                                                        <ol>
                                                            <li>Run the downloaded installer</li>
                                                            <li>Follow the prompts to complete installation</li>
                                                            <li>Launch the Automaton Agent from your start menu/applications folder</li>
                                                        </ol>
                                                    </Panel>
                                                </Collapse>
                                            </div>
                                        </div>
                                    </DescriptionTemplate>
                                </Step>
                                <Step Title="Connect your Agent" Status="@step2Status">
                                    <DescriptionTemplate>
                                        <div>
                                            <p>Run this command on your local machine to start the agent:</p>
                                            @if (!agentConnected)
                                            {
                                                <div class="connection-waiting">
                                                    <Text Code>automaton-agent --connect @ConfigService.BaseUrl</Text>
                                                    <div class="connection-status">
                                                        <Spin /> Waiting for Agent to connect...
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="connection-success">
                                                    <div class="connection-status">
                                                        <Icon Type="check-circle" Theme="IconThemeType.TwoTone" TwoToneColor="#52c41a" /> Success! Your Agent is connected.
                                                    </div>
                                                    <Button Type="@ButtonType.Primary" OnClick="@RunSampleFlow" Size="@ButtonSize.Large" Class="run-sample-btn">Run a Sample Flow</Button>
                                                </div>
                                            }
                                        </div>
                                    </DescriptionTemplate>
                                </Step>
                            </Steps>
                        </ChildContent>
                    </Card>

                    <!-- Path B: Desktop App -->
                    <Card Title="Desktop App" Class="path-card desktop">
                        <Extra>
                            <Icon Type="appstore" />
                        </Extra>
                        <ChildContent>
                            <div class="card-intro">
                                <h3 class="desktop-subtitle">The All-in-One Solution</h3>
                                <Paragraph Class="card-description">
                                    For a fully local experience with no agent to manage, download our standalone desktop application. 
                                    It includes everything you need in a single package.
                                </Paragraph>
                            </div>
                            
                            <div class="desktop-features">
                                <div class="feature-item">
                                    <Icon Type="safety-certificate" Theme="IconThemeType.TwoTone" TwoToneColor="#52c41a" />
                                    <span>Fully Local</span>
                                </div>
                                <div class="feature-item">
                                    <Icon Type="tool" Theme="IconThemeType.TwoTone" TwoToneColor="#52c41a" />
                                    <span>No Setup Required</span>
                                </div>
                                <div class="feature-item">
                                    <Icon Type="thunderbolt" Theme="IconThemeType.TwoTone" TwoToneColor="#52c41a" />
                                    <span>Instant Start</span>
                                </div>
                            </div>
                            
                            <Button Type="@ButtonType.Default" Size="@ButtonSize.Large" OnClick="@DownloadDesktopApp" Class="desktop-download-btn">
                                Download Desktop App
                            </Button>
                        </ChildContent>
                    </Card>
                </div>

                <!-- Footer -->
                <div class="footer-section">
                    <div class="help-links">
                        <a href="/docs/troubleshooting" class="help-link">
                            <Icon Type="book" />
                            Documentation
                        </a>
                        <a href="/support" class="help-link">
                            <Icon Type="customer-service" />
                            Support
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </Content>
</Layout>

<style>
    /* Enhanced Onboarding Page - Modern Design with AntDesign Components */

    /* Font Import */
    body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    /* Main wrapper and container */
    .onboarding-wrapper {
        min-height: calc(100vh - 64px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    }

    .onboarding-container {
        width: 100%;
        max-width: 80rem;
        margin: 0 auto;
        background-color: white;
        border-radius: 1rem;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        padding: 2rem;
    }

    @@media (min-width: 768px) {
        .onboarding-container {
            padding: 3rem;
        }
    }

    /* Hero Section */
    .hero-section {
        text-align: center;
        margin-bottom: 2rem;
    }

    .hero-title {
        font-size: 2.25rem !important;
        font-weight: 700 !important;
        color: #0f172a !important;
        margin: 0 0 0.5rem 0 !important;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        background-clip: text;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        color: #0f172a; /* Fallback */
    }

    .hero-subtitle {
        margin: 0.5rem 0 0 0;
        font-size: 1.125rem;
        color: #64748b;
    }

    .hero-description {
        text-align: center;
        margin-bottom: 2.5rem;
        max-width: 48rem;
        margin-left: auto;
        margin-right: auto;
    }

    .description-text {
        color: #374151;
        margin: 0;
        font-size: 1rem;
        line-height: 1.6;
    }

    .highlight-text {
        color: #2563eb;
        font-weight: 600;
    }

    /* Path Container - Grid Layout */
    .path-container {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
        margin-bottom: 2rem;
    }

    @@media (min-width: 1024px) {
        .path-container {
            grid-template-columns: 1fr 1fr;
        }
    }

    /* Enhanced Path Cards */
    .path-card {
        border-radius: 1rem;
        transition: all 0.3s ease;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        min-height: 500px;
        position: relative;
        overflow: hidden;
        display: flex !important;
        flex-direction: column !important;
    }

    .path-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .path-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    }

    .path-card:hover::before {
        opacity: 1;
    }

    .path-card.recommended {
        border: 2px solid #bfdbfe;
        background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
    }

    .path-card.recommended::before {
        background: linear-gradient(90deg, #1890ff, #40a9ff);
        opacity: 1;
    }

    .path-card.desktop {
        border: 1px solid #e5e7eb;
        background: #ffffff;
    }

    .path-card.desktop::before {
        background: linear-gradient(90deg, #722ed1, #9254de);
    }

    /* Card Content */
    .card-intro {
        margin-bottom: 1.5rem;
    }

    .card-description {
        color: #64748b;
        margin-bottom: 1rem;
        line-height: 1.6;
    }

    .desktop-subtitle {
        color: #374151;
        font-weight: 600;
        margin-bottom: 1rem;
        font-size: 1.25rem;
    }

    /* Recommended Badge */
    .recommended-badge {
        background: linear-gradient(135deg, #1890ff, #40a9ff);
        color: white;
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.25rem 0.75rem;
        border-radius: 12px;
        display: flex;
        align-items: center;
        gap: 0.25rem;
        box-shadow: 0 2px 4px rgba(24, 144, 255, 0.3);
    }

    .recommended-badge::before {
        content: '?';
        font-size: 0.875rem;
    }

    /* Download Buttons */
    .download-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }

    /* Connection Status */
    .connection-waiting {
        margin-bottom: 1rem;
    }

    .connection-status {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 0.5rem;
        font-size: 0.875rem;
        color: #64748b;
    }

    .connection-success .connection-status {
        color: #059669;
        font-weight: 500;
    }

    /* Run Sample Button */
    .run-sample-btn {
        margin-top: 1rem;
        width: 100%;
        height: 48px;
        font-weight: 600;
        background: linear-gradient(135deg, #52c41a, #73d13d);
        border: none;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

    .run-sample-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(82, 196, 26, 0.3);
    }

    /* Desktop Features */
    .desktop-features {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin: 1.5rem 0;
    }

    .feature-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        color: #374151;
        font-size: 0.875rem;
        font-weight: 500;
    }

    /* Desktop Download Button */
    .desktop-download-btn {
        margin-top: auto;
        margin-bottom: 13px;
        width: 100%;
        height: 48px;
        font-weight: 600;
        background: linear-gradient(135deg, #722ed1, #9254de) !important;
        border: none !important;
        color: white !important;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

    .desktop-download-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(114, 46, 209, 0.3);
        background: linear-gradient(135deg, #5a1a9e, #7c2db5) !important;
        color: white !important;
        border: none !important;
    }

    .desktop-download-btn:focus {
        background: linear-gradient(135deg, #722ed1, #9254de) !important;
        color: white !important;
        border: none !important;
        box-shadow: 0 0 0 2px rgba(114, 46, 209, 0.2);
    }

    /* Footer */
    .footer-section {
        text-align: center;
        margin-top: 2.5rem;
        padding-top: 2rem;
        border-top: 1px solid #f0f0f0;
    }

    .help-links {
        display: flex;
        justify-content: center;
        gap: 2rem;
        flex-wrap: wrap;
    }

    .help-link {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #64748b;
        text-decoration: none;
        font-weight: 500;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

    .help-link:hover {
        color: #2563eb;
        background: #f0f8ff;
        transform: translateY(-1px);
        text-decoration: none;
    }

    /* AntDesign Component Overrides */
    .ant-card {
        display: flex !important;
        flex-direction: column !important;
        height: 100% !important;
    }

    .ant-card-head {
        border-bottom: 1px solid rgba(0, 0, 0, 0.06);
        padding: 1.5rem 1.5rem 1rem 1.5rem;
        flex-shrink: 0;
    }

    .ant-card-head-title {
        font-size: 1.5rem;
        font-weight: 600;
        color: #374151;
    }

    .ant-card-body {
        padding: 0 1.5rem 1.5rem 1.5rem;
        display: flex !important;
        flex-direction: column !important;
        flex: 1 !important;
        min-height: 0;
    }

    .ant-card-extra {
        display: flex;
        align-items: center;
    }

    .ant-steps-item-title {
        font-weight: 600 !important;
        color: #374151 !important;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .onboarding-wrapper {
            padding: 0.5rem;
        }
        
        .onboarding-container {
            padding: 1.5rem;
        }
        
        .hero-title {
            font-size: 1.875rem !important;
        }
        
        .help-links {
            flex-direction: column;
            gap: 1rem;
        }
        
        .path-card {
            min-height: auto;
        }
    }

    /* Animation for step completion */
    @@keyframes checkmark {
        0% { transform: scale(0); }
        50% { transform: scale(1.1); }
        100% { transform: scale(1); }
    }

    .ant-steps-item-finish .ant-steps-item-icon {
        animation: checkmark 0.3s ease-in-out;
    }
</style>

@code {
    private int currentStep = 0;
    private StepsStatus step1Status = StepsStatus.Process;
    private StepsStatus step2Status = StepsStatus.Wait;
    private bool agentConnected = false;
    private System.Timers.Timer connectionCheckTimer;

    protected override void OnInitialized()
    {
        // Set up timer to check for agent connection
        connectionCheckTimer = new System.Timers.Timer(3000);
        connectionCheckTimer.Elapsed += CheckAgentConnection;
        connectionCheckTimer.AutoReset = true;
        connectionCheckTimer.Enabled = true;
    }

    private async void CheckAgentConnection(object source, System.Timers.ElapsedEventArgs e)
    {
        try
        {
            // Simulate agent connection check - in real implementation, 
            // this would call an API endpoint to check if an agent is connected
            var response = await Http.GetAsync($"{ConfigService.BaseUrl}/api/agent/status");
            
            if (response.IsSuccessStatusCode)
            {
                agentConnected = true;
                currentStep = 1;
                step1Status = StepsStatus.Finish;
                step2Status = StepsStatus.Process;
                
                // Once connected, stop checking
                connectionCheckTimer.Stop();
                
                await InvokeAsync(StateHasChanged);
            }
        }
        catch
        {
            // Connection failed or service unavailable, continue checking
        }
    }

    private void DownloadAgent(string platform)
    {
        // Mark step 1 as completed when user clicks download
        step1Status = StepsStatus.Finish;
        step2Status = StepsStatus.Process;
        StateHasChanged();

        string downloadUrl = platform switch
        {
            "windows" => $"{ConfigService.BaseUrl}/downloads/automaton-agent-setup.exe",
            "macos" => $"{ConfigService.BaseUrl}/downloads/automaton-agent.dmg",
            "linux" => $"{ConfigService.BaseUrl}/downloads/automaton-agent.deb",
            _ => ""
        };
        
        if (!string.IsNullOrEmpty(downloadUrl))
        {
            NavigationManager.NavigateTo(downloadUrl, true);
        }
    }

    private void DownloadDesktopApp()
    {
        NavigationManager.NavigateTo($"{ConfigService.BaseUrl}/downloads/desktop", true);
    }

    private void RunSampleFlow()
    {
        NavigationManager.NavigateTo("/flows/sample");
    }

    public void Dispose()
    {
        connectionCheckTimer?.Stop();
        connectionCheckTimer?.Dispose();
    }
}
