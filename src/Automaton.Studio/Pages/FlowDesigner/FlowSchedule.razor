@page "/flow/schedule/{flowid}/{flowname}"
@using AntDesign
@using Automaton.Studio.Models
@using Automaton.Studio.Enums
@using Blazored.FluentValidation

<div class="flow-tab-content">
    <div class="flow-tab-header">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <div>
                <Title Level="3" Style="margin-bottom: 8px;">Flow Schedules</Title>
                <Paragraph Style="color: #666;">
                    Configure automated schedules to run this workflow at specific times.
                </Paragraph>
            </div>
            <div>
                <Tooltip Title="New schedule">
                    <Button Type="@ButtonType.Primary" Icon="plus" @onclick="@(() => NewSchedule())">
                        New Schedule
                    </Button>
                </Tooltip>
            </div>
        </div>
    </div>
    
    <div class="flow-tab-table">
        @if (!loading && FlowScheduleViewModel.Schedules?.Any() != true)
        {
            <EnhancedEmpty Title="Schedules in minutes." 
                          Description="Schedules allow your workflows to run automatically at specific times or intervals. Each schedule you create enables automated execution of your workflows."
                          BackgroundImageUrl="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80"
                          GradientOverlay="linear-gradient(135deg, rgba(236, 72, 153, 0.85) 0%, rgba(219, 39, 119, 0.85) 100%)"
                          ActionCardTitle="Automated Scheduling"
                          ActionCardDescription="Create reliable schedules that keep your workflows running on time, every time."
                          ActionCardBulletPoints="@GetScheduleActionCardBullets()"
                          FeatureSectionTitle="Automated scheduling anyone can setup in seconds!"
                          FeatureSectionSubtitle="Create schedules with cron expressions or simple recurring patterns"
                          HelpSectionTitle="Learn more about Scheduling"
                          PrimaryAction="@(new EnhancedEmpty.EmptyActionModel { Text = "Create Schedule", Icon = "plus", OnClick = () => { NewSchedule(); return Task.CompletedTask; } })"
                          FeatureCards="@GetScheduleFeatureCards()"
                          HelpLinks="@GetScheduleHelpLinks()">
                <VisualMockup>
                    <ScheduleVisualMockup />
                </VisualMockup>
            </EnhancedEmpty>
        }
        else
        {
            <Table TItem="FlowScheduleModel" 
                DataSource="@FlowScheduleViewModel.Schedules"
                RowExpandable="@((record)=>true)"
                Loading="@loading" 
                Class="autoscroll-list"
                OnRow="OnRow"
                OnChange="OnChange">
            <ColumnDefinitions>
                <Column Title="Name" @bind-Field="@context.Name">
                    @context.Name
                </Column>

                <PropertyColumn Title="Type" Property="c=>c.CronRecurrence.CronType" />

                <PropertyColumn Title="Description" Property="c=>c.CronDescription" />

                <PropertyColumn Title="Next Execution" Property="c=>c.CronNextExecution" />

                <Column Title="CreatedAt" @bind-Field="@context.CreatedAt">
                    @context.CreatedAt
                </Column>
                <ActionColumn Title="Action" Width="10%">
                    <Dropdown Placement="@Placement.Bottom" Trigger="@(new Trigger[] { Trigger.Click })">
                                <Overlay>
                                    <Menu>
                                        <Popconfirm Title="Sure to delete?"
                                                    OnConfirm="()=> DeleteSchedule(context.Id)"
                                                    OkText="Yes"
                                                    CancelText="No">
                                            <MenuItem Icon="delete">
                                                Delete
                                            </MenuItem>
                                        </Popconfirm>
                                    </Menu>
                                </Overlay>
                                <ChildContent>
                                    <Tooltip Title="More actions">
                                        <a href="#" @onclick:preventDefault @onmousedown:stopPropagation>
                                        <Icon Type="more" Theme="IconThemeType.Outline" />
                                        </a>
                                    </Tooltip>
                                </ChildContent>
                            </Dropdown>
                </ActionColumn>
            </ColumnDefinitions>
            <ExpandTemplate Context="rowData">
                <div class="schedule-form-container">
                    <Form @ref="form"
                          Model="@rowData.Data"
                          Loading="rowData.Data.Loading"
                          Class="step-form"
                          Layout="@FormLayout.Vertical"
                          OnFinish="Save"
                          OnFinishFailed="SaveFailed">

                        <Validator>
                            <FluentValidationValidator />
                        </Validator>

                        <ChildContent>
                            <GridRow>
                                <GridCol>
                                    <FormItem Label="Name" Id="schedule-name">
                                        <Input Type="InputType.Text" @bind-Value="@rowData.Data.Name" />
                                    </FormItem>
                                </GridCol>
                                <GridCol>
                                    <FormItem Label="Runners" Id="schedule-runners">
                                       <Select Mode="SelectMode.Multiple" 
                                        @bind-Values="context.RunnerIds"
                                        Placeholder="Select runners..."
                                        TItemValue="Guid"
                                        TItem="Guid"
                                        AllowClear>
                                        <SelectOptions>
                                            @foreach (var item in FlowScheduleViewModel.Runners)
                                            {
                                                <SelectOption TItemValue="Guid" TItem="Guid" Value=@item.Id Label=@item.Name />
                                            }
                                        </SelectOptions>
                                    </Select>   
                                    </FormItem>
                                </GridCol>
                            </GridRow>
                            <GridRow>
                                <GridCol>
                                    <FormItem Label="Repeat">
                                        <RadioGroup TValue="CronType"
                                        @bind-Value="context.CronRecurrence.CronType" 
                                        ButtonStyle="@RadioButtonStyle.Solid" 
                                        OnChange="(e) => OnCronTypeChange(e)">
                                            <Radio RadioButton Value="@CronType.Never">Never</Radio>
                                            <Radio RadioButton Value="@CronType.Minutely">Minutely</Radio>
                                            <Radio RadioButton Value="@CronType.Hourly">Hourly</Radio>
                                            <Radio RadioButton Value="@CronType.Daily">Daily</Radio>
                                            <Radio RadioButton Value="@CronType.Weekly">Weekly</Radio>
                                            <Radio RadioButton Value="@CronType.Monthly">Monthly</Radio>
                                            <Radio RadioButton Value="@CronType.Yearly">Yearly</Radio>
                                        </RadioGroup>
                                    </FormItem>
                                </GridCol>                          
                            </GridRow>
                            <GridRow Class="cron-dates">

                                @if(!IsMinuteHidden(context.CronRecurrence.CronType))
                                {
                                    <GridCol Class="schedule-repeat-value-input">
                                        <FormItem Label="Minute">
                                            <AntDesign.InputNumber @bind-Value="@rowData.Data.CronRecurrence.Minute" 
                                                                   Min="0" Max="59" DefaultValue="0" />
                                        </FormItem>
                                    </GridCol>
                                }

                                @if(!IsHourHidden(context.CronRecurrence.CronType))
                                {
                                    <GridCol Class="schedule-repeat-value-input">
                                        <FormItem Label="Hour">
                                            <AntDesign.InputNumber @bind-Value="@rowData.Data.CronRecurrence.Hour"
                                                                   Min="0" Max="23" DefaultValue="0" />
                                        </FormItem>
                                    </GridCol>
                                }

                                @if (!IsDayHidden(context.CronRecurrence.CronType))
                                {
                                    <GridCol Class="schedule-repeat-value-input">
                                        <FormItem Label="Day">
                                            <AntDesign.InputNumber @bind-Value="@rowData.Data.CronRecurrence.Day"
                                                                   Min="1" Max="31" DefaultValue="1" />
                                        </FormItem>
                                    </GridCol>
                                }

                                @if (!IsDayOfWeekHidden(context.CronRecurrence.CronType))
                                {
                                    <GridCol Class="schedule-repeat-value-select">
                                        <FormItem Label="Day of Week">
                                            <Select @bind-Value="rowData.Data.CronRecurrence.DayOfWeek"
                                                    Placeholder="Select type..."
                                                    TItem="DayOfWeek"
                                                    TItemValue="DayOfWeek"
                                                    Class="day-of-week"
                                                    DefaultValue="DayOfWeek.Sunday">
                                                <SelectOptions>
                                                    @foreach (var day in Enum.GetValues(typeof(DayOfWeek)))
                                                    {
                                                        <SelectOption TItemValue="DayOfWeek" TItem="DayOfWeek" Value="(DayOfWeek)day" Label=@day.ToString() />
                                                    }
                                                </SelectOptions>
                                            </Select>
                                        </FormItem>
                                    </GridCol>
                                }
                                
                                @if (!IsMonthHidden(context.CronRecurrence.CronType))
                                {
                                    <GridCol Class="schedule-repeat-value-input">
                                        <FormItem Label="Month">
                                            <AntDesign.InputNumber @bind-Value="@rowData.Data.CronRecurrence.Month"
                                                                   Min="1" Max="12" DefaultValue="1" />
                                        </FormItem>
                                    </GridCol>
                                }
                            </GridRow>
                            <GridRow>
                                <FormItem>
                                    <Button Type="@ButtonType.Primary" HtmlType="submit">
                                        Save Schedule
                                    </Button>
                                </FormItem>
                            </GridRow>
                        </ChildContent>
                    </Form>
                </div>
            </ExpandTemplate>
        </Table>
        }
    </div>
</div>

<style>
    .flow-tab-content {
        height: 100%;
        display: flex;
        flex-direction: column;
        background: white;
        border-radius: 8px;
        padding: 0;
    }

    .flow-tab-header {
        padding: 24px 24px 16px 24px;
        border-bottom: 1px solid #f0f0f0;
        flex-shrink: 0;
        background: white;
        border-radius: 8px 8px 0 0;
    }

    .flow-tab-table {
        flex: 1;
        overflow: hidden;
        padding: 0 24px 24px 24px;
        background: white;
        border-radius: 0 0 8px 8px;
    }

    .schedule-form-container {
        background: #fbf9f7;
        padding: 24px;
        border-radius: 8px;
        border: 1px solid #f0f0f0;
        margin: 16px 0;
    }

    /* Override autoscroll-list for this specific context */
    .flow-tab-table .autoscroll-list {
        height: calc(100vh - 400px); /* Adjust based on header and margins */
    }

    .schedule-repeat-value-input {
        width: 80px;
        margin-right: 6px;
    }

    .schedule-repeat-value-select {
        width: 100px;
        margin-right: 6px;
    }

    #cron-date  {
        width: 160px !important;
    }

    #schedule-name {
        width: 255px;
        padding-right: 10px;
    }

    #schedule-runners {
        width: 300px;
    }
</style>



