@page "/flow/designer/{flowid}/{flowname}"
@using AntDesign
@using Automaton.Studio.Pages.FlowDesigner.Components.Drawer
@using Automaton.Studio.Pages.FlowDesigner.Components.StepExplorer
@using Automaton.Studio.Pages.FlowDesigner.Components;
@using Automaton.Studio.Domain;

<Layout>
    <Header Class="header">
        <Row>
            <Col Span="10">

                <Space Direction="SpaceDirection.Horizontal">
                    <SpaceItem>
                        <Breadcrumb>
                            <BreadcrumbItem Href="/">Flows</BreadcrumbItem>
                            <BreadcrumbItem></BreadcrumbItem>
                        </Breadcrumb>
                    </SpaceItem>
                    <SpaceItem><span style="font-size: 20px"><b>@FlowName</b></span></SpaceItem>
                </Space>

            </Col>

            <Col Class="right-actions" Span="14">
                <Space Class="right-header-items">
                    <SpaceItem>
                        <Button Icon="thunderbolt" Class="header-button" Type="@ButtonType.Primary">
                            Create Flow with AI ✨
                        </Button>
                    </SpaceItem>

                    <SpaceItem>
                        <Button Icon="save" Class="header-button" OnClick="SaveFlow">
                            Save
                        </Button>
                    </SpaceItem>

                    <SpaceItem>
                        @if (DesignerViewModel.CanExecuteFlow)
                        {
                            if (DesignerViewModel.IsFlowNotRunning())
                            {
                                <Button Icon="caret-right" Class="header-button" OnClick="RunFlow">Run</Button>
                            }
                            else
                            {
                                <Button Icon="stop" Class="header-button" OnClick="StopFlow">Stop</Button>
                            }
                        }
                    </SpaceItem>
                </Space>
            </Col>
        </Row>
    </Header>

    <Tabs ActiveKey="@activeTabKey" OnChange="OnTabChange" Class="main-tabs-container">
        <TabPane Key="designer" Tab="Designer">
            <Layout Class="designer-container">

                <Sider Theme="SiderTheme.Light" Style="width: 320px; min-width: 320px; max-width: 320px;">
                    <CascadingValue Value="DesignerViewModel.Flow">
                        <div class="step-library-container">
                            <div class="step-library-header">
                                <Title Level="5" Style="margin: 10px 0 5px 15px;">Step Library</Title>
                            </div>

                            <div class="step-library-content">
                                <Tabs DefaultActiveKey="core" TabPosition="@TabPosition.Bottom" Size="@TabSize.Small" Class="explorer-tabs">
                                    <TabPane Key="core" Tab="Core Steps">
                                        <CoreStepsExplorer></CoreStepsExplorer>
                                    </TabPane>
                                    <TabPane Key="custom" Tab="Custom Steps">
                                        <CustomStepsExplorer></CustomStepsExplorer>
                                    </TabPane>
                                </Tabs>

                                <div class="create-step-ai-section">
                                    <Button Icon="plus" Type="@ButtonType.Primary" Class="create-step-ai-button">
                                        Create Step with AI ✨
                                    </Button>
                                </div>
                            </div>
                        </div>
                    </CascadingValue>
                </Sider>

                <Splitter Layout="@SplitterLayout.Horizontal">
                    <SplitterPanel Size="@TopSplitterPercentage">
                        <Layout Class="main-content-layout">

                            <Splitter Layout="@SplitterLayout.Vertical" Class="main-splitter">
                                <SplitterPanel Size="70%">

                                    <Content Class="content-container">
                                        <Tabs Type="@TabType.EditableCard"
                                              Size="@TabSize.Small"
                                              ActiveKey="@DesignerViewModel.ActiveDefinition?.Id"
                                              DefaultActiveKey="@DesignerViewModel.GetStartupDefinitionId()"
                                              OnAddClick="OnDefinitionAddClick"
                                              OnTabClick="OnTabClick"
                                              OnClose="OnTabClose"
                                              Class="designer-tabs">

                                            @foreach (var definition in DesignerViewModel.GetFlowDefinitions())
                                            {
                                                <TabPane Key="@definition.Id" Tab="@definition.Name">
                                                    <Designer @ref="designer"
                                                              Class="dropzone"
                                                              Steps="definition.Steps"
                                                              ItemDrop="@((p)=>OnItemDrop(p))"
                                                              ItemDoubleClick="@((p)=>OnItemDoubleClick(p))">

                                                        <DesignerStep Step="@context" />

                                                    </Designer>
                                                </TabPane>
                                            }
                                        </Tabs>
                                    </Content>
                                </SplitterPanel>

                                <SplitterPanel Size="30%">
                                    <Footer Class="bottom-panel">
                                        <CascadingValue Value="DesignerViewModel.Flow">
                                            <Tabs DefaultActiveKey="logs" Size="@TabSize.Small" TabPosition="@TabPosition.Bottom" Class="bottom-tabs">
                                                <TabPane Key="logs" Tab="Logs">
                                                    <FlowLogs />
                                                </TabPane>
                                                <TabPane Key="variables" Tab="Variables">
                                                    <FlowVariables />
                                                </TabPane>
                                            </Tabs>
                                        </CascadingValue>
                                    </Footer>
                                </SplitterPanel>
                            </Splitter>

                        </Layout>
                    </SplitterPanel>

                    <SplitterPanel Size="@BottomSplitterPercentage">
                        @if (selectedStep != null)
                        {
                            <div class="properties-container">
                                <div class="properties-header">
                                    <Space Style="width: 100%; padding: 8px; justify-content: space-between;">
                                        <SpaceItem>
                                            <Title Level="5">Step Details</Title>
                                        </SpaceItem>
                                        <SpaceItem>
                                            <Button Icon="close" Size="@ButtonSize.Small" Type="@ButtonType.Text" 
                                                    OnClick="ClosePropertiesPanel" />
                                        </SpaceItem>
                                    </Space>
                                </div>
                                <div class="properties-content">
                                    <StepPropertiesWrapper Step="selectedStep" />
                                </div>
                            </div>
                        }
                    </SplitterPanel>
                </Splitter>

            </Layout>
        </TabPane>
        <TabPane Key="activity" Tab="Activity">
            <FlowActivity FlowId="@FlowId" FlowName="@FlowName" />
        </TabPane>
        <TabPane Key="schedule" Tab="Schedule">
            <FlowSchedule FlowId="@FlowId" FlowName="@FlowName" />
        </TabPane>
        <TabPane Key="settings" Tab="Settings">
            <FlowSettings FlowId="@FlowId" FlowName="@FlowName" />
        </TabPane>
    </Tabs>
</Layout>

<style>

    .content-container {
        background-color: #fff;
        flex: 1;
        overflow: hidden;
        min-width: 0; /* Important for flex shrinking */
        display: flex;
        flex-direction: column;
    }

    .designer-container {
        background-color: #fafafa;
        height: calc(100vh - 135px);
        overflow: hidden;
    }

    .main-content-layout {
        display: flex;
        flex-direction: column;
        height: 100%;
        min-width: 0; /* Important for flex shrinking */
    }

    /* Ensure the main splitter fills its container */
    .main-splitter {
        height: 100%;
        flex: 1;
    }

    /* Target the first splitter panel (containing the designer) using nth-child */
    .main-splitter .ant-splitter-panel:first-child {
        display: flex;
        flex-direction: column;
        min-height: 0; /* Important for flex child to shrink properly */
    }

    .properties-container {
        height: 100%;
        display: flex;
        flex-direction: column;
        background-color: #fff;
        border-left: 1px solid #f0f0f0;
    }

    .properties-header {
        background-color: #fafafa;
        border-bottom: 1px solid #f0f0f0;
        flex-shrink: 0;
    }

    .properties-content {
        flex: 1;
        overflow: auto;
        padding: 15px;
    }

    .bottom-panel {
        height: 100%;
        flex-shrink: 0;
        padding: 0; /* Remove padding to allow tabs to fill completely */
        display: flex;
        flex-direction: column;
    }

    /* Target only the bottom splitter panel (the one containing .bottom-panel) */
    .ant-splitter-panel:has(.bottom-panel) {
        overflow: hidden;
    }

    /* Target the right splitter panel conditionally */
    .ant-splitter-panel:nth-child(2) {
        transition: all 0.3s ease;
    }

    /* Hide the right splitter panel when no step is selected */
    .ant-splitter-panel:nth-child(2):has(.properties-container) {
        display: flex;
    }

    /* Main tabs container - ensure proper tab behavior for main navigation */
    .main-tabs-container {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        width: 100%;
        padding-left: 10px;
        box-sizing: border-box;
        background-color: white;
    }

    /* Main tabs should have normal tab behavior (no custom ordering) */
    .main-tabs-container .ant-tabs-nav {
        flex-shrink: 0;
        margin-bottom: 0;
        /* Don't override the default order for main tabs */
    }

    .main-tabs-container .ant-tabs-content-holder {
        flex: 1;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        /* Don't override the default order for main tabs */
    }

    /* Bottom tabs with TabPosition.Bottom - adjust layout accordingly */
    .bottom-tabs {
        height: 100%;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    /* When tabs are at bottom, content comes first, then nav */
    .bottom-tabs .ant-tabs-content-holder {
        flex: 1;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        order: 1; /* Content area comes first */
    }

    .bottom-tabs .ant-tabs-nav {
        flex-shrink: 0;
        margin-bottom: 0;
        margin-top: 0;
        order: 2; /* Navigation comes after content */
        position: relative;
    }

    .bottom-tabs .ant-tabs-content {
        height: 100%;
        flex: 1;
        overflow: hidden;
    }

    /* Style active tab panes to fill space properly */
    .bottom-tabs .ant-tabs-tabpane {
        padding: 6px;
    }

    .bottom-tabs .ant-tabs-tabpane-active {
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .runners-select {
        min-width: 140px;
        max-width: 140px;
    }

    .explorer-tabs {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .create-step-ai-section {
        padding: 8px 12px;
        border-top: 1px solid #e9ecef;
        background-color: #f8f9fa;
        flex-shrink: 0;
    }

    .create-step-ai-button {
        width: 100%;
    }

    /* Fix main tabs to use full height */
    .ant-tabs {
        height: 100%;
        display: flex;
        flex-direction: column;
    }

     .ant-tabs-content-holder .ant-tabs-content .ant-tabs-content-top {
        height: 100%;
    }

    /* Ensure designer tabs specifically fill available space */
    .designer-tabs {
        height: 100%;
        display: flex;
        flex-direction: column;
    }

        .designer-tabs .ant-tabs-content-holder {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .designer-tabs .ant-tabs-tabpane {
            height: 100%;
            display: flex;
            flex-direction: column;
        }
   
    .step-library-container {
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .step-library-header {
        background-color: #fafafa;
        border-bottom: 1px solid #f0f0f0;
        flex-shrink: 0;
    }

    .step-library-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-height: 0; /* Important for flex child to shrink */
        overflow: hidden;
    }
</style>