@page "/flow/designer/{flowid}/{flowname}"
@using AntDesign
@using Automaton.Studio.Pages.FlowDesigner.Components.Drawer
@using Automaton.Studio.Pages.FlowDesigner.Components.FlowExplorer
@using Automaton.Studio.Pages.FlowDesigner.Components.StepExplorer
@using Automaton.Studio.Pages.FlowDesigner.Components;
@using Automaton.Studio.Domain;

<Layout>
    <Header Class="header">
        <Row>
            <Col Span="10">

            <Space Direction="SpaceDirection.Horizontal">
                    <SpaceItem>
                        <Breadcrumb>
                            <BreadcrumbItem Href="/">Flows</BreadcrumbItem>
                        <BreadcrumbItem></BreadcrumbItem>
                        </Breadcrumb>                         
                    </SpaceItem>
                <SpaceItem><span style="font-size: 20px"><b>@FlowName</b></span></SpaceItem>
            </Space>
               
            </Col>

            <Col Class="right-actions" Span="14">
                <Space Class="right-header-items">
                    <SpaceItem>
                        <Button Icon="save" Class="header-button" OnClick="SaveFlow">
                            Save
                        </Button>
                    </SpaceItem>

                    <SpaceItem>
                        @if (DesignerViewModel.CanExecuteFlow)
                        {
                            if (DesignerViewModel.IsFlowNotRunning())
                            {
                                <Button Icon="caret-right" Class="header-button" OnClick="RunFlow">Run</Button>
                            }
                            else
                            {
                                <Button Icon="stop" Class="header-button" OnClick="StopFlow">Stop</Button>
                            }
                        }
                    </SpaceItem>
                </Space>
            </Col>
        </Row>
    </Header>

    <Tabs ActiveKey="@activeTabKey" OnChange="OnTabChange" Style="background-color: white; margin-left: 10px;">
        <TabPane Key="designer" Tab="Designer">
            <Layout Class="designer-container">

                <Sider Theme="SiderTheme.Light" Style="width: 300px">
                    <CascadingValue Value="DesignerViewModel.Flow">
                        <Tabs DefaultActiveKey="1" TabPosition="@TabPosition.Bottom" Size="@TabSize.Small" Class="explorer-tabs">
                            <TabPane Key="1" Tab="Steps">
                                <StepExplorer></StepExplorer>
                            </TabPane>
                            <TabPane Key="2" Tab="Definitions">
                                <FlowExplorer></FlowExplorer>
                            </TabPane>
                        </Tabs>
                    </CascadingValue>
                </Sider>

                <Layout Class="main-content-layout">
                    <Content Class="content-container">
                        <Tabs Type="@TabType.EditableCard"
                              Size="@TabSize.Small"
                              ActiveKey="@DesignerViewModel.ActiveDefinition?.Id"
                              DefaultActiveKey="@DesignerViewModel.GetStartupDefinitionId()"
                              OnAddClick="OnDefinitionAddClick"
                              OnTabClick="OnTabClick"
                              OnClose="OnTabClose">

                            @foreach (var definition in DesignerViewModel.GetFlowDefinitions())
                            {
                                <TabPane Key="@definition.Id" Tab="@definition.Name">
                                    <Designer @ref="designer"
                                          Class="dropzone"
                                          Steps="definition.Steps"
                                          ItemDrop="@((p)=>OnItemDrop(p))"
                                          ItemDoubleClick="@((p)=>OnItemDoubleClick(p))">

                                        <DesignerStep Step="@context" />

                                    </Designer>
                                </TabPane>
                            }
                        </Tabs>
                    </Content>

                    <Footer Class="bottom-panel">
                        <CascadingValue Value="DesignerViewModel.Flow">
                            <Tabs DefaultActiveKey="logs" Size="@TabSize.Small" Class="bottom-tabs">
                                <TabPane Key="logs" Tab="Logs">
                                    <FlowLogs />
                                </TabPane>
                                <TabPane Key="variables" Tab="Variables">
                                    <FlowVariables />
                                </TabPane>
                            </Tabs>
                        </CascadingValue>
                    </Footer>
                </Layout>

            </Layout>
        </TabPane>
        <TabPane Key="activity" Tab="Activity">
            <FlowActivity FlowId="@FlowId" FlowName="@FlowName" />
        </TabPane>
        <TabPane Key="schedule" Tab="Schedule">
            <FlowSchedule FlowId="@FlowId" FlowName="@FlowName" />
        </TabPane>
        <TabPane Key="settings" Tab="Settings">
            <FlowSettings FlowId="@FlowId" FlowName="@FlowName" />
        </TabPane>
    </Tabs>
</Layout>

<style>

    .content-container {
        background-color: #fff;
        flex: 1;
        overflow: auto;
    }

    .designer-container {
        background-color: #fafafa;
    }

    .main-content-layout {
        display: flex;
        flex-direction: column;
        height: calc(100vh - 200px);
    }

    .dropzone {
        overflow: auto;
        height: calc(100vh - 500px); /* Adjusted for bottom panel */
    }

    .bottom-panel {
        background-color: #f8f9fa;
        border-top: 1px solid #d9d9d9;
        height: 300px;
        flex-shrink: 0;
        padding: 0;
    }

    .bottom-tabs {
        height: 100%;
    }

    .bottom-tabs .ant-tabs-content-holder {
        height: calc(100% - 44px);
        overflow: auto;
    }

    .runners-select {
        min-width: 140px;
        max-width: 140px;
    }

    .explorer-tabs {
        padding-top: 10px;
        height: 100%;
    }

    div.ant-tabs-nav-wrap {
        padding-left: 5px;
    }

</style>



