@page "/flow/designer/{flowid}/{flowname}"
@using AntDesign
@using Automaton.Studio.Pages.FlowDesigner.Components.Drawer
@using Automaton.Studio.Pages.FlowDesigner.Components.StepExplorer
@using Automaton.Studio.Pages.FlowDesigner.Components;
@using Automaton.Studio.Domain;
@using Automaton.Studio.Models;

<Layout>
    <Header Class="header">
        <Row>
            <Col Span="10">

                <Space Direction="SpaceDirection.Horizontal">
                    <SpaceItem>
                    <Breadcrumb>
                        <BreadcrumbItem Href="/">
                            <Icon Type="home" Width="16" Height="16" />
                            <span>Home</span>
                        </BreadcrumbItem>
                        <BreadcrumbItem Href="/flows">
                            <Icon Type="profile" Width="16" Height="16" />
                            <span>Flows</span>
                        </BreadcrumbItem>
                        <BreadcrumbItem>
                            <Icon Type="edit" Width="16" Height="16" />
                            <span>@FlowName</span>
                        </BreadcrumbItem>
                    </Breadcrumb>
                    </SpaceItem>
                </Space>

            </Col>

            <Col Class="right-actions" Span="14">
                <Space Class="right-header-items">
                    <SpaceItem>
                        <Button Icon="thunderbolt" Type="@ButtonType.Primary">
                            Create Flow with AI ✨
                        </Button>
                    </SpaceItem>

                    <SpaceItem>
                        <Button Icon="save" OnClick="SaveFlow">
                            Save
                        </Button>
                    </SpaceItem>

                    <SpaceItem>
                        <!-- Execution Controls - Always show runner selection and run button -->
                        <Space Size="SpaceSize.Small" Class="execution-controls">
                            
                            <!-- Run/Stop Button with Enhanced UX -->
                            <SpaceItem>
                                @if (DesignerViewModel.IsFlowNotRunning())
                                {
                                    @if (ExecutionCapabilities.CanExecute)
                                    {
                                        <!-- Enabled Run Button -->
                                        <Tooltip Title="@ExecutionCapabilities.GetExecutionDescription()">
                                            <Button Icon="caret-right" 
                                                    Type="@ButtonType.Primary"
                                                    OnClick="RunFlow">
                                                @ExecutionCapabilities.GetButtonText()
                                            </Button>
                                        </Tooltip>
                                    }
                                    else
                                    {
                                        <!-- Disabled Run Button with Helpful Message -->
                                        <Tooltip Title="@RunButtonDisabledMessage">
                                            <Button Icon="caret-right" 
                                                    Type="@ButtonType.Primary"
                                                    Disabled="true"
                                                    OnClick="OnRunButtonClickWhenDisabled">
                                                Run Flow
                                            </Button>
                                        </Tooltip>
                                    }
                                }
                                else
                                {
                                    <Button Icon="stop" OnClick="StopFlow">Stop</Button>
                                }
                            </SpaceItem>

                            <!-- Runner Selection -->
                            <SpaceItem>
                                <Select Mode="SelectMode.Multiple"
                                        Placeholder="Select runners..."
                                        DataSource="availableRunners"
                                        TItem="RunnerModel"
                                        TItemValue="Guid"
                                        ValueProperty="r => r.Id"
                                        LabelProperty="r => r.Name"
                                        DisabledPredicate="r => r.Status == Automaton.Core.Enums.RunnerStatus.Offline"
                                        Values="@selectedRunners"
                                        OnSelectedItemsChanged="@OnRunnersSelectionChanged"
                                        AllowClear
                                        Style="width: 200px">
                                    <ItemTemplate Context="runnerContext">
                                        <Icon Type="@GetRunnerStatusIcon(runnerContext.Status)"
                                              class="@(GetRunnerStatusClass(runnerContext.Status))" />
                                        @runnerContext.Name
                                    </ItemTemplate>
                                    <LabelTemplate Context="runnerContext">
                                        <Icon Type="@GetRunnerStatusIcon(runnerContext.Status)"
                                              class="@(GetRunnerStatusClass(runnerContext.Status))" />
                                        @runnerContext.Name
                                    </LabelTemplate>
                                </Select>
                            </SpaceItem>
                            
                            <!-- Enhanced Help Section -->
                            @if (!ExecutionCapabilities.CanExecute)
                            {
                                <SpaceItem>
                                    @if (!HasAvailableRunners)
                                    {
                                        <!-- No Runners Available - Show Download Link -->
                                        <div style="display: flex; align-items: center; gap: 8px;">
                                            <Tooltip Title="No runners installed. Please install a runner first from Downloads page">
                                            <Icon Type="info-circle" Style="color: #faad14;" Width="16" Height="16" />
                                            </Tooltip>
                                        </div>
                                    }
                                    else if (!HasSelectedRunners)
                                    {
                                        <!-- Runners Available but None Selected -->
                                        <div style="display: flex; align-items: center; gap: 8px;" Width="16" Height="16">
                                            <Tooltip Title="Select runners above to execute this workflow">
                                                <Icon Type="info-circle" Style="color: #1890ff;" />
                                            </Tooltip>
                                        </div>
                                    }
                                </SpaceItem>
                            }
                            
                        </Space>
                    </SpaceItem>
                </Space>
            </Col>
        </Row>
    </Header>

    <Tabs ActiveKey="@activeTabKey" OnChange="OnTabChange" Class="main-tabs-container">
        <TabPane Key="designer" Tab="Designer">
            <Layout Class="designer-container">

                <Splitter Layout="@SplitterLayout.Horizontal">
                    <SplitterPanel Size="20%">

                        <Sider Theme="SiderTheme.Light" Style="width: 100%; max-width: 100%; height: 100%">
                        <CascadingValue Value="DesignerViewModel.Flow">
                            <div class="step-library-container">
                                <div class="step-library-header">
                                    <Title Level="5" Style="margin: 10px 0 5px 15px;">Step Library</Title>
                                </div>

                                <div class="step-library-content">
                                    <Tabs DefaultActiveKey="core" TabPosition="@TabPosition.Bottom" Size="@TabSize.Small" Class="explorer-tabs">
                                        <TabPane Key="core" Tab="Core Steps">
                                            <CoreStepsExplorer></CoreStepsExplorer>
                                        </TabPane>
                                        <TabPane Key="custom" Tab="Custom Steps">
                                            <CustomStepsExplorer></CustomStepsExplorer>
                                        </TabPane>
                                    </Tabs>

                                    <div class="create-step-ai-section">
                                        <Button Icon="plus" Type="@ButtonType.Primary" Class="create-step-ai-button">
                                            Create Step with AI ✨
                                        </Button>
                                    </div>
                                </div>
                            </div>
                        </CascadingValue>
                    </Sider>

                    </SplitterPanel>

                    <SplitterPanel Size="80%">

                        <Splitter Layout="@SplitterLayout.Horizontal">
                            <SplitterPanel Size="@TopSplitterPercentage">
                                <Layout Class="main-content-layout">

                                    <Splitter Layout="@SplitterLayout.Vertical" Class="main-splitter">
                                        <SplitterPanel Size="70%">

                                            <Content Class="content-container">
                                                <Tabs Type="@TabType.EditableCard"
                                                      Size="@TabSize.Small"
                                                      ActiveKey="@DesignerViewModel.ActiveDefinition?.Id"
                                                      DefaultActiveKey="@DesignerViewModel.GetStartupDefinitionId()"
                                                      OnAddClick="OnDefinitionAddClick"
                                                      OnTabClick="OnTabClick"
                                                      OnClose="OnTabClose"
                                                      Class="designer-tabs">

                                                    @foreach (var definition in DesignerViewModel.GetFlowDefinitions())
                                                    {
                                                        <TabPane Key="@definition.Id" Tab="@definition.Name">
                                                            <Designer @ref="designer"
                                                                      Class="dropzone"
                                                                      Steps="definition.Steps"
                                                                      ItemDrop="@((p)=>OnItemDrop(p))"
                                                                      ItemDoubleClick="@((p)=>OnItemDoubleClick(p))">

                                                                <DesignerStep Step="@context" />

                                                            </Designer>
                                                        </TabPane>
                                                    }
                                                </Tabs>
                                            </Content>
                                        </SplitterPanel>

                                        <SplitterPanel Size="30%">
                                            <Footer Class="bottom-panel">
                                                <CascadingValue Value="DesignerViewModel.Flow">
                                                    <Tabs DefaultActiveKey="logs" Size="@TabSize.Small" TabPosition="@TabPosition.Bottom" Class="bottom-tabs">
                                                        <TabPane Key="logs" Tab="Logs">
                                                            <FlowLogs />
                                                        </TabPane>
                                                        <TabPane Key="variables" Tab="Variables">
                                                            <FlowVariables />
                                                        </TabPane>
                                                    </Tabs>
                                                </CascadingValue>
                                            </Footer>
                                        </SplitterPanel>
                                    </Splitter>

                                </Layout>
                            </SplitterPanel>

                            <SplitterPanel Size="@BottomSplitterPercentage">
                                @if (selectedStep != null)
                                {
                                    <div class="properties-container">
                                        <div class="properties-header">
                                            <Space Style="width: 100%; padding: 8px; justify-content: space-between;">
                                                <SpaceItem>
                                                    <Title Level="5">Step Details</Title>
                                                </SpaceItem>
                                                <SpaceItem>
                                                    <Button Icon="close" Size="@ButtonSize.Small" Type="@ButtonType.Text" 
                                                            OnClick="ClosePropertiesPanel" />
                                                </SpaceItem>
                                            </Space>
                                        </div>
                                        <div class="properties-content">
                                            <StepPropertiesWrapper Step="selectedStep" />
                                        </div>
                                    </div>
                                }
            </SplitterPanel>
                        </Splitter>

                    </SplitterPanel>
                </Splitter>

            </Layout>
        </TabPane>
        <TabPane Key="activity" Tab="Activity">
            <FlowActivity FlowId="@FlowId" FlowName="@FlowName" />
        </TabPane>
        <TabPane Key="schedule" Tab="Schedule">
            <FlowSchedule FlowId="@FlowId" FlowName="@FlowName" />
        </TabPane>
        <TabPane Key="settings" Tab="Settings">
            <FlowSettings FlowId="@FlowId" FlowName="@FlowName" />
        </TabPane>
    </Tabs>
</Layout>

<style>

    .content-container {
        background-color: #fff;
        flex: 1;
        overflow: hidden;
        min-width: 0; /* Important for flex shrinking */
        display: flex;
        flex-direction: column;
    }

    .designer-container {
        background-color: #fafafa;
        height: calc(100vh - 120px);
        overflow: hidden;
        border-radius: 8px;
        border: 1px solid #f0f0f0;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.09);
    }

    .main-content-layout {
        display: flex;
        flex-direction: column;
        height: 100%;
        min-width: 0; /* Important for flex shrinking */
    }

    /* Ensure the main splitter fills its container */
    .main-splitter {
        height: 100%;
        flex: 1;
    }

    /* Target the first splitter panel (containing the designer) using nth-child */
    .main-splitter .ant-splitter-panel:first-child {
        display: flex;
        flex-direction: column;
        min-height: 0; /* Important for flex child to shrink properly */
    }

    /* Target the second splitter panel (containing the bottom-panel) */
    .main-splitter .ant-splitter-panel:nth-child(2) {
        display: flex;
        flex-direction: column;
        min-height: 0;
        overflow: hidden;
    }

    .properties-container {
        height: 100%;
        display: flex;
        flex-direction: column;
        background-color: #fff;
        border-left: 1px solid #f0f0f0;
    }

    .properties-header {
        background-color: #fafafa;
        border-bottom: 1px solid #f0f0f0;
        flex-shrink: 0;
    }

    .properties-content {
        flex: 1;
        overflow: auto;
        padding: 15px;
    }

    .bottom-panel {
        height: 100%;
        flex: 1;
        padding: 0;
        display: flex;
        flex-direction: column;
        background-color: #fff;
        min-height: 0;
        overflow: hidden;
    }

    /* Fix bottom tabs to properly fill available space and respond to splitter changes */
    .bottom-tabs {
        height: 100%;
        flex: 1;
        display: flex;
        flex-direction: column;
        background-color: #fff;
        min-height: 0;
        overflow: hidden;
    }

    .bottom-tabs .ant-tabs-nav {
        flex-shrink: 0;
        margin-bottom: 0;
        background-color: #fafafa;
        border-top: 1px solid #f0f0f0;
        padding: 0 8px;
        min-height: 32px;
        order: 2; /* Place navigation at bottom for TabPosition.Bottom */
    }

    .bottom-tabs .ant-tabs-tab {
        margin: 0 4px !important;
        padding: 4px 8px !important;
        min-height: 28px !important;
        font-size: 12px !important;
    }

    .bottom-tabs .ant-tabs-content-holder {
        flex: 1;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        min-height: 0;
        order: 1; /* Place content above navigation for TabPosition.Bottom */
    }

    .bottom-tabs .ant-tabs-content {
        height: 100%;
        flex: 1;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .bottom-tabs .ant-tabs-tabpane {
        height: 100%;
        flex: 1;
        display: flex;
        flex-direction: column;
        padding: 0;
        overflow: hidden;
        min-height: 0;
    }

    /* Ensure only active tab pane is visible */
    .bottom-tabs .ant-tabs-tabpane:not(.ant-tabs-tabpane-active) {
        display: none !important;
    }

    .bottom-tabs .ant-tabs-tabpane.ant-tabs-tabpane-active {
        display: flex !important;
        flex-direction: column;
        height: 100%;
        flex: 1;
    }

    /* Target only the bottom splitter panel (the one containing .bottom-panel) */
    .ant-splitter-panel:has(.bottom-panel) {
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    /* Target the right splitter panel conditionally */
    .ant-splitter-panel:nth-child(2) {
        transition: all 0.3s ease;
    }

    /* Hide the right splitter panel when no step is selected */
    .ant-splitter-panel:nth-child(2):has(.properties-container) {
        display: flex;
    }

    /* Main tabs container - ensure proper tab behavior for main navigation */
    .main-tabs-container {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        width: 100%;
        padding: 0 24px; /* Add horizontal margins matching other pages */
        box-sizing: border-box;
        background-color: white;
    }

    .main-tabs-container .ant-tabs-content-holder {
        flex: 1;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        /* Don't override the default order for main tabs */
    }

    /* Designer tab should not have the background/padding since it's a complex layout */
    .main-tabs-container .ant-tabs-tabpane:has(.designer-container) {
        background-color: transparent;
        border-radius: 0;
        padding: 0;
        margin-bottom: 0;
        box-shadow: none;
        border: none;
        height: 100%;
    }

    .execution-controls {
        align-items: center;
        display: flex;
        flex-wrap: nowrap;
        gap: 8px;
    }

    .runner-online {
        color: #52c41a !important; /* Green for online */
        margin-right: 4px;
    }

    .runner-offline {
        color: #ff4d4f !important; /* Red for offline */
        margin-right: 4px;
    }

    .explorer-tabs {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .create-step-ai-section {
        padding: 8px 12px;
        background-color: #f8f9fa;
        flex-shrink: 0;
    }

    .create-step-ai-button {
        width: 100%;
    }

    /* Fix main tabs to use full height */
    .ant-tabs {
        height: 100%;
        display: flex;
        flex-direction: column;
    }

     .ant-tabs-content-holder .ant-tabs-content .ant-tabs-content-top {
        height: 100%;
    }

    /* Ensure designer tabs specifically fill available space */
    .designer-tabs {
        height: 100%;
        display: flex;
        flex-direction: column;
    }

        .designer-tabs .ant-tabs-content-holder {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .designer-tabs .ant-tabs-tabpane {
            height: 100%;
            display: flex;
            flex-direction: column;
        }
   
    .step-library-container {
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .step-library-header {
        background-color: #fafafa;
        border-bottom: 1px solid #f0f0f0;
        flex-shrink: 0;
    }

    .step-library-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-height: 0; /* Important for flex child to shrink */
        overflow: hidden;
    }

    .runner-status-icon.runner-status-online {
        color: #52c41a !important; /* Green for online */
    }

    .runner-status-icon.runner-status-offline {
        color: #ff4d4f !important; /* Red for offline */
    }

    .runner-status-icon.runner-status-none {
        color: #d9d9d9 !important; /* Gray for none/unknown */
    }
</style>