@using Automaton.Studio.Resources
@using Automaton.Studio.Domain
@using Blazored.FluentValidation
@using Automaton.Core.Enums;

<div class="variables-container">
    <PanelHeader Title="Variables"
                 ShowClearButton="false"
                 ShowPinButton="false"
                 ShowCloseButton="false" />

    <div class="variables-content">
        <!-- Flow Variables Section -->
        <Collapse DefaultActiveKey="@(new[] { "flow" })" Bordered="false" Class="variables-collapse-panel">
            <Panel Key="flow">
                <HeaderTemplate>
                    <Space Direction="SpaceDirection.Horizontal" Align="SpaceAlign.Center">
                        <SpaceItem>
                            <Icon Type="deployment-unit" Theme="IconThemeType.Outline" Style="color: #666;" />
                        </SpaceItem>
                        <SpaceItem>
                            <b>Flow Variables</b>
                        </SpaceItem>
                    </Space>
                </HeaderTemplate>
                <ChildContent>
                    <div class="scrollable-list">
                        @if (Variables.Any())
                        {
                            @foreach (var variable in Variables)
                            {
                                <div class="variable">
                                    <div class="variable-item">
                                        <Button Type="ButtonType.Link" Size="@ButtonSize.Small" OnClick="@(() => ViewVariable(variable))">@variable.Name</Button>
                                        <span class="ellipsis">@variable.Value?.ToString()</span>
                                        <div class="designer-step-actions-icon">
                                            <Dropdown Placement="@Placement.Left" Trigger="@(new Trigger[] { Trigger.Click })">
                                                <Overlay>
                                                    <Menu>
                                                        <MenuItem Icon="eye" OnClick="@(() => ViewVariable(variable))">
                                                            View
                                                        </MenuItem>
                                                        <MenuItem Icon="search">
                                                            Find Usages
                                                        </MenuItem>
                                                    </Menu>
                                                </Overlay>
                                                <ChildContent>
                                                    <a href="#" @onclick:preventDefault @onmousedown:stopPropagation>
                                                        <Icon Type="more" Theme="IconThemeType.Outline" />
                                                    </a>
                                                </ChildContent>
                                            </Dropdown>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="variables-empty-inline">
                                <Icon Type="deployment-unit" Theme="IconThemeType.Outline" Style="font-size: 16px; color: #d9d9d9; margin-right: 8px;" />
                                <span>No flow variables available</span>
                            </div>
                        }
                    </div>
                </ChildContent>
            </Panel>
        </Collapse>

        <!-- Input Variables Section -->
        <Collapse DefaultActiveKey="@(new[] { "input" })" Bordered="false" Class="variables-collapse-panel">
            <Panel Key="input">
                <HeaderTemplate>
                    <Space Direction="SpaceDirection.Horizontal" Align="SpaceAlign.Center" Style="width: 100%; justify-content: space-between;">
                        <SpaceItem>
                            <Space Direction="SpaceDirection.Horizontal" Align="SpaceAlign.Center">
                                <SpaceItem>
                                    <Icon Type="import" Theme="IconThemeType.Outline" Style="color: #666;" />
                                </SpaceItem>
                                <SpaceItem>
                                    <b>Input Variables</b>
                                </SpaceItem>
                            </Space>
                        </SpaceItem>
                        <SpaceItem>
                            <Tooltip Title="Add input variable">
                                <Button Icon="plus"
                                        Size="@ButtonSize.Small"
                                        Type="@ButtonType.Text"
                                        Class="toolbar-btn"
                                        OnClick="@AddInputVariable" />
                            </Tooltip>
                        </SpaceItem>
                    </Space>
                </HeaderTemplate>
                <ChildContent>
                    <div class="scrollable-list">
                        @if (InputVariables.Any())
                        {
                            @foreach (var variable in InputVariables)
                            {
                                <div class="variable">
                                    <div class="variable-item">
                                        <Button Type="ButtonType.Link" Size="@ButtonSize.Small" OnClick="@(() => EditInputVariable(variable))">@variable.Name</Button>
                                        <span class="ellipsis">@variable.Value?.ToString()</span>
                                        <div class="designer-step-actions-icon">
                                            <Dropdown Placement="@Placement.Left" Trigger="@(new Trigger[] { Trigger.Click })">
                                                <Overlay>
                                                    <Menu>
                                                        <MenuItem Icon="edit" OnClick="@(() => EditInputVariable(variable))">
                                                            Edit
                                                        </MenuItem>
                                                        <MenuItem Icon="delete" OnClick="@(() => DeleteInputVariable(variable))">
                                                            Delete
                                                        </MenuItem>
                                                    </Menu>
                                                </Overlay>
                                                <ChildContent>
                                                    <a href="#" @onclick:preventDefault @onmousedown:stopPropagation>
                                                        <Icon Type="more" Theme="IconThemeType.Outline" />
                                                    </a>
                                                </ChildContent>
                                            </Dropdown>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="variables-empty-inline">
                                <Icon Type="import" Theme="IconThemeType.Outline" Style="font-size: 16px; color: #d9d9d9; margin-right: 8px;" />
                                <span>No input variables defined</span>
                            </div>
                        }
                    </div>
                </ChildContent>
            </Panel>
        </Collapse>

        <!-- Output Variables Section -->
        <Collapse DefaultActiveKey="@(new[] { "output" })" Bordered="false" Class="variables-collapse-panel">
            <Panel Key="output">
                <HeaderTemplate>
                    <Space Direction="SpaceDirection.Horizontal" Align="SpaceAlign.Center" Style="width: 100%; justify-content: space-between;">
                        <SpaceItem>
                            <Space Direction="SpaceDirection.Horizontal" Align="SpaceAlign.Center">
                                <SpaceItem>
                                    <Icon Type="export" Theme="IconThemeType.Outline" Style="color: #666;" />
                                </SpaceItem>
                                <SpaceItem>
                                    <b>Output Variables</b>
                                </SpaceItem>
                            </Space>
                        </SpaceItem>
                        <SpaceItem>
                            <Tooltip Title="Add output variable">
                                <Button Icon="plus"
                                        Size="@ButtonSize.Small"
                                        Type="@ButtonType.Text"
                                        Class="toolbar-btn"
                                        OnClick="@AddOutputVariable" />
                            </Tooltip>
                        </SpaceItem>
                    </Space>
                </HeaderTemplate>
                <ChildContent>
                    <div class="scrollable-list">
                        @if (OutputVariables.Any())
                        {
                            @foreach (var variable in OutputVariables)
                            {
                                <div class="variable">
                                    <div class="variable-item">
                                        <Button Type="ButtonType.Link" Size="@ButtonSize.Small" OnClick="@(() => EditOutputVariable(variable))">@variable.Name</Button>
                                        <span class="ellipsis">@variable.Value?.ToString()</span>
                                        <div class="designer-step-actions-icon">
                                            <Dropdown Placement="@Placement.Left" Trigger="@(new Trigger[] { Trigger.Click })">
                                                <Overlay>
                                                    <Menu>
                                                        <MenuItem Icon="edit" OnClick="@(() => EditOutputVariable(variable))">
                                                            Edit
                                                        </MenuItem>
                                                        <MenuItem Icon="delete" OnClick="@(() => DeleteOutputVariable(variable))">
                                                            Delete
                                                        </MenuItem>
                                                    </Menu>
                                                </Overlay>
                                                <ChildContent>
                                                    <a href="#" @onclick:preventDefault @onmousedown:stopPropagation>
                                                        <Icon Type="more" Theme="IconThemeType.Outline" />
                                                    </a>
                                                </ChildContent>
                                            </Dropdown>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="variables-empty-inline">
                                <Icon Type="export" Theme="IconThemeType.Outline" Style="font-size: 16px; color: #d9d9d9; margin-right: 8px;" />
                                <span>No output variables defined</span>
                            </div>
                        }
                    </div>
                </ChildContent>
            </Panel>
        </Collapse>
    </div>
</div>

<style>
    .variables-container {
        height: 100%;
        display: flex;
        flex-direction: column;
        background-color: #ffffff;
        overflow: hidden;
        flex: 1;
        min-height: 0;
    }

    .variables-content {
        flex: 1;
        overflow-y: auto;
        overflow-x: hidden;
        background-color: #ffffff;
        min-height: 0;
        padding: 0;
    }

    .variables-collapse-panel {
        background-color: #efefef;
        border-radius: 2px;
        margin: 5px 0 10px 0;
        border-radius: 5px;
    }

    .scrollable-list {
        overflow-x: hidden;
        overflow-y: auto;
        max-height: 250px;
        padding-right: 30px;
    }

    .scrollable-list .variable {
        margin: 6px 0 0 0;
    }

    .variable-item {
        display: flex;
        align-items: center;
        padding: 4px 0;
        border-bottom: 1px solid #f0f0f0;
    }

    .variable-item:last-child {
        border-bottom: none;
    }

    .variables-empty-inline {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
        color: #999;
        font-size: 12px;
        text-align: center;
    }

    .designer-step-actions-icon {
        padding: 0px 12px 0px 12px;
        margin-left: auto;
    }

    .ellipsis {
        display: inline-block;
        overflow: hidden;
        overflow-wrap: normal;
        text-overflow: ellipsis;
        white-space: nowrap;
        width: 100px;
        margin-left: 8px;
        color: #666;
        font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
        font-size: 12px;
        flex: 1;
    }

    .toolbar-btn {
        color: #666 !important;
        border: none !important;
        background: transparent !important;
        transition: all 0.2s ease;
    }

    .toolbar-btn:hover {
        color: #1890ff !important;
        background-color: rgba(24, 144, 255, 0.08) !important;
    }

    /* Adjust collapse panel header to accommodate the button */
    .ant-collapse-header {
        padding: 8px 12px !important;
    }

    .ant-collapse-content-box {
        padding: 8px 12px !important;
    }
</style>


