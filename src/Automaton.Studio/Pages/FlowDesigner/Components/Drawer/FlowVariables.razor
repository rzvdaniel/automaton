@using Automaton.Studio.Resources
@using Automaton.Studio.Domain
@using Blazored.FluentValidation
@using Automaton.Core.Enums;

<div class="variables-container">
    <!-- Toolbar -->
    <div class="variables-toolbar">
        <Space Direction="SpaceDirection.Horizontal" Align="SpaceAlign.Center" Style="width: 100%; justify-content: space-between;">
            <SpaceItem>
                <Space Direction="SpaceDirection.Horizontal" Align="SpaceAlign.Center">
                    <SpaceItem>
                        <Icon Type="deployment-unit" Theme="IconThemeType.Outline" Style="color: #666;" />
                    </SpaceItem>
                    <SpaceItem>
                        <Text Strong Style="color: #666; font-size: 12px;">Workflow Variables</Text>
                    </SpaceItem>
                </Space>
            </SpaceItem>
            <SpaceItem>
                <Space Direction="SpaceDirection.Horizontal" Size="SpaceSize.Small">
                    <SpaceItem>
                        <Segmented TValue="string"
                                   Labels="@(new[]{"Flow", "Input", "Output"})"
                                   Value="@selectedVariableType"
                                   OnChange="@OnVariableTypeChange"
                                   Size="@SegmentedSize.Small" />
                    </SpaceItem>
                    <SpaceItem>
                        @if (selectedVariableType != "Flow")
                        {
                            <Tooltip Title="@($"Add {selectedVariableType.ToLower()} variable")">
                                <Button Icon="plus"
                                        Size="@ButtonSize.Small"
                                        Type="@ButtonType.Text"
                                        Class="toolbar-btn"
                                        OnClick="@AddVariable" />
                            </Tooltip>
                        }
                    </SpaceItem>
                </Space>
            </SpaceItem>
        </Space>
    </div>

    <!-- Variables Content -->
    <div class="variables-content">
        @if (selectedVariableType == "Flow")
        {
            <div class="variable-section">
                @if (Variables.Any())
                {
                    <AntList DataSource="@Variables" Size="ListSize.Small" Class="scrollable-list">
                        <ChildContent Context="item">
                            <ListItem Style="padding-left: 0px; padding-bottom: 2px; padding-top: 2px">
                                <Button Type="ButtonType.Link" Size="@ButtonSize.Small" OnClick="@(() => ViewVariable(item))">@item.Name</Button>
                                <span class="ellipsis">@item.Value?.ToString()</span>
                                <div class="designer-step-actions-icon">
                                    <Dropdown Placement="@Placement.Left" Trigger="@(new Trigger[] { Trigger.Click })">
                                        <Overlay>
                                            <Menu>
                                                <MenuItem Icon="eye" OnClick="@(() => ViewVariable(item))">
                                                    View
                                                </MenuItem>
                                                <MenuItem Icon="search">
                                                    Find Usages
                                                </MenuItem>
                                            </Menu>
                                        </Overlay>
                                        <ChildContent>
                                            <a href="#" @onclick:preventDefault @onmousedown:stopPropagation>
                                                <Icon Type="more" Theme="IconThemeType.Outline" />
                                            </a>
                                        </ChildContent>
                                    </Dropdown>
                                </div>
                            </ListItem>
                        </ChildContent>
                    </AntList>
                }
                else
                {
                    <Result Status="@ResultStatus.Info"
                            Title="No flow variables"
                            SubTitle="Variables will appear here during flow execution."
                            Icon="@IconType.Outline.FileText">
                        <Extra>
                            <span style="color: #999; font-size: 12px;">
                                Click the Run button to execute the workflow and check variables.
                            </span>
                        </Extra>
                    </Result>
                }
            </div>
        }
        else if (selectedVariableType == "Input")
        {
            <div class="variable-section">
                @if (InputVariables.Any())
                {
                    <AntList DataSource="@InputVariables" Size="ListSize.Small" Class="scrollable-list">
                        <ChildContent Context="item">
                            <ListItem>
                                <Button Type="ButtonType.Link" Size="@ButtonSize.Small" OnClick="@(() => EditInputVariable(item))">@item.Name</Button>
                                <span class="ellipsis">@item.Value?.ToString()</span>
                                <div class="designer-step-actions-icon">
                                    <Dropdown Placement="@Placement.Left" Trigger="@(new Trigger[] { Trigger.Click })">
                                        <Overlay>
                                            <Menu>
                                                <MenuItem Icon="edit" OnClick="@(() => EditInputVariable(item))">
                                                    Edit
                                                </MenuItem>
                                                <MenuItem Icon="delete" OnClick="@(() => DeleteInputVariable(item))">
                                                    Delete
                                                </MenuItem>
                                            </Menu>
                                        </Overlay>
                                        <ChildContent>
                                            <a href="#" @onclick:preventDefault @onmousedown:stopPropagation>
                                                <Icon Type="more" Theme="IconThemeType.Outline" />
                                            </a>
                                        </ChildContent>
                                    </Dropdown>
                                </div>
                            </ListItem>
                        </ChildContent>
                    </AntList>
                }
                else
                {
                    <Result Status="@ResultStatus.Info"
                            Title="No input variables defined"
                            SubTitle="Create input variables to pass data into your workflow."
                            Icon="@IconType.Outline.FileText">
                        <Extra>
                            <Button Type="@ButtonType.Primary" OnClick="AddInputVariable">Add Input Variable</Button>
                        </Extra>
                    </Result>
                }
            </div>
        }
        else if (selectedVariableType == "Output")
        {
            <div class="variable-section">
                @if (OutputVariables.Any())
                {
                    <AntList DataSource="@OutputVariables" Size="ListSize.Small" Class="scrollable-list">
                        <ChildContent Context="item">
                            <ListItem>
                                <Button Type="ButtonType.Link" Size="@ButtonSize.Small" OnClick="@(() => EditOutputVariable(item))">@item.Name</Button>
                                <span class="ellipsis">@item.Value?.ToString()</span>
                                <div class="designer-step-actions-icon">
                                    <Dropdown Placement="@Placement.Left" Trigger="@(new Trigger[] { Trigger.Click })">
                                        <Overlay>
                                            <Menu>
                                                <MenuItem Icon="edit" OnClick="@(() => EditOutputVariable(item))">
                                                    Edit
                                                </MenuItem>
                                                <MenuItem Icon="delete" OnClick="@(() => DeleteOutputVariable(item))">
                                                    Delete
                                                </MenuItem>
                                            </Menu>
                                        </Overlay>
                                        <ChildContent>
                                            <a href="#" @onclick:preventDefault @onmousedown:stopPropagation>
                                                <Icon Type="more" Theme="IconThemeType.Outline" />
                                            </a>
                                        </ChildContent>
                                    </Dropdown>
                                </div>
                            </ListItem>
                        </ChildContent>
                    </AntList>
                }
                else
                {
                    <Result Status="@ResultStatus.Info"
                            Title="No output variables defined"
                            SubTitle="Create output variables to capture results from your workflow."
                            Icon="@IconType.Outline.FileText">
                        <Extra>
                            <Button Type="@ButtonType.Primary" OnClick="AddOutputVariable">Add Output Variable</Button>
                        </Extra>
                    </Result>
                }
            </div>
        }
    </div>
</div>

<style>
    .variables-container {
        height: 100%;
        display: flex;
        flex-direction: column;
        background-color: #ffffff;
        flex: 1;
    }

    .variables-toolbar {
        background-color: #fafafa;
        border-bottom: 1px solid #f0f0f0;
        padding: 6px 12px;
        flex-shrink: 0;
        min-height: 32px;
    }

    .variables-content {
        flex: 1;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        background-color: #ffffff;
    }

    .variable-section {
        flex: 1;
        overflow: auto;
        padding: 12px 16px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .scrollable-list {
        overflow: auto;
        max-height: 300px;
        width: 100%;
        align-self: flex-start;
    }

    .designer-step-actions-icon {
        padding: 0px 12px 0px 12px;
    }

    .ellipsis {
        display: inline-block;
        overflow: hidden;
        overflow-wrap: normal;
        text-overflow: ellipsis;
        white-space: nowrap;
        width: 100px;
        margin-left: 8px;
        color: #666;
        font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
        font-size: 12px;
    }

    .toolbar-btn {
        color: #666 !important;
        border: none !important;
        background: transparent !important;
        transition: all 0.2s ease;
    }

    .toolbar-btn:hover {
        color: #1890ff !important;
        background-color: rgba(24, 144, 255, 0.08) !important;
    }
</style>


