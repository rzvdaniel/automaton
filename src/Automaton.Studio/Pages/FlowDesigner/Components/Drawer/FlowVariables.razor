@using Automaton.Studio.Resources
@using Automaton.Studio.Domain
@using Blazored.FluentValidation
@using Automaton.Core.Enums;

<div class="variables-container">
    <!-- Segmented Control Header -->
    <div class="variables-header">
        <Space Direction="SpaceDirection.Horizontal" Align="SpaceAlign.Center" Style="width: 100%; justify-content: space-between;">
            <SpaceItem>
                <Segmented TValue="string" 
                          Labels="@(new[]{"Flow", "Input", "Output"})" 
                          Value="@selectedVariableType" 
                          OnChange="@OnVariableTypeChange"
                          Size="@SegmentedSize.Small" />
            </SpaceItem>
            <SpaceItem>
                @if (selectedVariableType != "Flow")
                {
                    <Tooltip Title="@($"Add {selectedVariableType.ToLower()} variable")">
                        <Button Icon="plus" 
                                Shape="@ButtonShape.Circle" 
                                Size="@ButtonSize.Small" 
                                Type="@ButtonType.Primary"
                                OnClick="@AddVariable" />
                    </Tooltip>
                }
            </SpaceItem>
        </Space>
    </div>

    <!-- Variables Content -->
    <div class="variables-content">
        @if (selectedVariableType == "Flow")
        {
            <div class="variable-section">
                @if (Variables.Any())
                {
                    <div class="variable-list">
                        @foreach (var variable in Variables)
                        {
                            <div class="variable-item">
                                <div class="variable-info">
                                    <div class="variable-name">@variable.Name</div>
                                    <div class="variable-value">@(variable.Value?.ToString() ?? "null")</div>
                                </div>
                                <div class="variable-actions">
                                    <Dropdown Placement="@Placement.Left" Trigger="@(new Trigger[] { Trigger.Click })">
                                        <Overlay>
                                            <Menu>
                                                <MenuItem Icon="eye" OnClick="@(() => ViewVariable(variable))">
                                                    View
                                                </MenuItem>
                                                <MenuItem Icon="search">
                                                    Find Usages
                                                </MenuItem>
                                            </Menu>
                                        </Overlay>
                                        <ChildContent>
                                            <Button Icon="more" 
                                                    Type="@ButtonType.Text" 
                                                    Size="@ButtonSize.Small" 
                                                    Class="variable-menu-btn" />
                                        </ChildContent>
                                    </Dropdown>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <Icon Type="database" Style="font-size: 24px; color: #d9d9d9;" />
                        <div class="empty-text">No flow variables</div>
                        <div class="empty-subtext">Variables will appear here during flow execution</div>
                    </div>
                }
            </div>
        }
        else if (selectedVariableType == "Input")
        {
            <div class="variable-section">
                @if (InputVariables.Any())
                {
                    <div class="variable-list">
                        @foreach (var variable in InputVariables)
                        {
                            <div class="variable-item">
                                <div class="variable-info">
                                    <div class="variable-name">@variable.Name</div>
                                    <div class="variable-value">@(variable.Value?.ToString() ?? "null")</div>
                                </div>
                                <div class="variable-actions">
                                    <Dropdown Placement="@Placement.Left" Trigger="@(new Trigger[] { Trigger.Click })">
                                        <Overlay>
                                            <Menu>
                                                <MenuItem Icon="edit" OnClick="@(() => EditInputVariable(variable))">
                                                    Edit
                                                </MenuItem>
                                                <MenuItem Icon="delete" OnClick="@(() => DeleteInputVariable(variable))">
                                                    Delete
                                                </MenuItem>
                                            </Menu>
                                        </Overlay>
                                        <ChildContent>
                                            <Button Icon="more" 
                                                    Type="@ButtonType.Text" 
                                                    Size="@ButtonSize.Small" 
                                                    Class="variable-menu-btn" />
                                        </ChildContent>
                                    </Dropdown>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <Icon Type="import" Style="font-size: 24px; color: #d9d9d9;" />
                        <div class="empty-text">No input variables defined</div>
                        <div class="empty-subtext">Create input variables for workflow parameters</div>
                    </div>
                }
            </div>
        }
        else if (selectedVariableType == "Output")
        {
            <div class="variable-section">
                @if (OutputVariables.Any())
                {
                    <div class="variable-list">
                        @foreach (var variable in OutputVariables)
                        {
                            <div class="variable-item">
                                <div class="variable-info">
                                    <div class="variable-name">@variable.Name</div>
                                    <div class="variable-value">@(variable.Value?.ToString() ?? "null")</div>
                                </div>
                                <div class="variable-actions">
                                    <Dropdown Placement="@Placement.Left" Trigger="@(new Trigger[] { Trigger.Click })">
                                        <Overlay>
                                            <Menu>
                                                <MenuItem Icon="edit" OnClick="@(() => EditOutputVariable(variable))">
                                                    Edit
                                                </MenuItem>
                                                <MenuItem Icon="delete" OnClick="@(() => DeleteOutputVariable(variable))">
                                                    Delete
                                                </MenuItem>
                                            </Menu>
                                        </Overlay>
                                        <ChildContent>
                                            <Button Icon="more" 
                                                    Type="@ButtonType.Text" 
                                                    Size="@ButtonSize.Small" 
                                                    Class="variable-menu-btn" />
                                        </ChildContent>
                                    </Dropdown>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <Icon Type="export" Style="font-size: 24px; color: #d9d9d9;" />
                        <div class="empty-text">No output variables defined</div>
                        <div class="empty-subtext">Create output variables to capture workflow results</div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    .variables-container {
        height: 100%;
        display: flex;
        flex-direction: column;
        background-color: #fff;
        flex: 1;
    }

    .variables-header {
        padding: 12px 16px 8px 16px;
        border-bottom: 1px solid #f0f0f0;
        background-color: #fafafa;
        flex-shrink: 0;
    }

    .variables-content {
        flex: 1;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .variable-section {
        flex: 1;
        overflow: auto;
        padding: 12px 16px;
    }

    .variable-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .variable-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 12px;
        background-color: #fafafa;
        border: 1px solid #f0f0f0;
        border-radius: 6px;
        transition: all 0.2s ease;
    }

    .variable-item:hover {
        border-color: #d9d9d9;
        background-color: #f5f5f5;
    }

    .variable-info {
        flex: 1;
        min-width: 0;
    }

    .variable-name {
        font-weight: 500;
        color: #262626;
        font-size: 13px;
        margin-bottom: 2px;
    }

    .variable-value {
        font-size: 12px;
        color: #666;
        font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .variable-actions {
        flex-shrink: 0;
        margin-left: 8px;
    }

    .variable-menu-btn {
        color: #666 !important;
        padding: 2px 6px !important;
    }

    .variable-menu-btn:hover {
        color: #1890ff !important;
        background-color: rgba(24, 144, 255, 0.08) !important;
    }

    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        text-align: center;
        min-height: 120px;
    }

    .empty-text {
        margin-top: 12px;
        font-size: 14px;
        color: #666;
        font-weight: 500;
    }

    .empty-subtext {
        margin-top: 4px;
        font-size: 12px;
        color: #999;
    }
</style>


