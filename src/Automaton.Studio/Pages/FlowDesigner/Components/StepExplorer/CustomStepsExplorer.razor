@using Automaton.Studio.Pages.FlowDesigner.Components.StepExplorer

<div class="activities-container">
    <Row>
        <div class="activities-search">
            <Search Placeholder="Search custom steps..." @bind-Value="@searchText" BindOnInput AllowClear ClassicSearchIcon></Search>
        </div>
    </Row>
    <Row>
        <Col Span="24">
            <Tree  
                ShowIcon
                Draggable
                DefaultExpandAll
                SearchValue="@searchText"
                HideUnmatched="true"
                DataSource="@CustomStepsViewModel.Steps"
                TitleExpression="x => x.DataItem.Title"
                ChildrenExpression="x => x.DataItem.Steps"
                IconExpression="x => x.DataItem.Icon"
                IsLeafExpression="x => x.DataItem.Steps == null || !x.DataItem.Steps.Any()"
                KeyExpression="x => x.DataItem.Name"
                OnDragStart="@((i)=> { CustomStepsViewModel.CreateStep(i); })"
                Class="activities-tree"
                TItem="StepExplorerModel">
            </Tree>
        </Col>
    </Row>
</div>

<style>
    .activities-tree {
        padding-top: 10px;
        background-color: white;
        border-right: 1px solid #f0f0f0;
        height: calc(100vh - 320px);
        overflow: auto
    }

    .activities-search {
        padding: 10px;
        background-color: white;
        border-right: 1px solid #f0f0f0;
        width: 100%;
    }

    .activities-container {
        height: 100%;
    }
</style>