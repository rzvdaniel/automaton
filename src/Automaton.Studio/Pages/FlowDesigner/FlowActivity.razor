@page "/flow/activity/{flowid}/{flowname}"
@using AntDesign
@using Automaton.Studio.Models;

<div class="flow-tab-content">
    <div class="flow-tab-header">
        <Title Level="3" Style="margin-bottom: 8px;">Flow Execution History</Title>
        <Paragraph Style="color: #666;">
            View and monitor all executions of this workflow. Expand any row to see detailed logs.
        </Paragraph>
    </div>
    
    <div class="flow-tab-table">
        @if (!loading && FlowActivityViewModel.Executions?.Any() != true)
        {
            <EnhancedEmpty Title="Execution history in real-time." 
                          Description="Track every execution of your workflow with detailed logs and status updates. Each run provides insights into performance, results, and any issues that may occur."
                          BackgroundImageUrl="https://images.unsplash.com/photo-1551288049-bebda4e38f71?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80"
                          GradientOverlay="linear-gradient(135deg, rgba(14, 165, 233, 0.85) 0%, rgba(59, 130, 246, 0.85) 100%)"
                          ActionCardTitle="Monitor Executions"
                          ActionCardDescription="Run your workflow to see execution history with detailed logs and status tracking."
                          ActionCardBulletPoints="@GetActivityActionCardBullets()"
                          FeatureSectionTitle="Real-time execution monitoring!"
                          FeatureSectionSubtitle="Track workflow runs with detailed logs and status updates"
                          HelpSectionTitle="Learn more about Activity Monitoring"
                          PrimaryAction="@(new EnhancedEmpty.EmptyActionModel { Text = "Run Workflow", Icon = "play-circle", OnClick = () => { NavigationManager.NavigateTo($"/flow/designer/{FlowId}/{FlowName}"); return Task.CompletedTask; } })"
                          FeatureCards="@GetActivityFeatureCards()"
                          HelpLinks="@GetActivityHelpLinks()">
                <VisualMockup>
                    <ActivityVisualMockup />
                </VisualMockup>
            </EnhancedEmpty>
        }
        else
        {
            <Table TItem="FlowExecution" 
                DataSource="@FlowActivityViewModel.Executions"
                RowExpandable="@((record)=>true)"
                OnExpand="OnRowExpand"
                Loading="@loading" 
                Class="autoscroll-list"
                EnableVirtualization
                OnChange="OnChange"
                Total="FlowActivityViewModel.Total"
                PageSize="100"
                RemoteDataSource>
                <ColumnDefinitions>
                    <Column Title="Application" @bind-Field="@context.Application">
                        @context.Application
                    </Column>

                    <Column Title="Started" @bind-Field="@context.Started">
                        @context.Started
                    </Column>

                    <Column Title="Finished" @bind-Field="@context.Finished">
                        @context.Finished
                    </Column>

                    <Column Title="Status" @bind-Field="@context.Status">
                        <span class="@context.StatusClass">@context.Status</span>
                    </Column>
                </ColumnDefinitions>

                <ExpandTemplate Context="rowData">
                    @if (LogIsLoading(rowData.Data.LogsText))
                    {
                        <div class="log-spin"><Spin /></div>
                    }
                    else
                    {
                        <TextArea Id="flow-logs" Value="@rowData.Data.LogsText" />
                    }
                </ExpandTemplate>
            </Table>
        }
    </div>
</div>

<style>
    .flow-tab-content {
        height: 100%;
        display: flex;
        flex-direction: column;
        background: white;
        border-radius: 8px;
        padding: 0;
    }

    .flow-tab-header {
        padding: 24px 24px 16px 24px;
        border-bottom: 1px solid #f0f0f0;
        flex-shrink: 0;
        background: white;
        border-radius: 8px 8px 0 0;
    }

    .flow-tab-table {
        flex: 1;
        overflow: hidden;
        padding: 0 24px 24px 24px;
        background: white;
        border-radius: 0 0 8px 8px;
    }

    #flow-logs {
        width: 100%;
        height: 300px !important;
        overflow-x: hidden;
        font-size: smaller;
        border-radius: 6px;
        border: 1px solid #f0f0f0;
    }

    .log-spin {
        text-align: center;
        border-radius: 4px;
        margin-bottom: 20px;
        margin: 20px 0;
    }

    /* Override autoscroll-list for this specific context */
    .flow-tab-table .autoscroll-list {
        height: calc(100vh - 400px); /* Adjust based on header and margins */
    }
</style>



