@using AntDesign
@using System.Collections.Generic
@using Microsoft.AspNetCore.Components

<div class="ai-chat-panel">
    <div class="ai-chat-header">
        <div class="title">AI Chat</div>
        <div class="header-actions">
            <Button Type="ButtonType.Text" Icon="pushpin" />
            <Button Type="ButtonType.Text" Icon="close" />
        </div>
    </div>

    <div class="ai-chat-body">
        <div class="messages" @ref="messagesContainer">
            @foreach (var msg in messages)
            {
                <div class="message">
                    <div class="meta">
                        <span class="role">@msg.Role</span>
                        <span class="time">@msg.Time.ToString("HH:mm")</span>
                    </div>
                    <div class="content">@((MarkupString)msg.Content)</div>
                </div>
            }
        </div>
    </div>

    <div class="ai-chat-input">
        <div class="controls">
            @* <Select @bind-Value="selectedAgent" Style="width: 140px; margin-right: 8px;">
                <SelectOptions>
                    <SelectOption Value="DefaultAgent" Label="Agent" />
                    <SelectOption Value="Assistant" Label="Assistant" />
                </SelectOptions>
            </Select>

            <Select @bind-Value="selectedModel" Style="width: 160px; margin-right: 8px;">
                <SelectOptions>
                    <SelectOption Value="gpt-4" Label="GPT-4" />
                    <SelectOption Value="gpt-4o" Label="GPT-4o" />
                    <SelectOption Value="gpt-3.5" Label="GPT-3.5" />
                </SelectOptions>
            </Select> *@

            <Space Style="flex:1">
                <Input @bind-Value="promptText" Placeholder="Ask the AI or request code generation..." />
            </Space>

            <Space>
                <Button Icon="paper-clip" OnClick="AttachFile" />
                <Button Type="ButtonType.Primary" Icon="caret-right" OnClick="SendPrompt">Send</Button>
            </Space>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback<string> OnSend { get; set; }

    ElementReference messagesContainer;

    private string selectedAgent = "DefaultAgent";
    private string selectedModel = "gpt-4";
    private string promptText = string.Empty;

    private List<ChatMessage> messages = new()
    {
        new ChatMessage("System", "AI chat panel ready. Ask a question or generate code.", DateTime.Now)
    };

    private void AttachFile()
    {
        // placeholder for attach action
    }

    private async Task SendPrompt()
    {
        if (string.IsNullOrWhiteSpace(promptText)) return;

        messages.Add(new ChatMessage("User", System.Net.WebUtility.HtmlEncode(promptText), DateTime.Now));
        var toSend = promptText;
        promptText = string.Empty;

        // Placeholder for actual send - emit event so page can handle
        if (OnSend.HasDelegate)
        {
            await OnSend.InvokeAsync(toSend);
        }

        // temporarily add a mocked assistant response
        messages.Add(new ChatMessage("AI", "<p>Generating... (mock response)</p>", DateTime.Now));

        await InvokeAsync(StateHasChanged);

        // scroll to bottom (best-effort)
        try
        {
            await JSRuntime.InvokeVoidAsync("blazorHelpers.scrollToBottom", messagesContainer);
        }
        catch { }
    }

    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;

    private record ChatMessage(string Role, string Content, DateTime Time);
}

<style>
.ai-chat-panel {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-left: 1px solid #f0f0f0;
}
.ai-chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    border-bottom: 1px solid #e8e8e8;
    background: #fafafa;
}
.ai-chat-header .title { font-weight: 600; }
.ai-chat-body {
    flex: 1 1 auto;
    overflow: auto;
    padding: 10px;
    background: #fff;
}
.messages { display: flex; flex-direction: column; gap: 8px; }
.message { padding: 8px; border-radius: 6px; background: #f6f8fa; }
.message .meta { font-size: 11px; color: #666; margin-bottom: 6px; display:flex; gap:8px }
.ai-chat-input { padding: 8px; border-top: 1px solid #e8e8e8; background: #fafafa; }
.ai-chat-input .controls { display:flex; align-items:center; gap:8px }
.ai-chat-input input { width:100%; }
</style>