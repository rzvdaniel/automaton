@using AntDesign
@using System.Collections.Generic
@using Microsoft.AspNetCore.Components
@using Automaton.Studio.Models
@using Automaton.Studio.Services

<div class="ai-chat-panel">
    <div class="ai-chat-header">
        <div class="title">AI Chat</div>
        <div class="header-actions">
            <Button Type="ButtonType.Text" Icon="pushpin" />
            <Button Type="ButtonType.Text" Icon="close" />
        </div>
    </div>

    <div class="ai-chat-body">
        <div class="messages" @ref="messagesContainer">
            @foreach (var msg in messages)
            {
                <div class="message">
                    <div class="meta">
                        <span class="role">@msg.Role</span>
                        <span class="time">@msg.Time.ToString("HH:mm")</span>
                    </div>
                    <div class="content">@((MarkupString)msg.Content)</div>
                </div>
            }
        </div>
    </div>

    <div class="ai-chat-input">
        <Space Style="flex:1">
            <Input @bind-Value="promptText" Placeholder="Ask the AI or request code generation..." />
        </Space>

        <div class="controls">
            <Select @bind-Value="selectedAgent"
                    TItemValue="string"
                    TItem="string"
                    Style="width: 140px; margin-right: 8px;">
                <SelectOptions>
                    <SelectOption TItemValue="string" TItem="string" Value="@Agent" Label="Agent" />
                    <SelectOption Value="@Assistant" Label="Assistant" />
                </SelectOptions>
            </Select>

            <Select @bind-Value="selectedProviderModel" 
                    TItemValue="string"
                    TItem="string" 
                    Style="width: 220px; margin-right: 8px;"
                    Placeholder="Select AI Provider & Model"
                    AllowClear="false">
                <SelectOptions>
                    @if (availableProviders?.Any() != true)
                    {
                        <SelectOption TItemValue="string" TItem="string" Value="@("none")" Label="No providers configured" Disabled="true" />
                    }
                    else
                    {
                        @foreach (var provider in availableProviders)
                        {
                            @if (provider.SupportedModels?.Any() == true)
                            {
                                @foreach (var model in provider.SupportedModels)
                                {
                                    var value = $"{provider.Provider}:{model}";
                                    var label = $"{provider.ProviderName} - {model}";
                                    var isDisabled = !provider.HasStoredKeys && !provider.HasEnvironmentKey;
                                    
                                    <SelectOption TItemValue="string" TItem="string" 
                                                Value="@value" 
                                                Label="@label"
                                                Disabled="@isDisabled" />
                                }
                            }
                        }
                    }
                </SelectOptions>
            </Select>

            @if (!string.IsNullOrEmpty(selectedProviderModel) && GetSelectedProvider() != null)
            {
                var selectedProvider = GetSelectedProvider();
                @if (selectedProvider.StoredKeys?.Any() == true)
                {
                    <Select @bind-Value="selectedApiKeyId"
                            TItemValue="string"
                            TItem="string" 
                            Style="width: 120px; margin-right: 8px;"
                            Placeholder="API Key"
                            AllowClear="false">
                        <SelectOptions>
                            @foreach (var apiKey in selectedProvider.StoredKeys)
                            {
                                <SelectOption TItemValue="string" TItem="string" 
                                            Value="@apiKey.Id.ToString()" 
                                            Label="@apiKey.Name" />
                            }
                        </SelectOptions>
                    </Select>
                }
            }

            <Space>
                <Button Icon="paper-clip" OnClick="AttachFile" />
                <Button Type="ButtonType.Primary" Icon="caret-right" OnClick="SendPrompt" Disabled="@(!IsReadyToSend)">Send</Button>
            </Space>
        </div>
    </div>

    @if (showNoProvidersMessage)
    {
        <div class="no-providers-message">
            <Alert Type="@AlertType.Warning" 
                   Message="No AI providers configured" 
                   Description="Configure your API keys in Settings to start using AI chat."
                   ShowIcon="true"
                   Style="margin: 8px;" />
        </div>
    }
</div>


<style>
.ai-chat-panel {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-left: 1px solid #f0f0f0;
}
.ai-chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    border-bottom: 1px solid #e8e8e8;
    background: #fafafa;
}
.ai-chat-header .title { font-weight: 600; }
.ai-chat-body {
    flex: 1 1 auto;
    overflow: auto;
    padding: 10px;
    background: #fff;
}
.messages { display: flex; flex-direction: column; gap: 8px; }
.message { padding: 8px; border-radius: 6px; background: #f6f8fa; }
.message .meta { font-size: 11px; color: #666; margin-bottom: 6px; display:flex; gap:8px }
.ai-chat-input { 
    padding: 8px; 
    border-top: 1px solid #e8e8e8; 
    background: #fafafa; 
    display: flex;
    flex-direction: column;
    gap: 8px;
}
.ai-chat-input .controls { 
    display:flex; 
    align-items:center; 
    gap:8px;
    flex-wrap: wrap;
}
.ai-chat-input input { width:100%; }

.model-disabled {
    color: #999;
    font-style: italic;
}

.no-providers-message {
    border-top: 1px solid #e8e8e8;
}
</style>