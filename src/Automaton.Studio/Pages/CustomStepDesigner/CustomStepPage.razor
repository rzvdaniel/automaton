@page "/stepdesigner/{stepId}"
@using AntDesign
@using Automaton.Studio.Pages.CustomStepDesigner.Components
@using Blazored.FluentValidation;
@using Automaton.Core.Enums;

<Layout>
    <Content>
        <Header Class="header">
            <Row>
                <Col>
                    <Space Direction="SpaceDirection.Horizontal">
                        <SpaceItem Class="header-item">
                            <Breadcrumb>
                                <BreadcrumbItem Href="/">
                                    <Icon Type="home" Width="16" Height="16" />
                                    <span>Home</span>
                                </BreadcrumbItem>
                                <BreadcrumbItem Href="/customsteps">
                                    <Icon Type="experiment" Width="16" Height="16" />
                                    <span>Steps</span>
                                </BreadcrumbItem>
                                <BreadcrumbItem>
                                    <Icon Type="edit" Width="16" Height="16" />
                                    <span>@StepDesignerViewModel.CustomStep.Name</span>
                                </BreadcrumbItem>
                            </Breadcrumb>
                        </SpaceItem>
                    </Space>
                </Col>
                <Col Class="right-actions">
                    <Space Class="right-header-items">
                        <SpaceItem>
                            <Tooltip Title="Save step">
                                <Button Icon="save" OnClick="Save">
                                    Save
                                </Button>
                            </Tooltip>
                        </SpaceItem>
                    </Space>
                </Col>
            </Row>
        </Header>
        <Form @ref="form"
              Model="@StepDesignerViewModel.CustomStep"
              Loading="loading"
              Class="step-form"
              Layout="@FormLayout.Vertical"
              LabelColSpan="24"
              WrapperColSpan="24">
            <Validator>
                <FluentValidationValidator />
                <ValidationSummary />
            </Validator>
            <ChildContent>
                <Tabs>
                    <TabPane Tab="Code" Key="1">
                        <Splitter Layout="@SplitterLayout.Horizontal" Class="main-splitter">
                            <SplitterPanel Size="70%">
                                <div class="left-panel">

                                    <Splitter Layout="@SplitterLayout.Vertical" Class="main-splitter">
                                        <SplitterPanel Size="70%">
                                            <div class="code-toolbar">
                                                 <Form @ref="codeForm"
                                                  Model="@StepDesignerViewModel.CustomStep"
                                                  Class="code-form"
                                                  Layout="@FormLayout.Vertical"
                                                  LabelColSpan="24"
                                                  WrapperColSpan="24">
                                                    <Validator>
                                                        <FluentValidationValidator />
                                                        <ValidationSummary />
                                                    </Validator>
                                                        <ChildContent Context="codeContext">
                                                            <Space Direction="SpaceDirection.Horizontal">
                                                                <SpaceItem>
                                                                    <Select @bind-Value="@StepDesignerViewModel.CustomStep.Definition.Language"
                                                                            Placeholder="Select Language..."
                                                                            TItemValue="string"
                                                                            TItem="string">
                                                                        <SelectOptions>
                                                                            @foreach (var lang in CustomStepLanguages)
                                                                            {
                                                                                <SelectOption TItemValue="string" TItem="string" Value=@lang Label=@lang />
                                                                            }
                                                                        </SelectOptions>
                                                                    </Select>
                                                                </SpaceItem>
                                                                <SpaceItem>
                                                                    <Button Class="code-button" Icon="caret-right" OnClick="Run" Loading="@runningCode" Disabled="@runningCode" Type="@ButtonType.Primary" HtmlType="submit">
                                                                        Run
                                                                    </Button>
                                                                </SpaceItem>
                                                                @if (showDiffEditor)
                                                                {
                                                                    <SpaceItem>
                                                                        <Button Icon="check" OnClick="AcceptCodeChanges" Type="@ButtonType.Primary" Style="background-color: #52c41a; border-color: #52c41a;">
                                                                            Accept Changes
                                                                        </Button>
                                                                    </SpaceItem>
                                                                    <SpaceItem>
                                                                        <Button Icon="close" OnClick="RejectCodeChanges" Danger>
                                                                            Reject Changes
                                                                        </Button>
                                                                    </SpaceItem>
                                                                }
                                                            </Space>
                                                        </ChildContent>
                                                    </Form>
                                            </div>
                                       
                                            <div class="monaco-container">
                                                @if (showDiffEditor)
                                                {
                                                    <DiffEditor Id="step-diff" ConstructionOptions="DiffEditorConstructionOptions" @ref="diffEditor" />
                                                }
                                                else
                                                {
                                                    <StandaloneCodeEditor Id="step-code" ConstructionOptions="EditorConstructionOptions" @ref="codeEditor" />
                                                }
                                            </div>
                                          
                                        </SplitterPanel>

                                        <SplitterPanel Size="30%">
                                            <div class="step-logs-container">
                                                <!-- Logs Toolbar -->
                                                <div class="step-logs-toolbar">
                                                    <Space Direction="SpaceDirection.Horizontal" Align="SpaceAlign.Center" Style="width: 100%; justify-content: space-between;">
                                                        <SpaceItem>
                                                            <Space Direction="SpaceDirection.Horizontal" Align="SpaceAlign.Center">
                                                                <SpaceItem>
                                                                    <Icon Type="file-text" Theme="IconThemeType.Outline" Style="color: #666;" />
                                                                </SpaceItem>
                                                                <SpaceItem>
                                                                    <Text Strong Style="color: #666; font-size: 12px;">Script Execution Logs</Text>
                                                                </SpaceItem>
                                                            </Space>
                                                        </SpaceItem>
                                                        <SpaceItem>
                                                            <Space Direction="SpaceDirection.Horizontal" Size="SpaceSize.Small">
                                                                <SpaceItem>
                                                                    <Tooltip Placement="@Placement.TopRight" Title="Auto-scroll to bottom">
                                                                        <Button Icon="@(autoScroll ? "pause-circle" : "play-circle")"
                                                                                Size="@ButtonSize.Small"
                                                                                Type="@ButtonType.Text"
                                                                                Class="@(autoScroll ? "toolbar-btn-active" : "toolbar-btn")"
                                                                                OnClick="ToggleAutoScroll">
                                                                        </Button>
                                                                    </Tooltip>
                                                                </SpaceItem>
                                                                <SpaceItem>
                                                                    <Tooltip Placement="@Placement.TopRight" Title="Copy logs to clipboard">
                                                                        <Button Icon="copy"
                                                                                Size="@ButtonSize.Small"
                                                                                Type="@ButtonType.Text"
                                                                                Class="toolbar-btn"
                                                                                OnClick="CopyLogs">
                                                                        </Button>
                                                                    </Tooltip>
                                                                </SpaceItem>
                                                                <SpaceItem>
                                                                    <Tooltip Placement="@Placement.TopRight" Title="Clear logs">
                                                                        <Button Icon="delete"
                                                                                Size="@ButtonSize.Small"
                                                                                Type="@ButtonType.Text"
                                                                                Class="toolbar-btn"
                                                                                OnClick="ClearLogs">
                                                                        </Button>
                                                                    </Tooltip>
                                                                </SpaceItem>
                                                            </Space>
                                                        </SpaceItem>
                                                    </Space>
                                                </div>

                                                <!-- Logs Content -->
                                                <div class="step-logs-content">
                                                    @if (!string.IsNullOrEmpty(StepDesignerViewModel.ScriptOutput?.ToString()))
                                                    {
                                                        <TextArea @ref="logsTextArea"
                                                                 Value="@StepDesignerViewModel.ScriptOutput.ToString()"
                                                                 ReadOnly="true"
                                                                 ShowCount="false"
                                                                 AutoSize="false"
                                                                 Class="step-logs-textarea"
                                                                 Id="step-logs-textarea"
                                                                 Style="height: 100%; resize: none; font-family: 'Consolas', 'Monaco', 'Courier New', monospace;" />
                                                    }
                                                    else
                                                    {
                                                        <div class="step-logs-empty">
                                                            <div class="step-logs-empty-content">
                                                                <Icon Type="file-text" Theme="IconThemeType.Outline" Style="font-size: 24px; color: #d9d9d9; margin-bottom: 8px;" />
                                                                <div class="step-logs-empty-title">No logs available</div>
                                                                <div class="step-logs-empty-subtitle">Logs will appear here when you run the script.</div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </SplitterPanel>
                                    </Splitter>
                                </div>
                            </SplitterPanel>

                            <SplitterPanel Size="30%">
                                <div class="right-panel-container">
                                    <Tabs Size="TabSize.Small" Class="right-panel">
                                        <TabPane Tab="AI Chat" Key="ai">
                                            <div class="tab-content-scrollable">
                                                <AiChatPanel OnCodeGenerated="OnCodeGenerated"
                                                             CurrentLanguage="@StepDesignerViewModel.CustomStep.Definition.Language"
                                                             InputVariables="@GetInputVariablesForAI()"
                                                             OutputVariables="@GetOutputVariablesForAI()" />
                                            </div>
                                        </TabPane>
                                        <TabPane Tab="Variables" Key="variables">
                                            <div class="tab-content-scrollable">
                                                <div class="variables-panel">
                                                    <Collapse DefaultActiveKey="@(new[] { "input" })" Bordered="false" Class="variables-collapse-panel">
                                                        <Panel Key="input">
                                                            <HeaderTemplate>
                                                                <b>Test Input Variables</b>
                                                            </HeaderTemplate>
                                                            <ChildContent>
                                                                <div class="scrollable-list">
                                                                    @foreach (var inputVariable in StepDesignerViewModel.CustomStep.Definition.CodeInputVariables)
                                                                    {
                                                                        <div class="variable">
                                                                            <DynamicComponent Type="GetVariableComponent(inputVariable.Type)" Parameters="GetVariableComponentParameters(inputVariable)" />
                                                                        </div>
                                                                    }
                                                                </div>
                                                            </ChildContent>
                                                        </Panel>
                                                    </Collapse>
                                                    <Collapse DefaultActiveKey="@(new[] { "output" })" Bordered="false" Class="variables-collapse-panel">
                                                        <Panel Key="output">
                                                            <HeaderTemplate>
                                                                <b>Test Output Variables</b>
                                                            </HeaderTemplate>
                                                            <ChildContent>
                                                                <div class="scrollable-list">
                                                                    @foreach (var outputVariable in StepDesignerViewModel.CustomStep.Definition.CodeOutputVariables)
                                                                    {
                                                                        <div class="variable">
                                                                            <DynamicComponent Type="GetVariableComponent(outputVariable.Type)" Parameters="GetVariableComponentParameters(outputVariable)" />
                                                                        </div>
                                                                    }
                                                                </div>
                                                            </ChildContent>
                                                        </Panel>
                                                    </Collapse>
                                                </div>
                                            </div>
                                        </TabPane>
                                    </Tabs>
                                </div>
                            </SplitterPanel>
                        </Splitter>
                    </TabPane>
                    <TabPane Tab="Input Variables" Key="2">
                        <Space Direction="SpaceDirection.Vertical">
                            <SpaceItem>
                                <Tooltip Title="Add input variable">
                                    <Button OnClick="AddInputVariable" Type="ButtonType.Primary">
                                        Add
                                    </Button>
                                </Tooltip>
                            </SpaceItem>
                            <SpaceItem>
                                <Table DataSource="@context.Definition.CodeInputVariables"
                                       RowExpandable="@((record)=>true)"
                                       ScrollY="calc(100vh - 310px);"
                                       ScrollBarWidth="5"
                                       HidePagination>
                                    <ChildContent Context="inputVariable">
                                        <Column Title="Name" TData="string">
                                            <Input Type="InputType.Text" @bind-Value="inputVariable.Name" AutoFocus />
                                        </Column>
                                        <Column Title="Type" TData="string">
                                            <Select @bind-Value="inputVariable.Type"
                                                    Placeholder="Select type..."
                                                    TItemValue="VariableType"
                                                    TItem="VariableType">
                                                <SelectOptions>
                                                    @foreach (var variableType in VariableTypes)
                                                    {
                                                        <SelectOption TItemValue="VariableType" TItem="VariableType" Value=@variableType Label=@variableType.ToString() />
                                                    }
                                                </SelectOptions>
                                            </Select>
                                        </Column>
                                        <ActionColumn Title="Action">
                                            <Tooltip Title="Delete variable">
                                                <Popconfirm Title="Sure to delete?"
                                                            OnConfirm="()=> DeleteInputVariable(inputVariable.Name)"
                                                            OkText="Yes"
                                                            CancelText="No">
                                                    <a>Delete</a>
                                                </Popconfirm>
                                            </Tooltip>
                                        </ActionColumn>
                                    </ChildContent>
                                    <ExpandTemplate Context="inputVariable2">
                                        <GridRow Gutter="(16, 0)" Class="expanded-content">
                                            <GridCol Xs="6" Md="6">
                                                <FormItem Label="Description">
                                                    <Input Type="InputType.Text" @bind-Value="inputVariable2.Data.Description" />
                                                </FormItem>
                                            </GridCol>
                                            <GridCol Xs="6" Md="6">
                                                <FormItem Label="Value">
                                                    <Input Type="InputType.Text" TValue="string" Value="inputVariable2.Data.Value?.ToString()" OnChange="(x) => { inputVariable2.Data.Value = x; }" />
                                                </FormItem>
                                            </GridCol>
                                        </GridRow>
                                    </ExpandTemplate>
                                </Table>
                            </SpaceItem>
                        </Space>
                    </TabPane>

                    <TabPane Tab="Output Variables" Key="3">
                        <Space Direction="SpaceDirection.Vertical" Style="width: 100%">
                            <SpaceItem>
                                <Tooltip Title="Add output variable">
                                    <Button OnClick="AddOutputVariable" Type="@ButtonType.Primary" >
                                        Add
                                    </Button>
                                </Tooltip>
                            </SpaceItem>
                            <SpaceItem>
                                <Table DataSource="context.Definition.CodeOutputVariables"
                                       RowExpandable="@((record)=>true)"
                                       ScrollY="calc(100vh - 310px);"
                                       ScrollBarWidth="5"
                                       HidePagination>
                                    <ChildContent Context="outputVariable">
                                        
                                        <Column Title="Name" TData="string">
                                            <Input Type="InputType.Text" @bind-Value="outputVariable.Name" />
                                        </Column>
                                        <Column Title="Type" TData="string">
                                            <Select @bind-Value="outputVariable.Type"
                                                    Placeholder="Select type..."
                                                    TItemValue="VariableType"
                                                    TItem="VariableType">
                                                <SelectOptions>
                                                    @foreach (var variableType in VariableTypes)
                                                    {
                                                        <SelectOption TItemValue="VariableType" TItem="VariableType" Value=@variableType Label=@variableType.ToString() />
                                                    }
                                                </SelectOptions>
                                            </Select>
                                        </Column>
                                        <ActionColumn Title="Action">
                                            <Tooltip Title="Delete variable">
                                                <Popconfirm Title="Sure to delete?"
                                                            OnConfirm="()=> DeleteOutputVariable(outputVariable.Name)"
                                                            OkText="Yes"
                                                            CancelText="No">
                                                    <a>Delete</a>
                                                </Popconfirm>
                                            </Tooltip>
                                        </ActionColumn>
                                    </ChildContent>
                                    <ExpandTemplate Context="outputVariable2">
                                        <GridRow Gutter="(16, 0)" Class="expanded-content">
                                            <GridCol Xs="6" Md="6">
                                                <FormItem Label="Description">
                                                    <Input Type="InputType.Text" @bind-Value="outputVariable2.Data.Description" />
                                                </FormItem>
                                            </GridCol>
                                            <GridCol Xs="6" Md="6">
                                                <FormItem Label="Value">
                                                    <Input Type="InputType.Text" TValue="string" Value="outputVariable2.Data.Value?.ToString()" OnChange="(x) => { outputVariable2.Data.Value = x; }" />
                                                </FormItem>
                                            </GridCol>
                                        </GridRow>
                                    </ExpandTemplate>
                                </Table>
                            </SpaceItem>
                        </Space>
                    </TabPane>

                    <TabPane Tab="Settings" Key="4">
                        <Row Gutter="(16, 0)" Justify="RowJustify.Start">
                            <Col Xs="24" Md="6">
                            <FormItem Label="Name">
                                <Input @bind-Value="@context.Name" Placeholder="Enter name" />
                            </FormItem>
                            </Col>
                            <Col Xs="24" Md="6">
                            <FormItem Label="Display Name">
                                <Input @bind-Value="@context.DisplayName" Placeholder="Enter display name" />
                            </FormItem>
                            </Col>
                        </Row>

                        <Row Gutter="(16, 0)" Justify="RowJustify.Start">
                            <Col Xs="24" Md="6">
                            <FormItem Label="Description">
                                <Input @bind-Value="@context.Description" Placeholder="Enter description" />
                            </FormItem>
                            </Col>
                            <Col Xs="24" Md="6">
                            <FormItem Label="More info URL">
                                <Input @bind-Value="@context.MoreInfo" Placeholder="Enter more info" />
                            </FormItem>
                            </Col>
                        </Row>
                    </TabPane>

                </Tabs>
            </ChildContent>
        </Form>
    </Content>
</Layout>

<style>
    .step-form {
        background-color: #fff;
        padding: 20px;
        height: calc(100vh - 117px);
    }
    .main-splitter {
        height: calc(100vh - 180px);
        width: 100%;
        display: flex;
    }
    .left-panel {
        display: flex;
        flex-direction: column;
        height: 100%;
        width: 100%;
    }

    .monaco-container {
        flex: 1 1 auto;
        width: 100%;
        height: 100%;
        display: flex;
        overflow:hidden;
    }
    #step-code {
        width: 100% !important;
        height: 100% !important;
        box-sizing: border-box;
        display: block;
    }
    
    #step-diff {
        width: 100% !important;
        height: 100% !important;
        box-sizing: border-box;
        display: block;
    }
    
    .code-toolbar {
        background-color:#EEE; 
        padding: 4px;
        margin-bottom: 10px;
        flex-shrink: 0;
    }

    /* Step Logs Styling - Following FlowLogs pattern */
    .step-logs-container {
        height: 100%;
        display: flex;
        flex-direction: column;
        background-color: #ffffff;
        overflow: hidden;
        flex: 1;
        min-height: 0;
        margin-top: 8px;
        border-radius: 6px;
        box-shadow: 0 1px 2px rgba(0,0,0,0.03);
    }

    .step-logs-toolbar {
        background-color: #fafafa;
        border-bottom: 1px solid #f0f0f0;
        padding: 6px 12px;
        flex-shrink: 0;
        min-height: 32px;
    }

    .step-logs-content {
        flex: 1;
        overflow: hidden;
        position: relative;
        min-height: 0;
        display: flex;
        flex-direction: column;
        background-color: #ffffff;
    }

    .step-logs-textarea {
        border: none !important;
        box-shadow: none !important;
        background-color: #ffffff !important;
        padding: 12px !important;
        line-height: 1.4 !important;
        font-size: 12px !important;
        flex: 1 !important;
        min-height: 0 !important;
        height: auto !important;
    }

    .step-logs-textarea:focus {
        border: none !important;
        box-shadow: none !important;
    }

    .step-logs-empty {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #ffffff;
        flex: 1;
        padding: 16px;
    }

    .step-logs-empty-content {
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        max-width: 280px;
    }

    .step-logs-empty-title {
        font-size: 14px;
        font-weight: 500;
        color: #666;
        margin-bottom: 4px;
        line-height: 1.4;
    }

    .step-logs-empty-subtitle {
        font-size: 12px;
        color: #999;
        line-height: 1.4;
        text-align: center;
    }

    .toolbar-btn {
        color: #666 !important;
        border: none !important;
        background: transparent !important;
        transition: all 0.2s ease;
    }

    .toolbar-btn:hover {
        color: #1890ff !important;
        background-color: rgba(24, 144, 255, 0.08) !important;
    }

    .toolbar-btn-active {
        color: #1890ff !important;
        background-color: rgba(24, 144, 255, 0.12) !important;
        border: none !important;
    }

    .toolbar-btn-active:hover {
        color: #1890ff !important;
        background-color: rgba(24, 144, 255, 0.16) !important;
    }

    .variables-panel {
        height: 100%;
        width: 100%;
        overflow-y: auto;
        box-sizing: border-box;
    }
    .variables-collapse-panel {
        background-color: #efefef;
        border-radius: 2px;
        margin: 5px 0 10px 0;
        border-radius: 5px;
    }
    .scrollable-list {
        overflow-x: hidden;
        overflow-y: auto;
        max-height: 250px;
        padding-right: 30px;
    }
    .scrollable-list .variable {
        margin: 6px 0 0 0;
    }

    .ant-splitter-panel {
        display: flex;
        flex-direction: column;
        min-height: 0;
        height: 100%;
    }
    
    .editor-panel {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }

    .right-panel { 
        padding: 0 0 0 10px;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    /* Fix for right panel tabs scrolling */
    .right-panel-container {
        height: 100%;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .right-panel .ant-tabs {
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .right-panel .ant-tabs-nav {
        flex-shrink: 0;
        margin-bottom: 0;
        position: sticky;
        top: 0;
        background: white;
        z-index: 10;
    }

    .right-panel .ant-tabs-content-holder {
        flex: 1 1 auto;
        overflow: hidden;
        min-height: 0;
    }

    .right-panel .ant-tabs-content {
        height: 100%;
    }

    .right-panel .ant-tabs-tabpane {
        height: 100%;
        overflow: hidden;
    }

    .tab-content-scrollable {
        height: 100%;
        overflow-y: auto;
        overflow-x: hidden;
    }

    /* Ensure AiChatPanel takes full height */
    .tab-content-scrollable .ai-chat-panel {
        height: 100%;
        min-height: 0;
    }
</style>

<script>
    window.setDiffEditorContent = function(editorId, originalContent, modifiedContent, language) {
        // Wait for Monaco to be available and the editor to be initialized
        setTimeout(() => {
            const editorElement = document.getElementById(editorId);
            if (editorElement && editorElement._monacoEditor) {
                const editor = editorElement._monacoEditor;
                
                // Create models for original and modified content
                const originalModel = monaco.editor.createModel(originalContent, language);
                const modifiedModel = monaco.editor.createModel(modifiedContent, language);
                
                // Set the models
                editor.setModel({
                    original: originalModel,
                    modified: modifiedModel
                });
            } else {
                console.warn('Diff editor not ready, retrying in 100ms');
                // Retry if editor isn't ready
                setTimeout(() => window.setDiffEditorContent(editorId, originalContent, modifiedContent, language), 100);
            }
        }, 50);
    };
</script>
