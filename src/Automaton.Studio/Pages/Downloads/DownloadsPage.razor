													<Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard("sudo chown root:wheel /Library/LaunchDaemons/com.automaton.runner.plist && sudo chmod 644 /Library/LaunchDaemons/com.automaton.runner.plist && sudo launchctl load /Library/LaunchDaemons/com.automaton.runner.plist", "Setup daemon command"))">
