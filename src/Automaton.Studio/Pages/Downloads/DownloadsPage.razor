@page "/downloads"
@attribute [Authorize]

@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IMessageService MessageService

<PageTitle>Downloads - Automaton</PageTitle>

<Layout Class="home-content">
	<Content>
		<div class="home-container">
			<!-- Hero Section -->
			<div class="downloads-hero">
				<div class="hero-badge">
					<Icon Type="rocket" />
					<span>Deploy in Seconds</span>
				</div>
				<h1>Deploy Automaton Runner</h1>
				<p class="hero-subtitle">Choose your preferred deployment method</p>
				<p class="hero-description">
					The Automaton Runner executes your automation flows. Deploy using Docker (recommended) 
					or download the native executable for your platform.
				</p>
				<Space Size="@SpaceSize.Small" Style="margin-top: 24px;">
					<SpaceItem>
						<Button Type="@ButtonType.Default" Size="@ButtonSize.Large" Style="background: rgba(255,255,255,0.2); border-color: white; color: white;" OnClick="@(() => ScrollToSection("docker-section"))">
							<Icon Type="container" />
							Docker (Recommended)
						</Button>
					</SpaceItem>
					<SpaceItem>
						<Button Type="@ButtonType.Default" Size="@ButtonSize.Large" Ghost OnClick="@(() => ScrollToSection("executable-section"))">
							<Icon Type="download" />
							Native Executable
						</Button>
					</SpaceItem>
				</Space>
			</div>

			<!-- Feature Cards -->
			<Row Gutter="(16, 16)" Style="margin-bottom: 48px;">
				<Col Xs="24" Sm="12" Lg="6">
				<Card Class="feature-card" Bordered="false">
					<Icon Type="container" Style="font-size: 32px; color: #1890ff; margin-bottom: 16px;" />
					<Title Level="4">Docker Ready</Title>
					<Paragraph Type="@TextElementType.Secondary">
						Pre-built image with Python 3.13 and all dependencies included
					</Paragraph>
				</Card>
				</Col>
				<Col Xs="24" Sm="12" Lg="6">
				<Card Class="feature-card" Bordered="false">
					<Icon Type="thunderbolt" Style="font-size: 32px; color: #52c41a; margin-bottom: 16px;" />
					<Title Level="4">One Command</Title>
					<Paragraph Type="@TextElementType.Secondary">
						Get running in seconds with a single command
					</Paragraph>
				</Card>
				</Col>
				<Col Xs="24" Sm="12" Lg="6">
				<Card Class="feature-card" Bordered="false">
					<Icon Type="global" Style="font-size: 32px; color: #722ed1; margin-bottom: 16px;" />
					<Title Level="4">Cross-Platform</Title>
					<Paragraph Type="@TextElementType.Secondary">
						Works on Windows, Linux, and macOS
					</Paragraph>
				</Card>
				</Col>
				<Col Xs="24" Sm="12" Lg="6">
				<Card Class="feature-card" Bordered="false">
					<Icon Type="safety-certificate" Style="font-size: 32px; color: #fa541c; margin-bottom: 16px;" />
					<Title Level="4">Secure & Reliable</Title>
					<Paragraph Type="@TextElementType.Secondary">
						API key authentication with automatic reconnection
					</Paragraph>
				</Card>
				</Col>
			</Row>

			<!-- Docker Installation Section -->
			<div id="docker-section">
				<Card Class="installation-card docker-install" Style="margin-bottom: 32px;">
					<TitleTemplate>
						<div style="display: flex; align-items: center; gap: 12px;">
							<Icon Type="container" Style="color: #1890ff; font-size: 20px;" />
							<span>Docker Installation</span>
							<Tag Color="@("green")">Recommended</Tag>
						</div>
					</TitleTemplate>
					<ChildContent>
						<Alert Type="@AlertType.Info" ShowIcon="true" Style="margin-bottom: 24px;">
							<MessageTemplate>
								Docker is the recommended deployment method. The image includes Python 3.13 with common packages 
								(requests, pandas, numpy, boto3, beautifulsoup4) pre-installed.
							</MessageTemplate>
						</Alert>

						<Tabs DefaultActiveKey="cli" Type="@TabType.Card">
							<!-- Docker CLI Tab -->
							<TabPane Key="cli">
								<TabTemplate>
									<Icon Type="code" Style="margin-right: 8px;" />
									Docker CLI
								</TabTemplate>
								<ChildContent>
									<Paragraph Type="@TextElementType.Secondary" Style="margin-bottom: 16px;">
										Run this command in your terminal. Replace <code>your_api_key</code> with your actual API key 
										(get one from <a @onclick='() => NavigationManager.NavigateTo("/apikeys")' style="cursor: pointer; color: #1890ff;">API Keys</a> page).
									</Paragraph>

									<div class="code-container" style="margin-bottom: 24px;">
										<div class="command-display">
											<Text Code Class="code-block">@dockerRunCommand</Text>
											<Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard(dockerRunCommand, "Docker command"))">
											</Button>
										</div>
									</div>

									<Collapse>
										<Panel Header="Command Options Explained" Key="options">
											<Descriptions Bordered Column="1" Size="@DescriptionsSize.Small">
												<DescriptionsItem Title="--name automaton-runner">Container name for easy reference</DescriptionsItem>
												<DescriptionsItem Title="-d">Run in detached (background) mode</DescriptionsItem>
												<DescriptionsItem Title="--restart unless-stopped">Auto-restart on failure or system reboot</DescriptionsItem>
												<DescriptionsItem Title="-e AUTOMATON_API_KEY">Your API key for authentication</DescriptionsItem>
												<DescriptionsItem Title="-e AUTOMATON_RUNNER_NAME">Optional: Custom name for this runner</DescriptionsItem>
											</Descriptions>
										</Panel>

										<Panel Header="Additional Examples" Key="examples">
											<Space Direction="SpaceDirection.Vertical" Style="width: 100%;">
												<SpaceItem>
													<Text Strong>Custom runner name:</Text>
													<div class="code-container" style="margin-top: 8px;">
														<Text Code Class="code-block">docker run --name automaton-runner -d --restart unless-stopped -e AUTOMATON_API_KEY=your_api_key -e AUTOMATON_RUNNER_NAME=my-server-01 rzvdaniel/automaton-runner:latest</Text>
													</div>
												</SpaceItem>
												<SpaceItem>
													<Text Strong>Connect to custom server:</Text>
													<div class="code-container" style="margin-top: 8px;">
														<Text Code Class="code-block">docker run --name automaton-runner -d --restart unless-stopped -e AUTOMATON_API_KEY=your_api_key -e AUTOMATON_SERVER_URL=https://your-server.com rzvdaniel/automaton-runner:latest</Text>
													</div>
												</SpaceItem>
												<SpaceItem>
													<Text Strong>View logs:</Text>
													<div class="code-container" style="margin-top: 8px;">
														<div class="command-display">
															<Text Code Class="code-block">docker logs -f automaton-runner</Text>
															<Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard("docker logs -f automaton-runner", "View logs command"))">
															</Button>
														</div>
													</div>
												</SpaceItem>
											</Space>
										</Panel>

										<Panel Header="Manage Container" Key="manage">
											<Row Gutter="16">
												<Col Span="12">
												<Text Strong>Stop the runner:</Text>
												<div class="code-container" style="margin-top: 8px;">
													<div class="command-display">
														<Text Code Class="code-block">docker stop automaton-runner</Text>
														<Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard("docker stop automaton-runner", "Stop command"))">
														</Button>
													</div>
												</div>
												</Col>
												<Col Span="12">
												<Text Strong>Start the runner:</Text>
												<div class="code-container" style="margin-top: 8px;">
													<div class="command-display">
														<Text Code Class="code-block">docker start automaton-runner</Text>
														<Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard("docker start automaton-runner", "Start command"))">
														</Button>
													</div>
												</div>
												</Col>
											</Row>
											<Row Gutter="16" Style="margin-top: 16px;">
												<Col Span="12">
												<Text Strong>Remove container:</Text>
												<div class="code-container" style="margin-top: 8px;">
													<div class="command-display">
														<Text Code Class="code-block">docker rm -f automaton-runner</Text>
														<Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard("docker rm -f automaton-runner", "Remove command"))">
														</Button>
													</div>
												</div>
												</Col>
												<Col Span="12">
												<Text Strong>Update to latest:</Text>
												<div class="code-container" style="margin-top: 8px;">
													<div class="command-display">
														<Text Code Class="code-block">docker pull rzvdaniel/automaton-runner:latest</Text>
														<Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard("docker pull rzvdaniel/automaton-runner:latest", "Pull latest command"))">
														</Button>
													</div>
												</div>
												</Col>
											</Row>
										</Panel>
									</Collapse>
								</ChildContent>
							</TabPane>

							<!-- Docker Desktop Tab -->
							<TabPane Key="desktop">
								<TabTemplate>
									<Icon Type="desktop" Style="margin-right: 8px;" />
									Docker Desktop
								</TabTemplate>
								<ChildContent>
									<Paragraph Type="@TextElementType.Secondary" Style="margin-bottom: 24px;">
										If you prefer using Docker Desktop's graphical interface, follow these steps:
									</Paragraph>

									<Steps Direction="@StepsDirection.Vertical" Current="99" Size="@StepsSize.Small">
										<Step Title="Search for the image" Description="Open Docker Desktop and go to the Images tab. Search for 'rzvdaniel/automaton-runner'" />
										<Step Title="Pull the image" Description="Click 'Pull' to download the latest image" />
										<Step Title="Run the container">
											<DescriptionTemplate>
												<div>
													<p>Click 'Run' and configure the following settings:</p>
													<ul style="margin-top: 8px;">
														<li><strong>Container name:</strong> automaton-runner</li>
														<li><strong>Environment variables:</strong></li>
													</ul>
													<div class="code-container" style="margin-top: 8px;">
														<Text Code Class="code-block">AUTOMATON_API_KEY=your_api_key</Text>
													</div>
													<div class="code-container" style="margin-top: 8px;">
														<Text Code Class="code-block">AUTOMATON_RUNNER_NAME=my-runner (optional)</Text>
													</div>
												</div>
											</DescriptionTemplate>
										</Step>
										<Step Title="Verify it's running" Description="The container should appear in the Containers tab with a green 'Running' status" />
									</Steps>

									<Alert Type="@AlertType.Info" ShowIcon="true" Style="margin-top: 24px;">
										<MessageTemplate>
											<strong>Tip:</strong> Enable "Restart policy: Unless stopped" in the container settings 
											so the runner automatically starts when Docker Desktop launches.
										</MessageTemplate>
									</Alert>
								</ChildContent>
							</TabPane>

							<!-- Docker Compose Tab -->
							<TabPane Key="compose">
								<TabTemplate>
									<Icon Type="cluster" Style="margin-right: 8px;" />
									Docker Compose
								</TabTemplate>
								<ChildContent>
									<Paragraph Type="@TextElementType.Secondary" Style="margin-bottom: 16px;">
										For production deployments or running multiple runners, use Docker Compose:
									</Paragraph>

									<div class="code-container" style="margin-bottom: 24px;">
										<pre class="code-block" style="margin: 0; white-space: pre-wrap;">@dockerComposeContent</pre>
										<Button Icon="copy" Size="@ButtonSize.Small" Style="position: absolute; top: 8px; right: 8px;" OnClick="@(() => CopyToClipboard(dockerComposeContent, "Docker Compose file"))">
										</Button>
									</div>

									<Space Direction="SpaceDirection.Vertical" Style="width: 100%;">
										<SpaceItem>
											<Text Strong>Start the runner:</Text>
											<div class="code-container" style="margin-top: 8px;">
												<div class="command-display">
													<Text Code Class="code-block">docker compose up -d</Text>
													<Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard("docker compose up -d", "Start command"))">
													</Button>
												</div>
											</div>
										</SpaceItem>
										<SpaceItem>
											<Text Strong>Stop the runner:</Text>
											<div class="code-container" style="margin-top: 8px;">
												<div class="command-display">
													<Text Code Class="code-block">docker compose down</Text>
													<Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard("docker compose down", "Stop command"))">
													</Button>
												</div>
											</div>
										</SpaceItem>
									</Space>

									<Alert Type="@AlertType.Warning" ShowIcon="true" Style="margin-top: 24px;">
										<MessageTemplate>
											Remember to create a <code>.env</code> file with your <code>AUTOMATON_API_KEY</code> 
											or replace <code>${AUTOMATON_API_KEY}</code> with your actual key in the compose file.
										</MessageTemplate>
									</Alert>
								</ChildContent>
							</TabPane>
						</Tabs>
					</ChildContent>
				</Card>
			</div>

			<!-- Prerequisites Info -->
			<Alert Type="@AlertType.Info" ShowIcon="true" Style="margin-bottom: 32px;">
				<MessageTemplate>
					<strong>Don't have Docker?</strong> Download Docker Desktop from 
					<a href="https://www.docker.com/products/docker-desktop/" target="_blank" rel="noopener noreferrer">docker.com</a> 
					(Windows, Mac, Linux) or install Docker Engine on Linux servers.
				</MessageTemplate>
			</Alert>

			<!-- Divider -->
			<Divider Style="margin: 48px 0;">
				<Text Type="@TextElementType.Secondary">Alternative Installation Methods</Text>
			</Divider>

			<!-- Native Executable Section -->
			<div id="executable-section">
				<Card Class="installation-card executable-install" Style="margin-bottom: 32px;">
					<TitleTemplate>
						<div style="display: flex; align-items: center; gap: 12px;">
							<Icon Type="download" Style="color: #52c41a; font-size: 20px;" />
							<span>Native Executable Installation</span>
							<Tag Color="@("blue")">Advanced</Tag>
						</div>
					</TitleTemplate>
					<ChildContent>
						<Paragraph Type="@TextElementType.Secondary" Style="margin-bottom: 24px;">
							Download and run the native executable if you prefer not to use Docker. 
							Note: You'll need to install Python 3.x separately for Python-based custom steps.
						</Paragraph>

						<Tabs DefaultActiveKey="quick" Type="@TabType.Card">
							<!-- Quick Install Tab -->
							<TabPane Key="quick">
								<TabTemplate>
									<Icon Type="thunderbolt" Style="margin-right: 8px;" />
									Quick Install
								</TabTemplate>
								<ChildContent>
									<Row Gutter="24">
										<Col Xs="24" Lg="12">
										<Card Size="@CardSize.Small" Style="height: 100%;">
											<TitleTemplate>
												<Icon Type="windows" Style="margin-right: 8px;" />
												Windows (PowerShell)
											</TitleTemplate>
											<ChildContent>
												<Paragraph Type="@TextElementType.Secondary" Style="margin-bottom: 12px;">
													Run as Administrator:
												</Paragraph>
												<div class="code-container">
													<div class="command-display">
														<Text Code Class="code-block">@windowsInstallCommand</Text>
														<Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard(windowsInstallCommand, "Windows install command"))">
														</Button>
													</div>
												</div>
											</ChildContent>
										</Card>
										</Col>
										<Col Xs="24" Lg="12">
										<Card Size="@CardSize.Small" Style="height: 100%;">
											<TitleTemplate>
												<Space>
													<SpaceItem><Icon Type="linux" /></SpaceItem>
													<SpaceItem><Icon Type="apple" /></SpaceItem>
												</Space>
												<span style="margin-left: 8px;">Linux / macOS</span>
											</TitleTemplate>
											<ChildContent>
												<Paragraph Type="@TextElementType.Secondary" Style="margin-bottom: 12px;">
													Run in terminal:
												</Paragraph>
												<div class="code-container">
													<div class="command-display">
														<Text Code Class="code-block">@unixInstallCommand</Text>
														<Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard(unixInstallCommand, "Unix install command"))">
														</Button>
													</div>
												</div>
											</ChildContent>
										</Card>
										</Col>
									</Row>
								</ChildContent>
							</TabPane>

							<!-- Manual Download Tab -->
							<TabPane Key="manual">
								<TabTemplate>
									<Icon Type="file-zip" Style="margin-right: 8px;" />
									Manual Download
								</TabTemplate>
								<ChildContent>
									<Row Gutter="16">
										<Col Xs="24" Sm="8">
										<Card Size="@CardSize.Small">
											<TitleTemplate>
												<Icon Type="windows" Style="margin-right: 4px;" />
												Windows
											</TitleTemplate>
											<ChildContent>
												<Space Direction="SpaceDirection.Vertical" Style="width: 100%;">
													<SpaceItem>
														<DownloadButton Url="@runnerWindowsX64Url" FileName="automaton-runner-win-x64.zip" Block="true">
															x64 (.zip)
														</DownloadButton>
													</SpaceItem>
													<SpaceItem>
														<DownloadButton Url="@runnerWindowsArm64Url" FileName="automaton-runner-win-arm64.zip" Block="true">
															ARM64 (.zip)
														</DownloadButton>
													</SpaceItem>
													<SpaceItem>
														<Paragraph Type="@TextElementType.Secondary" Style="font-size: 12px; text-align: center;">
															~30 MB each
														</Paragraph>
													</SpaceItem>
												</Space>
											</ChildContent>
										</Card>
										</Col>
										<Col Xs="24" Sm="8">
										<Card Size="@CardSize.Small">
											<TitleTemplate>
												<Icon Type="linux" Style="margin-right: 4px;" />
												Linux
											</TitleTemplate>
											<ChildContent>
												<Space Direction="SpaceDirection.Vertical" Style="width: 100%;">
													<SpaceItem>
														<DownloadButton Url="@runnerLinuxX64Url" FileName="automaton-runner-linux-x64.tar.gz" Block="true">
															x64 (.tar.gz)
														</DownloadButton>
													</SpaceItem>
													<SpaceItem>
														<DownloadButton Url="@runnerLinuxArm64Url" FileName="automaton-runner-linux-arm64.tar.gz" Block="true">
															ARM64 (.tar.gz)
														</DownloadButton>
													</SpaceItem>
													<SpaceItem>
														<Paragraph Type="@TextElementType.Secondary" Style="font-size: 12px; text-align: center;">
															~25 MB each
														</Paragraph>
													</SpaceItem>
												</Space>
											</ChildContent>
										</Card>
										</Col>
										<Col Xs="24" Sm="8">
										<Card Size="@CardSize.Small">
											<TitleTemplate>
												<Icon Type="apple" Style="margin-right: 4px;" />
												macOS
											</TitleTemplate>
											<ChildContent>
												<Space Direction="SpaceDirection.Vertical" Style="width: 100%;">
													<SpaceItem>
														<DownloadButton Url="@runnerMacosX64Url" FileName="automaton-runner-macos-x64.tar.gz" Block="true">
															Intel (.tar.gz)
														</DownloadButton>
													</SpaceItem>
													<SpaceItem>
														<DownloadButton Url="@runnerMacosArm64Url" FileName="automaton-runner-macos-arm64.tar.gz" Block="true">
															Apple Silicon (.tar.gz)
														</DownloadButton>
													</SpaceItem>
													<SpaceItem>
														<Paragraph Type="@TextElementType.Secondary" Style="font-size: 12px; text-align: center;">
															~25 MB each
														</Paragraph>
													</SpaceItem>
												</Space>
											</ChildContent>
										</Card>
										</Col>
									</Row>
									<Paragraph Type="@TextElementType.Secondary" Style="margin-top: 24px;">
										After download: Extract the archive and run <code>automaton-runner</code> to start configuration.
									</Paragraph>
								</ChildContent>
							</TabPane>
						</Tabs>
					</ChildContent>
				</Card>

				<!-- Service Installation -->
				<Card Class="installation-card service-install" Style="margin-bottom: 32px;">
					<TitleTemplate>
						<div style="display: flex; align-items: center; gap: 12px;">
							<Icon Type="setting" Style="color: #722ed1; font-size: 20px;" />
							<span>Run as System Service</span>
							<Tag Color="@("purple")">Production</Tag>
						</div>
					</TitleTemplate>
					<ChildContent>
						<Paragraph Type="@TextElementType.Secondary" Style="margin-bottom: 24px;">
							For production deployments without Docker, configure the runner to start automatically as a system service.
						</Paragraph>

						<Alert Type="@AlertType.Warning" ShowIcon="true" Style="margin-bottom: 24px;">
							<MessageTemplate>
								<strong>Prerequisite:</strong> Run the runner manually first (<code>automaton-runner</code>) to complete initial setup 
								(API key, server URL, runner name) before installing as a service.
							</MessageTemplate>
						</Alert>

						<Tabs DefaultActiveKey="windows" Type="@TabType.Card">
							<!-- Windows Service -->
							<TabPane Key="windows">
								<TabTemplate>
									<Icon Type="windows" Style="margin-right: 8px;" />
									Windows (NSSM)
								</TabTemplate>
								<ChildContent>
									<Collapse DefaultActiveKey="@(new[] { "auto" })">
										<Panel Header="Automatic Setup (Recommended)" Key="auto">
											<Paragraph Type="@TextElementType.Secondary" Style="margin-bottom: 16px;">
												Run this command in PowerShell as Administrator:
											</Paragraph>
											<div class="code-container">
												<div class="command-display">
													<Text Code Class="code-block">@windowsServiceCommand</Text>
													<Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard(windowsServiceCommand, "Windows service command"))">
													</Button>
												</div>
											</div>
											<Paragraph Type="@TextElementType.Secondary" Style="margin-top: 16px;">
												This script will:
											</Paragraph>
											<ul>
												<li>Download and install NSSM (Non-Sucking Service Manager)</li>
												<li>Register the runner as a Windows service</li>
												<li>Configure automatic startup</li>
												<li>Start the service</li>
											</ul>
										</Panel>
										<Panel Header="Manual Setup" Key="manual">
											<Steps Direction="@StepsDirection.Vertical" Current="99" Size="@StepsSize.Small">
												<Step Title="Download NSSM" Description="Download from nssm.cc and extract to a permanent location" />
												<Step Title="Install the service">
													<DescriptionTemplate>
														<div class="code-container" style="margin-top: 8px;">
															<Text Code Class="code-block">nssm install AutomatonRunner "C:\path\to\automaton-runner.exe"</Text>
														</div>
													</DescriptionTemplate>
												</Step>
												<Step Title="Configure environment">
													<DescriptionTemplate>
														<div class="code-container" style="margin-top: 8px;">
															<Text Code Class="code-block">nssm set AutomatonRunner AppEnvironmentExtra AUTOMATON_API_KEY=your_key</Text>
														</div>
													</DescriptionTemplate>
												</Step>
												<Step Title="Start the service">
													<DescriptionTemplate>
														<div class="code-container" style="margin-top: 8px;">
															<Text Code Class="code-block">nssm start AutomatonRunner</Text>
														</div>
													</DescriptionTemplate>
												</Step>
											</Steps>
										</Panel>
									</Collapse>
								</ChildContent>
							</TabPane>

							<!-- Linux Service -->
							<TabPane Key="linux">
								<TabTemplate>
									<Icon Type="linux" Style="margin-right: 8px;" />
									Linux (systemd)
								</TabTemplate>
								<ChildContent>
									<Collapse DefaultActiveKey="@(new[] { "auto" })">
										<Panel Header="Automatic Setup (Recommended)" Key="auto">
