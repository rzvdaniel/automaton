@page "/downloads"
@using Microsoft.AspNetCore.Components
@using Automaton.Studio.Services
@inject IJSRuntime JSRuntime
@inject ConfigurationService ConfigService
@inject NavigationManager NavigationManager
@inject MessageService MessageService

<PageTitle>Downloads - Automaton Studio</PageTitle>

<Layout>
	<Header Class="header">
		<Row>
			<Col Flex=@("none")>
			<Space Size="SpaceSize.Large">
				<SpaceItem Class="header-item">
					<Breadcrumb>
						<BreadcrumbItem Href="/">
							<Icon Type="home" Width="16" Height="16" />
							<span>Home</span>
						</BreadcrumbItem>
						<BreadcrumbItem>
							<Icon Type="download" Width="16" Height="16" />
							<span>Downloads</span>
						</BreadcrumbItem>
					</Breadcrumb>
				</SpaceItem>
			</Space>
			</Col>
			<Col Class="right-actions">
			<Space>
				<SpaceItem>
					<Button Type="@ButtonType.Primary" OnClick="@(() => NavigationManager.NavigateTo("/onboarding"))">
						<Icon Type="question-circle" />
						Get Started
					</Button>
				</SpaceItem>
			</Space>
			</Col>
		</Row>
	</Header>

	<Content Class="content-padding home-content content-background">
		<div class="home-container">

			<!-- Hero Section -->
			<div class="downloads-hero">
				<div class="hero-content">
					<div class="hero-badge">
						<Icon Type="lightning" Style="font-size: 24px; color: #fff;" />
						<span>One Command Setup</span>
					</div>
					<h1>Automaton Runner</h1>
					<p class="hero-subtitle">Execute your automation workflows anywhere</p>
					<p class="hero-description">
						Cross-platform command-line runner for workflow automation. Deploy on servers, CI/CD pipelines, Docker, or as a system service.
					</p>
				</div>
			</div>

			<!-- Key Features -->
			<Row Gutter="24" Style="margin-bottom: 48px;">
				<Col Xs="24" Sm="12" Md="6">
				<Card Class="feature-card">
					<ChildContent>
						<div class="feature-icon">
							<Icon Type="desktop" Style="font-size: 32px; color: #1890ff;" />
						</div>
						<div class="feature-content">
							<Title Level="5">Cross-Platform</Title>
							<Paragraph Type="@TextElementType.Secondary">
								Windows, Linux, and macOS support with native performance
							</Paragraph>
						</div>
					</ChildContent>
				</Card>
				</Col>
				<Col Xs="24" Sm="12" Md="6">
				<Card Class="feature-card">
					<ChildContent>
						<div class="feature-icon">
							<Icon Type="rocket" Style="font-size: 32px; color: #52c41a;" />
						</div>
						<div class="feature-content">
							<Title Level="5">One-Command Setup</Title>
							<Paragraph Type="@TextElementType.Secondary">
								Fully automated installation with interactive configuration
							</Paragraph>
						</div>
					</ChildContent>
				</Card>
				</Col>
				<Col Xs="24" Sm="12" Md="6">
				<Card Class="feature-card">
					<ChildContent>
						<div class="feature-icon">
							<Icon Type="cloud" Style="font-size: 32px; color: #faad14;" />
						</div>
						<div class="feature-content">
							<Title Level="5">Cloud & Docker Ready</Title>
							<Paragraph Type="@TextElementType.Secondary">
								Deploy on any cloud provider or containerized environment
							</Paragraph>
						</div>
					</ChildContent>
				</Card>
				</Col>
				<Col Xs="24" Sm="12" Md="6">
				<Card Class="feature-card">
					<ChildContent>
						<div class="feature-icon">
							<Icon Type="api" Style="font-size: 32px, color: #722ed1;" />
						</div>
						<div class="feature-content">
							<Title Level="5">Secure & Reliable</Title>
							<Paragraph Type="@TextElementType.Secondary">
								API key authentication with auto-recovery and reconnection
							</Paragraph>
						</div>
					</ChildContent>
				</Card>
				</Col>
			</Row>

			<!-- Quick Installation -->
			<Card Class="installation-card quick-install" Style="margin-bottom: 32px;">
				<TitleTemplate>
					<Icon Type="rocket" Style="margin-right: 8px; color: #52c41a;" />
					<span>Quick Installation (Recommended)</span>
				</TitleTemplate>
				<ChildContent>
					<Paragraph Type="@TextElementType.Secondary" Style="margin-bottom: 24px;">
						One command to download, install, and configure the runner for immediate use:
					</Paragraph>

					<Row Gutter="16" Style="margin-bottom: 24px;">
						<Col Xs="24" Sm="12">
						<Card Size="@CardSize.Small" Class="install-method-card">
							<TitleTemplate>
								<Icon Type="windows" Style="margin-right: 8px;" />
								<span>Windows (PowerShell)</span>
							</TitleTemplate>
							<ChildContent>
								<Paragraph Type="@TextElementType.Secondary" Style="font-size: 12px; margin-bottom: 12px;">
									Run as Administrator in PowerShell
								</Paragraph>
								<div class="code-container">
									<div class="command-display">
										<Text Code Class="code-block">@windowsInstallCommand</Text>
										<Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard(windowsInstallCommand, "Windows install command"))">
										</Button>
									</div>
								</div>
								<Alert Type="@AlertType.Info" ShowIcon="true" Style="margin-top: 12px; margin-bottom: 12px;">
									<MessageTemplate>
										<strong>💡 Tip:</strong> You can also <a href="/downloads/runner/install.ps1" download="install.ps1">download the script</a> and run it locally: <code>.\install.ps1</code>
									</MessageTemplate>
								</Alert>
							</ChildContent>
						</Card>
						</Col>
						<Col Xs="24" Sm="12">
						<Card Size="@CardSize.Small" Class="install-method-card">
							<TitleTemplate>
								<Icon Type="code" Style="margin-right: 8px;" />
								<span>Linux / macOS</span>
							</TitleTemplate>
							<ChildContent>
								<Paragraph Type="@TextElementType.Secondary" Style="font-size: 12px; margin-bottom: 12px;">
									Run in your terminal (bash or zsh)
								</Paragraph>
								<div class="code-container">
									<div class="command-display">
										<Text Code Class="code-block">@unixInstallCommand</Text>
										<Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard(unixInstallCommand, "Unix install command"))">
										</Button>
									</div>
								</div>
								<Alert Type="@AlertType.Info" ShowIcon="true" Style="margin-top: 12px; margin-bottom: 12px;">
									<MessageTemplate>
										<strong>💡 Tip:</strong> You can also <a href="/downloads/runner/install.sh" download="install.sh">download the script</a> and run it locally: <code>./install.sh</code>
									</MessageTemplate>
								</Alert>
							</ChildContent>
						</Card>
						</Col>
					</Row>

					<Alert Type="@AlertType.Success" ShowIcon="true" Style="margin-bottom: 24px;">
						<MessageTemplate>
							<strong>✨ After installation:</strong> Run <code>automaton-runner</code> to start your workflow runner. The runner will interactively guide you through configuration with your API key.
						</MessageTemplate>
					</Alert>
				</ChildContent>
			</Card>

			<!-- Service Installation Option -->
			<Card Class="installation-card service-install" Style="margin-bottom: 32px;">
				<TitleTemplate>
					<Icon Type="cluster" Style="margin-right: 8px; color: #1890ff;" />
					<span>Production Setup: Run as System Service</span>
				</TitleTemplate>
				<ChildContent>
					<Paragraph Type="@TextElementType.Secondary" Style="margin-bottom: 24px;">
						For production deployments, run the runner as a background system service. It will automatically start on system boot and restart on failures.
					</Paragraph>

					<Tabs DefaultActiveKey="windows-service">
						<TabPane Key="windows-service" Tab="@("Windows (NSSM)")">
							<Paragraph Type="@TextElementType.Secondary" Style="margin-bottom: 16px;">
								Windows uses NSSM (Non-Sucking Service Manager) to run the runner as a service. We provide an automated setup script that handles everything for you.
							</Paragraph>

							<Collapse Accordion="true" DefaultActiveKey="@(new string[] { "auto" })">
								<Panel Header="Automatic Setup (Recommended)" Key="auto">
									<Paragraph Type="@TextElementType.Secondary" Style="margin-bottom: 12px;">
										Run this script to automatically configure the Windows service. It will detect your existing configuration:
									</Paragraph>
									<div class="code-container">
										<div class="command-display">
											<Text Code Class="code-block">@windowsServiceCommand</Text>
											<Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard(@windowsServiceCommand, "Windows service setup command"))">
											</Button>
										</div>
									</div>

									<Alert Type="@AlertType.Info" ShowIcon="true" Style="margin-top: 12px; margin-bottom: 12px;">
										<MessageTemplate>
											<strong>💡 Tip:</strong> You can also <a href="/downloads/runner/setup-service.ps1" download="setup-service.ps1">download the script</a> and run it locally: <code>.\setup-service.ps1</code>
										</MessageTemplate>
									</Alert>

									<Alert Type="@AlertType.Success" ShowIcon="true" Style="margin-top: 16px;">
										<MessageTemplate>
											<strong>✅ What the script does:</strong><br/>
											• Auto-detects your API key from environment variables<br/>
											• Detects your runner registration (name and ID)<br/>
											• Detects your configured server URL<br/>
											• Downloads and installs NSSM if needed<br/>
											• Creates the Windows service with optimal settings<br/>
											• Optionally starts the service immediately
										</MessageTemplate>
									</Alert>

									<Paragraph Type="@TextElementType.Secondary" Style="margin-top: 16px;">
										<strong>Requirements:</strong>
									</Paragraph>
									<ul>
										<li>Run the runner once first: <code>automaton-runner</code></li>
										<li>This configures your API key, server URL, and runner name</li>
										<li>Then run the setup-service script with Administrator privileges</li>
									</ul>
								</Panel>

								<Panel Header="Manual Setup (Advanced)" Key="manual">
									<Paragraph Type="@TextElementType.Secondary" Style="margin-bottom: 16px;">
										If you prefer to set up the service manually, use these steps:
									</Paragraph>

									<Collapse Accordion="true">
										<Panel Header="Step 1: Install NSSM (One-time setup)" Key="1">
											<Paragraph Type="@TextElementType.Secondary" Style="margin-bottom: 12px;">
												NSSM is a service manager tool. Install it using Chocolatey (easiest):
											</Paragraph>
											<div class="code-container">
												<div class="command-display">
													<Text Code Class="code-block">choco install nssm</Text>
													<Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard("choco install nssm", "Install NSSM command"))">
													</Button>
												</div>
											</div>
											<Paragraph Type="@TextElementType.Secondary" Style="margin-top: 16px;">
												Or download manually from <a href="https://nssm.cc/download" target="_blank">nssm.cc</a>
											</Paragraph>
										</Panel>
										<Panel Header="Step 2: Create the Service" Key="2">
											<Paragraph Type="@TextElementType.Secondary" Style="margin-bottom: 12px;">
												After running <code>automaton-runner</code> once to configure, create the service (Run PowerShell as Administrator):
											</Paragraph>
											<div class="code-container">
												<div class="command-display">
													<Text Code Class="code-block">nssm install AutomatonRunner "C:\Program Files\Automaton\Runner\automaton-runner.exe"</Text>
													<Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard("nssm install AutomatonRunner \"C:\\Program Files\\Automaton\\Runner\\automaton-runner.exe\"", "Create service command"))">
													</Button>
													<Alert Type="@AlertType.Warning" ShowIcon="true" Style="margin-top: 12px;">
														<MessageTemplate>
															Please ensure the path to <code>automaton-runner.exe</code> is correct. Adjust if needed.
														</MessageTemplate>
													</Alert>
												</div>
											</div>
										</Panel>
										<Panel Header="Step 3: Configure Auto-Start" Key="3">
											<Paragraph Type="@TextElementType.Secondary" Style="margin-bottom: 12px;">
												Enable automatic startup on system boot:
											</Paragraph>
											<div class="code-container">
												<div class="command-display">
													<Text Code Class="code-block">nssm set AutomatonRunner Start SERVICE_AUTO_START</Text>
													<Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard("nssm set AutomatonRunner Start SERVICE_AUTO_START", "Enable auto-start command"))">
													</Button>
												</div>
											</div>
										</Panel>
										<Panel Header="Step 4: Start the Service" Key="4">
											<Paragraph Type="@TextElementType.Secondary" Style="margin-bottom: 12px;">
												Start the service now:
											</Paragraph>
											<div class="code-container">
												<div class="command-display">
													<Text Code Class="code-block">nssm start AutomatonRunner</Text>
													<Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard("nssm start AutomatonRunner", "Start service command"))">
													</Button>
												</div>
											</div>
											<Paragraph Type="@TextElementType.Secondary" Style="margin-top: 16px;">
												Check status:
											</Paragraph>
											<div class="code-container">
												<div class="command-display">
													<Text Code Class="code-block">nssm status AutomatonRunner</Text>
													<Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard("nssm status AutomatonRunner", "Check status command"))">
													</Button>
												</div>
											</div>
										</Panel>
									</Collapse>
								</Panel>
							</Collapse>
						</TabPane>

						<TabPane Key="linux-service" Tab="@("Linux (systemd)")">
							<Paragraph Type="@TextElementType.Secondary" Style="margin-bottom: 16px;">
								Linux uses systemd for service management. We provide an automated setup script that handles everything for you.
							</Paragraph>

							<Collapse Accordion="true" DefaultActiveKey="@(new string[] { "auto" })">
								<Panel Header="Automatic Setup (Recommended)" Key="auto">
									<Paragraph Type="@TextElementType.Secondary" Style="margin-bottom: 12px;">
										Run this script with sudo to automatically configure the systemd service. It will detect your existing configuration:
									</Paragraph>
									<div class="code-container">
										<div class="command-display">
											<Text Code Class="code-block">@unixServiceCommand</Text>
											<Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard(@unixServiceCommand, "Linux service setup command"))">
											</Button>
										</div>
									</div>

									<Alert Type="@AlertType.Info" ShowIcon="true" Style="margin-top: 12px; margin-bottom: 12px;">
										<MessageTemplate>
											<strong>💡 Tip:</strong> You can also <a href="/downloads/runner/setup-service.sh" download="setup-service.sh">download the script</a> and run it locally: <code>sudo ./setup-service.sh</code>
										</MessageTemplate>
									</Alert>

									<Alert Type="@AlertType.Success" ShowIcon="true" Style="margin-top: 16px;">
										<MessageTemplate>
											<strong>✅ What the script does:</strong><br/>
											• Auto-detects your API key from environment variables<br/>
											• Detects your runner registration (name and ID)<br/>
											• Detects your configured server URL<br/>
											• Creates the systemd service file<br/>
											• Enables auto-start on system boot<br/>
											• Optionally starts the service immediately
										</MessageTemplate>
									</Alert>

									<Paragraph Type="@TextElementType.Secondary" Style="margin-top: 16px;">
										<strong>Requirements:</strong>
									</Paragraph>
									<ul>
										<li>Run the runner once first: <code>automaton-runner</code></li>
										<li>This configures your API key, server URL, and runner name</li>
										<li>Then run the setup-service script with sudo privileges</li>
									</ul>
								</Panel>

								<Panel Header="Manual Setup (Advanced)" Key="manual">
									<Paragraph Type="@TextElementType.Secondary" Style="margin-bottom: 16px;">
										If you prefer to set up the service manually, use these steps:
									</Paragraph>

									<Collapse Accordion="true">
										<Panel Header="Step 1: Create Service File" Key="1">
											<Paragraph Type="@TextElementType.Secondary" Style="margin-bottom: 12px;">
												Create the systemd service file:
											</Paragraph>
											<div class="code-container">
												<div class="command-display">
													<Text Code Class="code-block">sudo nano /etc/systemd/system/automaton-runner.service</Text>
													<Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard("sudo nano /etc/systemd/system/automaton-runner.service", "Create service file command"))">
													</Button>
												</div>
											</div>
											<Paragraph Type="@TextElementType.Secondary" Style="margin-top: 12px;">
												Add this content (replace YOUR_USERNAME):
											</Paragraph>
											<div class="code-container" Style="max-height: 300px; overflow-y: auto;">
												<Text Code Class="code-block">@linuxServiceContent</Text>
											</div>
										</Panel>
										<Panel Header="Step 2: Enable and Start Service" Key="2">
											<Paragraph Type="@TextElementType.Secondary" Style="margin-bottom: 12px;">
												Load and enable the service:
											</Paragraph>
											<div class="code-container">
												<div class="command-display">
													<Text Code Class="code-block">sudo systemctl daemon-reload</Text>
													<Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard("sudo systemctl daemon-reload", "Reload systemd command"))">
													</Button>
												</div>
											</div>
											<Paragraph Type="@TextElementType.Secondary" Style="margin-top: 12px;">
												Enable auto-start:
                                            </Paragraph>
                                            <div class="code-container">
                                                <div class="command-display">
                                                    <Text Code Class="code-block">sudo systemctl enable automaton-runner</Text>
                                                    <Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard("sudo systemctl enable automaton-runner", "Enable auto-start command"))">
                                                    </Button>
                                                </div>
                                            </div>
                                            <Paragraph Type="@TextElementType.Secondary" Style="margin-top: 12px;">
												Start the service:
                                            </Paragraph>
                                            <div class="code-container">
                                                <div class="command-display">
                                                    <Text Code Class="code-block">sudo systemctl start automaton-runner</Text>
                                                    <Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard("sudo systemctl start automaton-runner", "Start service command"))">
                                                    </Button>
                                                </div>
                                            </div>
										</Panel>
										<Panel Header="Step 3: Monitor the Service" Key="3">
											<Paragraph Type="@TextElementType.Secondary" Style="margin-bottom: 12px;">
												Check status:
											</Paragraph>
											<div class="code-container">
												<div class="command-display">
													<Text Code Class="code-block">sudo systemctl status automaton-runner</Text>
													<Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard("sudo systemctl status automaton-runner", "Check status command"))">
													</Button>
												</div>
											</div>
											<Paragraph Type="@TextElementType.Secondary" Style="margin-top: 12px;">
												View real-time logs:
											</Paragraph>
											<div class="code-container">
												<div class="command-display">
													<Text Code Class="code-block">sudo journalctl -u automaton-runner -f</Text>
													<Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard("sudo journalctl -u automaton-runner -f", "View logs command"))">
													</Button>
												</div>
											</div>
										</Panel>
									</Collapse>
								</Panel>
							</Collapse>
						</TabPane>

						<TabPane Key="macos-service" Tab="@("macOS (launchd)")">
							<Paragraph Type="@TextElementType.Secondary" Style="margin-bottom: 16px;">
								macOS uses launchd for service management. We provide an automated setup script that handles everything for you.
							</Paragraph>

							<Collapse Accordion="true" DefaultActiveKey="@(new string[] { "auto" })">
								<Panel Header="Automatic Setup (Recommended)" Key="auto">
									<Paragraph Type="@TextElementType.Secondary" Style="margin-bottom: 12px;">
										Run this script with sudo to automatically configure the launchd service. It will detect your existing configuration:
									</Paragraph>
									<div class="code-container">
										<div class="command-display">
											<Text Code Class="code-block">@unixServiceCommand</Text>
											<Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard(@unixServiceCommand, "macOS service setup command"))">
											</Button>
										</div>
									</div>

									<Alert Type="@AlertType.Info" ShowIcon="true" Style="margin-top: 12px; margin-bottom: 12px;">
										<MessageTemplate>
											<strong>💡 Tip:</strong> You can also <a href="/downloads/runner/setup-service.sh" download="setup-service.sh">download the script</a> and run it locally: <code>sudo ./setup-service.sh</code>
										</MessageTemplate>
									</Alert>

									<Alert Type="@AlertType.Success" ShowIcon="true" Style="margin-top: 16px;">
										<MessageTemplate>
											<strong>✅ What the script does:</strong><br/>
											• Auto-detects your API key from environment variables<br/>
											• Detects your runner registration (name and ID)<br/>
											• Detects your configured server URL<br/>
											• Creates the launchd plist file<br/>
											• Sets correct permissions<br/>
											• Loads the daemon<br/>
											• Optionally starts the service immediately
										</MessageTemplate>
									</Alert>

									<Paragraph Type="@TextElementType.Secondary" Style="margin-top: 16px;">
										<strong>Requirements:</strong>
									</Paragraph>
									<ul>
										<li>Run the runner once first: <code>automaton-runner</code></li>
										<li>This configures your API key, server URL, and runner name</li>
										<li>Then run the setup-service script with sudo privileges</li>
									</ul>
								</Panel>

								<Panel Header="Manual Setup (Advanced)" Key="manual">
									<Paragraph Type="@TextElementType.Secondary" Style="margin-bottom: 16px;">
										If you prefer to set up the service manually, use these steps:
									</Paragraph>

									<Collapse Accordion="true">
										<Panel Header="Step 1: Create Launch Daemon" Key="1">
											<Paragraph Type="@TextElementType.Secondary" Style="margin-bottom: 12px;">
												Create the launch daemon plist file:
											</Paragraph>
											<div class="code-container">
												<div class="command-display">
													<Text Code Class="code-block">sudo nano /Library/LaunchDaemons/com.automaton.runner.plist</Text>
													<Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard("sudo nano /Library/LaunchDaemons/com.automaton.runner.plist", "Create plist file command"))">
													</Button>
												</div>
											</div>
											<Paragraph Type="@TextElementType.Secondary" Style="margin-top: 12px;">
												Add this content:
											</Paragraph>
											<div class="code-container" Style="max-height: 400px; overflow-y: auto;">
												<Text Code Class="code-block">@macosServiceContent</Text>
											</div>
										</Panel>
										<Panel Header="Step 2: Set Permissions" Key="2">
											<Paragraph Type="@TextElementType.Secondary" Style="margin-bottom: 12px;">
												Set correct file permissions:
											</Paragraph>
											<div class="code-container">
												<div class="command-display">
													<Text Code Class="code-block">sudo chown root:wheel /Library/LaunchDaemons/com.automaton.runner.plist && sudo chmod 644 /Library/LaunchDaemons/com.automaton.runner.plist</Text>
													<Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard("sudo chown root:wheel /Library/LaunchDaemons/com.automaton.runner.plist && sudo chmod 644 /Library/LaunchDaemons/com.automaton.runner.plist", "Set permissions command"))">
													</Button>
												</div>
											</div>
										</Panel>
										<Panel Header="Step 3: Load and Start" Key="3">
											<Paragraph Type="@TextElementType.Secondary" Style="margin-bottom: 12px;">
												Load the daemon:
											</Paragraph>
											<div class="code-container">
												<div class="command-display">
													<Text Code Class="code-block">sudo launchctl load /Library/LaunchDaemons/com.automaton.runner.plist</Text>
													<Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard("sudo launchctl load /Library/LaunchDaemons/com.automaton.runner.plist", "Load daemon command"))">
													</Button>
												</div>
											</div>
											<Paragraph Type="@TextElementType.Secondary" Style="margin-top: 12px;">
												Verify it's running:
											</Paragraph>
											<div class="code-container">
												<div class="command-display">
													<Text Code Class="code-block">sudo launchctl list | grep automaton</Text>
													<Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard("sudo launchctl list | grep automaton", "Check daemon command"))">
													</Button>
												</div>
											</div>
										</Panel>
										<Panel Header="Step 4: Monitor Logs" Key="4">
											<Paragraph Type="@TextElementType.Secondary" Style="margin-bottom: 12px;">
												View logs in real-time:
											</Paragraph>
											<div class="code-container">
												<div class="command-display">
													<Text Code Class="code-block">tail -f /var/log/automaton-runner.log</Text>
													<Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard("tail -f /var/log/automaton-runner.log", "View logs command"))">
													</Button>
												</div>
											</div>
										</Panel>
									</Collapse>
								</Panel>
							</Collapse>
						</TabPane>
					</Tabs>
				</ChildContent>
			</Card>

			<!-- Manual Installation -->
			<Card Class="installation-card manual-install">
				<TitleTemplate>
					<Icon Type="file-zip" Style="margin-right: 8px; color: #faad14;" />
					<span>Manual Installation</span>
				</TitleTemplate>
				<ChildContent>
					<Paragraph Type="@TextElementType.Secondary" Style="margin-bottom: 24px;">
						Download binaries directly if you prefer manual installation or need custom deployment:
					</Paragraph>

					<Row Gutter="16">
						<Col Xs="24" Sm="8">
						<Card Size="@CardSize.Small">
							<TitleTemplate>
								<Icon Type="windows" Style="margin-right: 4px;" />
								Windows
							</TitleTemplate>
							<ChildContent>
								<Space Direction="SpaceDirection.Vertical" Style="width: 100%;">
									<SpaceItem>
										<DownloadButton Url="@runnerWindowsX64Url" FileName="automaton-runner-win-x64.zip" Block="true">
											x64 (.zip)
										</DownloadButton>
									</SpaceItem>
									<SpaceItem>
										<DownloadButton Url="@runnerWindowsArm64Url" FileName="automaton-runner-win-arm64.zip" Block="true">
											ARM64 (.zip)
										</DownloadButton>
									</SpaceItem>
									<SpaceItem>
										<Paragraph Type="@TextElementType.Secondary" Style="font-size: 12px; text-align: center;">
											~30 MB each
										</Paragraph>
									</SpaceItem>
								</Space>
							</ChildContent>
						</Card>
						</Col>
						<Col Xs="24" Sm="8">
						<Card Size="@CardSize.Small">
							<TitleTemplate>
								<Icon Type="linux" Style="margin-right: 4px;" />
								Linux
							</TitleTemplate>
							<ChildContent>
								<Space Direction="SpaceDirection.Vertical" Style="width: 100%;">
									<SpaceItem>
										<DownloadButton Url="@runnerLinuxX64Url" FileName="automaton-runner-linux-x64.tar.gz" Block="true">
											x64 (.tar.gz)
										</DownloadButton>
									</SpaceItem>
									<SpaceItem>
										<DownloadButton Url="@runnerLinuxArm64Url" FileName="automaton-runner-linux-arm64.tar.gz" Block="true">
											ARM64 (.tar.gz)
										</DownloadButton>
									</SpaceItem>
									<SpaceItem>
										<Paragraph Type="@TextElementType.Secondary" Style="font-size: 12px; text-align: center;">
											~25 MB each
										</Paragraph>
									</SpaceItem>
								</Space>
							</ChildContent>
						</Card>
						</Col>
						<Col Xs="24" Sm="8">
						<Card Size="@CardSize.Small">
							<TitleTemplate>
								<Icon Type="apple" Style="margin-right: 4px;" />
								macOS
							</TitleTemplate>
							<ChildContent>
								<Space Direction="SpaceDirection.Vertical" Style="width: 100%;">
									<SpaceItem>
										<DownloadButton Url="@runnerMacosX64Url" FileName="automaton-runner-macos-x64.tar.gz" Block="true">
											Intel (.tar.gz)
										</DownloadButton>
									</SpaceItem>
									<SpaceItem>
										<DownloadButton Url="@runnerMacosArm64Url" FileName="automaton-runner-macos-arm64.tar.gz" Block="true">
											Apple Silicon (.tar.gz)
										</DownloadButton>
									</SpaceItem>
									<SpaceItem>
										<Paragraph Type="@TextElementType.Secondary" Style="font-size: 12px; text-align: center;">
											~25 MB each
										</Paragraph>
									</SpaceItem>
								</Space>
							</ChildContent>
						</Card>
						</Col>
					</Row>

					<Paragraph Type="@TextElementType.Secondary" Style="margin-top: 24px;">
						After download: Extract the archive and run <code>automaton-runner</code> to start configuration.
					</Paragraph>
				</ChildContent>
			</Card>

			<!-- Documentation Link -->
			<div Style="margin-top: 48px; text-align: center; padding: 32px; background: linear-gradient(135deg, #f0f9ff 0%, #ffffff 100%); border-radius: 12px;">
				<Icon Type="book" Style="font-size: 48px; color: #1890ff; margin-bottom: 16px;" />
				<Title Level="3" Style="margin-bottom: 8px;">Need More Information?</Title>
				<Paragraph Type="@TextElementType.Secondary" Style="margin-bottom: 24px;">
					Check out our comprehensive documentation for advanced configuration, troubleshooting, and best practices
				</Paragraph>
				<Button Type="@ButtonType.Primary" Size="@ButtonSize.Large" OnClick="@(() => NavigationManager.NavigateTo("/docs/#/user-guide/runner-setup"))">
					<Icon Type="book" />
					View Complete Runner Guide
				</Button>
			</div>
		</div>
	</Content>
</Layout>

@code {
	// Runner URLs
	private string windowsInstallCommand = "";
	private string unixInstallCommand = "";
	private string windowsServiceCommand  = "";
	private string unixServiceCommand = "";
	private string runnerWindowsX64Url = "";
	private string runnerWindowsArm64Url = "";
	private string runnerLinuxX64Url = "";
	private string runnerLinuxArm64Url = "";
	private string runnerMacosX64Url = "";
	private string runnerMacosArm64Url = "";

	// Service configuration content
	private string linuxServiceContent = @"[Unit]
Description=Automaton Runner
After=network.target
Wants=network.target

[Service]
Type=simple
User=YOUR_USERNAME
WorkingDirectory=/home/YOUR_USERNAME
Environment=""AppConfig__BaseUrl=https://studio.automaton.monster""
Environment=""AUTOMATON_API_KEY=ak_your_api_key_here""
ExecStart=/usr/local/bin/automaton-runner
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target";

	private string macosServiceContent = @"<?xml version=""1.0"" encoding=""UTF-8""?>
<!DOCTYPE plist PUBLIC ""-//Apple//DTD PLIST 1.0//EN"" ""http://www.apple.com/DTDs/PropertyList-1.0.dtd"">
<plist version=""1.0"">
<dict>
    <key>Label</key>
    <string>com.automaton.runner</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/automaton-runner</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/automaton-runner.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/automaton-runner-error.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>AppConfig__BaseUrl</key>
        <string>https://studio.automaton.monster</string>
        <key>AUTOMATON_API_KEY</key>
        <string>ak_your_api_key_here</string>
    </dict>
</dict>
</plist>";

	protected override void OnInitialized()
	{
		var clientBaseUrl = NavigationManager.BaseUri.TrimEnd('/');

		// Runner installation scripts
		windowsInstallCommand = $"iwr -useb {clientBaseUrl}/downloads/runner/install.ps1 | iex";
		unixInstallCommand = $"curl -sSL {clientBaseUrl}/downloads/runner/install.sh | bash";

		windowsServiceCommand = $"iwr -useb {clientBaseUrl}/downloads/runner/setup-service.ps1 | iex";
		unixServiceCommand = $"curl -sSL {clientBaseUrl}/downloads/runner/setup-service.sh | bash";

		// Runner manual downloads
		runnerWindowsX64Url = $"{clientBaseUrl}/downloads/runner/latest/automaton-runner-win-x64.zip";
		runnerWindowsArm64Url = $"{clientBaseUrl}/downloads/runner/latest/automaton-runner-win-arm64.zip";
		runnerLinuxX64Url = $"{clientBaseUrl}/downloads/runner/latest/automaton-runner-linux-x64.tar.gz";
		runnerLinuxArm64Url = $"{clientBaseUrl}/downloads/runner/latest/automaton-runner-linux-arm64.tar.gz";
		runnerMacosX64Url = $"{clientBaseUrl}/downloads/runner/latest/automaton-runner-macos-x64.tar.gz";
		runnerMacosArm64Url = $"{clientBaseUrl}/downloads/runner/latest/automaton-runner-macos-arm64.tar.gz";
	}

	private async Task CopyToClipboard(string text, string description)
	{
		try
		{
			await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
			await MessageService.SuccessAsync($"{description} copied to clipboard");
		}
		catch
		{
			await MessageService.WarningAsync("Could not copy to clipboard. Please copy manually.");
		}
	}

	private async Task ScrollToSection(string sectionId)
	{
		await JSRuntime.InvokeVoidAsync("eval", $"document.getElementById('{sectionId}')?.scrollIntoView({{ behavior: 'smooth', block: 'start' }})");
	}
}

