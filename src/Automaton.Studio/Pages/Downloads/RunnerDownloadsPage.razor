@page "/downloads-runner"
@using Microsoft.AspNetCore.Components
@using Automaton.Studio.Services
@inject IJSRuntime JSRuntime
@inject ConfigurationService ConfigService
@inject NavigationManager NavigationManager
@inject MessageService MessageService

<PageTitle>Download Console Runner - Automaton Studio</PageTitle>

<Layout>
    <Header Class="header">
        <Row>
            <Col Flex=@("none")>
                <Space Size="SpaceSize.Large">
                    <SpaceItem Class="header-item">
                        <Breadcrumb>
                            <BreadcrumbItem Href="/">
                                <Icon Type="home" Width="16" Height="16" />
                                <span>Home</span>
                            </BreadcrumbItem>
                            <BreadcrumbItem>
                                <Icon Type="download" Width="16" Height="16" />
                                <span>Downloads</span>
                            </BreadcrumbItem>
                            <BreadcrumbItem>
                                <Icon Type="code" Width="16" Height="16" />
                                <span>Console Runner</span>
                            </BreadcrumbItem>
                        </Breadcrumb>
                    </SpaceItem>
                </Space>
            </Col>
            <Col Class="right-actions">
                <Space>
                    <SpaceItem>
                        <Button Type="@ButtonType.Primary" OnClick="@(() => NavigationManager.NavigateTo("/onboarding"))">
                            <Icon Type="question-circle" />
                            Get Started
                        </Button>
                    </SpaceItem>
                    <SpaceItem>
                        <Button Type="@ButtonType.Default" OnClick="@(() => NavigationManager.NavigateTo("/desktop"))">
                            <Icon Type="appstore" />
                            Desktop App
                        </Button>
                    </SpaceItem>
                </Space>
            </Col>
        </Row>
    </Header>

    <Content Class="content-padding home-content content-background">
        <div class="home-container">
            
            <!-- Header Section -->
            <div class="downloads-header">
                <div class="downloads-header-content">
                    <div class="downloads-header-icon">
                        <Icon Type="code" Style="font-size: 48px; color: white;" />
                    </div>
                    <div class="downloads-header-text">
                        <Title Level="1" Style="margin-bottom: 8px;">Download Console Runner</Title>
                        <Paragraph Class="downloads-subtitle">
                            Cross-platform command-line runner with one-command interactive setup
                        </Paragraph>
                        <div Style="margin-top: 12px;">
                            <Button Type="@ButtonType.Link" Size="@ButtonSize.Large" OnClick="@(() => NavigationManager.NavigateTo("/docs/#/user-guide/runner-setup"))" Style="padding: 0; font-size: 16px;">
                                <Icon Type="book" Style="margin-right: 4px;" />
                                📚 View Complete Setup Guide & Troubleshooting
                            </Button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Installation Scripts Section - PRIMARY -->
            <Card Class="installation-scripts-card" Style="margin-bottom: 24px;">
                <TitleTemplate>
                    <Icon Type="rocket" Style="margin-right: 8px;" />
                    <span>Quick Installation (Recommended)</span>
                </TitleTemplate>
                <ChildContent>
                    <Paragraph Style="font-size: 16px; margin-bottom: 16px;">
                        <strong>Download and install the runner automatically:</strong>
                    </Paragraph>
                    
                    <Row Gutter="16">
                        <Col Span="12">
                            <Card Size="@CardSize.Small" Class="install-command-card">
                                <TitleTemplate>
                                    <Icon Type="windows" Style="margin-right: 8px; color: #0078d4;" />
                                    <span>Windows (PowerShell)</span>
                                </TitleTemplate>
                                <ChildContent>
                                    <Paragraph><strong>Run as Administrator:</strong></Paragraph>
                                    <div class="code-container">
                                        <div class="command-display">
                                            <Text Code Class="code-block">@windowsInstallCommand</Text>
                                            <Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard(windowsInstallCommand, "Windows install command"))" Style="margin-left: 8px;">
                                                Copy
                                            </Button>
                                        </div>
                                    </div>
                                    <Paragraph Type="@TextElementType.Secondary" Style="margin-top: 8px; font-size: 12px;">
                                        ✅ Downloads, installs, and adds to PATH<br/>
                                        ✅ Creates automaton-runner command globally
                                    </Paragraph>
                                </ChildContent>
                            </Card>
                        </Col>
                        
                        <Col Span="12">
                            <Card Size="@CardSize.Small" Class="install-command-card">
                                <TitleTemplate>
                                    <Icon Type="code" Style="margin-right: 8px; color: #ff6b35;" />
                                    <span>Linux / macOS (Terminal)</span>
                                </TitleTemplate>
                                <ChildContent>
                                    <Paragraph><strong>Install command:</strong></Paragraph>
                                    <div class="code-container">
                                        <div class="command-display">
                                            <Text Code Class="code-block">@unixInstallCommand</Text>
                                            <Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard(unixInstallCommand, "Unix install command"))" Style="margin-left: 8px;">
                                                Copy
                                            </Button>
                                        </div>
                                    </div>
                                    <Paragraph Type="@TextElementType.Secondary" Style="margin-top: 8px; font-size: 12px;">
                                        ✅ Downloads and installs to /usr/local/bin<br/>
                                        ✅ Creates automaton-runner command globally
                                    </Paragraph>
                                </ChildContent>
                            </Card>
                        </Col>
                    </Row>

                    <Alert Type="@AlertType.Success" ShowIcon="true" Style="margin-top: 16px;">
                        <MessageTemplate>
                            <strong>After installation:</strong> Just run <code>automaton-runner</code> and it will guide you through complete setup! <br/>
                            <strong>One Command Setup:</strong> The runner will interactively prompt for your API key, server URL, and runner name, then start automatically.
                        </MessageTemplate>
                    </Alert>
                </ChildContent>
            </Card>

            <!-- Manual Downloads Section -->
            <Card Class="manual-downloads-card" Style="margin-bottom: 24px;">
                <TitleTemplate>
                    <Icon Type="inbox" Style="margin-right: 8px;" />
                    <span>📦 Manual Downloads</span>
                </TitleTemplate>
                <ChildContent>
                    <Paragraph>Download specific platform binaries directly:</Paragraph>
                    
                    <Row Gutter="16">
                        <!-- Windows -->
                        <Col Span="8">
                            <Card Size="@CardSize.Small" Class="platform-card">
                                <TitleTemplate>
                                    <Icon Type="windows" Style="margin-right: 8px; color: #0078d4;" />
                                    <span>Windows</span>
                                </TitleTemplate>
                                <ChildContent>
                                    <Space Direction="SpaceDirection.Vertical" Style="width: 100%;">
                                        <SpaceItem>
                                            <DownloadButton Url="@windowsX64Url" FileName="automaton-runner-win-x64.zip" Type="@ButtonType.Primary" Block="true">
                                                <Icon Type="download" />
                                                x64 (.zip)
                                            </DownloadButton>
                                        </SpaceItem>
                                        <SpaceItem>
                                            <DownloadButton Url="@windowsArm64Url" FileName="automaton-runner-win-arm64.zip" Block="true">
                                                <Icon Type="download" />
                                                ARM64 (.zip)
                                            </DownloadButton>
                                        </SpaceItem>
                                    </Space>
                                </ChildContent>
                            </Card>
                        </Col>

                        <!-- Linux -->
                        <Col Span="8">
                            <Card Size="@CardSize.Small" Class="platform-card">
                                <TitleTemplate>
                                    <Icon Type="code" Style="margin-right: 8px; color: #ff6b35;" />
                                    <span>Linux</span>
                                </TitleTemplate>
                                <ChildContent>
                                    <Space Direction="SpaceDirection.Vertical" Style="width: 100%;">
                                        <SpaceItem>
                                            <DownloadButton Url="@linuxX64Url" FileName="automaton-runner-linux-x64.tar.gz" Type="@ButtonType.Primary" Block="true">
                                                <Icon Type="download" />
                                                x64 (.tar.gz)
                                            </DownloadButton>
                                        </SpaceItem>
                                        <SpaceItem>
                                            <DownloadButton Url="@linuxArm64Url" FileName="automaton-runner-linux-arm64.tar.gz" Block="true">
                                                <Icon Type="download" />
                                                ARM64 (.tar.gz)
                                            </DownloadButton>
                                        </SpaceItem>
                                    </Space>
                                </ChildContent>
                            </Card>
                        </Col>

                        <!-- macOS -->
                        <Col Span="8">
                            <Card Size="@CardSize.Small" Class="platform-card">
                                <TitleTemplate>
                                    <Icon Type="apple" Style="margin-right: 8px; color: #333;" />
                                    <span>macOS</span>
                                </TitleTemplate>
                                <ChildContent>
                                    <Space Direction="SpaceDirection.Vertical" Style="width: 100%;">
                                        <SpaceItem>
                                            <DownloadButton Url="@macosX64Url" FileName="automaton-runner-macos-x64.tar.gz" Type="@ButtonType.Primary" Block="true">
                                                <Icon Type="download" />
                                                Intel (.tar.gz)
                                            </DownloadButton>
                                        </SpaceItem>
                                        <SpaceItem>
                                            <DownloadButton Url="@macosArm64Url" FileName="automaton-runner-macos-arm64.tar.gz" Block="true">
                                                <Icon Type="download" />
                                                Apple Silicon (.tar.gz)
                                            </DownloadButton>
                                        </SpaceItem>
                                    </Space>
                                </ChildContent>
                            </Card>
                        </Col>
                    </Row>
                </ChildContent>
            </Card>

            <!-- Getting Started Section -->
            <Card Class="getting-started-card" Style="margin-bottom: 24px;">
                <TitleTemplate>
                    <Icon Type="play-circle" Style="margin-right: 8px;" />
                    <span>Quick Start (Recommended)</span>
                </TitleTemplate>
                <ChildContent>
                    <Alert Type="@AlertType.Info" ShowIcon="true" Style="margin-bottom: 16px;">
                        <MessageTemplate>
                            <strong>✨ Interactive Setup:</strong> Just run <code>automaton-runner</code> once and it handles everything!
                        </MessageTemplate>
                    </Alert>
                    
                    <Row Gutter="24">
                        <Col Span="12">
                            <div class="step-container">
                                <div class="step-number">1</div>
                                <div class="step-content">
                                    <Title Level="4">Get Your API Key</Title>
                                    <Paragraph>Create an API key in Automaton Studio:</Paragraph>
                                    <ol>
                                        <li>Go to <strong>Settings → API Keys</strong></li>
                                        <li>Click <strong>Create API Key</strong></li>
                                        <li>Choose <strong>"Runner"</strong> scope</li>
                                        <li>Copy your key (starts with <code>ak_</code>)</li>
                                    </ol>
                                    <Button Type="@ButtonType.Link" OnClick="@(() => NavigationManager.NavigateTo("/apikeys"))" Style="padding: 0;">
                                        <Icon Type="arrow-right" />
                                        Go to API Keys
                                    </Button>
                                </div>
                            </div>
                        </Col>
                        
                        <Col Span="12">
                            <div class="step-container">
                                <div class="step-number">2</div>
                                <div class="step-content">
                                    <Title Level="4">Run Interactive Setup</Title>
                                    <Paragraph><strong>That's it! Just run:</strong></Paragraph>
                                    <div class="code-example">
                                        <Text Code>automaton-runner</Text>
                                    </div>
                                    <Paragraph Type="@TextElementType.Secondary" Style="margin-top: 8px;">
                                        The runner will automatically:
                                        <br/>• Ask for your API key
                                        <br/>• Configure server URL 
                                        <br/>• Set runner name with smart defaults
                                        <br/>• Start running workflows immediately
                                    </Paragraph>
                                    <Alert Type="@AlertType.Success" ShowIcon="true" Style="margin-top: 12px;">
                                        <MessageTemplate>
                                            <strong>No complex setup needed!</strong> Everything is handled interactively.
                                        </MessageTemplate>
                                    </Alert>
                                </div>
                            </div>
                        </Col>
                    </Row>
                </ChildContent>
            </Card>

            <!-- Advanced Commands Section -->
            <Card Class="advanced-commands-card" Style="margin-bottom: 24px;">
                <TitleTemplate>
                    <Icon Type="code" Style="margin-right: 8px;" />
                    <span>⚙️ Advanced Commands (Optional)</span>
                </TitleTemplate>
                <ChildContent>
                    <Alert Type="@AlertType.Warning" ShowIcon="true" Style="margin-bottom: 16px;">
                        <MessageTemplate>
                            <strong>Most users don't need these!</strong> The interactive <code>automaton-runner</code> command handles everything automatically. 
                            These commands are for scripting and advanced scenarios.
                        </MessageTemplate>
                    </Alert>
                    
                    <Paragraph>For scripting, automation, and advanced usage scenarios:</Paragraph>
                    
                    <Row Gutter="16">
                        <Col Span="12">
                            <div class="command-section">
                                <Title Level="5">Manual Authentication</Title>
                                <div class="code-example">
                                    <Text Code># Interactive authentication</Text><br/>
                                    <Text Code>automaton-runner auth</Text><br/><br/>
                                    <Text Code># With parameters</Text><br/>
                                    <Text Code>automaton-runner auth --api-key ak_xxx --server https://server.com</Text>
                                </div>
                            </div>
                        </Col>
                        <Col Span="12">
                            <div class="command-section">
                                <Title Level="5">Manual Registration</Title>
                                <div class="code-example">
                                    <Text Code># Interactive registration</Text><br/>
                                    <Text Code>automaton-runner register</Text><br/><br/>
                                    <Text Code># With name</Text><br/>
                                    <Text Code>automaton-runner register --name "My-Runner"</Text><br/><br/>
                                    <Text Code># Force re-registration</Text><br/>
                                    <Text Code>automaton-runner register --force</Text>
                                </div>
                            </div>
                        </Col>
                    </Row>
                    
                    <Row Gutter="16" Style="margin-top: 16px;">
                        <Col Span="12">
                            <div class="command-section">
                                <Title Level="5">Configuration & Status</Title>
                                <div class="code-example">
                                    <Text Code># Configure server URL</Text><br/>
                                    <Text Code>automaton-runner server --url https://server.com</Text><br/><br/>
                                    <Text Code># Show detailed status</Text><br/>
                                    <Text Code>automaton-runner status</Text>
                                </div>
                            </div>
                        </Col>
                        <Col Span="12">
                            <div class="command-section">
                                <Title Level="5">Service & Maintenance</Title>
                                <div class="code-example">
                                    <Text Code># Install as system service</Text><br/>
                                    <Text Code>automaton-runner service install</Text><br/><br/>
                                    <Text Code># Clean up stored data</Text><br/>
                                    <Text Code>automaton-runner cleanup</Text><br/><br/>
                                    <Text Code># Show help</Text><br/>
                                    <Text Code>automaton-runner --help</Text>
                                </div>
                            </div>
                        </Col>
                    </Row>
                </ChildContent>
            </Card>

            <!-- Environment Variables Section -->
            <Card Class="env-vars-card" Style="margin-bottom: 24px;">
                <TitleTemplate>
                    <Icon Type="setting" Style="margin-right: 8px;" />
                    <span>🤖 Automation & CI/CD (Skip Interactive Prompts)</span>
                </TitleTemplate>
                <ChildContent>
                    <Paragraph>For automated deployments where you want to skip all interactive prompts:</Paragraph>
                    
                    <div class="code-example" Style="margin: 16px 0;">
                        <Text Code># Set API key via environment variable</Text><br/>
                        <Text Code>export AUTOMATON_API_KEY="ak_runner_1234567890abcdef"</Text><br/>
                        <Text Code>export AppConfig__BaseUrl="https://automaton.company.com"</Text><br/><br/>
                        <Text Code># Runner starts with no prompts - fully automated</Text><br/>
                        <Text Code>automaton-runner</Text>
                    </div>

                    <Alert Type="@AlertType.Info" ShowIcon="true" Style="margin-top: 16px;">
                        <MessageTemplate>
                            <strong>Perfect for Docker, CI/CD, and server deployments!</strong><br/>
                            When environment variables are set, the runner automatically detects them and skips all interactive prompts.
                        </MessageTemplate>
                    </Alert>
                    
                    <Alert Type="@AlertType.Success" ShowIcon="true" Style="margin-top: 12px;">
                        <MessageTemplate>
                            <strong>All set!</strong> Your runner is configured to start automatically with the provided settings.
                        </MessageTemplate>
                    </Alert>
                </ChildContent>
            </Card>

            <!-- Documentation Link Section -->
            <Card Class="documentation-card">
                <TitleTemplate>
                    <Icon Type="book" Style="margin-right: 8px;" />
                    <span>📚 Need More Help?</span>
                </TitleTemplate>
                <ChildContent>
                    <Row Gutter="24">
                        <Col Span="16">
                            <Title Level="4" Style="margin-bottom: 12px;">Complete Setup Guide & Troubleshooting</Title>
                            <Paragraph>
                                For comprehensive documentation including Docker deployment, CI/CD integration, 
                                troubleshooting, service configuration, and advanced scenarios, check out our complete setup guide.
                            </Paragraph>
                            <div class="doc-features">
                                <div class="doc-feature-item">
                                    <Icon Type="check-circle" Style="color: #52c41a; margin-right: 8px;" />
                                    <span>Detailed installation instructions for all platforms</span>
                                </div>
                                <div class="doc-feature-item">
                                    <Icon Type="check-circle" Style="color: #52c41a; margin-right: 8px;" />
                                    <span>Docker and Kubernetes deployment examples</span>
                                </div>
                                <div class="doc-feature-item">
                                    <Icon Type="check-circle" Style="color: #52c41a; margin-right: 8px;" />
                                    <span>CI/CD pipeline integration (GitHub Actions, Azure DevOps, GitLab)</span>
                                </div>
                                <div class="doc-feature-item">
                                    <Icon Type="check-circle" Style="color: #52c41a; margin-right: 8px;" />
                                    <span>Troubleshooting common issues</span>
                                </div>
                                <div class="doc-feature-item">
                                    <Icon Type="check-circle" Style="color: #52c41a; margin-right: 8px;" />
                                    <span>System service configuration</span>
                                </div>
                                <div class="doc-feature-item">
                                    <Icon Type="check-circle" Style="color: #52c41a; margin-right: 8px;" />
                                    <span>Security best practices</span>
                                </div>
                            </div>
                        </Col>
                        <Col Span="8" Style="display: flex; flex-direction: column; align-items: center; justify-content: center;">
                            <div Style="text-align: center;">
                                <div Style="font-size: 64px; margin-bottom: 16px;">📖</div>
                                <Button Type="@ButtonType.Primary" Size="@ButtonSize.Large" Block="true" OnClick="@(() => NavigationManager.NavigateTo("/docs/#/user-guide/runner-setup"))">
                                    <Icon Type="book" />
                                    View Setup Guide
                                </Button>
                                <Paragraph Type="@TextElementType.Secondary" Style="margin-top: 8px; font-size: 12px;">
                                    Complete guide with examples and troubleshooting
                                </Paragraph>
                            </div>
                        </Col>
                    </Row>
                </ChildContent>
            </Card>
        </div>
    </Content>
</Layout>

@code {
    private string windowsInstallCommand = "";
    private string unixInstallCommand = "";
    private string windowsX64Url = "";
    private string windowsArm64Url = "";
    private string linuxX64Url = "";
    private string linuxArm64Url = "";
    private string macosX64Url = "";
    private string macosArm64Url = "";

    protected override void OnInitialized()
    {
        // Get the client application base URL (where the Blazor app is running)
        var clientBaseUrl = NavigationManager.BaseUri.TrimEnd('/');
        
        // Installation scripts - these are served from the Blazor client app
        windowsInstallCommand = $"iwr -useb {clientBaseUrl}/downloads/install.ps1 | iex";
        unixInstallCommand = $"curl -sSL {clientBaseUrl}/downloads/install.sh | bash";
        
        // Build download URLs - these are also served from the Blazor client app
        windowsX64Url = $"{clientBaseUrl}/downloads/runner/latest/automaton-runner-win-x64.zip";
        windowsArm64Url = $"{clientBaseUrl}/downloads/runner/latest/automaton-runner-win-arm64.zip";
        linuxX64Url = $"{clientBaseUrl}/downloads/runner/latest/automaton-runner-linux-x64.tar.gz";
        linuxArm64Url = $"{clientBaseUrl}/downloads/runner/latest/automaton-runner-linux-arm64.tar.gz";
        macosX64Url = $"{clientBaseUrl}/downloads/runner/latest/automaton-runner-macos-x64.tar.gz";
        macosArm64Url = $"{clientBaseUrl}/downloads/runner/latest/automaton-runner-macos-arm64.tar.gz";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("detectPlatform");
        }
    }

    private async Task CopyToClipboard(string text, string description)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
            await MessageService.SuccessAsync($"{description} copied to clipboard");
        }
        catch
        {
            await MessageService.WarningAsync("Could not copy to clipboard. Please copy manually.");
        }
    }
}

<script>
    window.detectPlatform = function() {
        // Check if the required elements exist before proceeding
        const platformElement = document.getElementById('detected-platform');
        const downloadBtnElement = document.getElementById('recommended-download-btn');
        const cardElement = document.getElementById('recommended-card');
        
        if (!platformElement || !downloadBtnElement || !cardElement) {
            // Elements don't exist, exit gracefully
            return;
        }
        
        const platform = navigator.platform.toLowerCase();
        const userAgent = navigator.userAgent.toLowerCase();
        
        let detectedOS = 'Unknown';
        let detectedArch = 'x64';
        let downloadUrl = '';
        
        // Use relative URLs since we're on the same client app
        if (platform.includes('win')) {
            detectedOS = 'Windows';
            downloadUrl = '/downloads/runner/latest/automaton-runner-win-x64.zip';
        } else if (platform.includes('mac') || platform.includes('darwin')) {
            detectedOS = 'macOS';
            if (userAgent.includes('arm') || platform.includes('arm')) {
                detectedArch = 'Apple Silicon';
                downloadUrl = '/downloads/runner/latest/automaton-runner-macos-arm64.tar.gz';
            } else {
                detectedArch = 'Intel';
                downloadUrl = '/downloads/runner/latest/automaton-runner-macos-x64.tar.gz';
            }
        } else if (platform.includes('linux')) {
            detectedOS = 'Linux';
            downloadUrl = '/downloads/runner/latest/automaton-runner-linux-x64.tar.gz';
        }
        
        if (detectedOS !== 'Unknown') {
            platformElement.textContent = `${detectedOS} ${detectedArch}`;
            downloadBtnElement.onclick = () => window.location.href = downloadUrl;
            cardElement.style.display = 'block';
        }
    };
</script>

