@using Automaton.Studio.Models
@using Automaton.Studio.Components

<div class="flows-tab">
    <div style="margin-bottom: 16px; display: flex; gap: 8px;">
        @if (ViewModel.CanManageResources)
        {
            <Button Type="@ButtonType.Primary" OnClick="@ShowAddFlowModal">
                <Icon Type="plus" />
                Add Flow to Project
            </Button>
        }
        <Button OnClick="@LoadFlows" Loading="@isLoading">
            <Icon Type="reload" />
            Refresh
        </Button>
    </div>

    @if (isLoading && !flowsLoaded)
    {
        <div style="text-align: center; padding: 40px 0;">
            <Spin Size="@SpinSize.Large" />
            <div style="margin-top: 16px;">Loading flows...</div>
        </div>
    }
    else
    {
        <Table TItem="ProjectFlowDto" DataSource="@ViewModel.Flows" Loading="@isLoading">
            <Column Title="Flow Name" TData="string" @bind-Field="@context.FlowName" />
            <Column Title="Added" TData="DateTime" @bind-Field="@context.AddedAt" Format="yyyy-MM-dd HH:mm" Sortable />
            <Column Title="Added By" TData="string" @bind-Field="@context.AddedByUserName" />
            <ActionColumn Title="Actions">
                @if (ViewModel.CanManageResources)
                {
                    <Button Size="@ButtonSize.Small" Danger OnClick="@(() => HandleRemoveFlow(context.FlowId))">
                        <Icon Type="delete" /> Remove
                    </Button>
                }
            </ActionColumn>
        </Table>

        @if (ViewModel.Flows.Count == 0)
        {
            <Empty>
                <DescriptionTemplate>No flows in this project yet</DescriptionTemplate>
                <ChildContent>
                    @if (ViewModel.CanManageResources)
                    {
                        <Button Type="@ButtonType.Primary" OnClick="@ShowAddFlowModal">
                            Add First Flow
                        </Button>
                    }
                </ChildContent>
            </Empty>
        }
    }
</div>

<!-- Add Flow Modal -->
<Modal Title="Add Flow to Project"
       @bind-Visible="@addFlowModalVisible"
       OnOk="@HandleAddFlow"
       OnCancel="@(() => addFlowModalVisible = false)">
    <Form TModel="AddFlowModel" Layout="@FormLayout.Vertical">
        <FormItem Label="Select Flow">
            <FlowsSelector @bind-SelectedValue="@selectedFlowId" 
                           Style="width: 100%"
                           Placeholder="Select a flow to add" />
        </FormItem>
    </Form>
</Modal>

@code {
    [Parameter]
    public ProjectViewModel ViewModel { get; set; } = default!;

    private bool flowsLoaded = false;
    private bool isLoading = false;
    private bool addFlowModalVisible = false;
    private Guid? selectedFlowId = null;

    [Inject]
    private ModalService Modal { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadFlows();
    }

    private async Task LoadFlows()
    {
        if (ViewModel.Project != null && !isLoading)
        {
            isLoading = true;
            StateHasChanged();
            await ViewModel.LoadFlowsAsync(ViewModel.Project.Id);
            flowsLoaded = true;
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ShowAddFlowModal()
    {
        selectedFlowId = null;
        addFlowModalVisible = true;
    }

    private async Task HandleAddFlow()
    {
        if (ViewModel.Project != null && selectedFlowId.HasValue)
        {
            await ViewModel.AddFlowAsync(ViewModel.Project.Id, selectedFlowId.Value);
            addFlowModalVisible = false;
            StateHasChanged();
        }
    }

    private async Task HandleRemoveFlow(Guid flowId)
    {
        var confirmed = await Modal.ConfirmAsync(new ConfirmOptions
        {
            Title = "Remove Flow",
            Content = "Are you sure you want to remove this flow from the project?",
            OkText = "Remove",
            OkType = ButtonType.Primary,
            OkButtonProps = new ButtonProps { Danger = true }
        });

        if (confirmed && ViewModel.Project != null)
        {
            await ViewModel.RemoveFlowAsync(ViewModel.Project.Id, flowId);
            StateHasChanged();
        }
    }

    private class AddFlowModel
    {
        public Guid? FlowId { get; set; }
    }
}
