@using Automaton.Studio.Models
@using Automaton.Studio.Components

<div class="runners-tab">
    <div style="margin-bottom: 16px; display: flex; gap: 8px;">
        @if (ViewModel.CanManageResources)
        {
            <Button Type="@ButtonType.Primary" OnClick="@ShowAddRunnerModal">
                <Icon Type="plus" />
                Add Runner to Project
            </Button>
        }
        <Button OnClick="@LoadRunners" Loading="@isLoading">
            <Icon Type="reload" />
            Refresh
        </Button>
    </div>

    @if (isLoading && !runnersLoaded)
    {
        <div style="text-align: center; padding: 40px 0;">
            <Spin Size="@SpinSize.Large" />
            <div style="margin-top: 16px;">Loading runners...</div>
        </div>
    }
    else
    {
        <Table TItem="ProjectRunnerDto" DataSource="@ViewModel.Runners" Loading="@isLoading">
            <Column Title="Runner Name" TData="string" @bind-Field="@context.RunnerName" />
            <Column Title="Added" TData="DateTime" @bind-Field="@context.AddedAt" Format="yyyy-MM-dd HH:mm" Sortable />
            <Column Title="Added By" TData="string" @bind-Field="@context.AddedByUserName" />
            <ActionColumn Title="Actions">
                @if (ViewModel.CanManageResources)
                {
                    <Button Size="@ButtonSize.Small" Danger OnClick="@(() => HandleRemoveRunner(context.RunnerId))">
                        <Icon Type="delete" /> Remove
                    </Button>
                }
            </ActionColumn>
        </Table>

        @if (ViewModel.Runners.Count == 0)
        {
            <Empty>
                <DescriptionTemplate>No runners in this project yet</DescriptionTemplate>
                <ChildContent>
                    @if (ViewModel.CanManageResources)
                    {
                        <Button Type="@ButtonType.Primary" OnClick="@ShowAddRunnerModal">
                            Add First Runner
                        </Button>
                    }
                </ChildContent>
            </Empty>
        }
    }
</div>

<!-- Add Runner Modal -->
<Modal Title="Add Runner to Project"
       @bind-Visible="@addRunnerModalVisible"
       OnOk="@HandleAddRunner"
       OnCancel="@(() => addRunnerModalVisible = false)">
    <Form TModel="AddRunnerModel" Layout="@FormLayout.Vertical">
        <FormItem Label="Select Runner">
            <RunnerSelector @bind-SelectedValue="@selectedRunnerId" 
                            Style="width: 100%"
                            Placeholder="Select a runner to add" />
        </FormItem>
    </Form>
</Modal>

@code {
    [Parameter]
    public ProjectViewModel ViewModel { get; set; } = default!;

    private bool runnersLoaded = false;
    private bool isLoading = false;
    private bool addRunnerModalVisible = false;
    private Guid? selectedRunnerId = null;

    [Inject]
    private ModalService Modal { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadRunners();
    }

    private async Task LoadRunners()
    {
        if (ViewModel.Project != null && !isLoading)
        {
            isLoading = true;
            StateHasChanged();
            await ViewModel.LoadRunnersAsync(ViewModel.Project.Id);
            runnersLoaded = true;
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ShowAddRunnerModal()
    {
        selectedRunnerId = null;
        addRunnerModalVisible = true;
    }

    private async Task HandleAddRunner()
    {
        if (ViewModel.Project != null && selectedRunnerId.HasValue)
        {
            await ViewModel.AddRunnerAsync(ViewModel.Project.Id, selectedRunnerId.Value);
            addRunnerModalVisible = false;
            StateHasChanged();
        }
    }

    private async Task HandleRemoveRunner(Guid runnerId)
    {
        var confirmed = await Modal.ConfirmAsync(new ConfirmOptions
        {
            Title = "Remove Runner",
            Content = "Are you sure you want to remove this runner from the project?",
            OkText = "Remove",
            OkType = ButtonType.Primary,
            OkButtonProps = new ButtonProps { Danger = true }
        });

        if (confirmed && ViewModel.Project != null)
        {
            await ViewModel.RemoveRunnerAsync(ViewModel.Project.Id, runnerId);
            StateHasChanged();
        }
    }

    private class AddRunnerModel
    {
        public Guid? RunnerId { get; set; }
    }
}
