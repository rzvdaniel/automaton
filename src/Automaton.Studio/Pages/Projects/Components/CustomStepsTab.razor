@using Automaton.Studio.Models

<div class="customsteps-tab">
    @if (ViewModel.CanManageResources)
    {
        <div style="margin-bottom: 16px;">
            <Button Type="@ButtonType.Primary" OnClick="@ShowAddStepModal">
                <Icon Type="plus" />
                Add Custom Step to Project
            </Button>
        </div>
    }

    @if (!stepsLoaded)
    {
        <div style="text-align: center; padding: 40px 0;">
            <Button Type="@ButtonType.Link" OnClick="@LoadSteps">
                <Icon Type="reload" /> Load Custom Steps
            </Button>
        </div>
    }
    else
    {
        <Table TItem="ProjectCustomStepDto" DataSource="@ViewModel.CustomSteps">
            <Column Title="Step Name" TData="string" @bind-Field="@context.StepName" />
            <Column Title="Added" TData="DateTime" @bind-Field="@context.AddedAt" Format="yyyy-MM-dd HH:mm" Sortable />
            <Column Title="Added By" TData="string" @bind-Field="@context.AddedByUserName" />
            <ActionColumn Title="Actions">
                @if (ViewModel.CanManageResources)
                {
                    <Button Size="@ButtonSize.Small" Danger OnClick="@(() => HandleRemoveStep(context.StepId))">
                        <Icon Type="delete" /> Remove
                    </Button>
                }
            </ActionColumn>
        </Table>

        @if (ViewModel.CustomSteps.Count == 0)
        {
            <Empty>
                <DescriptionTemplate>No custom steps in this project yet</DescriptionTemplate>
                <ChildContent>
                    @if (ViewModel.CanManageResources)
                    {
                        <Button Type="@ButtonType.Primary" OnClick="@ShowAddStepModal">
                            Add First Custom Step
                        </Button>
                    }
                </ChildContent>
            </Empty>
        }
    }
</div>

<!-- Add Custom Step Modal -->
<Modal Title="Add Custom Step to Project"
       @bind-Visible="@addStepModalVisible"
       OnOk="@HandleAddStep"
       OnCancel="@(() => addStepModalVisible = false)">
    <Form TModel="AddStepModel" Layout="@FormLayout.Vertical">
        <FormItem Label="Custom Step ID">
            <Input @bind-Value="@selectedStepId" Placeholder="Enter Custom Step GUID" />
        </FormItem>
    </Form>
    <Text Type="@TextElementType.Secondary" Style="font-size: 12px;">
        Note: In a production version, this would be a dropdown of available custom steps.
    </Text>
</Modal>

@code {
    [Parameter]
    public ProjectSettingsViewModel ViewModel { get; set; } = default!;

    private bool stepsLoaded = false;
    private bool addStepModalVisible = false;
    private string selectedStepId = string.Empty;

    [Inject]
    private ModalService Modal { get; set; } = default!;

    private async Task LoadSteps()
    {
        if (ViewModel.Project != null)
        {
            await ViewModel.LoadCustomStepsAsync(ViewModel.Project.Id);
            stepsLoaded = true;
        }
    }

    private void ShowAddStepModal()
    {
        selectedStepId = string.Empty;
        addStepModalVisible = true;
    }

    private async Task HandleAddStep()
    {
        if (ViewModel.Project != null && Guid.TryParse(selectedStepId, out var stepId))
        {
            await ViewModel.AddCustomStepAsync(ViewModel.Project.Id, stepId);
            addStepModalVisible = false;
        }
    }

    private async Task HandleRemoveStep(Guid stepId)
    {
        var confirmed = await Modal.ConfirmAsync(new ConfirmOptions
        {
            Title = "Remove Custom Step",
            Content = "Are you sure you want to remove this custom step from the project?",
            OkText = "Remove",
            OkType = ButtonType.Primary,
            OkButtonProps = new ButtonProps { Danger = true }
        });

        if (confirmed && ViewModel.Project != null)
        {
            await ViewModel.RemoveCustomStepAsync(ViewModel.Project.Id, stepId);
        }
    }

    private class AddStepModel
    {
        public string StepId { get; set; } = string.Empty;
    }
}
