@using Automaton.Studio.Enums
@using Automaton.Studio.Models
@using Automaton.Studio.Services

<div class="members-tab">
    @if (IsProjectAdmin)
    {
        <div style="margin-bottom: 16px;">
            <Button Type="@ButtonType.Primary" OnClick="@ShowAddMemberModal" Icon="plus">
                Add Member
            </Button>
        </div>
    }

    <Table TItem="ProjectMemberDto" DataSource="@ViewModel.Members" Loading="@ViewModel.IsLoading">
        <Column Title="Email" TData="string" @bind-Field="@context.Email" Sortable />
        <Column Title="Username" TData="string" @bind-Field="@context.UserName" />
        <Column Title="Role" TData="ProjectRole">
            <Tag Color="@GetRoleColor(context.Role)">
                @context.Role
            </Tag>
        </Column>
        <Column Title="Joined" TData="DateTime" @bind-Field="@context.JoinedAt" Format="yyyy-MM-dd" Sortable />
        <ActionColumn Title="Actions">
            @if (IsProjectAdmin && !context.IsOwner)
            {
                <Dropdown Trigger="new[] { Trigger.Click }">
                    <Overlay>
                        <Menu>
                            <MenuItem Icon="edit" OnClick="@(() => ShowUpdateRoleModal(context))">
                                <span style="margin-left: 12px;">Change Role</span>
                            </MenuItem>
                            <MenuDivider />
                            <MenuItem Icon="delete" OnClick="@(() => ShowRemoveMemberConfirm(context))">
                                <span style="margin-left: 12px;">Remove</span>
                            </MenuItem>
                        </Menu>
                    </Overlay>
                    <ChildContent>
                        <Button Size="@ButtonSize.Small">
                            Actions <Icon Type="down" />
                        </Button>
                    </ChildContent>
                </Dropdown>
            }
            else if (context.IsOwner)
            {
                <Tag Color="@("gold")">Owner</Tag>
            }
        </ActionColumn>
    </Table>
</div>

<!-- Add Member Modal -->
<Modal Title="Add Member"
       Visible="@addMemberModalVisible"
       OnOk="@HandleAddMember"
       OnCancel="@HandleCancelAddMember"
       ConfirmLoading="@isAddingMember"
       MaskClosable="false">
    <Form Model="@addMemberModel">
        <FormItem Label="Email">
            <Input @bind-Value="@addMemberModel.Email" Placeholder="user@example.com" Disabled="@isAddingMember" />
        </FormItem>
        <FormItem Label="Role">
            <Select TItemValue="ProjectRole" TItem="string" @bind-Value="@addMemberModel.Role" Style="width: 100%;" Disabled="@isAddingMember">
                <SelectOption Value="ProjectRole.ProjectAdmin" Label="Project Admin" />
                <SelectOption Value="ProjectRole.Developer" Label="Developer" />
                <SelectOption Value="ProjectRole.AppUser" Label="App User" />
                <SelectOption Value="ProjectRole.Viewer" Label="Viewer" />
            </Select>
        </FormItem>
        <FormItem>
            <Checkbox @bind-Value="@addMemberModel.CreateAccountIfNotExists" Disabled="@isAddingMember">
                Create account if email doesn't exist
            </Checkbox>
            <div class="form-text text-muted" style="margin-top:8px;font-size:0.9em;">
                An invitation email will be sent to the address above. If the account doesn't exist it will be created and the recipient will be prompted to set a password; otherwise they will receive an invitation to join the project.
            </div>
        </FormItem>
    </Form>
</Modal>

<!-- Update Role Modal -->
<Modal Title="Update Member Role"
       @bind-Visible="@updateRoleModalVisible"
       OnOk="@HandleUpdateRole"
       OnCancel="@(() => updateRoleModalVisible = false)">
    @if (selectedMember != null)
    {
        <p>Update role for <strong>@selectedMember.Email</strong></p>
        <Form Model="@selectedMember">
            <FormItem Label="New Role">
                <Select TItemValue="ProjectRole" TItem="string" @bind-Value="@newRole" Style="width: 100%;">
                    <SelectOption Value="ProjectRole.ProjectAdmin" Label="Project Admin" />
                    <SelectOption Value="ProjectRole.Developer" Label="Developer" />
                    <SelectOption Value="ProjectRole.AppUser" Label="App User" />
                    <SelectOption Value="ProjectRole.Viewer" Label="Viewer" />
                </Select>
            </FormItem>
        </Form>
    }
</Modal>

@code {
    [Parameter]
    public ProjectViewModel ViewModel { get; set; } = default!;

    private bool addMemberModalVisible = false;
    private bool updateRoleModalVisible = false;
    private bool isAddingMember = false;
    private AddProjectMemberRequest addMemberModel = new();
    private ProjectMemberDto? selectedMember;
    private ProjectRole newRole;

    [Inject]
    private ModalService Modal { get; set; } = default!;

    [Inject]
    private ProjectContextService ProjectContextService { get; set; } = default!;

    private bool IsProjectAdmin => ProjectContextService?.CurrentProject?.CurrentUserRole == ProjectRole.ProjectAdmin || ViewModel.IsProjectAdmin;

    private void ShowAddMemberModal()
    {
        addMemberModel = new AddProjectMemberRequest 
        { 
            Role = ProjectRole.AppUser,
            CreateAccountIfNotExists = true
        };
        addMemberModalVisible = true;
    }

    private async Task HandleAddMember()
    {
        if (ViewModel.Project != null && !string.IsNullOrWhiteSpace(addMemberModel.Email))
        {
            isAddingMember = true;
            StateHasChanged();
            
            await ViewModel.AddMemberAsync(ViewModel.Project.Id, addMemberModel);
            
            isAddingMember = false;
            addMemberModalVisible = false;
            StateHasChanged();
        }
    }

    private void HandleCancelAddMember()
    {
        if (!isAddingMember)
        {
            addMemberModalVisible = false;
        }
    }

    private void ShowUpdateRoleModal(ProjectMemberDto member)
    {
        selectedMember = member;
        newRole = member.Role;
        updateRoleModalVisible = true;
    }

    private async Task HandleUpdateRole()
    {
        if (ViewModel.Project != null && selectedMember != null)
        {
            await ViewModel.UpdateMemberRoleAsync(ViewModel.Project.Id, selectedMember.UserId, newRole);
            updateRoleModalVisible = false;
            StateHasChanged();
        }
    }

    private async Task ShowRemoveMemberConfirm(ProjectMemberDto member)
    {
        var confirmed = await Modal.ConfirmAsync(new ConfirmOptions
        {
            Title = "Remove Member",
            Content = $"Are you sure you want to remove {member.Email} from this project?",
            OkText = "Remove",
            OkType = ButtonType.Primary,
            OkButtonProps = new ButtonProps { Danger = true },
            CancelText = "Cancel"
        });

        if (confirmed && ViewModel.Project != null)
        {
            await ViewModel.RemoveMemberAsync(ViewModel.Project.Id, member.UserId);
            StateHasChanged();
        }
    }

    private string GetRoleColor(ProjectRole role)
    {
        return role switch
        {
            ProjectRole.ProjectAdmin => "red",
            ProjectRole.Developer => "blue",
            ProjectRole.AppUser => "green",
            ProjectRole.Viewer => "default",
            _ => "default"
        };
    }
}
