@page "/projects"
@using AntDesign
@using Automaton.Studio.Models
@using Automaton.Studio.Enums

<Layout>
    <Header Class="header">
        <Row>
            <Col Flex=@("none") Class="page-title">
                <Space Size="SpaceSize.Large">
                    <SpaceItem Class="header-item">
                        <Breadcrumb>
                            <BreadcrumbItem Href="/">
                                <Icon Type="home" Width="16" Height="16" />
                                <span>Home</span>
                            </BreadcrumbItem>
                            <BreadcrumbItem>
                                <Icon Type="team" Width="16" Height="16" />
                                <span>Projects</span>
                            </BreadcrumbItem>
                        </Breadcrumb>
                    </SpaceItem>
                </Space>
            </Col>

            <Col Class="right-actions">
                <Space Class="right-header-items">
                    <SpaceItem>
                        <Tooltip Title="Create new project">
                            <Button Type="@ButtonType.Primary" Icon="plus" OnClick="@(() => ShowCreateProjectDialog())">
                                Create Project
                            </Button>
                        </Tooltip>
                    </SpaceItem>
                </Space>
            </Col>
        </Row>
    </Header>

    <Content Class="content-padding content-background">
        @if (!loading && ProjectsViewModel.Projects?.Any() != true)
        {
            <Empty Description="@string.Empty">
                <DescriptionTemplate>
                    <p>No projects yet</p>
                    <p>Create your first project to organize apps, flows, and team members.</p>
                    <Button Type="@ButtonType.Primary" Icon="plus" OnClick="@(() => ShowCreateProjectDialog())">
                        Create Project
                    </Button>
                </DescriptionTemplate>
            </Empty>
        }
        else
        {
            <Table TItem="ProjectListItem" DataSource="@ProjectsViewModel.Projects" Loading="@loading" Class="autoscroll-list">

                <Column Title="Name" @bind-Field="@context.Name">
                    <a href="javascript:void(0)" @onclick="@(() => ViewProject(context.Id))">@context.DisplayName</a>
                </Column>

                <Column Title="Description" @bind-Field="@context.Description">
                    @context.Description
                </Column>

                <Column Title="Owner" @bind-Field="@context.OwnerName">
                    @context.OwnerName
                </Column>

                <Column Title="Your Role" @bind-Field="@context.CurrentUserRole">
                    @if (context.CurrentUserRole.HasValue)
                    {
                        <Tag Color="@GetRoleColor(context.CurrentUserRole.Value)">@context.CurrentUserRole.Value</Tag>
                    }
                </Column>

                <Column Title="Members" @bind-Field="@context.MemberCount">
                    @context.MemberCount
                </Column>

                <Column Title="Apps" @bind-Field="@context.AppCount">
                    @context.AppCount
                </Column>

                <Column Title="Flows" @bind-Field="@context.FlowCount">
                    @context.FlowCount
                </Column>

                <Column Title="Created" @bind-Field="@context.CreatedAt">
                    @context.CreatedAt.ToString("MMM dd, yyyy")
                </Column>

                <ActionColumn Title="Action">
                    <div>
                        <Space>
                            <SpaceItem>
                                <Tooltip Title="View project">
                                    <Button Icon="eye" @onclick="@(() => ViewProject(context.Id))">View</Button>
                                </Tooltip>
                            </SpaceItem>
                            @if (context.CurrentUserRole == ProjectRole.ProjectAdmin)
                            {
                                <SpaceItem>
                                    <Dropdown Placement="@Placement.Bottom" Trigger="@(new Trigger[] { Trigger.Click })">
                                        <Overlay>
                                            <Menu>
                                                <MenuItem OnClick="@(() => EditProject(context.Id))">
                                                    <Icon Type="edit" /> Edit
                                                </MenuItem>
                                                @if (context.IsOwner)
                                                {
                                                    <MenuItem OnClick="@(() => DeleteProject(context.Id, context.DisplayName))">
                                                        <Icon Type="delete" Style="color: #ff4d4f;" /> Delete
                                                    </MenuItem>
                                                }
                                            </Menu>
                                        </Overlay>
                                        <ChildContent>
                                            <Button Icon="more" />
                                        </ChildContent>
                                    </Dropdown>
                                </SpaceItem>
                            }
                        </Space>
                    </div>
                </ActionColumn>
            </Table>
        }
    </Content>
</Layout>

<!-- Create Project Modal -->
<Modal Title="Create Project"
       @bind-Visible="@createProjectVisible"
       OnOk="@HandleCreateProject"
       OnCancel="@(() => createProjectVisible = false)"
       ConfirmLoading="@createProjectLoading">
    <Form Model="@createProjectModel" LabelColSpan="6" WrapperColSpan="18">
        <FormItem Label="Name" Required>
            <Input @bind-Value="@createProjectModel.Name" Placeholder="e.g., engineering-tools" />
            <p style="font-size: 12px; color: rgba(0, 0, 0, 0.45); margin-top: 4px;">Internal identifier (lowercase, no spaces)</p>
        </FormItem>
        <FormItem Label="Display Name" Required>
            <Input @bind-Value="@createProjectModel.DisplayName" Placeholder="e.g., Engineering Tools" />
        </FormItem>
        <FormItem Label="Description">
            <TextArea @bind-Value="@createProjectModel.Description" Placeholder="Project description" Rows="3" />
        </FormItem>
    </Form>
</Modal>

<!-- Edit Project Modal -->
<Modal Title="Edit Project"
       @bind-Visible="@editProjectVisible"
       OnOk="@HandleEditProject"
       OnCancel="@(() => editProjectVisible = false)"
       ConfirmLoading="@editProjectLoading">
    <Form Model="@editProjectModel" LabelColSpan="6" WrapperColSpan="18">
        <FormItem Label="Display Name" Required>
            <Input @bind-Value="@editProjectModel.DisplayName" Placeholder="e.g., Engineering Tools" />
        </FormItem>
        <FormItem Label="Description">
            <TextArea @bind-Value="@editProjectModel.Description" Placeholder="Project description" Rows="3" />
        </FormItem>
    </Form>
</Modal>
