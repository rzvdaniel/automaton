@attribute [AllowAnonymous]
@page "/projects/invite/{Token}"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using Automaton.Studio.Services
@inject HttpClient Http
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject IClaimUtilityService ClaimUtilityService

<Layout>
    <Content>
        <div class="auth-container">
            <!-- Form Panel -->
            <div class="form-panel">
                <div class="form-content">
                    @if (loading)
                    {
                        <div class="loading-container">
                            <p>Validating invitation...</p>
                        </div>
                    }
                    else if (!isValid)
                    {
                        <div class="form-header">
                            <Title Level="1" Class="form-title">Invalid Invitation</Title>
                        </div>
                        <div class="alert alert-danger">This invitation is invalid or expired.</div>
                    }
                    else if (isAuthenticated && matchesEmail)
                    {
                        <div class="form-header">
                            <Title Level="1" Class="form-title">Accepting Invitation</Title>
                        </div>
                        <div class="alert alert-info">Your account matches the invitation. Accepting now...</div>
                    }
                    else if (!isAuthenticated && requirePasswordSetup)
                    {
                        <Form Loading="submitting"
                              Model="@form"
                              Layout="@FormLayout.Vertical"
                              OnValidSubmit="OnSubmitAsync"
                              Class="auth-form">
                            <ChildContent>
                                <div class="form-header">
                                    <Title Level="1" Class="form-title">Accept Invitation</Title>
                                    <p class="form-subtitle">You are invited to join <strong>@inviteProjectName</strong> as <strong>@inviteRole</strong></p>
                                </div>

                                <FormItem Label="Name">
                                    <Input @bind-Value="@form.Name" Size="@InputSize.Large" />
                                </FormItem>

                                <FormItem Label="Password">
                                    <InputPassword @bind-Value="@form.Password" Size="@InputSize.Large" />
                                </FormItem>

                                <FormItem Label="Confirm Password">
                                    <InputPassword @bind-Value="@form.ConfirmPassword" Size="@InputSize.Large" />
                                </FormItem>

                                <FormItem>
                                    <Button Type="ButtonType.Primary" HtmlType="submit" Size="@ButtonSize.Large" Block Disabled="submitting">
                                        @((submitting) ? "Processing..." : "Accept Invitation & Set Password")
                                    </Button>
                                </FormItem>

                                @if (!string.IsNullOrEmpty(error))
                                {
                                    <div class="alert alert-danger">@error</div>
                                }
                            </ChildContent>
                        </Form>
                    }
                    else if (!isAuthenticated && !requirePasswordSetup)
                    {
                        <div class="form-header">
                            <Title Level="1" Class="form-title">Sign In Required</Title>
                        </div>
                        <div class="form-content-text">
                            <p>You are invited to join <strong>@inviteProjectName</strong> as <strong>@inviteRole</strong></p>
                            <p class="mt-3">This email already has an account. Please <a href="@loginUrl">sign in</a> to accept the invitation.</p>
                        </div>
                    }
                    else
                    {
                        <div class="form-header">
                            <Title Level="1" Class="form-title">Wrong Account</Title>
                        </div>
                        <div class="alert alert-warning">You are authenticated as a different user. Please sign out and open the invitation link from the invited email, or contact support.</div>
                    }

                    @if (showSuccess)
                    {
                        <div class="alert alert-success mt-3">Invitation accepted. Redirecting to projects...</div>
                    }
                    @if (showFailure)
                    {
                        <div class="alert alert-danger mt-3">Failed to accept invitation. @failureMessage</div>
                    }
                </div>
            </div>

            <!-- Information Panel -->
            <div class="info-panel">
                <div class="info-content">
                    <div class="brand-section">
                        <h1 class="brand-title">You're Invited</h1>
                        <p class="brand-subtitle">Join the team and start collaborating on automation workflows</p>
                    </div>
                    
                    <div class="hero-visual">
                        <div class="invitation-mockup">
                            <div class="invitation-header">
                                <div class="invitation-icon">??</div>
                                <p class="invitation-title">Project Invitation</p>
                            </div>
                            <div class="invitation-content">
                                <div class="invitation-item">
                                    <span class="invitation-label">Project:</span>
                                    <span class="invitation-value">@inviteProjectName</span>
                                </div>
                                <div class="invitation-item">
                                    <span class="invitation-label">Role:</span>
                                    <span class="invitation-value">@inviteRole</span>
                                </div>
                                <div class="invitation-item">
                                    <span class="invitation-label">Email:</span>
                                    <span class="invitation-value">@inviteEmail</span>
                                </div>
                                <div class="invitation-perks">
                                    <p class="perk-title">What you get access to:</p>
                                    <ul class="perk-list">
                                        <li>Collaborative automation workflows</li>
                                        <li>Team project management</li>
                                        <li>Real-time execution monitoring</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </Content>
</Layout>

@code {
    [Parameter] public string Token { get; set; } = string.Empty;

    private bool loading = true;
    private bool isValid = false;
    private bool isAuthenticated = false;
    private bool matchesEmail = false;
    private bool requirePasswordSetup = false;
    private string inviteEmail = string.Empty;
    private string inviteRole = string.Empty;
    private string inviteProjectName = string.Empty;
    private string error = string.Empty;
    private bool submitting = false;

    private bool showSuccess = false;
    private bool showFailure = false;
    private string failureMessage = string.Empty;

    private string loginUrl => $"/authentication/login?returnUrl={Uri.EscapeDataString(Nav.Uri)}";

    private FormModel form = new();

    protected override async Task OnInitializedAsync()
    {
        loading = true;

        try
        {
            var resp = await Http.GetAsync($"api/invitations/validate/{Token}");
            if (!resp.IsSuccessStatusCode)
            {
                isValid = false;
                loading = false;
                return;
            }

            var info = await resp.Content.ReadFromJsonAsync<InviteInfo>();
            if (info == null)
            {
                isValid = false;
                loading = false;
                return;
            }

            inviteEmail = info.email;
            inviteRole = info.role;
            inviteProjectName = info.projectName; // now display name
            requirePasswordSetup = info.requirePasswordSetup;

            isValid = true;

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            isAuthenticated = user.Identity?.IsAuthenticated == true;

            if (isAuthenticated)
            {
                var userEmail = this.ClaimUtilityService.GetUserEmail(user);
                matchesEmail = this.ClaimUtilityService.EmailsMatch(userEmail, inviteEmail);

                if (matchesEmail)
                {
                    // call server accept endpoint - authenticated path
                    var acceptResp = await Http.PostAsync($"api/invitations/accept/{Token}", null);
                    if (acceptResp.IsSuccessStatusCode)
                    {
                        showSuccess = true;
                        await Task.Delay(800);
                        Nav.NavigateTo("/projects", true);
                        return;
                    }
                    else
                    {
                        showFailure = true;
                        failureMessage = "Failed to accept invitation.";
                    }
                }
            }
        }
        catch (Exception ex)
        {
            isValid = false;
            error = "An error occurred while validating the invitation.";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OnSubmitAsync()
    {
        error = string.Empty;
        showFailure = false;
        showSuccess = false;
        submitting = true;

        if (form.Password != form.ConfirmPassword)
        {
            error = "Passwords do not match";
            submitting = false;
            return;
        }

        try
        {
            var payload = new
            {
                Name = string.IsNullOrWhiteSpace(form.Name) ? null : form.Name,
                Password = form.Password
            };

            var resp = await Http.PostAsJsonAsync($"api/invitations/accept/{Token}/complete", payload);
            if (resp.IsSuccessStatusCode)
            {
                showSuccess = true;
                await Task.Delay(800);
                Nav.NavigateTo("/projects", true);
                return;
            }

            var body = await resp.Content.ReadFromJsonAsync<Dictionary<string, object?>>();
            if (body != null && body.TryGetValue("message", out var msg))
            {
                error = msg?.ToString() ?? "Failed to complete invitation";
            }
            else
            {
                error = "Failed to complete invitation";
            }

            showFailure = true;
            failureMessage = error;
        }
        catch
        {
            showFailure = true;
            failureMessage = "An error occurred while completing the invitation.";
        }
        finally
        {
            submitting = false;
        }
    }

    private class InviteInfo
    {
        public Guid projectId { get; set; }
        public string projectName { get; set; } = string.Empty;
        public string email { get; set; } = string.Empty;
        public string role { get; set; } = string.Empty;
        public Guid invitedBy { get; set; }
        public bool requirePasswordSetup { get; set; }
    }

    private class FormModel
    {
        public string? Name { get; set; }
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}