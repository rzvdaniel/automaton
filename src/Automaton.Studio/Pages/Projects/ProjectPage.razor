@page "/projects/{ProjectId}"
@using AntDesign
@using Automaton.Studio.Enums
@using Automaton.Studio.Pages.Projects.Components;
@using Automaton.Studio.Services

@inject ProjectContextService ProjectContextService

<Layout>
    <Header Class="header">
        <Row>
            <Col Flex=@("none")>
                <Space Size="SpaceSize.Large">
                    <SpaceItem Class="header-item">
                        <Breadcrumb>
                            <BreadcrumbItem Href="/">
                                <Icon Type="home" Width="16" Height="16" />
                                <span>Home</span>
                            </BreadcrumbItem>
                            <BreadcrumbItem Href="/projects">
                                <Icon Type="team" Width="16" Height="16" />
                                <span>Projects</span>
                            </BreadcrumbItem>
                            <BreadcrumbItem>
                                <Icon Type="project" Width="16" Height="16" />
                                <span>@(ViewModel.Project?.DisplayName ?? "Loading...")</span>
                            </BreadcrumbItem>
                        </Breadcrumb>
                    </SpaceItem>
                    
                    @if (ViewModel.Project != null)
                    {
                        <SpaceItem>
                            <Tag Color="@GetRoleColor(ViewModel.Membership?.Role)">
                                @ViewModel.Membership?.Role
                            </Tag>
                        </SpaceItem>
                    }
                </Space>
            </Col>
        </Row>
    </Header>

    <Content Class="content-padding content-background">
        @if (ViewModel.IsLoading)
        {
            <div style="text-align: center; padding: 100px 0;">
                <Spin Size="@SpinSize.Large" />
                <div style="margin-top: 16px;">Loading project...</div>
            </div>
        }
        else if (ViewModel.Project == null)
        {
            <Result Status="@ResultStatus.Http404"
                    Title="Project Not Found"
                    SubTitle="The project you're looking for doesn't exist or you don't have access to it.">
                <Extra>
                    <Button Type="@ButtonType.Primary" OnClick="@(() => NavigationManager.NavigateTo("/projects"))">
                        Back to Projects
                    </Button>
                </Extra>
            </Result>
        }
        else
        {
            <div class="project-settings-container">
                <!-- Project Header -->
                <div style="margin-bottom: 24px;">
                    <Title Level="2" Style="margin-bottom: 8px;">@ViewModel.Project.DisplayName</Title>
                    @if (!string.IsNullOrEmpty(ViewModel.Project.Description))
                    {
                        <Paragraph>
                            <Text Type="@TextElementType.Secondary">
                                @ViewModel.Project.Description
                            </Text>
                        </Paragraph>
                    }
                </div>

                <!-- Tabs -->
                <Tabs ActiveKey="@ActiveTab" OnChange="@OnTabChange">
                    <TabPane Key="members" Tab="Members">
                        <Icon Type="user" />
                        <MembersTab ViewModel="@ViewModel" />
                    </TabPane>

                    <TabPane Key="apps" Tab="Apps">
                        <Icon Type="appstore" />
                        <AppsTab ViewModel="@ViewModel" />
                    </TabPane>

                    <TabPane Key="flows" Tab="Flows">
                        <Icon Type="branches" />
                        <FlowsTab ViewModel="@ViewModel" />
                    </TabPane>

                    <TabPane Key="runners" Tab="Runners">
                        <Icon Type="robot" />
                        <RunnersTab ViewModel="@ViewModel" />
                    </TabPane>

                    <TabPane Key="customsteps" Tab="Custom Steps">
                        <Icon Type="code" />
                        <CustomStepsTab ViewModel="@ViewModel" />
                    </TabPane>

                    <TabPane Key="apikeys" Tab="API Keys">
                        <Icon Type="key" />
                        <ApiKeysTab ViewModel="@ViewModel" />
                    </TabPane>

                    <TabPane Key="aiapikeys" Tab="AI API Keys">
                        <Icon Type="robot" />
                        <AiApiKeysTab ViewModel="@ViewModel" />
                    </TabPane>

                    @if (ViewModel.IsProjectAdmin)
                    {
                        <TabPane Key="settings" Tab="Settings">
                            <Icon Type="setting" />
                            <SettingsTab ViewModel="@ViewModel" />
                        </TabPane>
                    }
                </Tabs>
            </div>
        }
    </Content>
</Layout>

@code {
    private string ActiveTab { get; set; } = "members";

    private void OnTabChange(string key)
    {
        ActiveTab = key;
    }

    private string GetRoleColor(ProjectRole? role)
    {
        return role switch
        {
            ProjectRole.ProjectAdmin => "red",
            ProjectRole.Developer => "blue",
            ProjectRole.AppUser => "green",
            ProjectRole.Viewer => "default",
            _ => "default"
        };
    }
}
