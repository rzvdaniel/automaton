@page "/customsteps"
@using AntDesign

<Layout>
    <Header Class="header">
        <Row>
            <Col Flex=@("none") Class="page-title">
                <Space Size="SpaceSize.Large">
                    <SpaceItem Class="header-item">
                    <Breadcrumb>
                        <BreadcrumbItem Href="/">
                            <Icon Type="home" Width="16" Height="16" />
                            <span>Home</span>
                        </BreadcrumbItem>
                        <BreadcrumbItem>
                            <Icon Type="experiment" Width="16" Height="16" />
                            <span>Steps</span>
                        </BreadcrumbItem>
                    </Breadcrumb>
                    </SpaceItem>
                </Space>
            </Col>

            <Col Class="right-actions">
                <Space Class="right-header-items">
                    @if (CustomStepsViewModel.CanManageCustomSteps)
                    {
                        <SpaceItem>
                            <Tooltip Title="New custom step">
                                <Button Type="@ButtonType.Primary" Icon="plus" OnClick="@(() => ShowNewCustomStepDialog())">
                                    Create Step
                                </Button>
                            </Tooltip>
                        </SpaceItem>
                    }
                </Space>
            </Col>
        </Row>

    </Header>

    <Content Class="content-padding content-background">
        @if (!loading && CustomStepsViewModel.CustomSteps?.Any() != true)
        {
            <EnhancedEmpty Title="Custom Steps in minutes." 
                          Description="Custom Steps are reusable building blocks for your workflows. Each step you create is a new automation component you can use, either standalone or as part of larger workflows."
                          BackgroundImageUrl="https://images.unsplash.com/photo-1461749280684-dccba630e2f6?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80"
                          GradientOverlay="linear-gradient(135deg, rgba(139, 92, 246, 0.85) 0%, rgba(124, 58, 237, 0.85) 100%)"
                          ActionCardTitle="Build Custom Steps"
                          ActionCardDescription="Create powerful automation components using your preferred scripting language."
                          ActionCardBulletPoints="@GetCustomStepActionCardBullets()"
                          FeatureSectionTitle="Powerful automation steps anyone can create in seconds!"
                          FeatureSectionSubtitle="Create custom steps using Python, PowerShell, or Batch scripts"
                          HelpSectionTitle="Learn more about Custom Steps"
                          PrimaryAction="@(CustomStepsViewModel.CanManageCustomSteps ? new EnhancedEmpty.EmptyActionModel { Text = "Create Step", Icon = "plus", OnClick = () => ShowNewCustomStepDialog() } : null)"
                          SecondaryActions="@GetCustomStepSecondaryActions()"
                          FeatureCards="@GetCustomStepFeatureCards()"
                          HelpLinks="@GetCustomStepHelpLinks()">
                <VisualMockup>
                    <CodeEditorMockup Language="python" 
                                     FileName="custom_step.py" 
                                     FunctionName="execute_step" 
                                     Comment="Custom automation logic" 
                                     ReturnValue="completed" />
                </VisualMockup>
            </EnhancedEmpty>
        }
        else
        {
            <Tabs DefaultActiveKey="@GetDefaultTabKey()" OnChange="@OnTabChange" Style="margin-bottom: 16px;">
                <TabPane Key="flow-steps" Tab="Flow Steps">
                    <Badge Count="@GetFlowStepsCount()" Style="margin-left: 8px;" />
                </TabPane>
                <TabPane Key="app-steps" Tab="App Steps">
                    <Badge Count="@GetAppStepsCount()" Style="margin-left: 8px;" />
                </TabPane>
                <TabPane Key="all" Tab="All Steps">
                    <Badge Count="@GetAllStepsCount()" Style="margin-left: 8px;" />
                </TabPane>
            </Tabs>

            <Table TItem="CustomStepListItem" DataSource="@CustomStepsViewModel.CustomSteps" Class="autoscroll-list" Loading="@loading">
            <Column Title="Name" @bind-Field="@context.Name">
                <Space>
                    <SpaceItem>@context.Name</SpaceItem>
                    @if (context.LinkedAppCount > 0)
                    {
                        <SpaceItem>
                            <Tooltip Title="@($"Linked to {context.LinkedAppCount} app(s)")">
                                <Tag Color="@("blue")">
                                    <Icon Type="appstore" Theme="IconThemeType.Outline" Style="margin-right: 4px;" />
                                    @context.LinkedAppCount
                                </Tag>
                            </Tooltip>
                        </SpaceItem>
                    }
                </Space>
            </Column>

            <Column Title="Created" @bind-Field="@context.Created">
                @context.Created
            </Column>

            <Column Title="Updated" @bind-Field="@context.Updated">
                @context.Updated
            </Column>

            <ActionColumn Title="Action">
                <div>
                    <Space>
                        <SpaceItem>
                            <Tooltip Title="Edit step">
                                <Button Icon="edit" @onclick="@(() => EditCustomStep(context.Id))">Edit</Button>
                            </Tooltip>
                        </SpaceItem>
                    </Space>

                    <Dropdown Placement="@Placement.Bottom" Trigger="@(new Trigger[] { Trigger.Click })">
                        <Overlay>
                            <Menu>
                                <Popconfirm Title="Sure to delete?"
                                            OnConfirm="()=> DeleteCustomStep(context.Id)"
                                            OkText="Yes"
                                            CancelText="No">
                                    <MenuItem Icon="delete">                               
                                        Delete
                                    </MenuItem>
                                </Popconfirm>
                            </Menu>
                        </Overlay>
                        <ChildContent>
                            <Tooltip Title="More actions">
                                <a href="#" @onclick:preventDefault @onmousedown:stopPropagation>
                                    <Icon Type="more" Theme="IconThemeType.Outline" />
                                </a>
                            </Tooltip>
                        </ChildContent>
                    </Dropdown>
                </div>
            </ActionColumn>
        </Table>
        }
    </Content>
</Layout>


