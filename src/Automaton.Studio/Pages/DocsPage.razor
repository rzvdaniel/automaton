@page "/docs"
@page "/docs/{*path}"

<Layout>
    <Content Class="site-layout-background" Style="padding: 0; min-height: calc(100vh - 64px);">
        <div style="height: calc(100vh - 64px); width: 100%;">
            <iframe src="/docs/index.html" 
                    style="width: 100%; height: 100%; border: none; display: block;" 
                    title="Automaton Documentation">
            </iframe>
        </div>
    </Content>
</Layout>

@code {
    [Parameter] public string? Path { get; set; }
}