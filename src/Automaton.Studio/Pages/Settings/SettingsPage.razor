@page "/settings"
@using Automaton.Studio.Services
@inject OnboardingService OnboardingService
@inject NavigationManager NavigationManager

<Layout>
    <Header Class="header">
        <Row>
            <Col Flex=@("none")>
            <Space Size="SpaceSize.Large">
                <SpaceItem Class="header-item">
                    <Breadcrumb>
                        <BreadcrumbItem Href="/">
                            <Icon Type="home" Width="16" Height="16" />
                            <span>Home</span>
                        </BreadcrumbItem>
                        <BreadcrumbItem>
                            <Icon Type="setting" Width="16" Height="16" />
                            <span>Settings</span>
                        </BreadcrumbItem>
                    </Breadcrumb>
                </SpaceItem>
            </Space>
            </Col>
        </Row>
    </Header>

    <Content Class="content-padding home-content content-background">
        <div class="home-container">
            
            <!-- Header Section -->
            <div class="settings-header">
                <div class="settings-header-content">
                    <div class="settings-header-icon">
                        <Icon Type="setting" Style="font-size: 48px; color: white;" />
                    </div>
                    <div class="settings-header-text">
                        <Title Level="1" Style="margin-bottom: 8px;">Settings</Title>
                        <Paragraph Class="settings-subtitle">
                            Configure your Automaton workspace and manage your preferences.
                        </Paragraph>
                    </div>
                </div>
            </div>

            <!-- Settings Content -->
            <div class="settings-content">
                
                <!-- Getting Started Section -->
                <div class="section">
                    <Card Title="Getting Started & Setup" Class="settings-card" Bordered="true">
                        <Extra>
                            <Icon Type="question-circle" Style="color: #1890ff;" />
                        </Extra>
                        <ChildContent>
                            <Space Direction="SpaceDirection.Vertical" Style="width: 100%;">
                                <SpaceItem>
                                    <Paragraph>
                                        Access the setup guide to configure Automaton or troubleshoot your installation.
                                    </Paragraph>
                                </SpaceItem>
                                <SpaceItem>
                                    <Space>
                                        <SpaceItem>
                                            <Button Type="@ButtonType.Primary" OnClick="@(() => NavigationManager.NavigateTo("/onboarding"))">
                                                <Icon Type="play-circle" />
                                                Get Started
                                            </Button>
                                        </SpaceItem>
                                    </Space>
                                </SpaceItem>
                                <SpaceItem>
                                    <Alert Type="@AlertType.Info" 
                                           Message="Setup Status" 
                                           Description="@setupStatusMessage"
                                           ShowIcon="true" />
                                </SpaceItem>
                            </Space>
                        </ChildContent>
                    </Card>
                </div>

                <!-- Quick Actions Section -->
                <div class="section">
                    <Card Title="Quick Actions" Class="settings-card" Bordered="true">
                        <Extra>
                            <Icon Type="thunderbolt" Style="color: #52c41a;" />
                        </Extra>
                        <ChildContent>
                            <Space Wrap="true">
                                <SpaceItem>
                                    <Button OnClick="@(() => NavigationManager.NavigateTo("/flows"))">
                                        <Icon Type="profile" />
                                        Manage Flows
                                    </Button>
                                </SpaceItem>
                                <SpaceItem>
                                    <Button OnClick="@(() => NavigationManager.NavigateTo("/runners"))">
                                        <Icon Type="play-square" />
                                        Manage Runners
                                    </Button>
                                </SpaceItem>
                                <SpaceItem>
                                    <Button OnClick="@(() => NavigationManager.NavigateTo("/customsteps"))">
                                        <Icon Type="experiment" />
                                        Manage Steps
                                    </Button>
                                </SpaceItem>
                                <SpaceItem>
                                    <Button OnClick="@(() => NavigationManager.NavigateTo("/apikeys"))">
                                        <Icon Type="key" />
                                        API Keys
                                    </Button>
                                </SpaceItem>
                            </Space>
                        </ChildContent>
                    </Card>
                </div>

                <!-- System Information Section -->
                <div class="section">
                    <Card Title="System Information" Class="settings-card" Bordered="true">
                        <Extra>
                            <Icon Type="info-circle" Style="color: #722ed1;" />
                        </Extra>
                        <ChildContent>
                            <Space Direction="SpaceDirection.Vertical" Style="width: 100%;">
                                <SpaceItem>
                                    <Paragraph>
                                        View system information and application details.
                                    </Paragraph>
                                </SpaceItem>
                                <SpaceItem>
                                    <Space>
                                        <SpaceItem>
                                            <Button OnClick="@(() => NavigationManager.NavigateTo("/debug/onboarding"))">
                                                <Icon Type="bug" />
                                                Debug Onboarding
                                            </Button>
                                        </SpaceItem>
                                        <SpaceItem>
                                            <Button OnClick="@(() => NavigationManager.NavigateTo("/admin/onboarding"))">
                                                <Icon Type="crown" />
                                                Admin Tools
                                            </Button>
                                        </SpaceItem>
                                    </Space>
                                </SpaceItem>
                            </Space>
                        </ChildContent>
                    </Card>
                </div>

            </div>
        </div>
    </Content>
</Layout>

@code {
    private string setupStatusMessage = "Checking setup status...";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CheckSetupStatus();
        }
    }

    private async Task CheckSetupStatus()
    {
        try
        {
            var hasRunners = await OnboardingService.HasRegisteredRunnersAsync();
            var shouldShow = await OnboardingService.ShouldShowOnboardingAsync();
            
            if (hasRunners)
            {
                setupStatusMessage = "✅ Setup completed! You have registered runners and can create workflows.";
            }
            else if (shouldShow)
            {
                setupStatusMessage = "⚠️ Setup incomplete. No runners registered yet. Complete the setup guide to get started.";
            }
            else
            {
                setupStatusMessage = "ℹ️ No runners registered. Visit the setup guide when you're ready.";
            }
        }
        catch
        {
            setupStatusMessage = "❓ Unable to check runner status. Please try again later.";
        }
        
        StateHasChanged();
    }

    private void OpenExternalLink(string path)
    {
        NavigationManager.NavigateTo(path, true);
    }
}