@page "/settings"
@using Automaton.Core.Scripting.Engines
@using Automaton.Studio.Services
@using Automaton.Core.Scripting
@inject OnboardingService OnboardingService
@inject NavigationManager NavigationManager
@inject ConfigurationService ConfigurationService
@inject DesktopSettingsService DesktopSettingsService
@inject DesktopScriptEngineSettingsInitializer SettingsInitializer
@inject IMessageService MessageService

<Layout>
    <Header Class="header">
        <Row>
            <Col Flex=@("none")>
            <Space Size="SpaceSize.Large">
                <SpaceItem Class="header-item">
                    <Breadcrumb>
                        <BreadcrumbItem Href="/">
                            <Icon Type="home" Width="16" Height="16" />
                            <span>Home</span>
                        </BreadcrumbItem>
                        <BreadcrumbItem>
                            <Icon Type="setting" Width="16" Height="16" />
                            <span>Settings</span>
                        </BreadcrumbItem>
                    </Breadcrumb>
                </SpaceItem>
            </Space>
            </Col>
        </Row>
    </Header>

    <Content Class="content-padding home-content content-background">
        <div class="home-container">
            
            <!-- Header Section -->
            <div class="settings-header">
                <div class="settings-header-content">
                    <div class="settings-header-icon">
                        <Icon Type="setting" Style="font-size: 48px; color: white;" />
                    </div>
                    <div class="settings-header-text">
                        <Title Level="1" Style="margin-bottom: 8px;">Settings</Title>
                        <Paragraph Class="settings-subtitle">
                            Configure your Automaton workspace and manage your preferences.
                        </Paragraph>
                    </div>
                </div>
            </div>

            <!-- Settings Content -->
            <div class="settings-content">
                
                <!-- Python Engine Settings (Desktop Only) -->
                @if (ConfigurationService.IsDesktop)
                {
                    <div class="section">
                        <Card Title="Python Engine Settings" Class="settings-card" Bordered="true">
                            <Extra>
                                <Icon Type="code" Style="color: #1890ff;" />
                            </Extra>
                            <ChildContent>
                                <Form Model="dummyModel">
                                    <Space Direction="SpaceDirection.Vertical" Style="width:100%;" Size="@SpaceSize.Large">
                                        <SpaceItem>
                                            <Alert Type="@AlertType.Info" ShowIcon="true" Closable="false">
                                                <MessageTemplate>
                                                    <Text>Configure Python.NET settings for the desktop application. These settings control how Python scripts are executed in custom steps.</Text>
                                                </MessageTemplate>
                                            </Alert>
                                        </SpaceItem>
                                        <SpaceItem>
                                            <FormItem Label="Python Package Paths">
                                                <Space Direction="SpaceDirection.Vertical" Style="width:100%;">
                                                    @foreach (var (path, index) in pythonPaths.Select((p, i) => (p, i)))
                                                    {
                                                        <SpaceItem Style="width:100%;">
                                                            <Space Style="width:100%;">
                                                                <SpaceItem Style="flex:1;">
                                                                    <Input @bind-Value="pythonPaths[index]" 
                                                                           Placeholder="e.g., C:\Python312\Lib\site-packages"
                                                                           Style="width:100%;" />
                                                                </SpaceItem>
                                                                <SpaceItem>
                                                                    <Button Danger 
                                                                            Icon="delete" 
                                                                            Size="@ButtonSize.Small"
                                                                            OnClick="() => RemovePythonPath(index)"
                                                                            Disabled="@(pythonPaths.Count <=1)" />
                                                                </SpaceItem>
                                                            </Space>
                                                        </SpaceItem>
                                                    }
                                                    <SpaceItem>
                                                        <Button Type="@ButtonType.Dashed" 
                                                                Icon="plus" 
                                                                Block 
                                                                OnClick="AddPythonPath">
                                                            Add Path
                                                        </Button>
                                                    </SpaceItem>
                                                </Space>
                                                <Text Type="@TextElementType.Secondary" Style="font-size:12px;">
                                                    Additional Python package search paths (e.g., custom site-packages directories). These take priority over auto-detected paths.
                                                </Text>
                                            </FormItem>
                                        </SpaceItem>

                                        <SpaceItem>
                                            <Divider>Detected Python Environment (Read-Only)</Divider>
                                            <Descriptions Bordered Size="@DescriptionsSize.Small" Column="1">
                                                <DescriptionsItem Title="Auto-Detected Python Paths">
                                                    @if (pythonSettings.AutoDetectedPythonPaths?.Any() == true)
                                                    {
                                                        <ul>
                                                        @foreach (var path in pythonSettings.AutoDetectedPythonPaths)
                                                        {
                                                            <li>@path</li>
                                                        }
                                                        </ul>
                                                    }
                                                    else
                                                    {
                                                        <span>-</span>
                                                    }
                                                </DescriptionsItem>
                                                <DescriptionsItem Title="Python Version">@(pythonSettings.PythonVersion ?? "-")</DescriptionsItem>
                                                <DescriptionsItem Title="Python Executable">@(pythonSettings.PythonExecutablePath ?? "-")</DescriptionsItem>
                                                <DescriptionsItem Title="Python DLL Path">@(pythonSettings.PythonDllPath ?? "-")</DescriptionsItem>
                                                <DescriptionsItem Title="Architecture">@(pythonSettings.DetectedArchitecture ?? "-")</DescriptionsItem>
                                                <DescriptionsItem Title="Distributions">
                                                    @if (pythonSettings.DetectedDistributions?.Any() == true)
                                                    {
                                                        <ul>
                                                        @foreach (var dist in pythonSettings.DetectedDistributions)
                                                        {
                                                            <li>@dist</li>
                                                        }
                                                        </ul>
                                                    }
                                                    else
                                                    {
                                                        <span>-</span>
                                                    }
                                                </DescriptionsItem>
                                                <DescriptionsItem Title="Site-Packages Paths">
                                                    @if (pythonSettings.DetectedSitePackagesPaths?.Any() == true)
                                                    {
                                                        <ul>
                                                        @foreach (var sp in pythonSettings.DetectedSitePackagesPaths)
                                                        {
                                                            <li>@sp</li>
                                                        }
                                                        </ul>
                                                    }
                                                    else
                                                    {
                                                        <span>-</span>
                                                    }
                                                </DescriptionsItem>
                                                <DescriptionsItem Title="Is Auto Detection Successful">@((pythonSettings.IsAutoDetectionSuccessful == true) ? "Yes" : "No")</DescriptionsItem>
                                                <DescriptionsItem Title="Notes">@(pythonSettings.Notes ?? "-")</DescriptionsItem>
                                                <DescriptionsItem Title="Environment Variables">
                                                    @if (pythonSettings.EnvironmentVariables?.Any() == true)
                                                    {
                                                        <ul>
                                                        @foreach (var kv in pythonSettings.EnvironmentVariables)
                                                        {
                                                            <li><b>@kv.Key</b>: @kv.Value</li>
                                                        }
                                                        </ul>
                                                    }
                                                    else
                                                    {
                                                        <span>-</span>
                                                    }
                                                </DescriptionsItem>
                                            </Descriptions>
                                        </SpaceItem>
                                        <SpaceItem>
                                            <Space>
                                                <SpaceItem>
                                                    <Button Type="@ButtonType.Primary" 
                                                            Icon="save" 
                                                            Loading="@isSavingPythonSettings"
                                                            OnClick="SavePythonSettings">
                                                        Save Settings
                                                    </Button>
                                                </SpaceItem>
                                                <SpaceItem>
                                                    <Button Icon="reload" 
                                                            OnClick="LoadPythonSettings">
                                                        Reset
                                                    </Button>
                                                </SpaceItem>
                                            </Space>
                                        </SpaceItem>
                                    </Space>
                                </Form>
                            </ChildContent>
                        </Card>
                    </div>
                }
                
                <!-- Getting Started Section -->
                <div class="section">
                    <Card Title="Getting Started & Setup" Class="settings-card" Bordered="true">
                        <Extra>
                            <Icon Type="question-circle" Style="color: #1890ff;" />
                        </Extra>
                        <ChildContent>
                            <Space Direction="SpaceDirection.Vertical" Style="width: 100%;">
                                <SpaceItem>
                                    <Paragraph>
                                        Access the setup guide to configure Automaton or troubleshoot your installation.
                                    </Paragraph>
                                </SpaceItem>
                                
                                @if (!hasRunners)
                                {
                                    <!-- Setup Incomplete Alert with Action -->
                                    <SpaceItem>
                                        <Alert Type="@AlertType.Warning" ShowIcon="true" Closable="false" Style="border: 2px solid #faad14;">
                                            <MessageTemplate>
                                                <div style="display: flex; align-items: center; justify-content: space-between; width: 100%;">
                                                    <div>
                                                        <Text Strong>⚡ Setup Required to Create Workflows</Text>
                                                        <br />
                                                        <Text Type="@TextElementType.Secondary">No runners registered yet. Complete the setup guide to unlock automation features.</Text>
                                                    </div>
                                                    <div style="flex-shrink: 0; margin-left: 16px;">
                                                        <Button Type="@ButtonType.Primary" Size="@ButtonSize.Small" OnClick="@(() => NavigationManager.NavigateTo("/onboarding"))">
                                                            <Icon Type="play-circle" />
                                                            Complete Setup
                                                        </Button>
                                                    </div>
                                                </div>
                                            </MessageTemplate>
                                        </Alert>
                                    </SpaceItem>
                                }
                                else
                                {
                                    <!-- Setup Complete Info -->
                                    <SpaceItem>
                                        <Alert Type="@AlertType.Success" ShowIcon="true" Closable="false">
                                            <MessageTemplate>
                                                <div style="display: flex; align-items: center; justify-content: space-between; width: 100%;">
                                                    <div>
                                                        <Text Strong>✅ Setup Complete!</Text>
                                                        <br />
                                                        <Text Type="@TextElementType.Secondary">You have registered runners and can create workflows. Need help? Access the setup guide for troubleshooting.</Text>
                                                    </div>
                                                    <div style="flex-shrink: 0; margin-left: 16px;">
                                                        <Button Size="@ButtonSize.Small" OnClick="@(() => NavigationManager.NavigateTo("/onboarding"))">
                                                            <Icon Type="book" />
                                                            View Guide
                                                        </Button>
                                                    </div>
                                                </div>
                                            </MessageTemplate>
                                        </Alert>
                                    </SpaceItem>
                                }
                            </Space>
                        </ChildContent>
                    </Card>
                </div>

                <!-- Quick Actions Section -->
                <div class="section">
                    <Card Title="Quick Actions" Class="settings-card" Bordered="true">
                        <Extra>
                            <Icon Type="thunderbolt" Style="color: #52c41a;" />
                        </Extra>
                        <ChildContent>
                            <Space Wrap="true">
                                <SpaceItem>
                                    <Button OnClick="@(() => NavigationManager.NavigateTo("/flows"))">
                                        <Icon Type="profile" />
                                        Manage Flows
                                    </Button>
                                </SpaceItem>
                                <SpaceItem>
                                    <Button OnClick="@(() => NavigationManager.NavigateTo("/runners"))">
                                        <Icon Type="play-square" />
                                        Manage Runners
                                    </Button>
                                </SpaceItem>
                                <SpaceItem>
                                    <Button OnClick="@(() => NavigationManager.NavigateTo("/customsteps"))">
                                        <Icon Type="experiment" />
                                        Manage Steps
                                    </Button>
                                </SpaceItem>
                                <SpaceItem>
                                    <Button OnClick="@(() => NavigationManager.NavigateTo("/apikeys"))">
                                        <Icon Type="key" />
                                        API Keys
                                    </Button>
                                </SpaceItem>
                                <SpaceItem>
                                    <Button OnClick="@(() => NavigationManager.NavigateTo("/downloads"))">
                                        <Icon Type="download" />
                                        Downloads
                                    </Button>
                                </SpaceItem>
                                <SpaceItem>
                                    <Button OnClick="@(() => NavigationManager.NavigateTo("/account"))">
                                        <Icon Type="user" />
                                        Account Settings
                                    </Button>
                                </SpaceItem>
                            </Space>
                        </ChildContent>
                    </Card>
                </div>

            </div>
        </div>
    </Content>
</Layout>

@code {
    private bool hasRunners = false;
    private bool isSavingPythonSettings = false;
    
    private List<string> pythonPaths = new List<string> { "" };
    private PythonEngineSettings pythonSettings = new();
    // Dummy model for Form component
    private object dummyModel = new { };

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        
        // Load Python settings if in desktop mode
        if (ConfigurationService.IsDesktop)
        {
            await LoadPythonSettings();
        }
    }

    private async Task LoadPythonSettings()
    {
        try
        {
            var settings = await DesktopSettingsService.GetPythonSettingsAsync();
            
            if (settings != null)
            {
                pythonSettings = settings;
                pythonPaths = settings.PythonPaths?.Any() == true 
                    ? new List<string>(settings.PythonPaths) 
                    : new List<string> { "" };
            }
            else
            {
                pythonSettings = new PythonEngineSettings();
                pythonPaths = new List<string> { "" };
            }
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            MessageService.Error($"Failed to load Python settings: {ex.Message}");
        }
    }

    private async Task SavePythonSettings()
    {
        try
        {
            isSavingPythonSettings = true;
            StateHasChanged();

            var settings = new PythonEngineSettings
            {
                PythonPaths = pythonPaths
                    .Where(p => !string.IsNullOrWhiteSpace(p))
                    .ToList()
            };

            var success = await DesktopSettingsService.SavePythonSettingsAsync(settings);
            
            if (success)
            {
                // Reload settings into the singleton configuration immediately
                await SettingsInitializer.ReloadSettingsAsync();
                
                MessageService.Success("Python settings saved and applied successfully! Settings are now active.");
            }
            else
            {
                MessageService.Error("Failed to save Python settings. Please try again.");
            }
        }
        catch (Exception ex)
        {
            MessageService.Error($"Error saving Python settings: {ex.Message}");
        }
        finally
        {
            isSavingPythonSettings = false;
            StateHasChanged();
        }
    }

    private void AddPythonPath()
    {
        pythonPaths.Add("");
        StateHasChanged();
    }

    private void RemovePythonPath(int index)
    {
        if (pythonPaths.Count >1)
        {
            pythonPaths.RemoveAt(index);
            StateHasChanged();
        }
    }
}