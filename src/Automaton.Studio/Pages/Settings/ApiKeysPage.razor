@page "/settings/api-keys"
@using Automaton.Studio.Models

<PageTitle>API Keys - Automaton Studio</PageTitle>

<Layout>
    <Header Class="header">
        <Row>
            <Col Flex=@("none")>
                <Space Size="SpaceSize.Large">
                    <SpaceItem Class="header-item">
                        <Breadcrumb>
                            <BreadcrumbItem Href="/">
                                <Icon Type="home" Width="16" Height="16" />
                                <span>Home</span>
                            </BreadcrumbItem>
                            <BreadcrumbItem>
                                <Icon Type="key" Width="16" Height="16" />
                                <span>API Keys</span>
                            </BreadcrumbItem>
                        </Breadcrumb>
                    </SpaceItem>
                </Space>
            </Col>

            <Col Class="right-actions">
                <Space Class="right-header-items">
                    <SpaceItem>
                        <Tooltip Title="New API Key">
                            <Button Type="@ButtonType.Primary" Icon="plus" Class="header-button" OnClick="@(() => ShowCreateModal())">
                                Create API Key
                            </Button>
                        </Tooltip>
                    </SpaceItem>
                </Space>
            </Col>
        </Row>
    </Header>

    <Content>
        <div class="api-keys-container">
            
            @if (loading)
            {
                <div class="loading-container">
                    <Spin Size="SpinSize.Large" />
                </div>
            }
            else
            {
                @if (apiKeys?.Any() == true)
                {
                    <Table TItem="ApiKeyResponse" 
                           DataSource="@apiKeys" 
                           PageSize="10">
                        <Column Title="Name" @bind-Field="@context.Name">
                            @context.Name
                        </Column>
                        
                        <Column Title="API Key" @bind-Field="@context.KeyPrefix">
                            <code>@context.KeyPrefix</code>
                        </Column>
                        
                        <Column Title="Scope" @bind-Field="@context.Scope">
                            <span class="@GetScopeClass(context.Scope)">
                                @context.Scope
                            </span>
                        </Column>
                        
                        <Column Title="Created" @bind-Field="@context.CreatedAt">
                            @context.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                        </Column>
                        
                        <Column Title="Last Used" @bind-Field="@context.LastUsedAt">
                            @if (context.LastUsedAt.HasValue)
                            {
                                <span>@context.LastUsedAt.Value.ToString("yyyy-MM-dd HH:mm")</span>
                            }
                            else
                            {
                                <span class="text-secondary">Never</span>
                            }
                        </Column>
                        
                        <Column Title="Status" @bind-Field="@context.IsActive">
                            @if (context.IsActive)
                            {
                                <span class="status-active">Active</span>
                            }
                            else
                            {
                                <span class="status-revoked">Revoked</span>
                            }
                        </Column>
                        
                        <ActionColumn Title="Action">
                            @if (context.IsActive)
                            {
                                <Space>
                                    <SpaceItem>
                                        <Popconfirm Title="Are you sure you want to revoke this API key?"
                                                   OnConfirm="@(() => RevokeApiKey(context.Id))"
                                                   OkText="Yes"
                                                   CancelText="No">
                                            <Button Type="@ButtonType.Text" 
                                                   Danger
                                                   Icon="delete"
                                                   Size="@ButtonSize.Small">
                                                Revoke
                                            </Button>
                                        </Popconfirm>
                                    </SpaceItem>
                                </Space>
                            }
                        </ActionColumn>
                    </Table>
                }
                else
                {
                    <Empty>
                        <DescriptionTemplate>
                            <span>No API keys found</span>
                        </DescriptionTemplate>
                        <ChildContent>
                            <Button Type="@ButtonType.Primary" OnClick="@ShowCreateModal">
                                Create Your First API Key
                            </Button>
                        </ChildContent>
                    </Empty>
                }
            }
        </div>

        <!-- Create API Key Modal -->
        <Modal Title="Create API Key"
               @bind-Visible="createModalVisible"
               OnOk="@CreateApiKey"
               ConfirmLoading="@createLoading"
               Width="600">
            <Form Model="@createRequest" Layout="@FormLayout.Vertical">
                <FormItem Label="Name" Required>
                    <Input @bind-Value="createRequest.Name" Placeholder="e.g., Production Runner Key" />
                </FormItem>
                <FormItem Label="Description">
                    <TextArea @bind-Value="createRequest.Description" 
                             Placeholder="Optional description for this API key"
                             Rows="3" />
                </FormItem>
                <FormItem Label="Scope">
                    <Select @bind-Value="createRequest.Scope" 
                            DefaultValue="ApiKeyScope.Runner" 
                            TItemValue="ApiKeyScope" 
                            TItem="ApiKeyScope">
                        <SelectOptions>
                            <SelectOption TItemValue="ApiKeyScope" TItem="ApiKeyScope" Value="ApiKeyScope.Runner" Label="Runner">
                                <Icon Type="play-circle" /> Runner - Can register and operate runners
                            </SelectOption>
                            <SelectOption TItemValue="ApiKeyScope" TItem="ApiKeyScope" Value="ApiKeyScope.Execute" Label="Execute">
                                <Icon Type="thunderbolt" /> Execute - Can execute workflows
                            </SelectOption>
                            <SelectOption TItemValue="ApiKeyScope" TItem="ApiKeyScope" Value="ApiKeyScope.ReadOnly" Label="ReadOnly">
                                <Icon Type="eye" /> Read Only - Can read flows and executions
                            </SelectOption>
                        </SelectOptions>
                    </Select>
                </FormItem>
                <FormItem Label="Expiration (Optional)">
                    <DatePicker @bind-Value="createRequest.ExpiresAt" 
                               ShowTime="false" />
                </FormItem>
            </Form>
        </Modal>

        <!-- API Key Success Modal -->
        <Modal Title="API Key Created Successfully"
               @bind-Visible="successModalVisible"
               Footer="null"
               Width="700"
               Closable="false">
            <Alert Type="@AlertType.Success" 
                   Message="API Key Created" 
                   Description="Your API key has been created successfully. Copy it now as it won't be shown again."
                   ShowIcon="true" />
            
            <div style="margin-top: 16px;">
                <strong>API Key:</strong>
                <div class="api-key-display">
                    <Input @bind-Value="newApiKey" 
                           ReadOnly="true"
                           Style="font-family: monospace;" />
                    <Button Icon="copy" OnClick="@CopyToClipboard" Style="margin-left: 8px;">Copy</Button>
                </div>
            </div>

            <div style="margin-top: 24px;">
                <strong>Usage Examples:</strong>
                <div style="margin-top: 8px;">
                    <code>automaton-runner auth --api-key @newApiKey</code>
                    <br />
                    <code>export AUTOMATON_API_KEY="@newApiKey"</code>
                </div>
            </div>

            <div style="margin-top: 24px; text-align: right;">
                <Button Type="@ButtonType.Primary" OnClick="@CloseSuccessModal">
                    Done
                </Button>
            </div>
        </Modal>
    </Content>
</Layout>

<style>
    .api-keys-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 24px;
    }

    .loading-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 200px;
    }

    .api-key-display {
        display: flex;
        align-items: center;
        margin-top: 8px;
    }

    .api-key-display .ant-input {
        flex: 1;
        margin-right: 8px;
    }

    .text-secondary {
        color: #8c8c8c;
    }

    .status-active {
        color: #52c41a;
        font-weight: 500;
    }

    .status-revoked {
        color: #ff4d4f;
        font-weight: 500;
    }

    .scope-runner {
        color: #1890ff;
        font-weight: 500;
    }

    .scope-execute {
        color: #52c41a;
        font-weight: 500;
    }

    .scope-readonly {
        color: #fa8c16;
        font-weight: 500;
    }
</style>