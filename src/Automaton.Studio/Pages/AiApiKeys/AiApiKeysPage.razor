@page "/ai-keys"
@using Automaton.Studio.Models

<PageTitle>AI API Keys - Automaton Studio</PageTitle>

<Layout>
    <Header Class="header">
        <Row>
            <Col Flex=@("none")>
                <Space Size="SpaceSize.Large">
                    <SpaceItem Class="header-item">
                        <Breadcrumb>
                            <BreadcrumbItem Href="/">
                                <Icon Type="home" Width="16" Height="16" />
                                <span>Home</span>
                            </BreadcrumbItem>
                            <BreadcrumbItem>
                                <Icon Type="robot" Width="16" Height="16" />
                                <span>AI API Keys</span>
                            </BreadcrumbItem>
                        </Breadcrumb>
                    </SpaceItem>
                </Space>
            </Col>

            <Col Class="right-actions">
                <Space Class="right-header-items">
                    <SpaceItem>
                        <Tooltip Title="New AI API Key">
                            <Button Type="@ButtonType.Primary" Icon="plus" OnClick="@ViewModel.ShowCreateModal">
                                Add AI API Key
                            </Button>
                        </Tooltip>
                    </SpaceItem>
                </Space>
            </Col>
        </Row>
    </Header>

    <Content Class="content-padding content-background">
        @if (ViewModel.Loading)
        {
            <div class="loading-container">
                <Spin Size="SpinSize.Large" />
            </div>
        }
        else
        {
            @if (ViewModel.AiApiKeys?.Any() == true)
            {
                <Table TItem="AiApiKeyModel" 
                       DataSource="@ViewModel.AiApiKeys" 
                       PageSize="10">
                    <Column Title="Name" @bind-Field="@context.Name">
                        <Icon Type="@GetProviderIcon(context.Provider)" Style="margin-right: 8px;" />
                        @context.Name
                    </Column>
                    
                    <Column Title="Provider" @bind-Field="@context.Provider">
                        <span class="@GetProviderClass(context.Provider)">
                            @GetProviderDisplayName(context.Provider)
                        </span>
                    </Column>
                    
                    <Column Title="Model" @bind-Field="@context.Model">
                        @if (!string.IsNullOrEmpty(context.Model))
                        {
                            <code>@context.Model</code>
                        }
                        else
                        {
                            <span class="text-secondary">Default</span>
                        }
                    </Column>
                    
                    <Column Title="Created" @bind-Field="@context.CreatedAt">
                        @context.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                    </Column>
                    
                    <Column Title="Last Used" @bind-Field="@context.LastUsedAt">
                        @if (context.LastUsedAt.HasValue)
                        {
                            <span>@context.LastUsedAt.Value.ToString("yyyy-MM-dd HH:mm")</span>
                        }
                        else
                        {
                            <span class="text-secondary">Never</span>
                        }
                    </Column>
                    
                    <ActionColumn Title="Action">
                        <Space>
                            <SpaceItem>
                                <Popconfirm Title="Are you sure you want to delete this AI API key?"
                                           OnConfirm="@(() => ViewModel.DeleteAiApiKey(context.Id))"
                                           OkText="Yes"
                                           CancelText="No">
                                    <Button Type="@ButtonType.Text" 
                                           Danger
                                           Icon="delete"
                                           Size="@ButtonSize.Small">
                                        Delete
                                    </Button>
                                </Popconfirm>
                            </SpaceItem>
                        </Space>
                    </ActionColumn>
                </Table>
            }
            else
            {
                <Empty>
                    <DescriptionTemplate>
                        <span>No AI API keys found</span>
                    </DescriptionTemplate>
                    <ChildContent>
                        <Button Type="@ButtonType.Primary" OnClick="@ViewModel.ShowCreateModal">
                            Add Your First AI API Key
                        </Button>
                    </ChildContent>
                </Empty>
            }
        }
        
        <!-- Create AI API Key Modal -->
        <Modal Title="Add AI API Key"
               @bind-Visible="ViewModel.CreateModalVisible"
               OnOk="@ViewModel.CreateAiApiKey"
               ConfirmLoading="@ViewModel.CreateLoading"
               Width="700">
            <Form Model="@ViewModel.CreateRequest" Layout="@FormLayout.Vertical">
                <FormItem Label="Provider" Required>
                    <Select @bind-Value="ViewModel.CreateRequest.Provider" 
                            TItemValue="AiProvider" 
                            TItem="AiProvider"
                            OnSelectedItemChanged="OnProviderChanged">
                        <SelectOptions>
                            <SelectOption TItemValue="AiProvider" TItem="AiProvider" Value="AiProvider.OpenAI" Label="OpenAI (GPT-4, ChatGPT)" />
                            <SelectOption TItemValue="AiProvider" TItem="AiProvider" Value="AiProvider.Anthropic" Label="Anthropic (Claude)" />
                            <SelectOption TItemValue="AiProvider" TItem="AiProvider" Value="AiProvider.Google" Label="Google (Gemini)" />
                            <SelectOption TItemValue="AiProvider" TItem="AiProvider" Value="AiProvider.Azure" Label="Azure OpenAI" />
                        </SelectOptions>
                    </Select>
                </FormItem>
                
                <FormItem Label="Name" Required>
                    <Input @bind-Value="ViewModel.CreateRequest.Name" Placeholder="e.g., My OpenAI Key, Production Claude" />
                </FormItem>
                
                <FormItem Label="API Key" Required>
                    <InputPassword @bind-Value="ViewModel.CreateRequest.ApiKey" 
                                  Placeholder="Enter your API key from the provider" />
                    <div class="form-help-text">
                        @GetApiKeyHelpText(ViewModel.CreateRequest.Provider)
                    </div>
                </FormItem>
                
                @if (AvailableModels?.Any() == true)
                {
                    <FormItem Label="Model (Optional)">
                        <Select @bind-Value="ViewModel.CreateRequest.Model" 
                                TItemValue="string" 
                                TItem="string"
                                Placeholder="Select model (leave empty for default)">
                            <SelectOptions>
                                @foreach (var model in AvailableModels)
                                {
                                    <SelectOption TItemValue="string" TItem="string" Value="@model" Label="@model" />
                                }
                            </SelectOptions>
                        </Select>
                    </FormItem>
                }
                
                <FormItem Label="Description (Optional)">
                    <TextArea @bind-Value="ViewModel.CreateRequest.Description" 
                             Placeholder="Optional description for this API key"
                             Rows="3" />
                </FormItem>
            </Form>
        </Modal>
    </Content>
</Layout>

<style>
    .loading-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 200px;
    }

    .text-secondary {
        color: #8c8c8c;
    }

    .provider-openai {
        color: #10a37f;
        font-weight: 500;
    }

    .provider-anthropic {
        color: #d4822a;
        font-weight: 500;
    }

    .provider-google {
        color: #4285f4;
        font-weight: 500;
    }

    .provider-azure {
        color: #0078d4;
        font-weight: 500;
    }

    .provider-custom {
        color: #666;
        font-weight: 500;
    }

    .form-help-text {
        font-size: 12px;
        color: #666;
        margin-top: 4px;
        line-height: 1.4;
    }
</style>

@code {
    private List<string> AvailableModels => ViewModel.CreateRequest.Provider switch
    {
        AiProvider.OpenAI => new List<string> { "gpt-4", "gpt-4-turbo", "gpt-3.5-turbo" },
        AiProvider.Anthropic => new List<string> { "claude-3-sonnet", "claude-3-haiku", "claude-3-opus" },
        AiProvider.Google => new List<string> { "gemini-pro", "gemini-pro-vision", "gemini-1.5-pro" },
        AiProvider.Azure => new List<string> { "gpt-4", "gpt-35-turbo" },
        _ => new List<string>()
    };

    private void OnProviderChanged(AiProvider provider)
    {
        ViewModel.CreateRequest.Model = null; // Reset model selection
        StateHasChanged();
    }

    private string GetProviderIcon(AiProvider provider) => provider switch
    {
        AiProvider.OpenAI => "openai",
        AiProvider.Anthropic => "anthropic", 
        AiProvider.Google => "google",
        AiProvider.Azure => "microsoft",
        _ => "robot"
    };

    private string GetProviderClass(AiProvider provider) => $"provider-{provider.ToString().ToLower()}";

    private string GetProviderDisplayName(AiProvider provider) => provider switch
    {
        AiProvider.OpenAI => "OpenAI",
        AiProvider.Anthropic => "Anthropic",
        AiProvider.Google => "Google",
        AiProvider.Azure => "Azure OpenAI",
        AiProvider.Custom => "Custom",
        _ => provider.ToString()
    };

    private string GetApiKeyHelpText(AiProvider provider) => provider switch
    {
        AiProvider.OpenAI => "Get your API key from: https://platform.openai.com/api-keys",
        AiProvider.Anthropic => "Get your API key from: https://console.anthropic.com/",
        AiProvider.Google => "Get your API key from: https://aistudio.google.com/app/apikey",
        AiProvider.Azure => "Get your API key and endpoint from Azure OpenAI Service",
        _ => "Enter the API key from your AI provider"
    };
}