@page "/ai-keys"
@using Automaton.Studio.Models

<PageTitle>AI API Keys - Automaton Studio</PageTitle>

<Layout>
    <Header Class="header">
        <Row>
            <Col Flex=@("none")>
                <Space Size="SpaceSize.Large">
                    <SpaceItem Class="header-item">
                        <Breadcrumb>
                            <BreadcrumbItem Href="/">
                                <Icon Type="home" Width="16" Height="16" />
                                <span>Home</span>
                            </BreadcrumbItem>
                            <BreadcrumbItem>
                                <Icon Type="robot" Width="16" Height="16" />
                                <span>AI API Keys</span>
                            </BreadcrumbItem>
                        </Breadcrumb>
                    </SpaceItem>
                </Space>
            </Col>

            <Col Class="right-actions">
                <Space Class="right-header-items">
                    @if (ViewModel.CanManageAiApiKeys)
                    {
                        <SpaceItem>
                            <Tooltip Title="New AI API Key">
                                <Button Type="@ButtonType.Primary" Icon="plus" OnClick="@ViewModel.ShowCreateModal">
                                    Add AI API Key
                                </Button>
                            </Tooltip>
                        </SpaceItem>
                    }
                </Space>
            </Col>
        </Row>
    </Header>

    <Content Class="content-padding content-background">
        @if (ViewModel.Loading)
        {
            <div class="loading-container">
                <Spin Size="SpinSize.Large" />
            </div>
        }
        else
        {
            @if (ViewModel.AiApiKeys?.Any() == true)
            {
                <Table TItem="AiApiKeyModel"
                       DataSource="@ViewModel.AiApiKeys"
                       PageSize="10">
                    <Column Title="Name" @bind-Field="@context.Name">
                        <Icon Type="@GetProviderIcon(context.ProviderName)" Style="margin-right: 8px;" />
                        @context.Name
                    </Column>

                    <Column Title="Provider" @bind-Field="@context.ProviderName">
                        <span class="@GetProviderClass(context.ProviderName)">
                            @GetProviderDisplayName(context.ProviderName)
                        </span>
                    </Column>
                    
                    <Column Title="Model" @bind-Field="@context.Model">
                        @if (!string.IsNullOrEmpty(context.Model))
                        {
                            <code>@context.Model</code>
                        }
                        else
                        {
                            <span class="text-secondary">Default</span>
                        }
                    </Column>
                    
                    <Column Title="Created" @bind-Field="@context.CreatedAt">
                        @context.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                    </Column>
                    
                    <Column Title="Last Used" @bind-Field="@context.LastUsedAt">
                        @if (context.LastUsedAt.HasValue)
                        {
                            <span>@context.LastUsedAt.Value.ToString("yyyy-MM-dd HH:mm")</span>
                        }
                        else
                        {
                            <span class="text-secondary">Never</span>
                        }
                    </Column>
                    
                    <ActionColumn Title="Action">
                        <Space>
                            <SpaceItem>
                                <Popconfirm Title="Are you sure you want to delete this AI API key?"
                                           OnConfirm="@(() => ViewModel.DeleteAiApiKey(context.Id))"
                                           OkText="Yes"
                                           CancelText="No">
                                    <Button Type="@ButtonType.Text" 
                                           Danger
                                           Icon="delete"
                                           Size="@ButtonSize.Small">
                                        Delete
                                    </Button>
                                </Popconfirm>
                            </SpaceItem>
                        </Space>
                    </ActionColumn>
                </Table>
            }
            else
            {
                <EnhancedEmpty Title="AI API Keys in minutes." 
                              Description="AI API Keys connect your workflows to powerful AI services like OpenAI, Anthropic, and Google. Each key you add enables AI-powered automation capabilities."
                              BackgroundImageUrl="https://images.unsplash.com/photo-1677442136019-21780ecad995?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80"
                              GradientOverlay="linear-gradient(135deg, rgba(168, 85, 247, 0.85) 0%, rgba(147, 51, 234, 0.85) 100%)"
                              ActionCardTitle="AI Integration"
                              ActionCardDescription="Connect to leading AI providers and enhance your workflows with intelligent automation."
                              ActionCardBulletPoints="@GetAiApiKeyActionCardBullets()"
                              FeatureSectionTitle="AI-powered automation anyone can setup in seconds!"
                              FeatureSectionSubtitle="Connect to leading AI providers and enhance your workflows with intelligence"
                              HelpSectionTitle="Learn more about AI Integration"
                              PrimaryAction="@(new EnhancedEmpty.EmptyActionModel { Text = "Add AI API Key", Icon = "plus", OnClick = () => { ViewModel.ShowCreateModal(); return Task.CompletedTask; } })"
                              SecondaryActions="@GetAiApiKeySecondaryActions()"
                              FeatureCards="@GetAiApiKeyFeatureCards()"
                              HelpLinks="@GetAiApiKeyHelpLinks()">
                    <VisualMockup>
                        <AIVisualMockup />
                    </VisualMockup>
                </EnhancedEmpty>
            }
        }
        
        <!-- Create AI API Key Modal -->
        <Modal Title="Add AI API Key"
               @bind-Visible="ViewModel.CreateModalVisible"
               OnOk="@ViewModel.CreateAiApiKey"
               ConfirmLoading="@ViewModel.CreateLoading"
               Width="700">
            <Form Model="@ViewModel.CreateRequest" Layout="@FormLayout.Vertical">
                <FormItem Label="Provider" Required>
                    <Select @bind-Value="ViewModel.CreateRequest.ProviderName"
                            TItemValue="string"
                            TItem="AiProviderInfo"
                            DataSource="@ViewModel.AvailableProviders"
                            ValueProperty="p => p.ProviderName"
                            LabelProperty="p => p.DisplayName"
                            OnSelectedItemChanged="OnProviderChanged">
                        <ItemTemplate Context="provider">
                            <span>
                                <Icon Type="@(provider.IconName ?? "api")" Style="margin-right: 8px;" />
                                @provider.DisplayName
                            </span>
                        </ItemTemplate>
                    </Select>
                </FormItem>

                <FormItem Label="Name" Required>
                    <Input @bind-Value="ViewModel.CreateRequest.Name" Placeholder="e.g., My OpenAI Key, Production Claude" />
                </FormItem>

                <FormItem Label="API Key" Required>
                    <InputPassword @bind-Value="ViewModel.CreateRequest.ApiKey"
                                  Placeholder="Enter your API key from the provider" />
                    <div class="form-help-text">
                        @GetApiKeyHelpText(ViewModel.CreateRequest.ProviderName)
                    </div>
                </FormItem>

                <FormItem Label="Description (Optional)">
                    <TextArea @bind-Value="ViewModel.CreateRequest.Description"
                             Placeholder="Optional description for this API key"
                             Rows="3" />
                </FormItem>
            </Form>
        </Modal>
    </Content>
</Layout>

<style>
    .loading-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 200px;
    }

    .text-secondary {
        color: #8c8c8c;
    }

    .provider-openai {
        color: #10a37f;
        font-weight: 500;
    }

    .provider-anthropic {
        color: #d4822a;
        font-weight: 500;
    }

    .provider-google {
        color: #4285f4;
        font-weight: 500;
    }

    .provider-custom {
        color: #666;
        font-weight: 500;
    }

    .form-help-text {
        font-size: 12px;
        color: #666;
        margin-top: 4px;
        line-height: 1.4;
    }
</style>

@code {
    private void OnProviderChanged(AiProviderInfo? provider)
    {
        StateHasChanged();
    }

    private string GetProviderIcon(string providerName)
    {
        var provider = ViewModel.AvailableProviders?.FirstOrDefault(p =>
            string.Equals(p.ProviderName, providerName, StringComparison.OrdinalIgnoreCase));
        return provider?.IconName ?? "api";
    }

    private string GetProviderClass(string providerName) => $"provider-{providerName?.ToLowerInvariant() ?? "unknown"}";

    private string GetProviderDisplayName(string providerName)
    {
        var provider = ViewModel.AvailableProviders?.FirstOrDefault(p =>
            string.Equals(p.ProviderName, providerName, StringComparison.OrdinalIgnoreCase));
        return provider?.DisplayName ?? providerName ?? "Unknown";
    }

    private string GetApiKeyHelpText(string providerName)
    {
        var provider = ViewModel.AvailableProviders?.FirstOrDefault(p =>
            string.Equals(p.ProviderName, providerName, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrEmpty(provider?.ApiKeyHelpUrl))
        {
            return $"Get your API key from: {provider.ApiKeyHelpUrl}";
        }
        return "Enter the API key from your AI provider";
    }
}