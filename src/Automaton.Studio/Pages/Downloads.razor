@page "/downloads"
@using Microsoft.AspNetCore.Components
@using Automaton.Studio.Services
@inject IJSRuntime JSRuntime
@inject ConfigurationService ConfigService
@inject NavigationManager NavigationManager
@inject MessageService MessageService

<PageTitle>Downloads - Automaton Studio</PageTitle>

<Layout>
    <Header Class="header">
        <Row>
            <Col Flex=@("none")>
                <Space Size="SpaceSize.Large">
                    <SpaceItem Class="header-item">
                        <Breadcrumb>
                            <BreadcrumbItem Href="/">
                                <Icon Type="home" Width="16" Height="16" />
                                <span>Home</span>
                            </BreadcrumbItem>
                            <BreadcrumbItem>
                                <Icon Type="download" Width="16" Height="16" />
                                <span>Downloads</span>
                            </BreadcrumbItem>
                        </Breadcrumb>
                    </SpaceItem>
                </Space>
            </Col>
            <Col Class="right-actions">
                <Space>
                    <SpaceItem>
                        <Button Type="@ButtonType.Primary" OnClick="@(() => NavigationManager.NavigateTo("/onboarding"))">
                            <Icon Type="question-circle" />
                            Get Started
                        </Button>
                    </SpaceItem>
                </Space>
            </Col>
        </Row>
    </Header>

    <Content Class="content-padding home-content content-background">
        <div class="home-container">
            
            <!-- Header Section -->
            <div class="downloads-header">
                <div class="downloads-header-content">
                    <div class="downloads-header-icon">
                        <Icon Type="download" Style="font-size: 48px; color: white;" />
                    </div>
                    <div class="downloads-header-text">
                        <Title Level="1" Style="margin-bottom: 8px;">Download Automaton Runner</Title>
                        <Paragraph Class="downloads-subtitle">
                            Cross-platform console runner for your automation workflows
                        </Paragraph>
                    </div>
                </div>
            </div>

            <!-- Quick Install Section -->
            <Card Class="quick-install-card" Style="margin-bottom: 24px;">
                <TitleTemplate>
                    <Icon Type="rocket" Style="margin-right: 8px;" />
                    <span>Quick Install (Recommended)</span>
                </TitleTemplate>
                <ChildContent>
                    <Paragraph>One-command installation with automatic setup:</Paragraph>
                    
                    <Row Gutter="16">
                        <Col Span="12">
                            <Card Size="@CardSize.Small" Class="install-command-card">
                                <TitleTemplate>
                                    <Icon Type="windows" Style="margin-right: 8px; color: #0078d4;" />
                                    <span>Windows</span>
                                </TitleTemplate>
                                <ChildContent>
                                    <Paragraph>Run in PowerShell as Administrator:</Paragraph>
                                    <div class="code-container">
                                        <div class="command-display">
                                            <Text Code Class="code-block">@windowsCommand</Text>
                                            <Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard(windowsCommand, "Windows command"))" Style="margin-left: 8px;">
                                                Copy
                                            </Button>
                                        </div>
                                    </div>
                                    <Paragraph Type="@TextElementType.Secondary" Style="margin-top: 8px; font-size: 12px;">
                                        Installs, configures, and can optionally create a Windows service
                                    </Paragraph>
                                </ChildContent>
                            </Card>
                        </Col>
                        
                        <Col Span="12">
                            <Card Size="@CardSize.Small" Class="install-command-card">
                                <TitleTemplate>
                                    <Icon Type="code" Style="margin-right: 8px; color: #ff6b35;" />
                                    <span>Linux / macOS</span>
                                </TitleTemplate>
                                <ChildContent>
                                    <Paragraph>Run in Terminal:</Paragraph>
                                    <div class="code-container">
                                        <div class="command-display">
                                            <Text Code Class="code-block">@unixCommand</Text>
                                            <Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard(unixCommand, "Unix command"))" Style="margin-left: 8px;">
                                                Copy
                                            </Button>
                                        </div>
                                    </div>
                                    <Paragraph Type="@TextElementType.Secondary" Style="margin-top: 8px; font-size: 12px;">
                                        Installs, configures, and can create systemd service (Linux)
                                    </Paragraph>
                                </ChildContent>
                            </Card>
                        </Col>
                    </Row>

                    <Alert Type="@AlertType.Info" ShowIcon="true" Style="margin-top: 16px;">
                        <MessageTemplate>
                            <strong>Pro Tip:</strong> Add your API key during installation:
                            <br />
                            <div class="command-display" Style="margin-top: 8px;">
                                <Text Code>@advancedCommand</Text>
                                <Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard(advancedCommand, "Advanced command"))" Style="margin-left: 8px;">
                                    Copy
                                </Button>
                            </div>
                        </MessageTemplate>
                    </Alert>
                </ChildContent>
            </Card>

            <!-- Platform Detection Section -->
            <Card Class="recommended-download-card" Style="margin-bottom: 24px; display: none;" Id="recommended-card">
                <TitleTemplate>
                    <Icon Type="star" Theme="IconThemeType.TwoTone" TwoToneColor="#52c41a" Style="margin-right: 8px;" />
                    <span>Recommended for Your System</span>
                </TitleTemplate>
                <ChildContent>
                    <Row>
                        <Col Span="16">
                            <div id="detected-info">
                                <Title Level="4" Style="margin: 0;" Id="detected-platform">Detecting...</Title>
                                <Paragraph Type="@TextElementType.Secondary" Style="margin: 0;">We detected your operating system</Paragraph>
                            </div>
                        </Col>
                        <Col Span="8" Style="text-align: right;">
                            <Button Type="@ButtonType.Primary" Size="@ButtonSize.Large" Id="recommended-download-btn">
                                <Icon Type="download" />
                                Download Now
                            </Button>
                        </Col>
                    </Row>
                </ChildContent>
            </Card>

            <!-- Manual Downloads Section -->
            <Card Class="manual-downloads-card" Style="margin-bottom: 24px;">
                <TitleTemplate>
                    <Icon Type="inbox" Style="margin-right: 8px;" />
                    <span>Manual Downloads</span>
                </TitleTemplate>
                <ChildContent>
                    <Paragraph>Download specific platform binaries directly:</Paragraph>
                    
                    <Row Gutter="16">
                        <!-- Windows -->
                        <Col Span="8">
                            <Card Size="@CardSize.Small" Class="platform-card">
                                <TitleTemplate>
                                    <Icon Type="windows" Style="margin-right: 8px; color: #0078d4;" />
                                    <span>Windows</span>
                                </TitleTemplate>
                                <ChildContent>
                                    <Space Direction="SpaceDirection.Vertical" Style="width: 100%;">
                                        <SpaceItem>
                                            <DownloadButton Url="@windowsX64Url" FileName="automaton-runner-win-x64.zip" Type="@ButtonType.Primary" Block="true">
                                                <Icon Type="download" />
                                                x64 (.zip)
                                            </DownloadButton>
                                        </SpaceItem>
                                        <SpaceItem>
                                            <DownloadButton Url="@windowsArm64Url" FileName="automaton-runner-win-arm64.zip" Block="true">
                                                <Icon Type="download" />
                                                ARM64 (.zip)
                                            </DownloadButton>
                                        </SpaceItem>
                                    </Space>
                                </ChildContent>
                            </Card>
                        </Col>

                        <!-- Linux -->
                        <Col Span="8">
                            <Card Size="@CardSize.Small" Class="platform-card">
                                <TitleTemplate>
                                    <Icon Type="code" Style="margin-right: 8px; color: #ff6b35;" />
                                    <span>Linux</span>
                                </TitleTemplate>
                                <ChildContent>
                                    <Space Direction="SpaceDirection.Vertical" Style="width: 100%;">
                                        <SpaceItem>
                                            <DownloadButton Url="@linuxX64Url" FileName="automaton-runner-linux-x64.tar.gz" Type="@ButtonType.Primary" Block="true">
                                                <Icon Type="download" />
                                                x64 (.tar.gz)
                                            </DownloadButton>
                                        </SpaceItem>
                                        <SpaceItem>
                                            <DownloadButton Url="@linuxArm64Url" FileName="automaton-runner-linux-arm64.tar.gz" Block="true">
                                                <Icon Type="download" />
                                                ARM64 (.tar.gz)
                                            </DownloadButton>
                                        </SpaceItem>
                                    </Space>
                                </ChildContent>
                            </Card>
                        </Col>

                        <!-- macOS -->
                        <Col Span="8">
                            <Card Size="@CardSize.Small" Class="platform-card">
                                <TitleTemplate>
                                    <Icon Type="apple" Style="margin-right: 8px; color: #333;" />
                                    <span>macOS</span>
                                </TitleTemplate>
                                <ChildContent>
                                    <Space Direction="SpaceDirection.Vertical" Style="width: 100%;">
                                        <SpaceItem>
                                            <DownloadButton Url="@macosX64Url" FileName="automaton-runner-macos-x64.tar.gz" Type="@ButtonType.Primary" Block="true">
                                                <Icon Type="download" />
                                                Intel (.tar.gz)
                                            </DownloadButton>
                                        </SpaceItem>
                                        <SpaceItem>
                                            <DownloadButton Url="@macosArm64Url" FileName="automaton-runner-macos-arm64.tar.gz" Block="true">
                                                <Icon Type="download" />
                                                Apple Silicon (.tar.gz)
                                            </DownloadButton>
                                        </SpaceItem>
                                    </Space>
                                </ChildContent>
                            </Card>
                        </Col>
                    </Row>
                </ChildContent>
            </Card>

            <!-- Getting Started Section -->
            <Card Class="getting-started-card">
                <TitleTemplate>
                    <Icon Type="play-circle" Style="margin-right: 8px;" />
                    <span>Getting Started</span>
                </TitleTemplate>
                <ChildContent>
                    <Row Gutter="24">
                        <Col Span="12">
                            <div class="step-container">
                                <div class="step-number">1</div>
                                <div class="step-content">
                                    <Title Level="4">Get an API Key</Title>
                                    <Paragraph>Create an API key in your Automaton Studio:</Paragraph>
                                    <ol>
                                        <li>Go to <strong>Settings → API Keys</strong></li>
                                        <li>Click <strong>Create API Key</strong></li>
                                        <li>Choose <strong>"Runner"</strong> scope</li>
                                        <li>Copy your key (starts with <code>ak_</code>)</li>
                                    </ol>
                                    <Button Type="@ButtonType.Link" OnClick="@(() => NavigationManager.NavigateTo("/apikeys"))" Style="padding: 0;">
                                        <Icon Type="arrow-right" />
                                        Go to API Keys
                                    </Button>
                                </div>
                            </div>
                        </Col>
                        
                        <Col Span="12">
                            <div class="step-container">
                                <div class="step-number">2</div>
                                <div class="step-content">
                                    <Title Level="4">Configure & Run</Title>
                                    <Paragraph>Set up your runner with the API key:</Paragraph>
                                    <div class="code-example">
                                        <Text Code># Authenticate</Text><br/>
                                        <Text Code>automaton-runner auth --api-key YOUR_KEY</Text><br/><br/>
                                        <Text Code># Register</Text><br/>
                                        <Text Code>automaton-runner register --name "My-Runner"</Text><br/><br/>
                                        <Text Code># Run</Text><br/>
                                        <Text Code>automaton-runner run --name "My-Runner"</Text>
                                    </div>
                                </div>
                            </div>
                        </Col>
                    </Row>
                </ChildContent>
            </Card>
        </div>
    </Content>
</Layout>

@code {
    private string windowsCommand = "";
    private string unixCommand = "";
    private string advancedCommand = "";
    private string windowsX64Url = "";
    private string windowsArm64Url = "";
    private string linuxX64Url = "";
    private string linuxArm64Url = "";
    private string macosX64Url = "";
    private string macosArm64Url = "";

    protected override void OnInitialized()
    {
        windowsCommand = $"iwr -useb {ConfigService.BaseUrl}/downloads/install.ps1 | iex";
        unixCommand = $"curl -sSL {ConfigService.BaseUrl}/downloads/install.sh | bash";
        advancedCommand = $"curl -sSL {ConfigService.BaseUrl}/downloads/install.sh | bash -s -- --api-key \"YOUR_API_KEY\" --runner-name \"my-runner\"";
        
        // Build download URLs
        var baseUrl = ConfigService.BaseUrl;
        windowsX64Url = $"{baseUrl}/downloads/runner/latest/automaton-runner-win-x64.zip";
        windowsArm64Url = $"{baseUrl}/downloads/runner/latest/automaton-runner-win-arm64.zip";
        linuxX64Url = $"{baseUrl}/downloads/runner/latest/automaton-runner-linux-x64.tar.gz";
        linuxArm64Url = $"{baseUrl}/downloads/runner/latest/automaton-runner-linux-arm64.tar.gz";
        macosX64Url = $"{baseUrl}/downloads/runner/latest/automaton-runner-macos-x64.tar.gz";
        macosArm64Url = $"{baseUrl}/downloads/runner/latest/automaton-runner-macos-arm64.tar.gz";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("detectPlatform");
        }
    }

    private async Task OnCommandCopied(string command)
    {
        // You could add a notification here
        await Task.CompletedTask;
    }

    private async Task CopyToClipboard(string text, string description)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
            await MessageService.SuccessAsync($"{description} copied to clipboard");
        }
        catch
        {
            await MessageService.WarningAsync("Could not copy to clipboard. Please copy manually.");
        }
    }
}

<script>
    window.detectPlatform = function() {
        // Check if the required elements exist before proceeding
        const platformElement = document.getElementById('detected-platform');
        const downloadBtnElement = document.getElementById('recommended-download-btn');
        const cardElement = document.getElementById('recommended-card');
        
        if (!platformElement || !downloadBtnElement || !cardElement) {
            // Elements don't exist, exit gracefully
            return;
        }
        
        const platform = navigator.platform.toLowerCase();
        const userAgent = navigator.userAgent.toLowerCase();
        
        let detectedOS = 'Unknown';
        let detectedArch = 'x64';
        let downloadUrl = '';
        
        if (platform.includes('win')) {
            detectedOS = 'Windows';
            downloadUrl = '/downloads/runner/latest/automaton-runner-win-x64.zip';
        } else if (platform.includes('mac') || platform.includes('darwin')) {
            detectedOS = 'macOS';
            if (userAgent.includes('arm') || platform.includes('arm')) {
                detectedArch = 'Apple Silicon';
                downloadUrl = '/downloads/runner/latest/automaton-runner-macos-arm64.tar.gz';
            } else {
                detectedArch = 'Intel';
                downloadUrl = '/downloads/runner/latest/automaton-runner-macos-x64.tar.gz';
            }
        } else if (platform.includes('linux')) {
            detectedOS = 'Linux';
            downloadUrl = '/downloads/runner/latest/automaton-runner-linux-x64.tar.gz';
        }
        
        if (detectedOS !== 'Unknown') {
            platformElement.textContent = `${detectedOS} ${detectedArch}`;
            downloadBtnElement.onclick = () => window.location.href = downloadUrl;
            cardElement.style.display = 'block';
        }
    };
</script>

