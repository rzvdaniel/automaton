@using Automaton.Studio.Services
@inject DashboardContextService DashboardContext
@inject NavigationManager Navigation

<div class="app-portal-dashboard">
    <PageHeader Title="My Apps" />

    @if (DashboardContext.IsLoading)
    {
        <div class="loading-container">
            <Spin Size="large" />
        </div>
    }
    else if (!DashboardContext.ProjectApps.Any())
    {
        <Empty Description="No apps available">
            <ChildContent>
                <p>There are no apps in this project yet. Contact your project administrator to add apps.</p>
            </ChildContent>
        </Empty>
    }
    else
    {
        <div class="apps-grid">
            <Row Gutter="@(new[] { 16, 16 })">
                @foreach (var app in DashboardContext.ProjectApps)
                {
                    <Col Xs="24" Sm="12" Md="8" Lg="6">
                        <Card Hoverable="true" Class="app-card" @onclick="@(() => OpenApp(app.WebAppId))">
                            <Body>
                                <div class="app-icon">
                                    <Icon Type="appstore" Theme="outline" />
                                </div>
                                <h3 class="app-name">@app.AppName</h3>
                                @if (!string.IsNullOrEmpty(app.Description))
                                {
                                    <p class="app-description">@app.Description</p>
                                }
                                <div class="app-footer">
                                    <Button Type="@ButtonType.Primary" Size="@ButtonSize.Small">
                                        Launch App
                                    </Button>
                                </div>
                            </Body>
                        </Card>
                    </Col>
                }
            </Row>
        </div>
    }
</div>

@code {
    private void OpenApp(Guid appId)
    {
        Navigation.NavigateTo($"/appdesigner/{appId}");
    }
}
