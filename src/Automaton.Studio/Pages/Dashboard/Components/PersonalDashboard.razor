@using Automaton.Studio.Services
@using Automaton.Studio.Models
@using Automaton.Core.Enums
@using Automaton.Studio.Enums

@inject NavigationManager NavigationManager
@inject OnboardingService OnboardingService
@inject DashboardService DashboardService

<!-- Default dashboard for personal workspace -->
<div class="home-container">
    <!-- Header Section -->
    <div class="home-header">
        <div class="home-header-content">
            <div class="home-header-icon">
                <Icon Type="thunderbolt" Style="font-size: 48px; color: white;" />
            </div>
            <div class="home-header-text">
                <Title Level="1" Style="margin-bottom: 8px;">Personal Dashboard</Title>
                <Paragraph Class="home-subtitle">
                    Build, manage, and execute automated workflows with ease. Get started by exploring the sections below.
                </Paragraph>
            </div>
        </div>
    </div>

    <!-- Quick Stats Section -->
    @if (dashboardStats != null)
    {
        <div class="stats-section">
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-content">
                        <div class="stat-icon">
                            <Icon Type="profile" Style="font-size: 24px; color: #1890ff;" />
                        </div>
                        <div class="stat-details">
                            <div class="stat-value">@dashboardStats.TotalFlows</div>
                            <div class="stat-label">Total Flows</div>
                        </div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-content">
                        <div class="stat-icon">
                            <Icon Type="play-square" Style="font-size: 24px; color: #52c41a;" />
                        </div>
                        <div class="stat-details">
                            <div class="stat-value">@dashboardStats.OnlineRunners/@dashboardStats.TotalRunners</div>
                            <div class="stat-label">Online Runners</div>
                        </div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-content">
                        <div class="stat-icon">
                            <Icon Type="check-circle" Style="font-size: 24px; color: #722ed1;" />
                        </div>
                        <div class="stat-details">
                            <div class="stat-value">@dashboardStats.SuccessRate%</div>
                            <div class="stat-label">Success Rate</div>
                        </div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-content">
                        <div class="stat-icon">
                            <Icon Type="bar-chart" Style="font-size: 24px; color: #fa8c16;" />
                        </div>
                        <div class="stat-details">
                            <div class="stat-value">@dashboardStats.RecentExecutions</div>
                            <div class="stat-label">Recent Executions</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Main Content Tabs -->
    <Tabs DefaultActiveKey="recent-flows" Class="home-tabs">
        <TabPane Key="recent-flows" Tab="Recent Flows">
            <div class="flows-content">
                <Title Level="3">Your Recent Flows</Title>
                @if (recentFlows != null && recentFlows.Any())
                {
                    <div class="section">
                        <Paragraph>
                            Quick access to your recently edited workflows. Click any flow to continue editing.
                        </Paragraph>
                        
                        <div class="flows-grid">
                            @foreach (var flow in recentFlows)
                            {
                                <div class="flow-grid-card" @onclick="@(() => NavigationManager.NavigateTo($"/flow/designer/{flow.Id}/{flow.Name}"))">
                                    <Card Hoverable="true" Class="flow-card">
                                        <div class="flow-card-content">
                                            <div class="flow-header">
                                                <div class="flow-icon">
                                                    <Icon Type="profile" Style="font-size: 20px; color: #1890ff;" />
                                                </div>
                                                <div class="flow-info">
                                                    <Text Strong Class="flow-name">@flow.Name</Text>
                                                    <Text Type="@TextElementType.Secondary" Class="flow-date">
                                                        Updated @flow.Updated.ToString("MMM dd, yyyy")
                                                    </Text>
                                                </div>
                                                <div class="flow-actions">
                                                    <Icon Type="edit" Style="color: #1890ff;" />
                                                </div>
                                            </div>
                                            <div class="flow-stats">
                                                <div class="flow-stat">
                                                    <Icon Type="clock-circle" Style="font-size: 12px; color: #8c8c8c;" />
                                                    <span>@flow.Created.ToString("MMM dd")</span>
                                                </div>
                                            </div>
                                        </div>
                                    </Card>
                                </div>
                            }
                        </div>
                        
                        <div class="flows-actions">
                            <Button Type="@ButtonType.Primary" Icon="plus" OnClick="@(() => NavigationManager.NavigateTo("/flows"))" Size="@ButtonSize.Large">
                                Create New Flow
                            </Button>
                            <Button Type="@ButtonType.Default" OnClick="@(() => NavigationManager.NavigateTo("/flows"))" Size="@ButtonSize.Large">
                                View All Flows
                            </Button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="flows-empty">
                        <div class="empty-content">
                            <div class="empty-icon">
                                <Icon Type="profile" Style="font-size: 64px; color: #d9d9d9;" />
                            </div>
                            <Title Level="3" Style="color: #8c8c8c;">No Recent Flows</Title>
                            <Paragraph Style="color: #8c8c8c; margin-bottom: 24px;">
                                You haven't created any workflows yet. Get started by creating your first flow!
                            </Paragraph>
                            <Button Type="@ButtonType.Primary" Icon="plus" Size="@ButtonSize.Large" OnClick="@(() => NavigationManager.NavigateTo("/flows"))">
                                Create Your First Flow
                            </Button>
                        </div>
                    </div>
                }
            </div>
        </TabPane>

        <TabPane Key="activity" Tab="Recent Activity">
            <div class="activity-content">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                    <Title Level="3" style="margin-bottom: 0;">Recent Activity</Title>
                    <Button Type="@ButtonType.Link" OnClick="@RefreshActivity" Icon="reload" Size="@ButtonSize.Small">
                        Refresh
                    </Button>
                </div>
                
                @if (isLoadingActivity)
                {
                    <div style="text-align: center; padding: 40px;">
                        <Spin Size="SpinSize.Large" />
                    </div>
                }
                else if (recentActivity != null && recentActivity.Any())
                {
                    <div class="activity-list">
                        @foreach (var activity in recentActivity)
                        {
                            <Card Size="CardSize.Small" Class="activity-item" Bordered="true">
                                <div class="activity-content-item">
                                    <div class="activity-icon">
                                        <Icon Type="@activity.Icon" Style="@($"color: {activity.Color};")" />
                                    </div>
                                    <div class="activity-details">
                                        <div class="activity-title">
                                            <Text Strong>@activity.EntityName</Text>
                                            <Tag Color="@GetActivityTagColor(activity.ActivityType)">@activity.ActivityTypeText</Tag>
                                        </div>
                                        <div class="activity-description">
                                            <Text Type="@TextElementType.Secondary">@activity.Description</Text>
                                        </div>
                                        <div class="activity-meta">
                                            <span class="activity-meta-text">
                                                <Icon Type="clock-circle" Style="font-size: 12px;" />
                                                @activity.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                            </span>
                                            @if (!string.IsNullOrEmpty(activity.UserName))
                                            {
                                                <span class="activity-meta-text">
                                                    <Icon Type="user" Style="font-size: 12px;" />
                                                    @activity.UserName
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <div class="activity-actions">
                                        @if (activity.EntityId.HasValue)
                                        {
                                            @if (activity.ActivityType == ActivityType.FlowCreated || 
                                                 activity.ActivityType == ActivityType.FlowUpdated ||
                                                 activity.ActivityType == ActivityType.FlowExecuted)
                                            {
                                                <Button Type="@ButtonType.Link" Size="@ButtonSize.Small" 
                                                        OnClick="@(() => NavigationManager.NavigateTo($"/flow/designer/{activity.EntityId}/{activity.EntityName}"))">
                                                    <Icon Type="edit" />
                                                </Button>
                                            }
                                            else if (activity.ActivityType == ActivityType.CustomStepCreated || 
                                                     activity.ActivityType == ActivityType.CustomStepUpdated)
                                            {
                                                <Button Type="@ButtonType.Link" Size="@ButtonSize.Small" 
                                                        OnClick="@(() => NavigationManager.NavigateTo($"/customstep/designer/{activity.EntityId}"))">
                                                    <Icon Type="edit" />
                                                </Button>
                                            }
                                        }
                                    </div>
                                </div>
                            </Card>
                        }
                    </div>
                    
                    @if (recentActivity.Count() >= 10)
                    {
                        <div style="text-align: center; margin-top: 16px;">
                            <Button Type="@ButtonType.Link" OnClick="@LoadMoreActivity">
                                Load More
                            </Button>
                        </div>
                    }
                }
                else
                {
                    <div class="activity-placeholder">
                        <div style="text-align: center;">
                            <Icon Type="inbox" Style="font-size: 48px; color: #d9d9d9; margin-bottom: 16px;" />
                            <Title Level="4" Style="color: #999;">No Recent Activity</Title>
                            <Paragraph Style="color: #999; margin-bottom: 24px;">
                                Activity will appear here when you create, update, or execute flows and custom steps.
                            </Paragraph>
                            <Button Type="@ButtonType.Primary" OnClick="@(() => NavigationManager.NavigateTo("/flows"))">
                                Create Your First Flow
                            </Button>
                        </div>
                    </div>
                }
            </div>
        </TabPane>

        <TabPane Key="recent-executions" Tab="Recent Executions">
            <div class="executions-content">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                    <Title Level="3" style="margin-bottom: 0;">Recent Flow Executions</Title>
                    <Button Type="@ButtonType.Link" OnClick="@RefreshExecutions" Icon="reload" Size="@ButtonSize.Small">
                        Refresh
                    </Button>
                </div>
                
                @if (isLoadingExecutions)
                {
                    <div style="text-align: center; padding: 40px;">
                        <Spin Size="SpinSize.Large" />
                    </div>
                }
                else if (recentExecutions != null && recentExecutions.Any())
                {
                    <div class="executions-list">
                        @foreach (var execution in recentExecutions)
                        {
                            <Card Size="CardSize.Small" Class="execution-item" Bordered="true">
                                <div class="execution-content-item">
                                    <div class="execution-icon">
                                        @if (execution.Status == WorkflowStatus.Success)
                                        {
                                            <Icon Type="check-circle" Theme="IconThemeType.TwoTone" TwoToneColor="#52c41a" />
                                        }
                                        else if (execution.Status == WorkflowStatus.Error)
                                        {
                                            <Icon Type="close-circle" Theme="IconThemeType.TwoTone" TwoToneColor="#ff4d4f" />
                                        }
                                        else if (execution.Status == WorkflowStatus.Working)
                                        {
                                            <Icon Type="sync" Spin="true" Theme="IconThemeType.TwoTone" TwoToneColor="#1890ff" />
                                        }
                                        else
                                        {
                                            <Icon Type="clock-circle" Theme="IconThemeType.TwoTone" TwoToneColor="#d9d9d9" />
                                        }
                                    </div>
                                    <div class="execution-details">
                                        <div class="execution-title">
                                            <Text Strong>@execution.Application</Text>
                                            <Tag Color="@GetExecutionStatusColor(execution.Status)">@execution.Status</Tag>
                                        </div>
                                        <div class="execution-description">
                                            <Text Type="@TextElementType.Secondary">Flow ID: @execution.FlowId.ToString().Substring(0, 8)...</Text>
                                        </div>
                                        <div class="execution-meta">
                                            <span class="execution-meta-text">
                                                <Icon Type="clock-circle" Style="font-size: 12px;" />
                                                Started: @execution.Started.ToString("MMM dd, yyyy HH:mm")
                                            </span>
                                            @if (execution.Finished != default)
                                            {
                                                <span class="execution-meta-text">
                                                    <Icon Type="check" Style="font-size: 12px;" />
                                                    Finished: @execution.Finished.ToString("HH:mm")
                                                </span>
                                                <span class="execution-meta-text">
                                                    <Icon Type="hourglass" Style="font-size: 12px;" />
                                                    Duration: @((execution.Finished - execution.Started).TotalSeconds.ToString("F1"))s
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <div class="execution-actions">
                                        <Button Type="@ButtonType.Link" Size="@ButtonSize.Small" 
                                                OnClick="@(() => NavigationManager.NavigateTo($"/flow/activity/{execution.FlowId}/flow"))">
                                            <Icon Type="eye" />
                                        </Button>
                                    </div>
                                </div>
                            </Card>
                        }
                    </div>
                    
                    @if (recentExecutions.Count() >= executionCount)
                    {
                        <div style="text-align: center; margin-top: 16px;">
                            <Button Type="@ButtonType.Link" OnClick="@LoadMoreExecutions">
                                Load More
                            </Button>
                        </div>
                    }
                }
                else
                {
                    <div class="executions-placeholder">
                        <div style="text-align: center;">
                            <Icon Type="bar-chart" Style="font-size: 48px; color: #d9d9d9; margin-bottom: 16px;" />
                            <Title Level="4" Style="color: #999;">No Recent Executions</Title>
                            <Paragraph Style="color: #999; margin-bottom: 24px;">
                                Executions will appear here when you run workflows.
                            </Paragraph>
                            <Button Type="@ButtonType.Primary" OnClick="@(() => NavigationManager.NavigateTo("/flows"))">
                                View Your Flows
                            </Button>
                        </div>
                    </div>
                }
            </div>
        </TabPane>
    </Tabs>
</div>

@code {
    private DashboardStats? dashboardStats;
    private IEnumerable<FlowInfo>? recentFlows;
    private IEnumerable<RecentActivity>? recentActivity;
    private IEnumerable<FlowExecution>? recentExecutions;
    private bool isLoadingActivity = false;
    private bool isLoadingExecutions = false;
    private int activityCount = 10;
    private int executionCount = 15;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Load activity data after the initial render to improve perceived performance
            await LoadRecentActivity();
            await LoadRecentExecutions();
        }
    }

    private async Task LoadDashboardData()
    {
        try
        {
            // Load stats
            dashboardStats = await DashboardService.GetDashboardStatsAsync();

            // Load more recent flows for the dedicated tab
            recentFlows = await DashboardService.GetAllRecentFlowsAsync();

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard data: {ex.Message}");
        }
    }

    private async Task LoadRecentActivity()
    {
        isLoadingActivity = true;
        StateHasChanged();

        try
        {
            recentActivity = await DashboardService.GetRecentActivityAsync(activityCount);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading recent activity: {ex.Message}");
            recentActivity = new List<RecentActivity>();
        }
        finally
        {
            isLoadingActivity = false;
            StateHasChanged();
        }
    }

    private async Task LoadRecentExecutions()
    {
        isLoadingExecutions = true;
        StateHasChanged();

        try
        {
            recentExecutions = await DashboardService.GetRecentExecutionsAsync(executionCount);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading recent executions: {ex.Message}");
            recentExecutions = new List<FlowExecution>();
        }
        finally
        {
            isLoadingExecutions = false;
            StateHasChanged();
        }
    }

    private async Task RefreshActivity()
    {
        activityCount = 10; // Reset to initial count
        await LoadRecentActivity();
    }

    private async Task RefreshExecutions()
    {
        executionCount = 15; // Reset to initial count
        await LoadRecentExecutions();
    }

    private async Task LoadMoreActivity()
    {
        activityCount += 10;
        await LoadRecentActivity();
    }

    private async Task LoadMoreExecutions()
    {
        executionCount += 15;
        await LoadRecentExecutions();
    }

    private string GetActivityTagColor(ActivityType activityType)
    {
        return activityType switch
        {
            ActivityType.FlowCreated or ActivityType.CustomStepCreated or ActivityType.RunnerAdded or ActivityType.ScheduleCreated => "green",
            ActivityType.FlowUpdated or ActivityType.CustomStepUpdated or ActivityType.RunnerUpdated or ActivityType.ScheduleUpdated => "blue",
            ActivityType.FlowDeleted or ActivityType.CustomStepDeleted or ActivityType.RunnerDeleted or ActivityType.ScheduleDeleted => "red",
            ActivityType.FlowExecuted => "purple",
            _ => "default"
        };
    }

    private string GetExecutionStatusColor(WorkflowStatus status)
    {
        return status switch
        {
            WorkflowStatus.Success => "green",
            WorkflowStatus.Error => "red",
            WorkflowStatus.Working => "blue",
            _ => "default"
        };
    }
}

