@using Automaton.Studio.Services
@using Automaton.Studio.Models
@inject DashboardContextService DashboardContext
@inject NavigationManager Navigation
@inject AppsService AppsService
@inject ProjectContextService ProjectContext
@inject IJSRuntime JSRuntime

<div class="app-user-dashboard">
    <!-- Welcome Header -->
    <div class="home-header">
        <div class="home-header-content">
            <div class="home-header-icon">
                <Icon Type="appstore" Style="font-size: 48px; color: white;" />
            </div>
            <div class="home-header-text">
                <Title Level="1" Style="margin-bottom: 8px;">
                    @if (ProjectContext.IsInProjectContext())
                    {
                        @($"{ProjectContext.CurrentProject?.DisplayName} Apps")
                    }
                    else
                    {
                        @("Applications")
                    }
                </Title>
                <Paragraph Class="home-subtitle">
                    Access and launch your applications
                </Paragraph>
            </div>
        </div>
    </div>

    <!-- Compact App User Information -->
    @if (ProjectContext.IsInProjectContext())
    {
        <div class="info-section-compact">
            <Alert Type="@AlertType.Info" 
                   Message="@($"You have access to {totalApps} application(s). " + (!string.IsNullOrEmpty(ProjectContext.CurrentProject?.OwnerName) ? $"Contact {ProjectContext.CurrentProject.OwnerName} for additional access." : ""))"
                   ShowIcon="true"
                   Closable="false" />
        </div>
    }

    <!-- Latest Apps Section -->
    <div class="section">
        <div class="section-header">
            <Title Level="3" Style="margin-bottom: 0;">Available Applications</Title>
            <Select TItemValue="string" 
                    TItem="string"
                    @bind-Value="@sortBy" 
                    Style="width: 200px;" 
                    Placeholder="Sort by"
                    OnSelectedItemChanged="@OnSortChanged">
                <SelectOptions>
                    <SelectOption TItemValue="string" TItem="string" Value="@("updated")" Label="Recently Updated" />
                    <SelectOption TItemValue="string" TItem="string" Value="@("created")" Label="Recently Created" />
                    <SelectOption TItemValue="string" TItem="string" Value="@("name")" Label="Name (A-Z)" />
                    <SelectOption TItemValue="string" TItem="string" Value="@("published")" Label="Published First" />
                </SelectOptions>
            </Select>
        </div>
        
        <AppGridDisplay Apps="@displayedApps"
                        IsLoading="@(DashboardContext.IsLoading || isLoadingAppDetails)"
                        EmptyTitle="No Applications Available"
                        EmptyMessage="There are no applications in this project yet. Contact your project administrator to add applications."
                        OnAppClick="@(async (app) => await OpenApp(app))" />
    </div>
</div>

@code {
    private List<AppListItem>? fullAppDetails;
    private List<AppListItem>? displayedApps;
    private bool isLoadingAppDetails = false;
    private int totalApps = 0;
    private string sortBy = "updated";

    protected override async Task OnInitializedAsync()
    {
        DashboardContext.OnDashboardDataChanged += StateHasChanged;
        await LoadAppDetails();
    }

    private async Task LoadAppDetails()
    {
        isLoadingAppDetails = true;
        try
        {
            // Load full app details for each project app
            fullAppDetails = new List<AppListItem>();
            foreach (var projectApp in DashboardContext.ProjectApps)
            {
                try
                {
                    var appDetail = await AppsService.Load(projectApp.AppId);
                    
                    // Convert AppModel to AppListItem
                    fullAppDetails.Add(new AppListItem
                    {
                        Id = appDetail.Id,
                        Name = appDetail.Name,
                        DisplayName = appDetail.DisplayName,
                        Description = appDetail.Description,
                        IsPublished = appDetail.IsPublished,
                        PublicUrl = appDetail.PublicUrl,
                        PublishedAt = appDetail.PublishedAt,
                        Version = appDetail.Version,
                        RequiresAuthentication = appDetail.RequiresAuthentication,
                        Created = appDetail.Created,
                        Updated = appDetail.Updated,
                        ExecutionRunnerId = appDetail.ExecutionRunnerId,
                        Appearance = appDetail.Appearance
                    });
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error loading app {projectApp.AppId}: {ex.Message}");
                }
            }

            totalApps = fullAppDetails.Count;
            SortApps();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading app details: {ex.Message}");
        }
        finally
        {
            isLoadingAppDetails = false;
        }
    }

    private void SortApps()
    {
        if (fullAppDetails == null || !fullAppDetails.Any())
        {
            displayedApps = new List<AppListItem>();
            return;
        }

        displayedApps = sortBy switch
        {
            "updated" => fullAppDetails.OrderByDescending(a => a.Updated).ToList(),
            "created" => fullAppDetails.OrderByDescending(a => a.Created).ToList(),
            "name" => fullAppDetails.OrderBy(a => a.DisplayName ?? a.Name).ToList(),
            "published" => fullAppDetails.OrderByDescending(a => a.IsPublished).ThenByDescending(a => a.Updated).ToList(),
            _ => fullAppDetails.OrderByDescending(a => a.Updated).ToList()
        };
    }

    private async Task OnSortChanged()
    {
        SortApps();
        StateHasChanged();
        await Task.CompletedTask;
    }

    private async Task OpenApp(AppListItem app)
    {
        if (app.IsPublished && !string.IsNullOrEmpty(app.PublicUrl))
        {
            // Navigate to published app
            await JSRuntime.InvokeVoidAsync("open", $"/web/{app.PublicUrl}", "_blank");
        }
        else
        {
            // Navigate to app (fallback for unpublished apps)
            Navigation.NavigateTo($"/app/{app.Id}");
        }
    }

    public void Dispose()
    {
        DashboardContext.OnDashboardDataChanged -= StateHasChanged;
    }
}

<style>
    .app-user-dashboard {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px 40px 24px;
    }

    .home-header {
        margin-bottom: 24px;
        padding: 24px 0;
    }

    .home-header-content {
        display: flex;
        align-items: center;
        gap: 24px;
    }

    .home-header-icon {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 80px;
        height: 80px;
        background-color: #722ed1;
        border-radius: 16px;
    }

    .home-header-text {
        flex: 1;
    }

    .home-subtitle {
        font-size: 16px;
        color: #666;
        margin-bottom: 0;
    }

    /* Compact Info Section */
    .info-section-compact {
        margin-bottom: 24px;
    }

    /* Section */
    .section {
        margin-bottom: 40px;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .home-header {
            padding: 16px 0;
        }

        .home-header-content {
            flex-direction: column;
            text-align: center;
        }

        .section-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 16px;
        }
    }
</style>
