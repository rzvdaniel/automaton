@using Automaton.Studio.Services
@using Automaton.Studio.Models
@inject DashboardContextService DashboardContext
@inject NavigationManager Navigation
@inject AppsService AppsService

<div class="app-user-dashboard">
    <!-- Welcome Header -->
    <div class="dashboard-header">
        <div class="header-content">
            <div class="header-icon">
                <Icon Type="appstore" Style="font-size: 48px; color: white;" />
            </div>
            <div class="header-text">
                <Title Level="1" Style="margin-bottom: 8px; color: white;">My Applications</Title>
                <Paragraph Style="color: rgba(255, 255, 255, 0.9); font-size: 16px; margin-bottom: 0;">
                    Access your project applications below
                </Paragraph>
            </div>
        </div>
    </div>

    <!-- Use reusable AppGridDisplay component -->
    <AppGridDisplay Apps="@fullAppDetails"
                    IsLoading="@(DashboardContext.IsLoading || isLoadingAppDetails)"
                    EmptyTitle="No Applications Available"
                    EmptyMessage="There are no applications in this project yet. Contact your project administrator to add applications."
                    OnAppClick="@(async (app) => await OpenApp(app))" />
</div>

@code {
    private List<AppListItem>? fullAppDetails;
    private bool isLoadingAppDetails = false;

    protected override async Task OnInitializedAsync()
    {
        DashboardContext.OnDashboardDataChanged += StateHasChanged;
        await LoadAppDetails();
    }

    private async Task LoadAppDetails()
    {
        isLoadingAppDetails = true;
        try
        {
            // Load full app details for each project app
            fullAppDetails = new List<AppListItem>();
            foreach (var projectApp in DashboardContext.ProjectApps)
            {
                try
                {
                    var appDetail = await AppsService.Load(projectApp.AppId);
                    
                    // Convert AppModel to AppListItem
                    fullAppDetails.Add(new AppListItem
                    {
                        Id = appDetail.Id,
                        Name = appDetail.Name,
                        DisplayName = appDetail.DisplayName,
                        Description = appDetail.Description,
                        IsPublished = appDetail.IsPublished,
                        PublicUrl = appDetail.PublicUrl,
                        PublishedAt = appDetail.PublishedAt,
                        Version = appDetail.Version,
                        RequiresAuthentication = appDetail.RequiresAuthentication,
                        Created = appDetail.Created,
                        Updated = appDetail.Updated,
                        ExecutionRunnerId = appDetail.ExecutionRunnerId,
                        Appearance = appDetail.Appearance
                    });
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error loading app {projectApp.AppId}: {ex.Message}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading app details: {ex.Message}");
        }
        finally
        {
            isLoadingAppDetails = false;
        }
    }

    private async Task OpenApp(AppListItem app)
    {
        if (app.IsPublished && !string.IsNullOrEmpty(app.PublicUrl))
        {
            // Navigate to published app
            Navigation.NavigateTo($"/web/{app.PublicUrl}", forceLoad: false);
        }
        else
        {
            // Navigate to app designer (fallback for unpublished apps)
            Navigation.NavigateTo($"/appdesigner/{app.Id}");
        }
    }

    public void Dispose()
    {
        DashboardContext.OnDashboardDataChanged -= StateHasChanged;
    }
}

<style>
    .app-user-dashboard {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0;
    }

    .dashboard-header {
        background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
        border-radius: 12px;
        padding: 48px 40px;
        margin-bottom: 32px;
        box-shadow: 0 4px 12px rgba(24, 144, 255, 0.2);
    }

    .header-content {
        display: flex;
        align-items: center;
        gap: 24px;
    }

    .header-icon {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 80px;
        height: 80px;
        background-color: rgba(255, 255, 255, 0.2);
        border-radius: 16px;
    }

    .header-text {
        flex: 1;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .dashboard-header {
            padding: 32px 24px;
        }

        .header-content {
            flex-direction: column;
            text-align: center;
        }
    }
</style>
