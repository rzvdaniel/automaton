@using Automaton.Studio.Services
@using Automaton.Studio.Models
@inject ProjectContextService ProjectContext
@inject DashboardService DashboardService
@inject NavigationManager Navigation

<div class="viewer-dashboard">
    <!-- Welcome Header -->
    <div class="dashboard-header">
        <div class="header-content">
            <div class="header-icon">
                <Icon Type="eye" Style="font-size: 48px; color: white;" />
            </div>
            <div class="header-text">
                <Title Level="1" Style="margin-bottom: 8px; color: white;">
                    @if (ProjectContext.IsInProjectContext())
                    {
                        @($"Project: {ProjectContext.CurrentProject?.DisplayName}")
                    }
                    else
                    {
                        @("Project Overview")
                    }
                </Title>
                <Paragraph Style="color: rgba(255, 255, 255, 0.9); font-size: 16px; margin-bottom: 0;">
                    Read-only view of project resources and activity
                </Paragraph>
            </div>
        </div>
    </div>

    <!-- Project Statistics -->
    @if (dashboardStats != null)
    {
        @* <div class="section">
            <Title Level="3" Style="margin-bottom: 24px;">Project Statistics</Title>
            <Row Gutter="(16, 16)">
                <Col Xs="24" Sm="12" Md="6">
                    <Card Class="stat-card">
                        <Statistic Title="Total Flows"
                                  Value="@dashboardStats.TotalFlows"
                                  Prefix="@flowIcon"
                                  ValueStyle="@("color: #1890ff")" />
                        <div class="stat-description">
                            Automation workflows in project
                        </div>
                    </Card>
                </Col>
                <Col Xs="24" Sm="12" Md="6">
                    <Card Class="stat-card">
                        <Statistic Title="Online Runners"
                                  Value="@($"{dashboardStats.OnlineRunners}/{dashboardStats.TotalRunners}")"
                                  Prefix="@runnerIcon"
                                  ValueStyle="@("color: #52c41a")" />
                        <div class="stat-description">
                            Active execution runners
                        </div>
                    </Card>
                </Col>
                <Col Xs="24" Sm="12" Md="6">
                    <Card Class="stat-card">
                        <Statistic Title="Success Rate"
                                  Value="@dashboardStats.SuccessRate"
                                  Suffix="%"
                                  Prefix="@successIcon"
                                  ValueStyle="@("color: #52c41a")" />
                        <div class="stat-description">
                            Successful executions
                        </div>
                    </Card>
                </Col>
                <Col Xs="24" Sm="12" Md="6">
                    <Card Class="stat-card">
                        <Statistic Title="Recent Executions"
                                  Value="@dashboardStats.RecentExecutions"
                                  Prefix="@executionIcon"
                                  ValueStyle="@("color: #722ed1")" />
                        <div class="stat-description">
                            Executions in last 7 days
                        </div>
                    </Card>
                </Col>
            </Row>
        </div> *@
    }

    <!-- Information Cards -->
    <div class="section">
        <Title Level="3" Style="margin-bottom: 24px;">Project Information</Title>
        <Row Gutter="(16, 16)">
            <Col Xs="24" Md="12">
                <Card Class="info-card">
                    <div class="info-header">
                        <Icon Type="info-circle" Style="font-size: 24px; color: #1890ff;" />
                        <Title Level="4" Style="margin: 0;">About Viewer Access</Title>
                    </div>
                    <Paragraph>
                        As a Viewer, you have read-only access to this project. You can:
                    </Paragraph>
                    <ul class="permission-list">
                        <li><Icon Type="check" Style="color: #52c41a;" /> View project statistics and metrics</li>
                        <li><Icon Type="check" Style="color: #52c41a;" /> Monitor execution logs and history</li>
                        <li><Icon Type="check" Style="color: #52c41a;" /> Access project documentation</li>
                        <li><Icon Type="close" Style="color: #ff4d4f;" /> Cannot create or modify resources</li>
                        <li><Icon Type="close" Style="color: #ff4d4f;" /> Cannot execute flows or workflows</li>
                    </ul>
                </Card>
            </Col>
            <Col Xs="24" Md="12">
                <Card Class="info-card">
                    <div class="info-header">
                        <Icon Type="team" Style="font-size: 24px; color: #722ed1;" />
                        <Title Level="4" Style="margin: 0;">Need More Access?</Title>
                    </div>
                    <Paragraph>
                        If you need to create or modify resources, please contact your project administrator to upgrade your role.
                    </Paragraph>
                    <Paragraph Type="@TextElementType.Secondary">
                        <strong>Project Owner:</strong> @(ProjectContext.CurrentProject?.OwnerName ?? "Unknown")
                    </Paragraph>
                    <Paragraph Type="@TextElementType.Secondary" Style="margin-top: 16px;">
                        Available roles:
                    </Paragraph>
                    <div class="role-badges">
                        <Tag Color="@TagColor.Blue">Viewer (Current)</Tag>
                        <Tag>AppUser</Tag>
                        <Tag>Developer</Tag>
                        <Tag>ProjectAdmin</Tag>
                    </div>
                </Card>
            </Col>
        </Row>
    </div>

    <!-- Quick Links -->
    <div class="section">
        <Title Level="3" Style="margin-bottom: 24px;">Available Resources</Title>
        <Row Gutter="(16, 16)">
            <Col Xs="24" Sm="12" Md="6">
                <Card Hoverable Class="resource-card">
                    <div class="resource-icon">
                        <Icon Type="bar-chart" Style="font-size: 32px; color: #1890ff;" />
                    </div>
                    <Title Level="5">Analytics</Title>
                    <Paragraph Type="@TextElementType.Secondary">
                        View project metrics and reports
                    </Paragraph>
                    <Button Type="@ButtonType.Text" Disabled>
                        Coming Soon
                    </Button>
                </Card>
            </Col>
            <Col Xs="24" Sm="12" Md="6">
                <Card Hoverable Class="resource-card">
                    <div class="resource-icon">
                        <Icon Type="file-text" Style="font-size: 32px; color: #52c41a;" />
                    </div>
                    <Title Level="5">Logs</Title>
                    <Paragraph Type="@TextElementType.Secondary">
                        View execution logs and history
                    </Paragraph>
                    <Button Type="@ButtonType.Text" Disabled>
                        Coming Soon
                    </Button>
                </Card>
            </Col>
            <Col Xs="24" Sm="12" Md="6">
                <Card Hoverable Class="resource-card">
                    <div class="resource-icon">
                        <Icon Type="book" Style="font-size: 32px; color: #722ed1;" />
                    </div>
                    <Title Level="5">Documentation</Title>
                    <Paragraph Type="@TextElementType.Secondary">
                        Access project documentation
                    </Paragraph>
                    <Button Type="@ButtonType.Text" Disabled>
                        Coming Soon
                    </Button>
                </Card>
            </Col>
            <Col Xs="24" Sm="12" Md="6">
                <Card Hoverable Class="resource-card">
                    <div class="resource-icon">
                        <Icon Type="calendar" Style="font-size: 32px; color: #fa8c16;" />
                    </div>
                    <Title Level="5">Schedules</Title>
                    <Paragraph Type="@TextElementType.Secondary">
                        View scheduled workflows
                    </Paragraph>
                    <Button Type="@ButtonType.Text" Disabled>
                        Coming Soon
                    </Button>
                </Card>
            </Col>
        </Row>
    </div>
</div>

@code {
    private DashboardStats? dashboardStats;

    private RenderFragment flowIcon = @<Icon Type="profile" />;
    private RenderFragment runnerIcon = @<Icon Type="play-square" />;
    private RenderFragment successIcon = @<Icon Type="check-circle" />;
    private RenderFragment executionIcon = @<Icon Type="bar-chart" />;

    protected override async Task OnInitializedAsync()
    {
        // Load dashboard stats
        dashboardStats = await DashboardService.GetDashboardStatsAsync();
    }
}

<style>
    .viewer-dashboard {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0;
    }

    .dashboard-header {
        background: linear-gradient(135deg, #722ed1 0%, #531dab 100%);
        border-radius: 12px;
        padding: 48px 40px;
        margin-bottom: 32px;
        box-shadow: 0 4px 12px rgba(114, 46, 209, 0.2);
    }

    .header-content {
        display: flex;
        align-items: center;
        gap: 24px;
    }

    .header-icon {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 80px;
        height: 80px;
        background-color: rgba(255, 255, 255, 0.2);
        border-radius: 16px;
    }

    .header-text {
        flex: 1;
    }

    .section {
        margin-bottom: 48px;
    }

    .stat-card {
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        transition: all 0.3s ease;
        padding: 24px;
    }

    .stat-card:hover {
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
    }

    .stat-description {
        font-size: 12px;
        color: #8c8c8c;
        margin-top: 8px;
    }

    .info-card {
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        height: 100%;
    }

    .info-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
    }

    .permission-list {
        list-style: none;
        padding: 0;
        margin: 16px 0;
    }

    .permission-list li {
        padding: 8px 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .role-badges {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .resource-card {
        text-align: center;
        padding: 24px;
        border-radius: 12px;
        transition: all 0.3s ease;
        height: 100%;
    }

    .resource-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.12);
    }

    .resource-icon {
        width: 80px;
        height: 80px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f0f2f5;
        margin: 0 auto 16px;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .dashboard-header {
            padding: 32px 24px;
        }

        .header-content {
            flex-direction: column;
            text-align: center;
        }

        .section {
            margin-bottom: 32px;
        }
    }
</style>
