@page "/admin/ai-providers"
@using Automaton.Studio.Models.Admin
@using Automaton.Studio.Pages.Admin.AiProviders
@layout Automaton.Studio.Shared.AdminLayout

<PageTitle>AI Providers - Admin - Automaton Studio</PageTitle>

<div class="admin-page-header">
    <div class="admin-page-title">
        <Icon Type="robot" class="admin-page-icon" />
        <h2>AI Providers</h2>
    </div>
    <div class="admin-page-actions">
        <Button Type="@ButtonType.Primary" Icon="plus" OnClick="@NavigateToCreate">
            Add Provider
        </Button>
    </div>
</div>

@if (ViewModel.Loading)
{
    <div class="loading-container">
        <Spin Size="SpinSize.Large" />
    </div>
}
else
{
    <Card>
        <Table TItem="AiProviderAdminModel"
               DataSource="@ViewModel.Providers"
               PageSize="20">

            <Column Title="Provider" TData="string">
                <div class="provider-name-cell">
                    <Icon Type="@(context.IconName ?? "api")" class="provider-icon" />
                    <div class="provider-info">
                        <span class="provider-display-name">@context.DisplayName</span>
                        <span class="provider-name-code">@context.Name</span>
                    </div>
                </div>
            </Column>

            <Column Title="Status" TData="bool">
                <Switch Checked="@context.IsActive"
                        CheckedChildren="Active"
                        UnCheckedChildren="Inactive"
                        OnChange="@(() => ViewModel.ToggleProviderStatus(context))" />
            </Column>

            <Column Title="Models" TData="int">
                <Space>
                    <SpaceItem>
                        <Tag Color=@("blue")>@context.ModelCount total</Tag>
                    </SpaceItem>
                    <SpaceItem>
                        <Tag Color=@("green")>@context.ActiveModelCount active</Tag>
                    </SpaceItem>
                </Space>
            </Column>

            <Column Title="API Key" TData="bool">
                @if (context.RequiresApiKey)
                {
                    <Tag Color=@("orange")>Required</Tag>
                    @if (!string.IsNullOrEmpty(context.EnvironmentKeyName))
                    {
                        <Tooltip Title="@($"Environment variable: {context.EnvironmentKeyName}")">
                            <Tag Color=@("cyan")>ENV</Tag>
                        </Tooltip>
                    }
                }
                else
                {
                    <Tag>Not Required</Tag>
                }
            </Column>

            <Column Title="Sort Order" @bind-Field="@context.SortOrder" Width="100" />

            <ActionColumn Title="Actions" Width="150">
                <Space>
                    <SpaceItem>
                        <Tooltip Title="View Models">
                            <Button Type="@ButtonType.Text"
                                    Icon="unordered-list"
                                    Size="@ButtonSize.Small"
                                    OnClick="@(() => NavigateToModels(context.Id))" />
                        </Tooltip>
                    </SpaceItem>
                    <SpaceItem>
                        <Tooltip Title="Edit">
                            <Button Type="@ButtonType.Text"
                                    Icon="edit"
                                    Size="@ButtonSize.Small"
                                    OnClick="@(() => NavigateToEdit(context.Id))" />
                        </Tooltip>
                    </SpaceItem>
                    <SpaceItem>
                        <Popconfirm Title="Are you sure you want to delete this provider?"
                                   OnConfirm="@(() => ViewModel.DeleteProvider(context.Id))"
                                   OkText="Yes"
                                   CancelText="No">
                            <Tooltip Title="Delete">
                                <Button Type="@ButtonType.Text"
                                        Danger
                                        Icon="delete"
                                        Size="@ButtonSize.Small" />
                            </Tooltip>
                        </Popconfirm>
                    </SpaceItem>
                </Space>
            </ActionColumn>
        </Table>
    </Card>
}

<style>
    .admin-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .admin-page-title {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .admin-page-title h2 {
        margin: 0;
        font-size: 24px;
        font-weight: 600;
    }

    .admin-page-icon {
        font-size: 28px;
        color: #1890ff;
    }

    .loading-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 200px;
    }

    .provider-name-cell {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .provider-icon {
        font-size: 24px;
        color: #1890ff;
    }

    .provider-info {
        display: flex;
        flex-direction: column;
    }

    .provider-display-name {
        font-weight: 500;
    }

    .provider-name-code {
        font-size: 12px;
        color: #8c8c8c;
        font-family: monospace;
    }

    .form-help {
        font-size: 12px;
        color: #8c8c8c;
        margin-top: 4px;
    }
</style>
