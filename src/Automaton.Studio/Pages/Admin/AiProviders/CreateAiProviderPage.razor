@page "/admin/ai-providers/create"
@using Automaton.Studio.Models.Admin
@using Automaton.Studio.Pages.Admin.AiProviders.Components
@layout Automaton.Studio.Shared.AdminLayout

<PageTitle>Create AI Provider - Admin - Automaton Studio</PageTitle>

<div class="admin-page-header">
    <div class="admin-page-title">
        <Icon Type="robot" class="admin-page-icon" />
        <h2>Create AI Provider</h2>
    </div>
</div>

<Breadcrumb Style="margin-bottom: 16px;">
    <BreadcrumbItem>
        <a href="/admin/ai-providers">AI Providers</a>
    </BreadcrumbItem>
    <BreadcrumbItem>Create</BreadcrumbItem>
</Breadcrumb>

<Card>
    <AiProviderForm Model="@formModel"
                    IsEditMode="false"
                    IsSaving="@isSaving"
                    OnSave="@HandleCreate"
                    OnCancel="@HandleCancel" />
</Card>

<style>
    .admin-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .admin-page-title {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .admin-page-title h2 {
        margin: 0;
        font-size: 24px;
        font-weight: 600;
    }

    .admin-page-icon {
        font-size: 28px;
        color: #1890ff;
    }
</style>
