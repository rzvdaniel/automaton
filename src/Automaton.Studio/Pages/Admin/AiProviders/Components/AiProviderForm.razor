@using Automaton.Studio.Models.Admin

<Form Model="@Model" Layout="@FormLayout.Vertical">
    <FormItem Label="Name" Required>
        <Input @bind-Value="Model.Name"
               Placeholder="e.g., OpenAI, Anthropic, Google" />
        <div class="form-help">Internal identifier. Use lowercase letters, no spaces.</div>
    </FormItem>

    <FormItem Label="Display Name" Required>
        <Input @bind-Value="Model.DisplayName"
               Placeholder="e.g., OpenAI, Anthropic Claude, Google AI" />
    </FormItem>

    <FormItem Label="Description">
        <TextArea @bind-Value="Model.Description"
                 Placeholder="Brief description of the provider"
                 Rows="2" />
    </FormItem>

    <FormItem Label="Base URL">
        <Input @bind-Value="Model.BaseUrl"
               Placeholder="e.g., https://api.openai.com/v1" />
    </FormItem>

    <Row Gutter="16">
        <Col Span="12">
            <FormItem Label="Icon Name">
                <Input @bind-Value="Model.IconName"
                       Placeholder="e.g., robot, cloud" />
            </FormItem>
        </Col>
        <Col Span="12">
            <FormItem Label="Sort Order">
                <AntDesign.InputNumber @bind-Value="Model.SortOrder" Min="0" Style="width:100%" />
            </FormItem>
        </Col>
    </Row>

    <Row Gutter="16">
        <Col Span="12">
            <FormItem Label="Requires API Key">
                <Switch @bind-Checked="Model.RequiresApiKey" />
            </FormItem>
        </Col>
        <Col Span="12">
            <FormItem Label="Active">
                <Switch @bind-Checked="Model.IsActive" />
            </FormItem>
        </Col>
    </Row>

    @if (Model.RequiresApiKey)
    {
        <FormItem Label="Environment Variable Name">
            <Input @bind-Value="Model.EnvironmentKeyName"
                   Placeholder="e.g., OPENAI_API_KEY" />
        </FormItem>

        <FormItem Label="API Key Help URL">
            <Input @bind-Value="Model.ApiKeyHelpUrl"
                   Placeholder="e.g., https://platform.openai.com/api-keys" />
        </FormItem>
    }

    <div class="form-actions">
        <Space>
            <SpaceItem>
                <Button Type="@ButtonType.Default" OnClick="@OnCancel">
                    Cancel
                </Button>
            </SpaceItem>
            <SpaceItem>
                <Button Type="@ButtonType.Primary" OnClick="@HandleSave" Loading="@IsSaving">
                    @(IsEditMode ? "Update" : "Create") Provider
                </Button>
            </SpaceItem>
        </Space>
    </div>
</Form>

<style>
    .form-help {
        font-size: 12px;
        color: #8c8c8c;
        margin-top: 4px;
    }

    .form-actions {
        margin-top: 24px;
        display: flex;
        justify-content: flex-end;
    }
</style>

@code {
    [Parameter] public AiProviderFormModel Model { get; set; } = new();
    [Parameter] public bool IsEditMode { get; set; }
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task HandleSave()
    {
        await OnSave.InvokeAsync();
    }
}
