@page "/admin/ai-providers/edit/{id:guid}"
@using Automaton.Studio.Models.Admin
@using Automaton.Studio.Pages.Admin.AiProviders.Components
@layout Automaton.Studio.Shared.AdminLayout

<PageTitle>Edit AI Provider - Admin - Automaton Studio</PageTitle>

<div class="admin-page-header">
    <div class="admin-page-title">
        <Icon Type="robot" class="admin-page-icon" />
        <h2>Edit AI Provider</h2>
    </div>
</div>

<Breadcrumb Style="margin-bottom: 16px;">
    <BreadcrumbItem>
        <a href="/admin/ai-providers">AI Providers</a>
    </BreadcrumbItem>
    <BreadcrumbItem>Edit</BreadcrumbItem>
</Breadcrumb>

@if (loading)
{
    <div class="loading-container">
        <Spin Size="SpinSize.Large" />
    </div>
}
else if (formModel != null)
{
    <Card>
        <AiProviderForm Model="@formModel"
                        IsEditMode="true"
                        IsSaving="@isSaving"
                        OnSave="@HandleUpdate"
                        OnCancel="@HandleCancel" />
    </Card>
}
else
{
    <Card>
        <Result Status="404"
                Title="Provider not found"
                SubTitle="The AI provider you're looking for doesn't exist.">
            <Extra>
                <Button Type="@ButtonType.Primary" OnClick="@HandleCancel">
                    Back to Providers
                </Button>
            </Extra>
        </Result>
    </Card>
}

<style>
    .admin-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .admin-page-title {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .admin-page-title h2 {
        margin: 0;
        font-size: 24px;
        font-weight: 600;
    }

    .admin-page-icon {
        font-size: 28px;
        color: #1890ff;
    }

    .loading-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 200px;
    }
</style>
