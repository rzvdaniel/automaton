                    Style="width:100%"
                    Placeholder="e.g., 0.0015" />
                </FormItem>
            </Col>
            <Col Span="12">
                <FormItem Label="Output Cost ($)">
                <AntDesign.InputNumber @bind-Value="ViewModel.EditRequest.CostPer1kTokensOutput"
                    Min="0"
                    Step="0.0001"
                    Style="width:100%"
                    Placeholder="e.g., 0.002" />
                </FormItem>
            </Col>
        </Row>
    </Form>
</Modal>

<style>
    .admin-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .admin-page-title {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .admin-page-title h2 {
        margin: 0;
        font-size: 24px;
        font-weight: 600;
    }

    .admin-page-icon {
        font-size: 28px;
        color: #1890ff;
    }

    .loading-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 200px;
    }

    .model-name-cell {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .model-info {
        display: flex;
        flex-direction: column;
    }

    .model-display-name {
        font-weight: 500;
        display: flex;
        align-items: center;
    }

    .model-id-code {
        font-size: 12px;
        color: #8c8c8c;
        font-family: monospace;
    }

    .form-help {
        font-size: 12px;
        color: #8c8c8c;
        margin-top: 4px;
    }

    .cost-info {
        display: flex;
        flex-direction: column;
        font-size: 12px;
        font-family: monospace;
    }

    .text-muted {
        color: #8c8c8c;
    }
</style>