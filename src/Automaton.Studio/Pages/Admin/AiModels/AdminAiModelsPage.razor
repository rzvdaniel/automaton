@page "/admin/ai-models"
@using Automaton.Studio.Models.Admin
@using Automaton.Studio.Pages.Admin.AiModels
@layout Automaton.Studio.Shared.AdminLayout

<PageTitle>AI Models - Admin - Automaton Studio</PageTitle>

<div class="admin-page-header">
    <div class="admin-page-title">
        <Icon Type="appstore" class="admin-page-icon" />
        <h2>AI Models</h2>
    </div>
    <div class="admin-page-actions">
        <Space>
            <SpaceItem>
                <Select TItem="AiProviderAdminModel"
                        TItemValue="Guid?"
                        DataSource="@ViewModel.Providers"
                        @bind-Value="@ViewModel.SelectedProviderId"
                        ValueName="@nameof(AiProviderAdminModel.Id)"
                        LabelName="@nameof(AiProviderAdminModel.DisplayName)"
                        OnSelectedItemChanged="@OnProviderFilterChanged"
                        AllowClear
                        Placeholder="All providers"
                        Style="width: 200px" />
            </SpaceItem>
            <SpaceItem>
                <Button Type="@ButtonType.Primary" Icon="plus" OnClick="@ViewModel.ShowCreateModal">
                    Add Model
                </Button>
            </SpaceItem>
        </Space>
    </div>
</div>

@if (ViewModel.Loading)
{
    <div class="loading-container">
        <Spin Size="SpinSize.Large" />
    </div>
}
else
{
    <Card>
        <Table TItem="AiModelAdminModel"
               DataSource="@ViewModel.Models"
               PageSize="20">

            <Column Title="Model" TData="string">
                <div class="model-name-cell">
                    <div class="model-info">
                        <span class="model-display-name">
                            @context.DisplayName
                            @if (context.IsDefault)
                            {
                                <Tag Color=@("blue") Style="margin-left: 8px;">Default</Tag>
                            }
                        </span>
                        <span class="model-id-code">@context.ModelId</span>
                    </div>
                </div>
            </Column>

            <Column Title="Provider" @bind-Field="@context.ProviderName">
                <Tag Color=@("cyan")>@context.ProviderName</Tag>
            </Column>

            <Column Title="Status" TData="bool">
                <Switch Checked="@context.IsActive"
                        CheckedChildren="Active"
                        UnCheckedChildren="Inactive"
                        OnChange="@(() => ViewModel.ToggleModelStatus(context))" />
            </Column>

            <Column Title="Capabilities" TData="string">
                <Space Wrap>
                    @if (context.SupportsStreaming)
                    {
                        <SpaceItem><Tag>Streaming</Tag></SpaceItem>
                    }
                    @if (context.SupportsTools)
                    {
                        <SpaceItem><Tag Color=@("green")>Tools</Tag></SpaceItem>
                    }
                    @if (context.SupportsVision)
                    {
                        <SpaceItem><Tag Color=@("purple")>Vision</Tag></SpaceItem>
                    }
                </Space>
            </Column>

            <Column Title="Max Tokens" @bind-Field="@context.MaxTokens" Width="120">
                <code>@context.MaxTokens.ToString("N0")</code>
            </Column>

            <Column Title="Cost" TData="decimal?" Width="180">
                @if (context.CostPer1kTokensInput.HasValue || context.CostPer1kTokensOutput.HasValue)
                {
                    <div class="cost-info">
                        @if (context.CostPer1kTokensInput.HasValue)
                        {
                            <span>In: $@context.CostPer1kTokensInput.Value.ToString("F4")</span>
                        }
                        @if (context.CostPer1kTokensOutput.HasValue)
                        {
                            <span>Out: $@context.CostPer1kTokensOutput.Value.ToString("F4")</span>
                        }
                    </div>
                }
                else
                {
                    <span class="text-muted">-</span>
                }
            </Column>

            <ActionColumn Title="Actions" Width="180">
                <Space>
                    @if (!context.IsDefault)
                    {
                        <SpaceItem>
                            <Tooltip Title="Set as Default">
                                <Button Type="@ButtonType.Text"
                                        Icon="star"
                                        Size="@ButtonSize.Small"
                                        OnClick="@(() => ViewModel.SetAsDefault(context))" />
                            </Tooltip>
                        </SpaceItem>
                    }
                    <SpaceItem>
                        <Tooltip Title="Edit">
                            <Button Type="@ButtonType.Text"
                                    Icon="edit"
                                    Size="@ButtonSize.Small"
                                    OnClick="@(() => ViewModel.ShowEditModal(context))" />
                        </Tooltip>
                    </SpaceItem>
                    <SpaceItem>
                        <Popconfirm Title="Are you sure you want to delete this model?"
                                   OnConfirm="@(() => ViewModel.DeleteModel(context.Id))"
                                   OkText="Yes"
                                   CancelText="No">
                            <Tooltip Title="Delete">
                                <Button Type="@ButtonType.Text"
                                        Danger
                                        Icon="delete"
                                        Size="@ButtonSize.Small" />
                            </Tooltip>
                        </Popconfirm>
                    </SpaceItem>
                </Space>
            </ActionColumn>
        </Table>
    </Card>
}

<!-- Create Model Modal -->
<Modal Title="Add AI Model"
       @bind-Visible="ViewModel.CreateModalVisible"
       OnOk="@ViewModel.CreateModel"
       ConfirmLoading="@ViewModel.CreateLoading"
       Width="700">
    <Form Model="@ViewModel.CreateRequest" Layout="@FormLayout.Vertical">
        <FormItem Label="Provider" Required>
            <Select TItem="AiProviderAdminModel"
                    TItemValue="Guid"
                    DataSource="@ViewModel.Providers"
                    ValueProperty="p => p.Id"
                    LabelProperty="p => p.DisplayName"
                    @bind-Value="ViewModel.CreateProviderId"
                    Style="width: 100%" />
        </FormItem>

        <Row Gutter="16">
            <Col Span="12">
                <FormItem Label="Model ID" Required>
                    <Input @bind-Value="ViewModel.CreateRequest.ModelId"
                           Placeholder="e.g., gpt-4, claude-3-opus" />
                    <div class="form-help">The API identifier for the model</div>
                </FormItem>
            </Col>
            <Col Span="12">
                <FormItem Label="Display Name" Required>
                    <Input @bind-Value="ViewModel.CreateRequest.DisplayName"
                           Placeholder="e.g., GPT-4, Claude 3 Opus" />
                </FormItem>
            </Col>
        </Row>

        <FormItem Label="Description">
            <TextArea @bind-Value="ViewModel.CreateRequest.Description"
                     Placeholder="Brief description of the model's capabilities"
                     Rows="2" />
        </FormItem>

        <Row Gutter="16">
            <Col Span="8">
                <FormItem Label="Max Tokens">
                    <AntDesign.InputNumber @bind-Value="ViewModel.CreateRequest.MaxTokens" Min="1" Style="width:100%" />
                </FormItem>
            </Col>
            <Col Span="8">
                <FormItem Label="Sort Order">
                    <AntDesign.InputNumber @bind-Value="ViewModel.CreateRequest.SortOrder" Min="0" Style="width:100%" />
                </FormItem>
            </Col>
            <Col Span="8">
                <FormItem Label="Status">
                    <Space>
                        <SpaceItem>
                            <Checkbox @bind-Checked="ViewModel.CreateRequest.IsActive">Active</Checkbox>
                        </SpaceItem>
                        <SpaceItem>
                            <Checkbox @bind-Checked="ViewModel.CreateRequest.IsDefault">Default</Checkbox>
                        </SpaceItem>
                    </Space>
                </FormItem>
            </Col>
        </Row>

        <Divider Orientation="@DividerOrientation.Left">Capabilities</Divider>

        <Row Gutter="16">
            <Col Span="8">
                <Checkbox @bind-Checked="ViewModel.CreateRequest.SupportsStreaming">Supports Streaming</Checkbox>
            </Col>
            <Col Span="8">
                <Checkbox @bind-Checked="ViewModel.CreateRequest.SupportsTools">Supports Tools/Functions</Checkbox>
            </Col>
            <Col Span="8">
                <Checkbox @bind-Checked="ViewModel.CreateRequest.SupportsVision">Supports Vision</Checkbox>
            </Col>
        </Row>

        <Divider Orientation="@DividerOrientation.Left">Pricing (per 1K tokens)</Divider>

        <Row Gutter="16">
            <Col Span="12">
                <FormItem Label="Input Cost ($)">
                <AntDesign.InputNumber @bind-Value="ViewModel.CreateRequest.CostPer1kTokensInput"
                    Min="0"
                    Step="0.0001"
                    Style="width:100%"
                    Placeholder="e.g., 0.0015" />
                </FormItem>
            </Col>
            <Col Span="12">
                <FormItem Label="Output Cost ($)">
                <AntDesign.InputNumber @bind-Value="ViewModel.CreateRequest.CostPer1kTokensOutput"
                    Min="0"
                    Step="0.0001"
                    Style="width:100%"
                    Placeholder="e.g., 0.002" />
                </FormItem>
            </Col>
        </Row>
    </Form>
</Modal>

<!-- Edit Model Modal -->
