        </Row>

        <Divider Orientation="@DividerOrientation.Left">Pricing (per 1K tokens)</Divider>

        <Row Gutter="16">
            <Col Span="12">
                <FormItem Label="Input Cost ($)">
                <AntDesign.InputNumber @bind-Value="ViewModel.EditRequest.CostPer1kTokensInput"
                    Min="0"
