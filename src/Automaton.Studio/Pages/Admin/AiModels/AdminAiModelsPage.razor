@page "/admin/ai-models"
@using Automaton.Studio.Models.Admin
@using Automaton.Studio.Pages.Admin.AiModels
@layout Automaton.Studio.Shared.AdminLayout

<PageTitle>AI Models - Admin - Automaton Studio</PageTitle>

<div class="admin-page-header">
    <div class="admin-page-title">
        <Icon Type="appstore" class="admin-page-icon" />
        <h2>AI Models</h2>
    </div>
    <div class="admin-page-actions">
        <Space>
            <SpaceItem>
                <Select TItem="AiProviderAdminModel"
                        TItemValue="Guid?"
                        DataSource="@ViewModel.Providers"
                        @bind-Value="@ViewModel.SelectedProviderId"
                        ValueName="@nameof(AiProviderAdminModel.Id)"
                        LabelName="@nameof(AiProviderAdminModel.DisplayName)"
                        OnSelectedItemChanged="@OnProviderFilterChanged"
                        AllowClear
                        Placeholder="All providers"
                        Style="width: 200px" />
            </SpaceItem>
            <SpaceItem>
                <Button Type="@ButtonType.Primary" Icon="plus" OnClick="@NavigateToCreate">
                    Add Model
                </Button>
            </SpaceItem>
        </Space>
    </div>
</div>

@if (ViewModel.Loading)
{
    <div class="loading-container">
        <Spin Size="SpinSize.Large" />
    </div>
}
else
{
    <Card>
        <Table TItem="AiModelAdminModel"
               DataSource="@ViewModel.Models"
               PageSize="20">

            <Column Title="Model" TData="string">
                <div class="model-name-cell">
                    <div class="model-info">
                        <span class="model-display-name">
                            @context.DisplayName
                            @if (context.IsDefault)
                            {
                                <Tag Color=@("blue") Style="margin-left: 8px;">Default</Tag>
                            }
                        </span>
                        <span class="model-id-code">@context.ModelId</span>
                    </div>
                </div>
            </Column>

            <Column Title="Provider" @bind-Field="@context.ProviderName">
                <Tag Color=@("cyan")>@context.ProviderName</Tag>
            </Column>

            <Column Title="Status" TData="bool">
                <Switch Checked="@context.IsActive"
                        CheckedChildren="Active"
                        UnCheckedChildren="Inactive"
                        OnChange="@(() => ViewModel.ToggleModelStatus(context))" />
            </Column>

            <Column Title="Capabilities" TData="string">
                <Space Wrap>
                    @if (context.SupportsStreaming)
                    {
                        <SpaceItem><Tag>Streaming</Tag></SpaceItem>
                    }
                    @if (context.SupportsTools)
                    {
                        <SpaceItem><Tag Color=@("green")>Tools</Tag></SpaceItem>
                    }
                    @if (context.SupportsVision)
                    {
                        <SpaceItem><Tag Color=@("purple")>Vision</Tag></SpaceItem>
                    }
                </Space>
            </Column>

            <Column Title="Max Tokens" @bind-Field="@context.MaxTokens" Width="120">
                <code>@context.MaxTokens.ToString("N0")</code>
            </Column>

            <Column Title="Cost" TData="decimal?" Width="180">
                @if (context.CostPer1kTokensInput.HasValue || context.CostPer1kTokensOutput.HasValue)
                {
                    <div class="cost-info">
                        @if (context.CostPer1kTokensInput.HasValue)
                        {
                            <span>In: $@context.CostPer1kTokensInput.Value.ToString("F4")</span>
                        }
                        @if (context.CostPer1kTokensOutput.HasValue)
                        {
                            <span>Out: $@context.CostPer1kTokensOutput.Value.ToString("F4")</span>
                        }
                    </div>
                }
                else
                {
                    <span class="text-muted">-</span>
                }
            </Column>

            <ActionColumn Title="Actions" Width="180">
                <Space>
                    @if (!context.IsDefault)
                    {
                        <SpaceItem>
                            <Tooltip Title="Set as Default">
                                <Button Type="@ButtonType.Text"
                                        Icon="star"
                                        Size="@ButtonSize.Small"
                                        OnClick="@(() => ViewModel.SetAsDefault(context))" />
                            </Tooltip>
                        </SpaceItem>
                    }
                    <SpaceItem>
                        <Tooltip Title="Edit">
                            <Button Type="@ButtonType.Text"
                                    Icon="edit"
                                    Size="@ButtonSize.Small"
                                    OnClick="@(() => NavigateToEdit(context.Id))" />
                        </Tooltip>
                    </SpaceItem>
                    <SpaceItem>
                        <Popconfirm Title="Are you sure you want to delete this model?"
                                   OnConfirm="@(() => ViewModel.DeleteModel(context.Id))"
                                   OkText="Yes"
                                   CancelText="No">
                            <Tooltip Title="Delete">
                                <Button Type="@ButtonType.Text"
                                        Danger
                                        Icon="delete"
                                        Size="@ButtonSize.Small" />
                            </Tooltip>
                        </Popconfirm>
                    </SpaceItem>
                </Space>
            </ActionColumn>
        </Table>
    </Card>
}

<style>
    .admin-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .admin-page-title {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .admin-page-title h2 {
        margin: 0;
        font-size: 24px;
        font-weight: 600;
    }

    .admin-page-icon {
        font-size: 28px;
        color: #1890ff;
    }

    .loading-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 200px;
    }

    .model-name-cell {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .model-info {
        display: flex;
        flex-direction: column;
    }

    .model-display-name {
        font-weight: 500;
        display: flex;
        align-items: center;
    }

    .model-id-code {
        font-size: 12px;
        color: #8c8c8c;
        font-family: monospace;
    }

    .form-help {
        font-size: 12px;
        color: #8c8c8c;
        margin-top: 4px;
    }

    .cost-info {
        display: flex;
        flex-direction: column;
        font-size: 12px;
        font-family: monospace;
    }

    .text-muted {
        color: #8c8c8c;
    }
</style>