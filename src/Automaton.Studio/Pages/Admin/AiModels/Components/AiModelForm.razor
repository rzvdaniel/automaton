@using Automaton.Studio.Models.Admin

<Form Model="@Model" Layout="@FormLayout.Vertical">
    @if (ShowProviderSelector && Providers != null)
    {
        <FormItem Label="Provider" Required>
            <Select TItem="AiProviderAdminModel"
                    TItemValue="Guid"
                    DataSource="@Providers"
                    ValueProperty="p => p.Id"
                    LabelProperty="p => p.DisplayName"
                    @bind-Value="SelectedProviderId"
                    Style="width: 100%" />
        </FormItem>
    }

    <Row Gutter="16">
        <Col Span="12">
            <FormItem Label="Model ID" Required>
                <Input @bind-Value="Model.ModelId"
                       Placeholder="e.g., gpt-4, claude-3-opus" />
                <div class="form-help">The API identifier for the model</div>
            </FormItem>
        </Col>
        <Col Span="12">
            <FormItem Label="Display Name" Required>
                <Input @bind-Value="Model.DisplayName"
                       Placeholder="e.g., GPT-4, Claude 3 Opus" />
            </FormItem>
        </Col>
    </Row>

    <FormItem Label="Description">
        <TextArea @bind-Value="Model.Description"
                 Placeholder="Brief description of the model's capabilities"
                 Rows="2" />
    </FormItem>

    <Row Gutter="16">
        <Col Span="8">
            <FormItem Label="Max Tokens">
                <AntDesign.InputNumber @bind-Value="Model.MaxTokens" Min="1" Style="width:100%" />
            </FormItem>
        </Col>
        <Col Span="8">
            <FormItem Label="Sort Order">
                <AntDesign.InputNumber @bind-Value="Model.SortOrder" Min="0" Style="width:100%" />
            </FormItem>
        </Col>
        <Col Span="8">
            <FormItem Label="Status">
                <Space>
                    <SpaceItem>
                        <Checkbox @bind-Checked="Model.IsActive">Active</Checkbox>
                    </SpaceItem>
                    <SpaceItem>
                        <Checkbox @bind-Checked="Model.IsDefault">Default</Checkbox>
                    </SpaceItem>
                </Space>
            </FormItem>
        </Col>
    </Row>

    <Divider Orientation="@DividerOrientation.Left">Capabilities</Divider>

    <Row Gutter="16">
        <Col Span="8">
            <Checkbox @bind-Checked="Model.SupportsStreaming">Supports Streaming</Checkbox>
        </Col>
        <Col Span="8">
            <Checkbox @bind-Checked="Model.SupportsTools">Supports Tools/Functions</Checkbox>
        </Col>
        <Col Span="8">
            <Checkbox @bind-Checked="Model.SupportsVision">Supports Vision</Checkbox>
        </Col>
    </Row>

    <Divider Orientation="@DividerOrientation.Left">Pricing (per 1K tokens)</Divider>

    <Row Gutter="16">
        <Col Span="12">
            <FormItem Label="Input Cost ($)">
                <AntDesign.InputNumber @bind-Value="Model.CostPer1kTokensInput"
                                      Min="0"
                                      Step="0.0001"
                                      Style="width:100%"
                                      Placeholder="e.g., 0.0015" />
            </FormItem>
        </Col>
        <Col Span="12">
            <FormItem Label="Output Cost ($)">
                <AntDesign.InputNumber @bind-Value="Model.CostPer1kTokensOutput"
                                      Min="0"
                                      Step="0.0001"
                                      Style="width:100%"
                                      Placeholder="e.g., 0.002" />
            </FormItem>
        </Col>
    </Row>

    <div class="form-actions">
        <Space>
            <SpaceItem>
                <Button Type="@ButtonType.Default" OnClick="@OnCancel">
                    Cancel
                </Button>
            </SpaceItem>
            <SpaceItem>
                <Button Type="@ButtonType.Primary" OnClick="@HandleSave" Loading="@IsSaving">
                    @(IsEditMode ? "Update" : "Create") Model
                </Button>
            </SpaceItem>
        </Space>
    </div>
</Form>

<style>
    .form-help {
        font-size: 12px;
        color: #8c8c8c;
        margin-top: 4px;
    }

    .form-actions {
        margin-top: 24px;
        display: flex;
        justify-content: flex-end;
    }
</style>

@code {
    [Parameter] public AiModelFormModel Model { get; set; } = new();
    [Parameter] public bool IsEditMode { get; set; }
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public bool ShowProviderSelector { get; set; }
    [Parameter] public IEnumerable<AiProviderAdminModel>? Providers { get; set; }
    [Parameter] public Guid SelectedProviderId { get; set; }
    [Parameter] public EventCallback<Guid> SelectedProviderIdChanged { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task HandleSave()
    {
        await OnSave.InvokeAsync();
    }
}
