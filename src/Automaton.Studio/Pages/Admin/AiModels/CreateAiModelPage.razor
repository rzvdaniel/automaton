@page "/admin/ai-models/create"
@using Automaton.Studio.Models.Admin
@using Automaton.Studio.Pages.Admin.AiModels.Components
@layout Automaton.Studio.Shared.AdminLayout

<PageTitle>Create AI Model - Admin - Automaton Studio</PageTitle>

<div class="admin-page-header">
    <div class="admin-page-title">
        <Icon Type="appstore" class="admin-page-icon" />
        <h2>Create AI Model</h2>
    </div>
</div>

<Breadcrumb Style="margin-bottom: 16px;">
    <BreadcrumbItem>
        <a href="/admin/ai-models">AI Models</a>
    </BreadcrumbItem>
    <BreadcrumbItem>Create</BreadcrumbItem>
</Breadcrumb>

@if (loading)
{
    <div class="loading-container">
        <Spin Size="SpinSize.Large" />
    </div>
}
else
{
    <Card>
        <AiModelForm Model="@formModel"
                     IsEditMode="false"
                     IsSaving="@isSaving"
                     ShowProviderSelector="true"
                     Providers="@providers"
                     @bind-SelectedProviderId="@selectedProviderId"
                     OnSave="@HandleCreate"
                     OnCancel="@HandleCancel" />
    </Card>
}

<style>
    .admin-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .admin-page-title {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .admin-page-title h2 {
        margin: 0;
        font-size: 24px;
        font-weight: 600;
    }

    .admin-page-icon {
        font-size: 28px;
        color: #1890ff;
    }

    .loading-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 200px;
    }
</style>
