@page "/downloads"
@using Microsoft.AspNetCore.Components
@using Automaton.Studio.Services
@inject IJSRuntime JSRuntime
@inject ConfigurationService ConfigService
@inject NavigationManager NavigationManager
@inject MessageService MessageService

<PageTitle>Download Console Runner - Automaton Studio</PageTitle>

<Layout>
    <Header Class="header">
        <Row>
            <Col Flex=@("none")>
                <Space Size="SpaceSize.Large">
                    <SpaceItem Class="header-item">
                        <Breadcrumb>
                            <BreadcrumbItem Href="/">
                                <Icon Type="home" Width="16" Height="16" />
                                <span>Home</span>
                            </BreadcrumbItem>
                            <BreadcrumbItem>
                                <Icon Type="download" Width="16" Height="16" />
                                <span>Downloads</span>
                            </BreadcrumbItem>
                            <BreadcrumbItem>
                                <Icon Type="code" Width="16" Height="16" />
                                <span>Console Runner</span>
                            </BreadcrumbItem>
                        </Breadcrumb>
                    </SpaceItem>
                </Space>
            </Col>
            <Col Class="right-actions">
                <Space>
                    <SpaceItem>
                        <Button Type="@ButtonType.Primary" OnClick="@(() => NavigationManager.NavigateTo("/onboarding"))">
                            <Icon Type="question-circle" />
                            Get Started
                        </Button>
                    </SpaceItem>
                    <SpaceItem>
                        <Button Type="@ButtonType.Default" OnClick="@(() => NavigationManager.NavigateTo("/desktop"))">
                            <Icon Type="appstore" />
                            Desktop App
                        </Button>
                    </SpaceItem>
                </Space>
            </Col>
        </Row>
    </Header>

    <Content Class="content-padding home-content content-background">
        <div class="home-container">
            
            <!-- Header Section -->
            <div class="downloads-header">
                <div class="downloads-header-content">
                    <div class="downloads-header-icon">
                        <Icon Type="code" Style="font-size: 48px; color: white;" />
                    </div>
                    <div class="downloads-header-text">
                        <Title Level="1" Style="margin-bottom: 8px;">Download Console Runner</Title>
                        <Paragraph Class="downloads-subtitle">
                            Cross-platform command-line runner with interactive setup
                        </Paragraph>
                    </div>
                </div>
            </div>

            <!-- Installation Scripts Section - PRIMARY -->
            <Card Class="installation-scripts-card" Style="margin-bottom: 24px;">
                <TitleTemplate>
                    <Icon Type="rocket" Style="margin-right: 8px;" />
                    <span>🚀 Quick Installation (Recommended)</span>
                </TitleTemplate>
                <ChildContent>
                    <Paragraph Style="font-size: 16px; margin-bottom: 16px;">
                        <strong>Download and install the runner automatically:</strong>
                    </Paragraph>
                    
                    <Row Gutter="16">
                        <Col Span="12">
                            <Card Size="@CardSize.Small" Class="install-command-card">
                                <TitleTemplate>
                                    <Icon Type="windows" Style="margin-right: 8px; color: #0078d4;" />
                                    <span>Windows (PowerShell)</span>
                                </TitleTemplate>
                                <ChildContent>
                                    <Paragraph><strong>Run as Administrator:</strong></Paragraph>
                                    <div class="code-container">
                                        <div class="command-display">
                                            <Text Code Class="code-block">@windowsInstallCommand</Text>
                                            <Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard(windowsInstallCommand, "Windows install command"))" Style="margin-left: 8px;">
                                                Copy
                                            </Button>
                                        </div>
                                    </div>
                                    <Paragraph Type="@TextElementType.Secondary" Style="margin-top: 8px; font-size: 12px;">
                                        ✅ Downloads, installs, and adds to PATH<br/>
                                        ✅ Creates automaton-runner command globally
                                    </Paragraph>
                                </ChildContent>
                            </Card>
                        </Col>
                        
                        <Col Span="12">
                            <Card Size="@CardSize.Small" Class="install-command-card">
                                <TitleTemplate>
                                    <Icon Type="code" Style="margin-right: 8px; color: #ff6b35;" />
                                    <span>Linux / macOS (Terminal)</span>
                                </TitleTemplate>
                                <ChildContent>
                                    <Paragraph><strong>Install command:</strong></Paragraph>
                                    <div class="code-container">
                                        <div class="command-display">
                                            <Text Code Class="code-block">@unixInstallCommand</Text>
                                            <Button Icon="copy" Size="@ButtonSize.Small" OnClick="@(() => CopyToClipboard(unixInstallCommand, "Unix install command"))" Style="margin-left: 8px;">
                                                Copy
                                            </Button>
                                        </div>
                                    </div>
                                    <Paragraph Type="@TextElementType.Secondary" Style="margin-top: 8px; font-size: 12px;">
                                        ✅ Downloads and installs to /usr/local/bin<br/>
                                        ✅ Creates automaton-runner command globally
                                    </Paragraph>
                                </ChildContent>
                            </Card>
                        </Col>
                    </Row>

                    <Alert Type="@AlertType.Success" ShowIcon="true" Style="margin-top: 16px;">
                        <MessageTemplate>
                            <strong>After installation:</strong> Run <code>automaton-runner</code> and it will guide you through setup with your API key!
                        </MessageTemplate>
                    </Alert>
                </ChildContent>
            </Card>

            <!-- Manual Downloads Section -->
            <Card Class="manual-downloads-card" Style="margin-bottom: 24px;">
                <TitleTemplate>
                    <Icon Type="inbox" Style="margin-right: 8px;" />
                    <span>📦 Manual Downloads</span>
                </TitleTemplate>
                <ChildContent>
                    <Paragraph>Download specific platform binaries directly:</Paragraph>
                    
                    <Row Gutter="16">
                        <!-- Windows -->
                        <Col Span="8">
                            <Card Size="@CardSize.Small" Class="platform-card">
                                <TitleTemplate>
                                    <Icon Type="windows" Style="margin-right: 8px; color: #0078d4;" />
                                    <span>Windows</span>
                                </TitleTemplate>
                                <ChildContent>
                                    <Space Direction="SpaceDirection.Vertical" Style="width: 100%;">
                                        <SpaceItem>
                                            <DownloadButton Url="@windowsX64Url" FileName="automaton-runner-win-x64.zip" Type="@ButtonType.Primary" Block="true">
                                                <Icon Type="download" />
                                                x64 (.zip)
                                            </DownloadButton>
                                        </SpaceItem>
                                        <SpaceItem>
                                            <DownloadButton Url="@windowsArm64Url" FileName="automaton-runner-win-arm64.zip" Block="true">
                                                <Icon Type="download" />
                                                ARM64 (.zip)
                                            </DownloadButton>
                                        </SpaceItem>
                                    </Space>
                                </ChildContent>
                            </Card>
                        </Col>

                        <!-- Linux -->
                        <Col Span="8">
                            <Card Size="@CardSize.Small" Class="platform-card">
                                <TitleTemplate>
                                    <Icon Type="code" Style="margin-right: 8px; color: #ff6b35;" />
                                    <span>Linux</span>
                                </TitleTemplate>
                                <ChildContent>
                                    <Space Direction="SpaceDirection.Vertical" Style="width: 100%;">
                                        <SpaceItem>
                                            <DownloadButton Url="@linuxX64Url" FileName="automaton-runner-linux-x64.tar.gz" Type="@ButtonType.Primary" Block="true">
                                                <Icon Type="download" />
                                                x64 (.tar.gz)
                                            </DownloadButton>
                                        </SpaceItem>
                                        <SpaceItem>
                                            <DownloadButton Url="@linuxArm64Url" FileName="automaton-runner-linux-arm64.tar.gz" Block="true">
                                                <Icon Type="download" />
                                                ARM64 (.tar.gz)
                                            </DownloadButton>
                                        </SpaceItem>
                                    </Space>
                                </ChildContent>
                            </Card>
                        </Col>

                        <!-- macOS -->
                        <Col Span="8">
                            <Card Size="@CardSize.Small" Class="platform-card">
                                <TitleTemplate>
                                    <Icon Type="apple" Style="margin-right: 8px; color: #333;" />
                                    <span>macOS</span>
                                </TitleTemplate>
                                <ChildContent>
                                    <Space Direction="SpaceDirection.Vertical" Style="width: 100%;">
                                        <SpaceItem>
                                            <DownloadButton Url="@macosX64Url" FileName="automaton-runner-macos-x64.tar.gz" Type="@ButtonType.Primary" Block="true">
                                                <Icon Type="download" />
                                                Intel (.tar.gz)
                                            </DownloadButton>
                                        </SpaceItem>
                                        <SpaceItem>
                                            <DownloadButton Url="@macosArm64Url" FileName="automaton-runner-macos-arm64.tar.gz" Block="true">
                                                <Icon Type="download" />
                                                Apple Silicon (.tar.gz)
                                            </DownloadButton>
                                        </SpaceItem>
                                    </Space>
                                </ChildContent>
                            </Card>
                        </Col>
                    </Row>
                </ChildContent>
            </Card>

            <!-- Getting Started Section -->
            <Card Class="getting-started-card" Style="margin-bottom: 24px;">
                <TitleTemplate>
                    <Icon Type="play-circle" Style="margin-right: 8px;" />
                    <span>Getting Started</span>
                </TitleTemplate>
                <ChildContent>
                    <Row Gutter="24">
                        <Col Span="12">
                            <div class="step-container">
                                <div class="step-number">1</div>
                                <div class="step-content">
                                    <Title Level="4">Get Your API Key</Title>
                                    <Paragraph>Create an API key in Automaton Studio:</Paragraph>
                                    <ol>
                                        <li>Go to <strong>Settings → API Keys</strong></li>
                                        <li>Click <strong>Create API Key</strong></li>
                                        <li>Choose <strong>"Runner"</strong> scope</li>
                                        <li>Copy your key (starts with <code>ak_</code>)</li>
                                    </ol>
                                    <Button Type="@ButtonType.Link" OnClick="@(() => NavigationManager.NavigateTo("/apikeys"))" Style="padding: 0;">
                                        <Icon Type="arrow-right" />
                                        Go to API Keys
                                    </Button>
                                </div>
                            </div>
                        </Col>
                        
                        <Col Span="12">
                            <div class="step-container">
                                <div class="step-number">2</div>
                                <div class="step-content">
                                    <Title Level="4">Run Interactive Setup</Title>
                                    <Paragraph>Start the runner - it will guide you:</Paragraph>
                                    <div class="code-example">
                                        <Text Code>automaton-runner</Text>
                                    </div>
                                    <Paragraph Type="@TextElementType.Secondary" Style="margin-top: 8px;">
                                        The runner will prompt for your API key, server URL, and runner name.
                                    </Paragraph>
                                </div>
                            </div>
                        </Col>
                    </Row>
                </ChildContent>
            </Card>

            <!-- Advanced Commands Section -->
            <Card Class="advanced-commands-card" Style="margin-bottom: 24px;">
                <TitleTemplate>
                    <Icon Type="code" Style="margin-right: 8px;" />
                    <span>Advanced Commands</span>
                </TitleTemplate>
                <ChildContent>
                    <Paragraph>For scripting and advanced usage, individual commands are available:</Paragraph>
                    
                    <Row Gutter="16">
                        <Col Span="12">
                            <div class="command-section">
                                <Title Level="5">Authentication</Title>
                                <div class="code-example">
                                    <Text Code># Interactive authentication</Text><br/>
                                    <Text Code>automaton-runner auth</Text><br/><br/>
                                    <Text Code># With parameters</Text><br/>
                                    <Text Code>automaton-runner auth --api-key ak_xxx --server https://server.com</Text>
                                </div>
                            </div>
                        </Col>
                        <Col Span="12">
                            <div class="command-section">
                                <Title Level="5">Registration</Title>
                                <div class="code-example">
                                    <Text Code># Interactive registration</Text><br/>
                                    <Text Code>automaton-runner register</Text><br/><br/>
                                    <Text Code># With name</Text><br/>
                                    <Text Code>automaton-runner register --name "My-Runner"</Text><br/><br/>
                                    <Text Code># Force re-registration</Text><br/>
                                    <Text Code>automaton-runner register --force</Text>
                                </div>
                            </div>
                        </Col>
                    </Row>
                    
                    <Row Gutter="16" Style="margin-top: 16px;">
                        <Col Span="12">
                            <div class="command-section">
                                <Title Level="5">Configuration</Title>
                                <div class="code-example">
                                    <Text Code># Configure server URL</Text><br/>
                                    <Text Code>automaton-runner server --url https://server.com</Text><br/><br/>
                                    <Text Code># Show status</Text><br/>
                                    <Text Code>automaton-runner status</Text>
                                </div>
                            </div>
                        </Col>
                        <Col Span="12">
                            <div class="command-section">
                                <Title Level="5">Maintenance</Title>
                                <div class="code-example">
                                    <Text Code># Clean up stored data</Text><br/>
                                    <Text Code>automaton-runner cleanup</Text><br/><br/>
                                    <Text Code># Show help</Text><br/>
                                    <Text Code>automaton-runner --help</Text>
                                </div>
                            </div>
                        </Col>
                    </Row>
                </ChildContent>
            </Card>

            <!-- Environment Variables Section -->
            <Card Class="env-vars-card">
                <TitleTemplate>
                    <Icon Type="setting" Style="margin-right: 8px;" />
                    <span>Automation & Environment Variables</span>
                </TitleTemplate>
                <ChildContent>
                    <Paragraph>For automated deployments and CI/CD:</Paragraph>
                    
                    <div class="code-example" Style="margin: 16px 0;">
                        <Text Code># Set API key via environment variable</Text><br/>
                        <Text Code>export AUTOMATON_API_KEY="ak_runner_1234567890abcdef"</Text><br/><br/>
                        <Text Code># Runner starts with no prompts</Text><br/>
                        <Text Code>automaton-runner</Text>
                    </div>

                    <Alert Type="@AlertType.Info" ShowIcon="true" Style="margin-top: 16px;">
                        <MessageTemplate>
                            <strong>Perfect for Docker, CI/CD, and server deployments!</strong><br/>
                            The runner automatically detects environment variables and skips interactive prompts.
                        </MessageTemplate>
                    </Alert>
                </ChildContent>
            </Card>
        </div>
    </Content>
</Layout>

@code {
    private string windowsInstallCommand = "";
    private string unixInstallCommand = "";
    private string windowsX64Url = "";
    private string windowsArm64Url = "";
    private string linuxX64Url = "";
    private string linuxArm64Url = "";
    private string macosX64Url = "";
    private string macosArm64Url = "";

    protected override void OnInitialized()
    {
        // Installation scripts
        windowsInstallCommand = $"iwr -useb {ConfigService.BaseUrl}/downloads/install.ps1 | iex";
        unixInstallCommand = $"curl -sSL {ConfigService.BaseUrl}/downloads/install.sh | bash";
        
        // Build download URLs
        var baseUrl = ConfigService.BaseUrl;
        windowsX64Url = $"{baseUrl}/downloads/runner/latest/automaton-runner-win-x64.zip";
        windowsArm64Url = $"{baseUrl}/downloads/runner/latest/automaton-runner-win-arm64.zip";
        linuxX64Url = $"{baseUrl}/downloads/runner/latest/automaton-runner-linux-x64.tar.gz";
        linuxArm64Url = $"{baseUrl}/downloads/runner/latest/automaton-runner-linux-arm64.tar.gz";
        macosX64Url = $"{baseUrl}/downloads/runner/latest/automaton-runner-macos-x64.tar.gz";
        macosArm64Url = $"{baseUrl}/downloads/runner/latest/automaton-runner-macos-arm64.tar.gz";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("detectPlatform");
        }
    }

    private async Task CopyToClipboard(string text, string description)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
            await MessageService.SuccessAsync($"{description} copied to clipboard");
        }
        catch
        {
            await MessageService.WarningAsync("Could not copy to clipboard. Please copy manually.");
        }
    }
}

<script>
    window.detectPlatform = function() {
        // Check if the required elements exist before proceeding
        const platformElement = document.getElementById('detected-platform');
        const downloadBtnElement = document.getElementById('recommended-download-btn');
        const cardElement = document.getElementById('recommended-card');
        
        if (!platformElement || !downloadBtnElement || !cardElement) {
            // Elements don't exist, exit gracefully
            return;
        }
        
        const platform = navigator.platform.toLowerCase();
        const userAgent = navigator.userAgent.toLowerCase();
        
        let detectedOS = 'Unknown';
        let detectedArch = 'x64';
        let downloadUrl = '';
        
        if (platform.includes('win')) {
            detectedOS = 'Windows';
            downloadUrl = '/downloads/runner/latest/automaton-runner-win-x64.zip';
        } else if (platform.includes('mac') || platform.includes('darwin')) {
            detectedOS = 'macOS';
            if (userAgent.includes('arm') || platform.includes('arm')) {
                detectedArch = 'Apple Silicon';
                downloadUrl = '/downloads/runner/latest/automaton-runner-macos-arm64.tar.gz';
            } else {
                detectedArch = 'Intel';
                downloadUrl = '/downloads/runner/latest/automaton-runner-macos-x64.tar.gz';
            }
        } else if (platform.includes('linux')) {
            detectedOS = 'Linux';
            downloadUrl = '/downloads/runner/latest/automaton-runner-linux-x64.tar.gz';
        }
        
        if (detectedOS !== 'Unknown') {
            platformElement.textContent = `${detectedOS} ${detectedArch}`;
            downloadBtnElement.onclick = () => window.location.href = downloadUrl;
            cardElement.style.display = 'block';
        }
    };
</script>

<style>
    /* Main content structure - matching DashboardPage and OnboardingPage */
    .home-content {
        min-height: auto;
        padding-bottom: 40px;
    }

    .home-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px 40px 24px;
    }

    /* Header section - matching OnboardingPage pattern exactly */
    .downloads-header {
        margin-bottom: 24px;
        padding: 24px 0;
    }

    .downloads-header-content {
        display: flex;
        align-items: center;
        gap: 24px;
    }

    .downloads-header-icon {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 80px;
        height: 80px;
        background-color: #1890ff;
        border-radius: 16px;
    }

    .downloads-header-text {
        flex: 1;
    }

    .downloads-subtitle {
        font-size: 16px;
        color: #666;
        margin-bottom: 0;
    }

    /* Installation Scripts Card - PRIMARY */
    .installation-scripts-card {
        border: 2px solid #52c41a;
        background: linear-gradient(135deg, #f6ffed 0%, #ffffff 100%);
    }

    .installation-scripts-card .ant-card-head-title {
        color: #52c41a;
        font-weight: 600;
    }

    /* Cards styling */
    .installation-scripts-card,
    .getting-started-card,
    .manual-downloads-card,
    .advanced-commands-card,
    .env-vars-card {
        margin-bottom: 24px;
    }

    .command-section {
        margin-bottom: 16px;
    }

    .platform-card {
        height: 100%;
        text-align: center;
    }

    .platform-card .ant-card-head-title {
        font-weight: 500;
    }

    .step-container {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        height: 100%;
    }

    .step-number {
        width: 40px;
        height: 40px;
        background: #1890ff;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 18px;
        flex-shrink: 0;
    }

    .step-content {
        flex: 1;
    }

    .code-example {
        background: #f6f8fa;
        border: 1px solid #e1e4e8;
        border-radius: 6px;
        padding: 12px;
        font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
        font-size: 13px;
        line-height: 1.6;
    }

    /* Responsive design */
    @@media (max-width: 768px) {
        .downloads-header-content {
            flex-direction: column;
            text-align: center;
        }
    }
</style>