@page "/flows"
@using AntDesign
@using Automaton.Studio.Components

<Layout>
    <Header Class="header">
        <Row>
            <Col Flex=@("none")>
                <Space Size="SpaceSize.Large">
                    <SpaceItem Class="header-item">
                    <Breadcrumb>
                        <BreadcrumbItem Href="/">
                            <Icon Type="home" Width="16" Height="16" />
                            <span>Home</span>
                        </BreadcrumbItem>
                        <BreadcrumbItem>
                            <Icon Type="profile" Width="16" Height="16" />
                            <span>Flows</span>
                        </BreadcrumbItem>
                    </Breadcrumb>
                    </SpaceItem>               
                </Space>
            </Col>

            <Col Class="right-actions">
                <Space Class="right-header-items">
                    @if (FlowsViewModel.CanManageFlows)
                    {
                        <SpaceItem>
                            <Tooltip Title="New flow">
                                <Button Type="@ButtonType.Primary" Icon="plus" OnClick="@(() => NewFlowDialog())">
                                    Create Flow
                                </Button>
                            </Tooltip>
                        </SpaceItem>
                    }
                </Space>
            </Col>
        </Row>
    </Header>

    <Content Class="content-padding content-background">
        @if (!loading && FlowsViewModel.Flows?.Any() != true)
        {
            <EnhancedEmpty Title="Workflows in minutes." 
                          Description="Workflows are automated sequences of tasks that streamline your processes. Each workflow you create is a new automation you can use, either standalone or as part of a larger, integrated infrastructure."
                          BackgroundImageUrl="https://images.unsplash.com/photo-1518186285589-2f7649de83e0?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80"
                          GradientOverlay="linear-gradient(135deg, rgba(59, 130, 246, 0.85) 0%, rgba(99, 102, 241, 0.85) 100%)"
                          ActionCardTitle="Create Workflows"
                          ActionCardDescription="Build automated sequences that streamline your processes and boost productivity."
                          ActionCardBulletPoints="@GetFlowActionCardBullets()"
                          FeatureSectionTitle="Automated workflows anyone can setup in seconds!"
                          FeatureSectionSubtitle="Create powerful automation flows with our intuitive drag-and-drop interface"
                          HelpSectionTitle="Learn more about Workflows"
                           PrimaryAction="@(FlowsViewModel.CanManageFlows ? new EnhancedEmpty.EmptyActionModel { Text = "Create Flow", Icon = "plus", OnClick = () => NewFlowDialog() } : null)"
                          SecondaryActions="@GetFlowSecondaryActions()"
                          FeatureCards="@GetFlowFeatureCards()"
                          HelpLinks="@GetFlowHelpLinks()">
                <VisualMockup>
                    <WorkflowVisualMockup />
                </VisualMockup>
            </EnhancedEmpty>
        }
        else
        {
            <Table TItem="FlowModel" DataSource="@FlowsViewModel.Flows" Loading="@loading" Class="autoscroll-list">

            <Column Title="Name" @bind-Field="@context.Name">
                @context.Name
            </Column>

            <Column Title="Last Executed" @bind-Field="@context.Started">
                @context.StartedMessage
            </Column>

            <Column Title="Last Result" @bind-Field="@context.Status">
                <span class="@context.StatusClass">@context.Status</span>
            </Column>

            <Column @bind-Field="@context.RunnerIds" Title="Runners" Width="300">
                <RunnerSelector  Multiple="true" SelectedValues="context.RunnerIds" SelectedValuesChanged="EventCallback.Factory.Create<IEnumerable<Guid>>(this, v => context.RunnerIds = v)" Style="width:300px" />
            </Column>

            <ActionColumn Title="Action">
                <div>
                    <Space>
                        <SpaceItem>
                            <Tooltip Title="Run flow">
                                <Button Icon="caret-right" @onclick="@(() => RunFlow(context))" Disabled="context.DoesNotHaveRunners" Loading="@context.Running" />
                        </Tooltip>
                        </SpaceItem>
                        <SpaceItem>
                            <Tooltip Title="Edit flow">
                                <Button Icon="edit" @onclick="@(() => EditFlow(context.Id, context.Name))">Edit</Button>
                        </Tooltip>
                        </SpaceItem>
                        <SpaceItem>
                            <Dropdown Placement="@Placement.Bottom" Trigger="@(new Trigger[] { Trigger.Click })">
                                <Overlay>
                                    <Menu>
                                        <MenuItem Icon="edit" OnClick="()=> RenameFlow(context.Id, context.Name)">
                                            Rename
                                        </MenuItem>
                                        <Popconfirm Title="Sure to delete?"
                                                    OnConfirm="()=> DeleteFlow(context.Id)"
                                                    OkText="Yes"
                                                    CancelText="No">
                                            <MenuItem Icon="delete">
                                                Delete
                                            </MenuItem>
                                        </Popconfirm>
                                    </Menu>
                                </Overlay>
                                <ChildContent>
                                    <Tooltip Title="More actions">
                                        <a href="#" @onclick:preventDefault @onmousedown:stopPropagation>
                                            <Icon Type="more" Theme="IconThemeType.Outline" />
                                        </a>
                                    </Tooltip>
                                </ChildContent>
                            </Dropdown>
                        </SpaceItem>
                    </Space>                  
                </div>
            </ActionColumn>
        </Table>
        }
    </Content>
</Layout>

<style>
    .status-none {
        color: gray;
        padding-top: 3px;
        font-size: 20px;
        visibility: collapse;
    }

    .status-working {
        color: deepskyblue;
        padding-top: 3px;
        font-size: 20px;
    }

    .status-success {
        color: limegreen;
        padding-top: 3px;
        font-size: 20px;
    }

    .status-error {
        color: red;
        padding-top: 3px;
        font-size: 20px;
    }

    .flow-running {
        color: blue;
        padding-top: 3px;
        font-size: 20px;
        float: left;
    }


</style>


