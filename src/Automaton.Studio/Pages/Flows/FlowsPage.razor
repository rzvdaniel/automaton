@page "/flows"
@using AntDesign

<Layout>
    <Header Class="header">
        <Row>
            <Col Flex=@("none")>
                <Space Size="SpaceSize.Large">
                    <SpaceItem Class="header-item">
                    <Breadcrumb>
                        <BreadcrumbItem Href="/">
                            <Icon Type="home" Width="16" Height="16" />
                            <span>Home</span>
                        </BreadcrumbItem>
                        <BreadcrumbItem>
                            <Icon Type="profile" Width="16" Height="16" />
                            <span>Flows</span>
                        </BreadcrumbItem>
                    </Breadcrumb>
                    </SpaceItem>               
                </Space>
            </Col>

            <Col Class="right-actions">
                <Space Class="right-header-items">
                    <SpaceItem>
                        <Tooltip Title="New flow">
                            <Button Type="@ButtonType.Primary" Icon="plus" Class="header-button" OnClick="@(() => NewFlowDialog())">
                                Create Flow
                            </Button>
                        </Tooltip>
                    </SpaceItem>
                </Space>
            </Col>
        </Row>
    </Header>

    <Content Class="content-padding content-background">
        <Table TItem="FlowModel" DataSource="@FlowsViewModel.Flows" Loading="@loading" Class="autoscroll-list">

            <Column Title="Name" @bind-Field="@context.Name">
                @context.Name
            </Column>

            <Column Title="Last Executed" @bind-Field="@context.Started">
                @context.StartedMessage
            </Column>

            <Column Title="Last Result" @bind-Field="@context.Status">
                <span class="@context.StatusClass">@context.Status</span>
            </Column>

            <Column @bind-Field="@context.RunnerIds" Title="Runners" Width="300">
                <Select Mode="SelectMode.Multiple" 
                    Placeholder="Select runners..."
                    DataSource="FlowsViewModel.Runners"
                    ValueProperty="r => r.Id"
                    LabelProperty="r => r.Name"
                    DisabledPredicate="r => r.Status == Automaton.Core.Enums.RunnerStatus.Offline"
                    AllowClear>
                    <ItemTemplate Context="runnerContext">
                        <Icon Type="@GetRunnerStatusIcon(runnerContext.Status)"
                              class="@(GetRunnerStatusClass(runnerContext.Status))" />
                        @runnerContext.Name
                    </ItemTemplate>
                    <LabelTemplate Context="runnerContext">
                        <Icon Type="@GetRunnerStatusIcon(runnerContext.Status)"
                              class="@(GetRunnerStatusClass(runnerContext.Status))" />
                        @runnerContext.Name
                    </LabelTemplate>
                </Select>                
            </Column>

            <ActionColumn Title="Action">
                <div>
                    <Space>
                        <SpaceItem>
                            <Tooltip Title="Run flow">
                                <Button Icon="caret-right" @onclick="@(() => RunFlow(context))" Disabled="context.DoesNotHaveRunners" Loading="@context.Running" />
                        </Tooltip>
                        </SpaceItem>
                        <SpaceItem>
                            <Tooltip Title="Edit flow">
                                <Button Icon="edit" @onclick="@(() => EditFlow(context.Id, context.Name))">Edit</Button>
                        </Tooltip>
                        </SpaceItem>
                        <SpaceItem>
                            <Dropdown Placement="@Placement.Bottom" Trigger="@(new Trigger[] { Trigger.Click })">
                                <Overlay>
                                    <Menu>
                                        <Popconfirm Title="Sure to delete?"
                                                    OnConfirm="()=> DeleteFlow(context.Id)"
                                                    OkText="Yes"
                                                    CancelText="No">
                                            <MenuItem Icon="delete">
                                                Delete
                                            </MenuItem>
                                        </Popconfirm>
                                    </Menu>
                                </Overlay>
                                <ChildContent>
                                    <Tooltip Title="More actions">
                                        <a href="#" @onclick:preventDefault @onmousedown:stopPropagation>
                                            <Icon Type="more" Theme="IconThemeType.Outline" />
                                        </a>
                                    </Tooltip>
                                </ChildContent>
                            </Dropdown>
                        </SpaceItem>
                    </Space>                  
                </div>
            </ActionColumn>
        </Table>
    </Content>
</Layout>

<style>
    .status-none {
        color: gray;
        padding-top: 3px;
        font-size: 20px;
        visibility: collapse;
    }

    .status-working {
        color: deepskyblue;
        padding-top: 3px;
        font-size: 20px;
    }

    .status-success {
        color: limegreen;
        padding-top: 3px;
        font-size: 20px;
    }

    .status-error {
        color: red;
        padding-top: 3px;
        font-size: 20px;
    }

    .flow-running {
        color: blue;
        padding-top: 3px;
        font-size: 20px;
        float: left;
    }

    .runner-status-icon.runner-status-online {
        color: #52c41a !important; /* Green for online */
    }

    .runner-status-icon.runner-status-offline {
        color: #ff4d4f !important; /* Red for offline */
    }

    .runner-status-icon.runner-status-none {
        color: #d9d9d9 !important; /* Gray for none/unknown */
    }
</style>


