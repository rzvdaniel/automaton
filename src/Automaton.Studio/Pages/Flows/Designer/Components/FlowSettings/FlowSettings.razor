@page "/flow/settings/{flowid}/{flowname}"
@using AntDesign
@using Automaton.Studio.Models

<div class="flow-tab-content">
    <div class="flow-tab-header">
        <Title Level="3" Style="margin-bottom: 8px;">Flow Settings</Title>
        <Paragraph Style="color: #666;">
            Configure and manage settings for this workflow.
        </Paragraph>
    </div>
    
    <div class="flow-tab-main">
        <div class="settings-section">
            <Card Title="Flow Information" Style="margin-bottom: 24px;">
                <Form Model="@settingsModel" Layout="@FormLayout.Vertical">
                    <FormItem Label="Name">
                        <Input @bind-Value="@settingsModel.Name" />
                    </FormItem>
                    <FormItem Label="Created">
                        <Input Value="@ViewModel.Created.ToString()" Disabled="true" />
                    </FormItem>
                    <FormItem Label="Updated">
                        <Input Value="@ViewModel.Updated.ToString()" Disabled="true" />
                    </FormItem>
                    <FormItem>
                        <Button Type="@ButtonType.Primary" OnClick="@HandleUpdateSettings" Loading="@isSaving">
                            Save Changes
                        </Button>
                    </FormItem>
                </Form>
            </Card>
        </div>
        
        <div class="settings-section">
            <Title Level="4">Configuration</Title>
            <Paragraph Style="color: #666; margin-top: 16px;">
                Additional flow configuration options will be available here in future updates.
            </Paragraph>
        </div>
    </div>
</div>

<style>
    .flow-tab-content {
        height: 100%;
        display: flex;
        flex-direction: column;
        background: white;
        border-radius: 8px;
        padding: 0;
    }

    .flow-tab-header {
        padding: 24px 24px 16px 24px;
        border-bottom: 1px solid #f0f0f0;
        flex-shrink: 0;
        background: white;
        border-radius: 8px 8px 0 0;
    }

    .flow-tab-main {
        flex: 1;
        overflow-y: auto;
        padding: 24px;
        background: white;
        border-radius: 0 0 8px 8px;
    }

    .settings-section {
        margin-bottom: 32px;
    }

    .settings-section:last-child {
        margin-bottom: 0;
    }
</style>



