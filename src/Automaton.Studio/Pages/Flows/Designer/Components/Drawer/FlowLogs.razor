@using Automaton.Studio.Resources
@using Automaton.Studio.Domain
@using Blazored.FluentValidation

<div class="flow-logs-container">
    <!-- Toolbar -->
    <div class="flow-logs-toolbar">
        <Space Direction="SpaceDirection.Horizontal" Align="SpaceAlign.Center" Style="width: 100%; justify-content: space-between;">
            <SpaceItem>
                <Space Direction="SpaceDirection.Horizontal" Align="SpaceAlign.Center">
                    <SpaceItem>
                        <Icon Type="file-text" Theme="IconThemeType.Outline" Style="color: #666;" />
                    </SpaceItem>
                    <SpaceItem>
                        <Text Strong Style="color: #666; font-size: 12px;">Flow Execution Logs</Text>
                    </SpaceItem>
                </Space>
            </SpaceItem>
            <SpaceItem>
                <Space Direction="SpaceDirection.Horizontal" Size="SpaceSize.Small">
                    <SpaceItem>
                        <Tooltip Placement="@Placement.TopRight" Title="Auto-scroll to bottom">
                            <Button Icon="@(autoScroll ? "pause-circle" : "play-circle")"
                                    Size="@ButtonSize.Small"
                                    Type="@ButtonType.Text"
                                    Class="@(autoScroll ? "toolbar-btn-active" : "toolbar-btn")"
                                    OnClick="ToggleAutoScroll">
                            </Button>
                        </Tooltip>
                    </SpaceItem>
                    <SpaceItem>
                        <Tooltip Placement="@Placement.TopRight" Title="Copy logs to clipboard">
                            <Button Icon="copy"
                                    Size="@ButtonSize.Small"
                                    Type="@ButtonType.Text"
                                    Class="toolbar-btn"
                                    OnClick="CopyLogs">
                            </Button>
                        </Tooltip>
                    </SpaceItem>
                    <SpaceItem>
                        <Tooltip Placement="@Placement.TopRight" Title="Clear logs">
                            <Button Icon="delete"
                                    Size="@ButtonSize.Small"
                                    Type="@ButtonType.Text"
                                    Class="toolbar-btn"
                                    OnClick="ClearLogs">
                            </Button>
                        </Tooltip>
                    </SpaceItem>
                </Space>
            </SpaceItem>
        </Space>
    </div>

    <!-- Logs Content -->
    <div class="flow-logs-content">
        @if (!string.IsNullOrEmpty(WorkflowLogsManager?.Logs))
        {
            <TextArea @ref="logsTextArea"
                     Value="@WorkflowLogsManager.Logs"
                     ReadOnly="true"
                     ShowCount="false"
                     AutoSize="false"
                     Class="flow-logs-textarea"
                     Id="flow-logs-textarea"
                     Style="height: 100%; resize: none; font-family: 'Consolas', 'Monaco', 'Courier New', monospace;" />
        }
        else
        {
            <div class="flow-logs-empty">
                <div class="flow-logs-empty-content">
                    <Icon Type="file-text" Theme="IconThemeType.Outline" Style="font-size: 24px; color: #d9d9d9; margin-bottom: 8px;" />
                    <div class="flow-logs-empty-title">No logs available</div>
                    <div class="flow-logs-empty-subtitle">Logs will appear here when you run the workflow.</div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .flow-logs-container {
        height: 100%;
        display: flex;
        flex-direction: column;
        background-color: #ffffff;
        overflow: hidden;
        flex: 1;
        min-height: 0;
        /* Remove border and border-radius to prevent size issues */
    }

    .flow-logs-toolbar {
        background-color: #fafafa;
        border-bottom: 1px solid #f0f0f0;
        padding: 6px 12px;
        flex-shrink: 0;
        min-height: 32px;
    }

    .flow-logs-content {
        flex: 1;
        overflow: hidden;
        position: relative;
        min-height: 0; /* Critical for proper flex behavior */
        display: flex;
        flex-direction: column;
        background-color: #ffffff;
    }

    .flow-logs-textarea {
        border: none !important;
        box-shadow: none !important;
        background-color: #ffffff !important;
        padding: 12px !important;
        line-height: 1.4 !important;
        font-size: 12px !important;
        /* Ensure textarea fills the content area */
        flex: 1 !important;
        min-height: 0 !important;
        height: auto !important;
    }

    .flow-logs-textarea:focus {
        border: none !important;
        box-shadow: none !important;
    }

    .flow-logs-empty {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #ffffff;
        flex: 1;
        padding: 16px;
    }

    .flow-logs-empty-content {
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        max-width: 280px;
    }

    .flow-logs-empty-title {
        font-size: 14px;
        font-weight: 500;
        color: #666;
        margin-bottom: 4px;
        line-height: 1.4;
    }

    .flow-logs-empty-subtitle {
        font-size: 12px;
        color: #999;
        line-height: 1.4;
        text-align: center;
    }

    .toolbar-btn {
        color: #666 !important;
        border: none !important;
        background: transparent !important;
        transition: all 0.2s ease;
    }

    .toolbar-btn:hover {
        color: #1890ff !important;
        background-color: rgba(24, 144, 255, 0.08) !important;
    }

    .toolbar-btn-active {
        color: #1890ff !important;
        background-color: rgba(24, 144, 255, 0.12) !important;
        border: none !important;
    }

    .toolbar-btn-active:hover {
        color: #1890ff !important;
        background-color: rgba(24, 144, 255, 0.16) !important;
    }
</style>