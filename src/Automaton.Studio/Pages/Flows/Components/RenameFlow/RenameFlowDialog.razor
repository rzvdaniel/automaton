@using Blazored.FluentValidation;
@inherits FeedbackComponent<RenameFlowModel>

<Form @ref="form"
      Model="@flowModel"
      LabelColSpan="4"
      WrapperColSpan="20">
    <Validator>
        <FluentValidationValidator @ref="fluentValidationValidator" />
    </Validator>

    <ChildContent>
        <FormItem Label="Name">
            <Input @bind-Value="@context.Name" Placeholder="Enter new flow name" />
        </FormItem>
    </ChildContent>
</Form>
