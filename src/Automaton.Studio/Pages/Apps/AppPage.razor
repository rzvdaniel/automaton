@page "/app/{appId}"
@using AntDesign
@using Automaton.Studio.Components.AiChat
@using Automaton.Studio.Pages.Apps.Components
@using Automaton.Studio.Components
@using Automaton.Studio.Models

<Layout>
	<Content>
		<Header Class="header">
			<Row>
				<Col>
				<Space Direction="SpaceDirection.Horizontal">
					<SpaceItem Class="header-item">
						<Breadcrumb>
							<BreadcrumbItem Href="/">
								<Icon Type="home" Width="16" Height="16" />
								<span>Home</span>
							</BreadcrumbItem>
							<BreadcrumbItem Href="/apps">
								<Icon Type="appstore" Width="16" Height="16" />
								<span>Apps</span>
							</BreadcrumbItem>
							<BreadcrumbItem>
								<Icon Type="edit" Width="16" Height="16" />
								<span>@currentApp.Name</span>
							</BreadcrumbItem>
						</Breadcrumb>
					</SpaceItem>

					@if (currentApp.IsPublished)
					{
						<SpaceItem>
							<Text Type="TextElementType.Secondary" Style="font-size: 12px;">
								<Icon Type="link" />
								/web/@currentApp.PublicUrl
							</Text>
						</SpaceItem>

						<SpaceItem>
							<Tag Color="@("green")" Icon="check-circle">
								Published
							</Tag>
						</SpaceItem>

						@if (!currentApp.RequiresAuthentication)
						{
							<SpaceItem>
								<Tooltip Title="This app is accessible to anyone with the link (no login required)">
									<Tag Color="@("orange")" Icon="unlock">Public Access</Tag>
								</Tooltip>
							</SpaceItem>
						}
						else
						{
							<SpaceItem>
								<Tooltip Title="This app requires users to be logged in to Automaton">
									<Tag Color="@("blue")" Icon="lock">Protected</Tag>
								</Tooltip>
							</SpaceItem>
						}
					}
				</Space>
				</Col>
				<Col Class="right-actions">
				<Space Class="right-header-items">
					<SpaceItem>
						<Tooltip Title="Save app">
							<Button Icon="save" OnClick="Save" Type="@ButtonType.Primary" Loading="@saving">
								Save
							</Button>
						</Tooltip>
					</SpaceItem>

					<SpaceItem>
						<Button Icon="@(currentApp.IsPublished ? "stop" : "cloud-upload")"
								OnClick="TogglePublish"
								Loading="@publishing">
							@(currentApp.IsPublished ? "Unpublish" : "Publish")
						</Button>
					</SpaceItem>

					@if (currentApp.IsPublished)
					{
						<SpaceItem>
							<Button Icon="eye"
									OnClick="OpenPublishedApp"
									Type="@ButtonType.Default">
								View Published
							</Button>
						</SpaceItem>
					}
				</Space>
				</Col>
			</Row>
		</Header>

		<Form Model="@currentApp"
			  Loading="loading"
			  Class="app-form"
			  Layout="@FormLayout.Vertical"
			  LabelColSpan="24"
			  WrapperColSpan="24">
			<ChildContent>
				<Tabs DefaultActiveKey="1">
					<TabPane Tab="Code" Key="1">
						<Splitter Layout="@SplitterLayout.Horizontal" Class="main-splitter">
							<SplitterPanel Size="70%">
								<div class="left-panel">
									<div class="monaco-container">
										<StandaloneCodeEditor Id="app-code-editor" ConstructionOptions="EditorConstructionOptions" @ref="codeEditor" />
									</div>
								</div>
							</SplitterPanel>

							<SplitterPanel Size="30%">
								<div class="right-panel-container">
									<Tabs Size="TabSize.Small" Class="right-panel">
										<TabPane Tab="AI Chat" Key="ai">
											<div class="tab-content-scrollable">
												<AiChatPanel Context="@CreateAiChatContext()"
												 McpClient="@UnifiedAppMcpClient"
												 OnCodeGenerated="OnCodeGenerated"
												 ResourceType="ChatResourceType.WebApp"
												 ResourceId="@Guid.Parse(AppId)" />
											</div>
										</TabPane>
									</Tabs>
								</div>
							</SplitterPanel>
						</Splitter>
					</TabPane>

					<TabPane Tab="Preview" Key="preview">
						<div class="preview-container">
							<div class="preview-toolbar">
								<Space>
									<!-- Show and allow changing selected runner for preview -->
									<SpaceItem>
										Execution runner: <RunnerSelector @bind-SelectedValue="currentApp.ExecutionRunnerId" Style="width:200px" />
									</SpaceItem>

									<SpaceItem>
										<Tooltip Title="Refresh preview">
											<Button Icon="reload" OnClick="RefreshPreview" Size="@ButtonSize.Small">
												Refresh
											</Button>
										</Tooltip>
									</SpaceItem>
									@if (currentApp.IsPublished)
									{
										<SpaceItem>
											<Tooltip Title="View published app">
												<Button Icon="eye"
														Type="@ButtonType.Primary"
														OnClick="OpenPublishedApp"
														Size="@ButtonSize.Small">
													View Published
												</Button>
											</Tooltip>
										</SpaceItem>
									}
								</Space>
							</div>
							<iframe id="app-preview-frame"
									srcdoc="@GetPreviewHtml()"
									sandbox="allow-scripts allow-same-origin allow-modals allow-forms"
									class="preview-iframe">
							</iframe>
						</div>
					</TabPane>


					<TabPane Tab="Steps" Key="backend">
						<div class="backend-actions-container">
							<Card Class="backend-card" Bordered="true">
								<TitleTemplate>
									<Space>
										<SpaceItem><Icon Type="code" Style="color: #1890ff;" /></SpaceItem>
										<SpaceItem><span>App Steps</span></SpaceItem>
										<SpaceItem><Tag Color="@("blue")">@appSteps.Count steps</Tag></SpaceItem>
									</Space>
								</TitleTemplate>
								<Extra>
									<Button Type="@ButtonType.Primary" Icon="plus" OnClick="@ShowCreateAppStepDialog">
										Create Step
									</Button>
								</Extra>
								<ChildContent>
									@if (loadingSteps)
									{
										<Spin Tip="Loading steps..." />
									}
									else if (!appSteps.Any())
									{
										<Empty Description="@("No steps for this app yet")">
											<ChildContent>
												<div>
													<p><Text Type="TextElementType.Secondary">Create custom steps to add backend functionality to your app, or let AI create them for you.</Text></p>
													<Button Type="@ButtonType.Primary" Icon="plus" OnClick="@ShowCreateAppStepDialog">
														Create Step
													</Button>
												</div>
											</ChildContent>
										</Empty>
									}
									else
									{
										<div class="steps-toolbar">
											<Space>
												<SpaceItem>
													<Input Placeholder="Search steps..."
														   @bind-Value="stepSearchText"
														   @oninput="OnStepSearchInput"
														   AllowClear="true"
														   Style="width: 300px;" />
												</SpaceItem>
												<SpaceItem>
													<Text Type="TextElementType.Secondary">
														@FilteredAppSteps.Count of @appSteps.Count steps
													</Text>
												</SpaceItem>
											</Space>
										</div>

										<Table TItem="LinkedStepInfo" 
											   DataSource="@FilteredAppSteps" 
											   Size="@TableSize.Small"
											   Class="steps-table"
											   Context="step">
											<Column TData="string" Title="Name">
												<Space>
													<SpaceItem>
														<Icon Type="@GetStepIcon(step.Language)" Style="color: #1890ff;" />
													</SpaceItem>
													<SpaceItem>
														<div>
															<strong>@(string.IsNullOrEmpty(step.DisplayName) ? step.Name : step.DisplayName)</strong>
															@if (!string.IsNullOrEmpty(step.Description))
															{
																<br />
																<span style="font-size: 12px; color: #8c8c8c;">@step.Description</span>
															}
														</div>
													</SpaceItem>
												</Space>
											</Column>
											<Column TData="string" Title="Language" Width="100">
												<Tag Color="@GetLanguageColor(step.Language)">@step.Language</Tag>
											</Column>
											<Column TData="string" Title="Variables" Width="150">
												<Space>
													@if (step.HasInputVariables)
													{
														<SpaceItem><Tag Color="@("green")">@step.InputCount in</Tag></SpaceItem>
													}
													@if (step.HasOutputVariables)
													{
														<SpaceItem><Tag Color="@("orange")">@step.OutputCount out</Tag></SpaceItem>
													}
												</Space>
											</Column>
											<ActionColumn Title="Actions" Width="200">
												<Space>
													<SpaceItem>
														<Tooltip Title="Edit step">
															<Button Icon="edit" Size="@ButtonSize.Small" OnClick="@(() => NavigateToStep(step.Id))"></Button>
														</Tooltip>
													</SpaceItem>
													<SpaceItem>
														<Tooltip Title="View code">
															<Button Icon="code" Size="@ButtonSize.Small" OnClick="@(() => ShowStepCodeDialog(step))"></Button>
														</Tooltip>
													</SpaceItem>
													<SpaceItem>
														<Popconfirm Title="Delete this step permanently?"
																	OnConfirm="@(() => DeleteAppStep(step.Id))"
																	OkText="Delete"
																	CancelText="Cancel">
															<Tooltip Title="Delete step">
																<Button Icon="delete" Size="@ButtonSize.Small" Danger></Button>
															</Tooltip>
														</Popconfirm>
													</SpaceItem>
												</Space>
											</ActionColumn>
										</Table>
									}

									<Divider />
									<Alert Type="@AlertType.Info" ShowIcon="true">
										<MessageTemplate>
											<div>
												<strong>How to use steps in your app:</strong>
												<pre class="code-example">const result = await automatonApi.executeStep('StepName', { inputs: { key: 'value' } });
console.log(result.outputVariables);</pre>
											</div>
										</MessageTemplate>
									</Alert>
								</ChildContent>
							</Card>
						</div>
					</TabPane>

					<TabPane Tab="Settings" Key="2">
						<div class="settings-container">
							<Card Class="settings-card" Bordered="true">
								<TitleTemplate>
									<Space>
										<SpaceItem>
											<Icon Type="setting" Style="color: #1890ff;" />
										</SpaceItem>
										<SpaceItem>
											<span>App Configuration</span>
										</SpaceItem>
									</Space>
								</TitleTemplate>
								<ChildContent>
									<Row Gutter="(24, 16)">
										<Col Xs="24" Md="12">
										<FormItem Label="Name" Required>
											<Input @bind-Value="@currentApp.Name"
												   Placeholder="Enter app name"
												   Size="@InputSize.Large" />
										</FormItem>
										</Col>
										<Col Xs="24" Md="12">
										<FormItem Label="Display Name">
											<Input @bind-Value="@currentApp.DisplayName"
												   Placeholder="Enter display name"
												   Size="@InputSize.Large" />
										</FormItem>
										</Col>
									</Row>

									<Row Gutter="(24, 16)">
										<Col Span="24">
										<FormItem Label="Description">
											<TextArea @bind-Value="@currentApp.Description"
													  Placeholder="Describe your app..."
													  Rows="4"
													  ShowCount
													  MaxLength="500"
													  Size="@InputSize.Large" />
										</FormItem>
										</Col>
									</Row>
									<Row>
										<Col Span="24">
										<FormItem Label="Runner for Preview/Execution">
											<RunnerSelector @bind-SelectedValue="currentApp.ExecutionRunnerId" Style="width:100%" />
											<Text Type="TextElementType.Secondary">Optional: select runner used for preview and any executions initiated from this app.</Text>
										</FormItem>
										</Col>
									</Row>
								</ChildContent>
							</Card>

							<Card Class="settings-card" Bordered="true" Style="margin-top: 24px;">
								<TitleTemplate>
									<Space>
										<SpaceItem>
											<Icon Type="mobile" Style="color: #1890ff;" />
										</SpaceItem>
										<SpaceItem>
											<span>PWA Settings</span>
										</SpaceItem>
									</Space>
								</TitleTemplate>
								<ChildContent>
									<FormItem Label="Enable PWA">
										<Switch @bind-Value="@currentApp.Definition.Settings.EnablePwa" />
									</FormItem>

									<Row Gutter="(24, 16)">
										<Col Xs="24" Md="12">
										<FormItem Label="PWA Name">
											<Input @bind-Value="@currentApp.Definition.Settings.PwaName" Disabled="@(!currentApp.Definition.Settings.EnablePwa)" />
										</FormItem>
										</Col>
										<Col Xs="24" Md="12">
										<FormItem Label="PWA Short Name">
											<Input @bind-Value="@currentApp.Definition.Settings.PwaShortName" Disabled="@(!currentApp.Definition.Settings.EnablePwa)" />
										</FormItem>
										</Col>
									</Row>
									<Row Gutter="(24, 16)">
										<Col Xs="24" Md="12">
										<FormItem Label="Theme Color">
											<Input @bind-Value="@currentApp.Definition.Settings.ThemeColor" Placeholder="#1890ff" Disabled="@(!currentApp.Definition.Settings.EnablePwa)" />
										</FormItem>
										</Col>
										<Col Xs="24" Md="12">
										<FormItem Label="Background Color">
											<Input @bind-Value="@currentApp.Definition.Settings.BackgroundColor" Placeholder="#ffffff" Disabled="@(!currentApp.Definition.Settings.EnablePwa)" />
										</FormItem>
										</Col>
									</Row>
								</ChildContent>
							</Card>

							<Card Class="settings-card" Bordered="true" Style="margin-top: 24px;">
								<TitleTemplate>
									<Space>
										<SpaceItem>
											<Icon Type="picture" Style="color: #1890ff;" />
										</SpaceItem>
										<SpaceItem>
											<span>Card Appearance</span>
										</SpaceItem>
									</Space>
								</TitleTemplate>
								<ChildContent>
									<Alert Message="Customize how this app appears on the Apps page" Type="@AlertType.Info" Style="margin-bottom: 16px;" />

									<Row Gutter="(24, 16)">
										<Col Xs="24" Md="12">
										<FormItem Label="Title Font Color">
											<InputGroup Compact>
												<Input @bind-Value="@currentApp.Appearance.TitleFontColor"
													   Placeholder="#ffffff"
													   Style="width: calc(100% - 40px);" />
												<input type="color"
													   @bind="currentApp.Appearance.TitleFontColor"
													   style="width: 40px; height: 32px; cursor: pointer; border: 1px solid #d9d9d9; border-left: none;" />
											</InputGroup>
										</FormItem>
										</Col>
									</Row>

									<Row Gutter="(24, 16)">
										<Col Xs="24" Md="12">
										<FormItem Label="Background Color">
											<InputGroup Compact>
												<Input @bind-Value="@currentApp.Appearance.BackgroundColor"
													   Placeholder="#ffffff"
													   Style="width: calc(100% - 40px);" />
												<input type="color"
													   @bind="currentApp.Appearance.BackgroundColor"
													   style="width: 40px; height: 32px; cursor: pointer; border: 1px solid #d9d9d9; border-left: none;" />
											</InputGroup>
										</FormItem>
										</Col>
									</Row>

									<Row Gutter="(24, 16)">
										<Col Span="24">
										<FormItem Label="Upload Image">
											<div class="image-upload-wrapper">
												@if (!string.IsNullOrEmpty(currentApp.Appearance.BackgroundImageUrl))
												{
													<div class="image-preview" style="@GetPreviewImageStyle()">
														<img src="@currentApp.Appearance.BackgroundImageUrl" alt="Background preview" />
													</div>
												}
												<Upload Name="file"
														Accept="image/*"
														ListType="@UploadListType.Picture"
														Action="@GetUploadAction()"
														OnChange="OnBackgroundImageUpload"
														Headers="@uploadHeaders"
														ShowUploadList="true">
													<Button Icon="cloud-upload">Click to Upload Image</Button>
												</Upload>
												<Text Type="TextElementType.Secondary" Style="display: block; margin-top: 8px;">
													Recommended: 500x300px, PNG or JPG (max 2MB)
												</Text>
											</div>
										</FormItem>
										</Col>
									</Row>

									<Row Gutter="(24, 16)">
										<Col Xs="24" Md="12">
										<FormItem Label="Image Opacity">
											<Slider @bind-Value="@currentApp.Appearance.BackgroundImageOpacity" Min="0" Max="1" Step="0.1" />
											<Text Type="TextElementType.Secondary">@($"{(currentApp.Appearance.BackgroundImageOpacity * 100):F0}%")</Text>
										</FormItem>

										@if (!string.IsNullOrEmpty(currentApp.Appearance.BackgroundImageUrl))
										{
											<FormItem Label="">
												<Button Block Danger OnClick="RemoveBackgroundImage">Remove Image</Button>
											</FormItem>
										}
										</Col>

									</Row>

								</ChildContent>
							</Card>

							<Card Class="settings-card" Bordered="true" Style="margin-top: 24px;">
								<TitleTemplate>
									<Space>
										<SpaceItem>
											<Icon Type="github" Style="color: #1890ff;" />
										</SpaceItem>
										<SpaceItem>
											<span>GitHub Integration</span>
										</SpaceItem>
									</Space>
								</TitleTemplate>
								<ChildContent>
									<Alert Message="Connect this app to a GitHub repository for version control and backup" Type="@AlertType.Info" ShowIcon="true" Style="margin-bottom: 16px;" />

									@if (!hasGitHubToken)
									{
										<Alert Message="No GitHub token configured. Please add a GitHub Personal Access Token in your account settings first." Type="@AlertType.Warning" ShowIcon="true" Style="margin-bottom: 16px;" />
										<Button Type="@ButtonType.Primary" Icon="key" OnClick="NavigateToGitHubSettings">
											Configure GitHub Token
										</Button>
									}
									else
									{
										<FormItem Label="Enable GitHub Sync">
											<Switch @bind-Value="@githubSyncEnabled" OnChange="@((bool enabled) => OnGitHubSyncToggle(enabled))" />
											<Text Type="TextElementType.Secondary" Style="display: block; margin-top: 8px;">
												Sync this app with a GitHub repository
											</Text>
										</FormItem>

										@if (githubSyncEnabled)
										{
											<Row Gutter="(24, 16)">
												<Col Xs="24" Md="12">
												<FormItem Label="Repository URL" Required>
													<Input @bind-Value="@githubRepoUrl"
														   Placeholder="username/repo-name"
														   Size="@InputSize.Large" />
													<Text Type="TextElementType.Secondary">Format: username/repository-name</Text>
												</FormItem>
												</Col>
												<Col Xs="24" Md="12">
												<FormItem Label="Branch">
													<Input @bind-Value="@githubBranch"
														   Placeholder="main"
														   Size="@InputSize.Large" />
												</FormItem>
												</Col>
											</Row>

											<Row Gutter="(24, 16)">
												<Col Xs="24" Md="12">
												<FormItem Label="Path in Repository">
													<Input @bind-Value="@githubPath"
														   Placeholder="apps/my-app"
														   Size="@InputSize.Large" />
													<Text Type="TextElementType.Secondary">Optional: folder path within the repository</Text>
												</FormItem>
												</Col>
											</Row>

											<Space>
												<SpaceItem>
													<Button Type="@ButtonType.Primary" Icon="cloud-upload" OnClick="PushToGitHub" Loading="@githubPushing">
														Push to GitHub
													</Button>
												</SpaceItem>
												<SpaceItem>
													<Button Icon="cloud-download" OnClick="PullFromGitHub" Loading="@githubPulling">
														Pull from GitHub
													</Button>
												</SpaceItem>
												<SpaceItem>
													<Button Icon="sync" OnClick="CheckGitHubStatus" Loading="@githubCheckingStatus">
														Check Status
													</Button>
												</SpaceItem>
												<SpaceItem>
													<Button Icon="plus" OnClick="CreateGitHubRepo" Loading="@githubCreatingRepo">
														Create New Repo
													</Button>
												</SpaceItem>
											</Space>

											@if (!string.IsNullOrEmpty(githubStatusMessage))
											{
												<Alert Message="@githubStatusMessage" Type="@githubStatusType" ShowIcon="true" Style="margin-top: 16px;" Closable />
											}

											@if (currentApp.Definition.GitHub?.LastSyncedAt != null)
											{
												<Text Type="TextElementType.Secondary" Style="display: block; margin-top: 16px;">
													Last synced: @currentApp.Definition.GitHub.LastSyncedAt?.ToString("yyyy-MM-dd HH:mm")
												</Text>
											}
										}
									}
								</ChildContent>
							</Card>
						</div>
					</TabPane>
				</Tabs>
			</ChildContent>
		</Form>
	</Content>
</Layout>

<style>
	/* All existing styles remain the same */
	.app-form {
		background-color: #fff;
		padding: 20px;
		overflow-y: auto; /* moved scrolling here so page scrollbar is at viewport edge */
		-webkit-overflow-scrolling: touch;
		height: calc(100vh - 55px);
	}

	.main-splitter {
		height: calc(100vh - 180px);
		width: 100%;
		display: flex;
	}

	.left-panel {
		display: flex;
		flex-direction: column;
		height: 100%;
		width: 100%;
	}

	.monaco-container {
		flex: 1 1 auto;
		width: 100%;
		height: 100%;
		display: flex;
		overflow: hidden;
	}

	#app-code-editor {
		width: 100% !important;
		height: 100% !important;
		box-sizing: border-box;
		display: block;
	}

	.ant-splitter-panel {
		display: flex;
		flex-direction: column;
		min-height: 0;
		height: 100%;
	}

	.right-panel {
		padding: 0 0 0 10px;
		height: 100%;
		display: flex;
		flex-direction: column;
	}

	.right-panel-container {
		height: 100%;
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}

	.right-panel .ant-tabs {
		height: 100%;
		display: flex;
		flex-direction: column;
	}

	.right-panel .ant-tabs-nav {
		flex-shrink: 0;
		margin-bottom: 0;
		position: sticky;
		top: 0;
		background: white;
		z-index: 10;
	}

	.right-panel .ant-tabs-content-holder {
		flex: 1 1 auto;
		overflow: hidden;
		min-height: 0;
	}

	.right-panel .ant-tabs-content {
		height: 100%;
	}

	.right-panel .ant-tabs-tabpane {
		height: 100%;
		overflow: hidden;
	}

	.tab-content-scrollable {
		height: 100%;
		overflow-y: auto;
		overflow-x: hidden;
	}

	.preview-container {
		display: flex;
		flex-direction: column;
		height: calc(100vh - 180px);
		background: #fafafa;
	}

	.preview-toolbar {
		padding: 12px;
		border-bottom: 1px solid #e8e8e8;
		background: #ffffff;
		flex-shrink: 0;
	}

	.preview-iframe {
		flex: 1;
		border: none;
		width: 100%;
		height: 100%;
		background: white;
	}

	.settings-container {
		padding: 24px;
		max-width: 1000px;
		margin: 0 auto;
	}

	.settings-card {
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.09);
		border: 1px solid #f0f0f0;
		border-radius: 8px;
	}

		.settings-card .ant-card-head {
			border-bottom: 1px solid #f0f0f0;
			background: #fafafa;
		}

		.settings-card .ant-card-head-title {
			font-size: 18px;
			font-weight: 600;
