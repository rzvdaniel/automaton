@using AntDesign
@using Automaton.Studio.Models
@using Automaton.Studio.Services
@using Automaton.Studio.Pages.Apps.Components.LinkStepDialog
@inherits AntDesign.FeedbackComponent<LinkStepDialogModel>

<div class="link-step-dialog">
    <div class="search-box">
        <Search Placeholder="Search steps..."
                @bind-Value="searchText"
                OnSearch="OnSearch"
                Style="margin-bottom: 16px;" />
    </div>

    @if (!filteredSteps.Any())
    {
        <Empty Description="@("No available steps to link")">
            <ChildContent>
                <Button Type="@ButtonType.Primary" 
                        OnClick="CreateNewStep">
                    Create New Step
                </Button>
            </ChildContent>
        </Empty>
    }
    else
    {
        <div class="steps-grid">
            @foreach (var step in filteredSteps)
            {
                <div class="step-option-wrapper" @onclick="@(() => SelectStep(step.Id))">
                    <Card Class="@($"step-option {(Options?.SelectedStepId == step.Id ? "selected" : "")}")"
                          Size="@CardSize.Small"
                          Hoverable="true">
                        <ChildContent>
                            <div class="step-option-content">
                                <Checkbox Checked="@(Options?.SelectedStepId == step.Id)" />
                                <div class="step-option-info">
                                    <div class="step-option-name">
                                        <Text Strong>@step.DisplayName</Text>
                                    </div>
                                    <div class="step-option-meta">
                                        <Tag Color="@GetLanguageColor(step.Language)">
                                            @step.Language
                                        </Tag>
                                    </div>
                                    @if (!string.IsNullOrEmpty(step.Description))
                                    {
                                        <div class="step-option-description">
                                            <Text Type="TextElementType.Secondary" 
                                                  Style="font-size: 12px;">
                                                @step.Description
                                            </Text>
                                        </div>
                                    }
                                </div>
                            </div>
                        </ChildContent>
                    </Card>
                </div>
            }
        </div>
    }
</div>

<style>
    .link-step-dialog {
        max-height: 400px;
        overflow-y: auto;
    }

    .steps-grid {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .step-option-wrapper {
        cursor: pointer;
    }

    .step-option {
        transition: all 0.2s;
    }

    .step-option.selected {
        border-color: #1890ff;
        background: #e6f7ff;
    }

    .step-option-content {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .step-option-info {
        flex: 1;
    }

    .step-option-name {
        margin-bottom: 4px;
    }

    .step-option-description {
        margin-top: 4px;
    }
</style>
