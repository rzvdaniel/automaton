@using Automaton.Studio.Pages.StepDesigner.Components.ToolResults

<CodeSuccessDisplay Title="@Title"
                    FullResponse="@GeneratedCode"
                    Language="@Language"
                    CodeId="@CodeId"
                    IsApplyDisabled="@IsApplyDisabled"
                    Timestamp="@Timestamp"
                    ShowTimestamp="false"
                    OnApplyCode="@OnApplyCode" />

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? GeneratedCode { get; set; }

    [Parameter, EditorRequired]
    public string Language { get; set; } = string.Empty;

    [Parameter]
    public string? CodeId { get; set; }

    [Parameter]
    public bool IsApplyDisabled { get; set; }

    [Parameter]
    public DateTime Timestamp { get; set; }

    [Parameter]
    public EventCallback<string> OnApplyCode { get; set; }
}
