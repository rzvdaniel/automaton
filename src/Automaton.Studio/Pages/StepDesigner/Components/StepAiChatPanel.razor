@using AntDesign
@using System.Collections.Generic
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@using Automaton.Studio.Models
@using Automaton.Studio.Services
@using Automaton.Studio.Shared.Components
@using Automaton.Mcp.Client
@using Automaton.Studio.Pages.StepDesigner.Components.ToolResults
@using Automaton.Studio.Pages.StepDesigner.Components.ToolResults.Processors

@implements IDisposable

<div class="ai-chat-panel">
	<PanelHeader Title="AI Code Generation (MCP)"
				 ShowClearButton="true"
				 OnClearClick="ClearConversationHistory"
				 ClearDisabled="@isGeneratingCode"
				 ClearTooltip="Clear conversation history"
				 ShowPinButton="true"
				 ShowCloseButton="true"
				 PinTooltip="Pin panel"
				 CloseTooltip="Close panel" />

	<div class="ai-chat-body" @ref="messagesContainer" id="ai-chat-messages">
		<div class="messages">
			@foreach (var msg in messages)
			{
				<div class="message">
					<div class="meta">
						<span class="role">@msg.Role</span>
						<span class="time">@msg.Time.ToString("HH:mm")</span>
					</div>
					<div class="content">
						@switch (msg.Type)
						{
							case MessageType.Generating:
								<div>
									<p><em>@msg.Content</em></p>
									<Spin Size="SpinSize.Small" /> Generating code with MCP tools...
								</div>
								break;

							case MessageType.OperationInProgress:
								<!-- GitHub Copilot-style operation status -->
								<div class="operation-in-progress">
									<div class="operation-header">
										<Icon Type="@GetOperationIcon(msg.Content)" Style="font-size: 16px; color: #f59e0b;" />
										<span class="operation-text">@msg.Content</span>
										<Spin Size="SpinSize.Small" Style="margin-left: 8px;" />
									</div>
								</div>
								break;

							case MessageType.OperationComplete:
								<!-- GitHub Copilot-style completed operation -->
								<div class="@($"operation-complete {(msg.IsSuccess ? "" : "failed")}")">
									<div class="operation-header">
										<Icon Type="@GetCompletionIcon(msg.IsSuccess)" Style="@($"font-size: 16px; color: {(msg.IsSuccess ? "#22c55e" : "#ef4444")};")"/>
										<span class="operation-text">@msg.Content</span>
										@if (!string.IsNullOrEmpty(msg.ToolResult))
										{
											<span class="operation-result-preview">@GetResultPreview(msg.ToolResult)</span>
										}
									</div>
								</div>
								break;

							case MessageType.ToolExecution:
								<div class="tool-execution-message" data-status="@msg.ToolStatus">
									@if (msg.ToolStatus == "executing")
									{
										<!-- Executing state: Clean design with spinner -->
										<div class="tool-header-executing">
											<span class="tool-icon-emoji">@GetToolEmoji(msg.ToolName)</span>
											<span class="tool-description">@msg.Content</span>
											<Spin Size="SpinSize.Small" Style="margin-left: auto;" />
										</div>
									}
									else if (msg.ToolStatus == "completed")
									{
										<!-- Completed state: Show checkmark to indicate operation finished -->
										<div class="tool-header-completed">
											<span class="tool-icon-emoji">@GetToolEmoji(msg.ToolName)</span>
											<span class="tool-description">@msg.Content</span>
											<Icon Type="check-circle" Style="margin-left: auto; color: #22c55e; font-size: 16px;" />
										</div>
									}
									else
									{
										<!-- Result state: Show detailed result without duplicate icon -->
										<ToolResultDisplay Result="msg.ToolResultViewModel" 
														   Status="@(msg.ToolStatus ?? "unknown")"
														   Timestamp="@msg.Time"
														   ShowTimestamp="true" />
									}
									
									@if (!string.IsNullOrEmpty(msg.ToolError))
									{
										<div class="tool-error">
											<Icon Type="exclamation-circle" Style="color: #dc3545; margin-right: 4px;" />
											<span>@msg.ToolError</span>
										</div>
									}
								</div>
								break;

							case MessageType.CodeSuccess:
								<CodeSuccessDisplay Title="@msg.Content"
													FullResponse="@msg.GeneratedCode"
													Language="@CurrentLanguage"
													CodeId="@msg.CodeId"
													IsApplyDisabled="@isGeneratingCode"
													Timestamp="@msg.Time"
													ShowTimestamp="false"
													OnApplyCode="@(async (codeId) => await ApplyCodeFromButton(codeId))" />
								break;

							case MessageType.CodeError:
								<div style="background: #f8f9fa; padding: 12px; border-radius: 6px; border-left: 4px solid #dc3545;">
									<Icon Type="close-circle" Style="color: #dc3545; margin-right: 4px;" />
									<strong>@msg.Content</strong><br />
									<span style="color: #dc3545;">@msg.Content</span>
								</div>
								break;

							case MessageType.System:
								<div style="color: #666; font-style: italic;">
									<Icon Type="info-circle" Style="margin-right: 4px;" />
									@msg.Content
								</div>
								break;

							case MessageType.Text:
							default:
								@((MarkupString)AiMessageFormattingService.FormatReasoningTextWithCode(msg.Content))
								break;
						}
					</div>
				</div>
			}
		</div>
	</div>

	<div class="ai-chat-input">
		<div class="input-area">
			<TextArea @bind-Value="promptText"
					  Placeholder="Describe what you want the AI to do... (MCP tools will be used automatically)"
					  Disabled="@isGeneratingCode"
					  ShowCount="false"
					  AutoSize="false"
					  Rows="3"
					  Style="resize: none; border: none; box-shadow: none; padding: 12px;"
					  @oninput="OnInputChange"
					  @onkeydown="OnKeyDown" />
		</div>

		<div class="input-controls">
			<div class="left-controls">
				<Select @bind-Value="selectedAgent"
						TItemValue="string"
						TItem="string"
						Size="@InputSize.Small"
						Style="width: 80px;"
						Disabled="@isGeneratingCode">
					<SelectOptions>
						<SelectOption Value="@Ask" Label="Ask" />
						<SelectOption TItemValue="string" TItem="string" Value="@Agent" Label="Agent" />
					</SelectOptions>
				</Select>

				<Select @bind-Value="selectedProviderModel"
						TItemValue="string"
						TItem="string"
						Size="@InputSize.Small"
						Style="width: 180px;"
						Placeholder="Select model"
						AllowClear="false"
						Disabled="@isGeneratingCode">
					<SelectOptions>
						@if (availableProviders?.Any() != true)
						{
							<SelectOption TItemValue="string" TItem="string" Value="@("none")" Label="No providers configured" Disabled="true" />
						}
						else
						{
							@foreach (var provider in availableProviders)
							{
								@if (provider.SupportedModels?.Any() == true)
								{
									@foreach (var model in provider.SupportedModels)
									{
										var value = $"{provider.Provider}:{model}";
										var label = $"{model}";
										var isDisabled = !provider.HasStoredKeys && !provider.HasEnvironmentKey;

										<SelectOption TItemValue="string" TItem="string"
													  Value="@value"
													  Label="@label"
													  Disabled="@isDisabled" />
									}
								}
							}
						}
					</SelectOptions>
				</Select>

				@if (!string.IsNullOrEmpty(CurrentLanguage))
				{
					<div class="language-badge">
						<Text Type="@TextElementType.Secondary" Style="font-size: 11px;">
							<Icon Type="code" Style="margin-right: 2px; font-size: 10px;" />
							@CurrentLanguage
						</Text>
					</div>
				}
			</div>

			<div class="right-controls">
				<Button Icon="@(isGeneratingCode ? "loading" : "caret-right")"
						Type="@ButtonType.Primary"
						Size="@ButtonSize.Small"
						Shape="@ButtonShape.Circle"
						OnClick="SendPrompt"
						Disabled="@(!IsReadyToSendRealtime)"
						Loading="@isGeneratingCode"
						Style="width: 28px; height: 28px; display: flex; align-items: center; justify-content: center;">
				</Button>
			</div>
		</div>

		@if (showNoProvidersMessage)
		{
			<div class="no-providers-message">
				<Alert Type="@AlertType.Warning"
					   Message="No AI providers configured"
					   Description="Configure your API keys in Settings to start using AI code generation with MCP tools."
					   ShowIcon="true"
					   Style="margin: 8px 0 0 0;" />
			</div>
		}
	</div>
</div>

<script>
	// Simple function to set the component reference
	window.setAiChatPanelRef = function(componentRef) {
		window.aiChatPanelInstance = componentRef;
	};
</script>

<style>
	.ai-chat-panel {
		display: flex;
		flex-direction: column;
		height: 100%;
		min-height: 0;
	}

	.ai-chat-body {
		flex: 1 1 auto;
		flex: 1;
		overflow-y: auto;
		overflow-x: hidden;
		padding: 10px;
		background: #fff;
		min-height: 0;
	}

	.messages {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.message {
		padding: 8px;
		border-radius: 6px;
		background: #f6f8fa;
		word-wrap: break-word;
		overflow-wrap: break-word;
	}

		.message .meta {
			font-size: 11px;
			color: #666;
			margin-bottom: 6px;
			display: flex;
			gap: 8px;
		}

	/* Remove padding/background for CodeSuccess messages since the component handles its own styling */
	.message:has(code-success-display) {
		padding: 0;
		background: transparent;
	}

	/* GitHub Copilot-style operation status */
	.operation-in-progress {
		background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
		border: 1px solid #fbbf24;
		border-left: 4px solid #f59e0b;
		border-radius: 8px;
		padding: 12px;
	}

	.operation-complete {
		background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
		border: 1px solid #86efac;
		border-left: 4px solid #22c55e;
		border-radius: 8px;
		padding: 12px;
	}

	.operation-complete.failed {
		background: linear-gradient(135deg, #fef2f2 0%, #fecaca 100%);
		border-color: #fca5a5;
		border-left-color: #ef4444;
	}

	.operation-header {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 13px;
		font-weight: 500;
	}

	.operation-text {
		color: #374151;
	}

	.operation-result-preview {
		margin-left: auto;
		font-size: 11px;
		color: #64748b;
		font-family: 'Courier New', monospace;
	}

	.ai-chat-input {
		border-top: 1px solid #e8e8e8;
		background: #ffffff;
		display: flex;
		flex-direction: column;
		flex-shrink: 0;
		position: sticky;
		bottom: 0;
		z-index: 10;
	}

	.input-area {
		background: #ffffff;
		border-bottom: 1px solid #f0f0f0;
	}

		.input-area .ant-input {
			border: none !important;
			box-shadow: none !important;
			background: transparent !important;
			resize: none !important;
		}

			.input-area .ant-input:focus,
			.input-area .ant-input:hover {
				border: none !important;
				box-shadow: none !important;
			}

	.input-controls {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 6px 12px;
		background: #fafafa;
		border-top: 1px solid #f0f0f0;
	}

	.left-controls {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.right-controls {
		display: flex;
		align-items: center;
	}

	.language-badge, .step-badge {
		padding: 2px 6px;
		background: #e3f2fd;
		border: 1px solid #bbdefb;
		border-radius: 12px;
		font-size: 11px;
		color: #1565c0;
	}

	.step-badge {
		background: #f0f9ff;
		border: 1px solid #93c5fd;
		color: #1e40af;
	}

	.no-providers-message {
		flex-shrink: 0;
		position: sticky;
		bottom: 0;
		background: #fafafa;
		z-index: 10;
	}

	/* VS-style send button */
	.right-controls .ant-btn-circle {
		min-width: 28px !important;
		width: 28px !important;
		height: 28px !important;
		padding: 0 !important;
		display: flex !important;
		align-items: center !important;
		justify-content: center !important;
	}

		.right-controls .ant-btn-circle .anticon {
			font-size: 12px;
		}

	/* Small select styling to match VS */
	.left-controls .ant-select-small {
		font-size: 11px;
	}

		.left-controls .ant-select-small .ant-select-selector {
			border: 1px solid #d9d9d9;
			border-radius: 4px;
			height: 24px !important;
			min-height: 24px !important;
		}

		.left-controls .ant-select-small .ant-select-selection-item {
			line-height: 22px !important;
			font-size: 11px;
		}

	/* Tool execution message styling - GitHub Copilot style */
	.tool-execution-message {
		background: #ffffff;
		border: 1px solid #e1e4e8;
		border-left: 3px solid #0969da;
		border-radius: 6px;
		padding: 12px;
		margin: 4px 0;
		transition: all 0.2s ease;
	}

	.tool-execution-message[data-status="executing"] {
		background: #f6f8fa;
		border-left-color: #8b949e;
	}

	.tool-execution-message[data-status="completed"] {
		background: #f6faf8;
		border-left-color: #22c55e;
		opacity: 0.8;
	}

	.tool-execution-message[data-status="success"] {
		border-left-color: #1a7f37;
	}

	.tool-header-executing {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 13px;
		color: #24292f;
	}

	.tool-header-completed {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 13px;
		color: #24292f;
		opacity: 0.7;
		transition: opacity 0.3s ease;
	}

	.tool-icon-emoji {
		font-size: 16px;
		line-height: 1;
	}

	.tool-description {
		flex: 1;
		font-weight: 500;
	}

	.tool-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 8px;
	}

	.tool-info {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.tool-icon {
		font-size: 16px;
		line-height: 1;
	}

	.tool-name {
		font-weight: 600;
		color: #1e293b;
		font-size: 14px;
	}

	.tool-timestamp {
		font-size: 11px;
		color: #64748b;
		font-family: 'Courier New', monospace;
	}

	.tool-content {
		margin-top: 8px;
		font-size: 13px;
		line-height: 1.5;
		color: #374151;
	}
	</style>

@code {
	private string GetOperationIcon(string operationText)
	{
		if (operationText.Contains("Reading", StringComparison.OrdinalIgnoreCase) || 
			operationText.Contains("Get", StringComparison.OrdinalIgnoreCase))
			return "file-text";
		if (operationText.Contains("Testing", StringComparison.OrdinalIgnoreCase) || 
			operationText.Contains("Execut", StringComparison.OrdinalIgnoreCase))
			return "experiment";
		if (operationText.Contains("Saving", StringComparison.OrdinalIgnoreCase))
			return "save";
		if (operationText.Contains("Generat", StringComparison.OrdinalIgnoreCase))
			return "code";
		return "loading";
	}

	private string GetCompletionIcon(bool isSuccess)
	{
		return isSuccess ? "check-circle" : "close-circle";
	}

	private string GetResultPreview(string result)
	{
		if (string.IsNullOrEmpty(result))
			return string.Empty;
			
		// Show first 50 characters of result
		return result.Length > 50 ? result[..50] + "..." : result;
	}
	
	private string GetToolEmoji(string? toolName)
	{
		return toolName switch
		{
			"get_current_code" => "📖",
			"execute_code" => "🧪",
			"get_step_variables" => "🔍",
			"save_code" => "💾",
			_ => "🔧"
		};
	}
}