@using Automaton.Studio.Pages.StepDesigner.Components.ToolResults
@using Automaton.Studio.Pages.StepDesigner.Components.ToolResults.Processors
@using Automaton.Studio.Pages.StepDesigner.Components.ToolResults.Utilities
@using System.Net

<div class="code-success-container">
    <ToolResultHeader StatusIcon="?" 
                      StatusText="Success" 
                      Status="success"
                      Title="@Title"
                      Timestamp="@Timestamp"
                      ShowTimestamp="@ShowTimestamp" />
    
    <div class="code-success-content">
        @((MarkupString)FormatContentForDisplay())
    </div>
    
    @if (!string.IsNullOrEmpty(CodeId) && OnApplyCode.HasDelegate)
    {
        <button class="apply-code-btn" @onclick="HandleApplyCode" disabled="@IsApplyDisabled" title="Apply code to editor">
            Apply Code
        </button>
    }
</div>

<style>
    .code-success-container {
        background: #f6f8fa;
        padding: 12px;
        border-radius: 6px;
        border-left: 4px solid #28a745;
        margin-bottom: 12px;
    }

    .code-success-content {
        color: #374151;
        line-height: 1.5;
        font-size: 14px;
        margin-bottom: 12px;
        margin-top: 8px;
    }

    .code-success-content strong {
        font-weight: 600;
        color: #1e293b;
    }

    .code-success-content ul, .code-success-content ol {
        margin: 8px 0;
        padding-left: 20px;
    }

    .code-success-content li {
        margin: 4px 0;
    }

    .apply-code-btn {
        background: #007bff;
        color: white;
        border: none;
        padding: 0.375rem 0.75rem;
        border-radius: 0.25rem;
        font-size: 0.75rem;
        cursor: pointer;
    }

    .apply-code-btn:hover {
        background: #0056b3;
    }

    .apply-code-btn:disabled {
        background: #6c757d;
        cursor: not-allowed;
    }
</style>

@code {
    [Parameter, EditorRequired] 
    public string Title { get; set; } = default!;
    
    [Parameter] 
    public string? FullResponse { get; set; }
    
    [Parameter] 
    public string? Language { get; set; }
    
    [Parameter] 
    public string? CodeId { get; set; }
    
    [Parameter] 
    public bool IsApplyDisabled { get; set; } = false;
    
    [Parameter] 
    public DateTime? Timestamp { get; set; }
    
    [Parameter] 
    public bool ShowTimestamp { get; set; } = false;
    
    [Parameter] 
    public EventCallback<string> OnApplyCode { get; set; }
    
    private async Task HandleApplyCode()
    {
        if (!string.IsNullOrEmpty(CodeId) && OnApplyCode.HasDelegate)
        {
            await OnApplyCode.InvokeAsync(CodeId);
        }
    }
    
    private string FormatContentForDisplay()
    {
        if (string.IsNullOrEmpty(FullResponse))
            return string.Empty;
            
        return CodeExtractionUtility.FormatResponseForDisplay(FullResponse, Language ?? "python");
    }
}