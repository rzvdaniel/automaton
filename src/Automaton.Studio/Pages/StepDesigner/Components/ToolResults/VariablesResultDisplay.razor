@using Automaton.Studio.Pages.StepDesigner.Components.ToolResults
@using Automaton.Studio.Pages.StepDesigner.Components.ToolResults.Processors
@using System.Net

<style>
    .raw-result-btn {
        background: none;
        border: none;
        color: #6c757d;
        font-size: 0.875rem;
        padding: 0.25rem 0.5rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        margin-top: 0.5rem;
        text-decoration: none;
    }

    .raw-result-btn:hover {
        color: #495057;
        background-color: #f8f9fa;
        border-radius: 0.25rem;
    }

    .raw-result-btn .raw-icon {
        font-size: 0.875rem;
    }

    .raw-result-collapsible {
        margin-top: 0.5rem;
        border: 1px solid #dee2e6;
        border-radius: 0.375rem;
        overflow: hidden;
    }

    .raw-result-content {
        /* Removed background-color and padding */
    }

    .raw-result-content .raw-result {
        margin: 0;
        background-color: white;
        border: 1px solid #dee2e6;
        border-radius: 0.25rem;
        padding: 0.75rem;
        font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
        font-size: 0.875rem;
        line-height: 1.4;
        white-space: pre-wrap;
        word-wrap: break-word;
    }
</style>

@if (!string.IsNullOrEmpty(Result.Summary))
{
    <div class="tool-result-summary">
        <strong>Variables:</strong>
        @((MarkupString)FormatSummaryForDisplay(Result.Summary))
    </div>
}

@if (!string.IsNullOrEmpty(Result.RawResult))
{
    <button class="raw-result-btn" @onclick="ToggleRawResult" title="View Raw Result">
        <span class="raw-icon">🔍</span> Raw Result
    </button>
    
    @if (showRawResult)
    {
        <div class="raw-result-collapsible">
            <div class="raw-result-content">
                <pre class="raw-result">@WebUtility.HtmlEncode(Result.RawResult)</pre>
            </div>
        </div>
    }
}

@code {
    [Parameter, EditorRequired] 
    public ToolResultViewModel Result { get; set; } = default!;
    
    private bool showRawResult = false;

    private void ToggleRawResult()
    {
        showRawResult = !showRawResult;
    }

    private string FormatSummaryForDisplay(string summary)
    {
        return summary
            .Replace("**", "<strong>", StringComparison.Ordinal)
            .Replace("**", "</strong>", StringComparison.Ordinal)
            .Replace("`", "<code>", StringComparison.Ordinal)
            .Replace("`", "</code>", StringComparison.Ordinal)
            .Replace("\n", "<br>", StringComparison.Ordinal);
    }
}