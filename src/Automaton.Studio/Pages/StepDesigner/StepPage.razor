@page "/stepdesigner/{stepId}"
@using AntDesign
@using Automaton.Studio.Pages.StepDesigner.Components
@using Automaton.Studio.Models
@using Blazored.FluentValidation;
@using Automaton.Core.Enums;
@using Automaton.Studio.Steps.Custom.Variables
@using Automaton.Studio.Components

<Layout>
    <Content>
        <Header Class="header">
            <Row>
                <Col>
                    <Space Direction="SpaceDirection.Horizontal">
                        <SpaceItem Class="header-item">
                            <Breadcrumb>
                                <BreadcrumbItem Href="/">
                                    <Icon Type="home" Width="16" Height="16" />
                                    <span>Home</span>
                                </BreadcrumbItem>
                                <BreadcrumbItem Href="/customsteps">
                                    <Icon Type="experiment" Width="16" Height="16" />
                                    <span>Steps</span>
                                </BreadcrumbItem>
                                <BreadcrumbItem>
                                    <Icon Type="edit" Width="16" Height="16" />
                                    <span>@StepDesignerViewModel.CustomStep.Name</span>
                                </BreadcrumbItem>
                            </Breadcrumb>
                        </SpaceItem>
                        <SpaceItem>
                            <Tooltip Title="View documentation on creating custom steps">
                                <a href="/docs/#/user-guide/custom-steps" target="_blank" class="docs-link">
                                <Icon Type="question-circle" Width="20" Height="20" />
                                </a>
                            </Tooltip>
                        </SpaceItem>
                    </Space>
                </Col>
                <Col Class="right-actions">
                    <Space Class="right-header-items">
                        <SpaceItem>
                            <Tooltip Title="Save step">
                                <Button Icon="save" OnClick="Save" Type="@ButtonType.Primary">
                                    Save
                                </Button>
                            </Tooltip>
                        </SpaceItem>
                        
                        <SpaceItem>
                            <Space Size="SpaceSize.Small" Class="execution-controls">
                                
                                <SpaceItem>
                                    @if (StepDesignerViewModel.CanRunFlow)
                                    {
                                        <!-- Enabled Run Button -->
                                        <Tooltip Title="Will execute on all selected runners">
                                            <Button Icon="caret-right" 
                                                    Type="@ButtonType.Primary"
                                                    OnClick="Run"
                                                    Loading="@runningCode"
                                                    Disabled="@runningCode">
                                            Run on Runners
                                            </Button>
                                        </Tooltip>
                                    }
                                    else
                                    {
                                        <!-- Disabled Run Button with Helpful Message -->
                                        <Tooltip Title="@RunButtonDisabledMessage">
                                            <Button Icon="caret-right" 
                                                    Type="@ButtonType.Primary"
                                                    Disabled="true"
                                                    OnClick="@OnRunButtonClickWhenDisabled">
                                                Run Step
                                            </Button>
                                        </Tooltip>
                                    }
                                </SpaceItem>

                                <!-- Runner Selection -->
                                <SpaceItem>
                                    <RunnerSelector Multiple="true" @bind-SelectedValues="StepDesignerViewModel.SelectedRunners" Style="width:200px" />
                                </SpaceItem>
                                
                                <!-- Enhanced Help Section -->
                                @if (!StepDesignerViewModel.CanRunFlow)
                                {
                                    <SpaceItem>
                                        @if (!StepDesignerViewModel.HasSelectedRunners)
                                        {
                                            <!-- Runners Available but None Selected -->
                                            <div style="display: flex; align-items: center; gap: 8px;">
                                                <Tooltip Title="Select runners above to execute this step">
                                                    <Icon Type="info-circle" Style="color: #1890ff;" Width="16" Height="16" />
                                                </Tooltip>
                                            </div>
                                        }
                                    </SpaceItem>
                                }                             
                            </Space>
                        </SpaceItem>
                    </Space>
                </Col>
            </Row>
        </Header>
        <Form @ref="form"
              Model="@StepDesignerViewModel.CustomStep"
              Loading="loading"
              Class="step-form"
              Layout="@FormLayout.Vertical"
              LabelColSpan="24"
              WrapperColSpan="24">
            <Validator>
                <FluentValidationValidator />
                <ValidationSummary />
            </Validator>
            <ChildContent>
                <Tabs>
                    <TabPane Tab="Code" Key="1">
                        <Splitter Layout="@SplitterLayout.Horizontal" Class="main-splitter">
                            <SplitterPanel Size="70%">
                                <div class="left-panel">

                                    <Splitter Layout="@SplitterLayout.Vertical" Class="main-splitter">
                                        <SplitterPanel Size="70%">
                                            <div class="code-toolbar">
                                                 <Form @ref="codeForm"
                                                  Model="@StepDesignerViewModel.CustomStep"
                                                  Class="code-form"
                                                  Layout="@FormLayout.Vertical"
                                                  LabelColSpan="24"
                                                  WrapperColSpan="24">
                                                    <Validator>
                                                        <FluentValidationValidator />
                                                        <ValidationSummary />
                                                    </Validator>
                                                        <ChildContent Context="codeContext">
                                                            <Space Direction="SpaceDirection.Horizontal">
                                                                <SpaceItem>
                                                                    <Select @bind-Value="@StepDesignerViewModel.CustomStep.Definition.Language"
                                                                            Placeholder="Select Language..."
                                                                            TItemValue="string"
                                                                            TItem="string">
                                                                        <SelectOptions>
                                                                            @foreach (var lang in CustomStepLanguages)
                                                                            {
                                                                                <SelectOption TItemValue="string" TItem="string" Value=@lang Label=@lang />
                                                                            }
                                                                        </SelectOptions>
                                                                    </Select>
                                                                </SpaceItem>
                                                            </Space>
                                                        </ChildContent>
                                                    </Form>
                                            </div>
                                       
                                            <div class="monaco-container">
                                                <StandaloneCodeEditor Id="step-code" ConstructionOptions="EditorConstructionOptions" @ref="codeEditor" />
                                            </div>
                                          
                                        </SplitterPanel>

                                        <SplitterPanel Size="30%">
                                            <div class="step-logs-container">
                                                <!-- Logs Toolbar -->
                                                <div class="step-logs-toolbar">
                                                    <Space Direction="SpaceDirection.Horizontal" Align="SpaceAlign.Center" Style="width: 100%; justify-content: space-between;">
                                                        <SpaceItem>
                                                            <Space Direction="SpaceDirection.Horizontal" Align="SpaceAlign.Center">
                                                                <SpaceItem>
                                                                    <Icon Type="file-text" Theme="IconThemeType.Outline" Style="color: #666;" />
                                                                </SpaceItem>
                                                                <SpaceItem>
                                                                    <Text Strong Style="color: #666; font-size: 12px;">Script Execution Logs</Text>
                                                                </SpaceItem>
                                                            </Space>
                                                        </SpaceItem>
                                                        <SpaceItem>
                                                            <Space Direction="SpaceDirection.Horizontal" Size="SpaceSize.Small">
                                                                <SpaceItem>
                                                                    <Tooltip Placement="@Placement.TopRight" Title="Auto-scroll to bottom">
                                                                        <Button Icon="@(autoScroll ? "pause-circle" : "play-circle")"
                                                                                Size="@ButtonSize.Small"
                                                                                Type="@ButtonType.Text"
                                                                                Class="@(autoScroll ? "toolbar-btn-active" : "toolbar-btn")"
                                                                                OnClick="ToggleAutoScroll">
                                                                        </Button>
                                                                    </Tooltip>
                                                                </SpaceItem>
                                                                <SpaceItem>
                                                                    <Tooltip Placement="@Placement.TopRight" Title="Copy logs to clipboard">
                                                                        <Button Icon="copy"
                                                                                Size="@ButtonSize.Small"
                                                                                Type="@ButtonType.Text"
                                                                                Class="toolbar-btn"
                                                                                OnClick="CopyLogs">
                                                                        </Button>
                                                                    </Tooltip>
                                                                </SpaceItem>
                                                                <SpaceItem>
                                                                    <Tooltip Placement="@Placement.TopRight" Title="Clear logs">
                                                                        <Button Icon="delete"
                                                                                Size="@ButtonSize.Small"
                                                                                Type="@ButtonType.Text"
                                                                                Class="toolbar-btn"
                                                                                OnClick="ClearLogs">
                                                                        </Button>
                                                                    </Tooltip>
                                                                </SpaceItem>
                                                            </Space>
                                                        </SpaceItem>
                                                    </Space>
                                                </div>

                                                <!-- Logs Content -->
                                                <div class="step-logs-content">
                                                    @if (!string.IsNullOrEmpty(StepDesignerViewModel.ScriptOutput?.ToString()))
                                                    {
                                                        <TextArea @ref="logsTextArea"
                                                                 Value="@StepDesignerViewModel.ScriptOutput.ToString()"
                                                                 ReadOnly="true"
                                                                 ShowCount="false"
                                                                 AutoSize="false"
                                                                 Class="step-logs-textarea"
                                                                 Id="step-logs-textarea"
                                                                 Style="height: 100%; resize: none; font-family: 'Consolas', 'Monaco', 'Courier New', monospace;" />
                                                    }
                                                    else
                                                    {
                                                        <div class="step-logs-empty">
                                                            <div class="step-logs-empty-content">
                                                                <Icon Type="file-text" Theme="IconThemeType.Outline" Style="font-size: 24px; color: #d9d9d9; margin-bottom: 8px;" />
                                                                <div class="step-logs-empty-title">No logs available</div>
                                                                <div class="step-logs-empty-subtitle">Logs will appear here when you run the script.</div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </SplitterPanel>
                                    </Splitter>
                                </div>
                            </SplitterPanel>

                            <SplitterPanel Size="30%">
                                <div class="right-panel-container">
                                    <Tabs Size="TabSize.Small" Class="right-panel">
                                        <TabPane Tab="AI Chat" Key="ai">
                                            <div class="tab-content-scrollable">
                                                <StepAiChatPanel OnCodeGenerated="OnCodeGenerated"
                                                             CurrentLanguage="@StepDesignerViewModel.CustomStep.Definition.Language"
                                                             InputVariables="@GetInputVariablesForAI()"
                                                             OutputVariables="@GetOutputVariablesForAI()"
                                                             GetCurrentCode="@GetCurrentCodeForAI"
                                                             CurrentStepId="@StepId" />
                                            </div>
                                        </TabPane>
                                        <TabPane Tab="Test Variables" Key="variables">
                                            <div class="tab-content-scrollable">
                                                <div class="variables-panel">
                                                    <PanelHeader Title="Test variable values"
                                                                 ShowClearButton="false"
                                                                 ShowPinButton="true"
                                                                 ShowCloseButton="true"
                                                                 PinTooltip="Pin panel"
                                                                 CloseTooltip="Close" />

                                                    <Collapse DefaultActiveKey="@(new[] { "input" })" Bordered="false" Class="variables-collapse-panel">
                                                        <Panel Key="input">
                                                            <HeaderTemplate>
                                                                <b>Input Variables</b>
                                                            </HeaderTemplate>
                                                            <ChildContent>
                                                              <div class="scrollable-list">
     @foreach (var inputVariable in StepDesignerViewModel.CustomStep.Definition.CodeInputVariables)
           {
  <div class="variable">
       <InputVariable Variable="@inputVariable" />
         </div>
  }
        </div>
                                                            </ChildContent>
                                                        </Panel>
                                                    </Collapse>
                                                    <Collapse DefaultActiveKey="@(new[] { "output" })" Bordered="false" Class="variables-collapse-panel">
                                                        <Panel Key="output">
                                                            <HeaderTemplate>
                                                               <b>Output Variables</b>
                                                               </HeaderTemplate>
                                                             <ChildContent>
                                                                   <div class="scrollable-list">
                                                                  @foreach (var outputVariable in StepDesignerViewModel.CustomStep.Definition.CodeOutputVariables)
                                                             {
                                                                <div class="variable">
                                                                     <OutputVariable Variable="@outputVariable" />
                                                                    </div>
                                                               }
                                                            </div>
                                                        </ChildContent>
                                                              </Panel>
                                                           </Collapse>
                                                </div>
                                            </div>
                                        </TabPane>
                                    </Tabs>
                                </div>
                            </SplitterPanel>
                        </Splitter>
                    </TabPane>
                    <TabPane Tab="Input Variables" Key="2">
                        <Space Direction="SpaceDirection.Vertical">
                            <SpaceItem>
                                <Tooltip Title="Add input variable">
                                    <Button OnClick="AddInputVariable" Type="ButtonType.Primary">
                                        Add
                                    </Button>
                                </Tooltip>
                            </SpaceItem>
                            <SpaceItem>
                                <Table DataSource="@context.Definition.CodeInputVariables"
                                       RowExpandable="@((record)=>true)"
                                       ScrollY="calc(100vh - 310px);"
                                       ScrollBarWidth="5"
                                       HidePagination>
                                    <ChildContent Context="inputVariable">
                                        <Column Title="Name" TData="string">
                                            <Input Type="InputType.Text" @bind-Value="inputVariable.Name" AutoFocus />
                                        </Column>
                                        <ActionColumn Title="Action">
                                            <Tooltip Title="Delete variable">
                                                <Popconfirm Title="Sure to delete?"
                                                            OnConfirm="()=> DeleteInputVariable(inputVariable.Name)"
                                                            OkText="Yes"
                                                            CancelText="No">
                                                    <a>Delete</a>
                                                </Popconfirm>
                                            </Tooltip>
                                        </ActionColumn>
                                    </ChildContent>
                                    <ExpandTemplate Context="inputVariable2">
                                        <GridRow Gutter="(16, 0)" Class="expanded-content">
                                            <GridCol Xs="6" Md="6">
                                                <FormItem Label="Description">
                                                    <Input Type="InputType.Text" @bind-Value="inputVariable2.Data.Description" />
                                                </FormItem>
                                            </GridCol>
                                            <GridCol Xs="6" Md="6">
                                                <FormItem Label="Value">
                                                    <Input Type="InputType.Text" TValue="string" Value="inputVariable2.Data.Value?.ToString()" OnChange="(x) => { inputVariable2.Data.Value = x; }" />
                                                </FormItem>
                                            </GridCol>
                                        </GridRow>
                                    </ExpandTemplate>
                                </Table>
                            </SpaceItem>
                        </Space>
                    </TabPane>

                    <TabPane Tab="Output Variables" Key="3">
                        <Space Direction="SpaceDirection.Vertical" Style="width: 100%">
                            <SpaceItem>
                                <Tooltip Title="Add output variable">
                                    <Button OnClick="AddOutputVariable" Type="@ButtonType.Primary" >
                                        Add
                                    </Button>
                                </Tooltip>
                            </SpaceItem>
                            <SpaceItem>
                                <Table DataSource="context.Definition.CodeOutputVariables"
                                       RowExpandable="@((record)=>true)"
                                       ScrollY="calc(100vh - 310px);"
                                       ScrollBarWidth="5"
                                       HidePagination>
                                    <ChildContent Context="outputVariable">
                                        
                                        <Column Title="Name" TData="string">
                                            <Input Type="InputType.Text" @bind-Value="outputVariable.Name" />
                                        </Column>
                                        <ActionColumn Title="Action">
                                            <Tooltip Title="Delete variable">
                                                <Popconfirm Title="Sure to delete?"
                                                            OnConfirm="()=> DeleteOutputVariable(outputVariable.Name)"
                                                            OkText="Yes"
                                                            CancelText="No">
                                                    <a>Delete</a>
                                                </Popconfirm>
                                            </Tooltip>
                                        </ActionColumn>
                                    </ChildContent>
                                    <ExpandTemplate Context="outputVariable2">
                                        <GridRow Gutter="(16, 0)" Class="expanded-content">
                                            <GridCol Xs="6" Md="6">
                                                <FormItem Label="Description">
                                                    <Input Type="InputType.Text" @bind-Value="outputVariable2.Data.Description" />
                                                </FormItem>
                                            </GridCol>
                                            <GridCol Xs="6" Md="6">
                                                <FormItem Label="Value">
                                                    <Input Type="InputType.Text" TValue="string" Value="outputVariable2.Data.Value?.ToString()" OnChange="(x) => { outputVariable2.Data.Value = x; }" />
                                                </FormItem>
                                            </GridCol>
                                        </GridRow>
                                    </ExpandTemplate>
                                </Table>
                            </SpaceItem>
                        </Space>
                    </TabPane>

                    <TabPane Tab="Settings" Key="4">
                        <div class="settings-container">
                            <Card Class="settings-card" Bordered="true">
                                <TitleTemplate>
                                    <Space>
                                        <SpaceItem>
                                            <Icon Type="setting" Style="color: #1890ff;" />
                                        </SpaceItem>
                                        <SpaceItem>
                                            <span>Step Configuration</span>
                                        </SpaceItem>
                                    </Space>
                                </TitleTemplate>
                                <Extra>
                                    <Tooltip Title="View documentation on custom step configuration">
                                        <a href="/docs/#/user-guide/custom-steps" target="_blank" style="color: #666;">
                                            <Icon Type="book" />
                                        </a>
                                    </Tooltip>
                                </Extra>
                                <ChildContent>
                                    <Paragraph Style="color: #666; margin-bottom: 24px;">
                                        Configure your custom step's basic properties. These settings help identify and describe your step within workflows.
                                    </Paragraph>
                                    
                                    <Row Gutter="(24, 16)">
                                        <Col Xs="24" Md="12">
                                            <FormItem Label="Name" Required>
                                                <Input @bind-Value="@context.Name" 
                                                       Placeholder="Enter a unique name (e.g., 'SendEmail')" 
                                                       Size="@InputSize.Large" />
                                                <div class="field-hint">
                                                    <Icon Type="info-circle" Style="margin-right: 4px;" />
                                                    <span>Unique identifier for this step</span>
                                                </div>
                                            </FormItem>
                                        </Col>
                                        <Col Xs="24" Md="12">
                                            <FormItem Label="Display Name">
                                                <Input @bind-Value="@context.DisplayName" 
                                                       Placeholder="Enter display name (e.g., 'Send Email')" 
                                                       Size="@InputSize.Large" />
                                                <div class="field-hint">
                                                    <Icon Type="info-circle" Style="margin-right: 4px;" />
                                                    <span>Friendly name shown in the flow designer</span>
                                                </div>
                                            </FormItem>
                                        </Col>
                                    </Row>

                                    <Row Gutter="(24, 16)">
                                        <Col Span="24">
                                            <FormItem Label="Description">
                                                <TextArea @bind-Value="@context.Description" 
                                                         Placeholder="Describe what this step does and when to use it..."
                                                         Rows="4"
                                                         ShowCount
                                                         MaxLength="500"
                                                         Size="@InputSize.Large" />
                                                <div class="field-hint">
                                                    <Icon Type="info-circle" Style="margin-right: 4px;" />
                                                    <span>Help users understand the purpose and functionality of this step</span>
                                                </div>
                                            </FormItem>
                                        </Col>
                                    </Row>

                                    <Row Gutter="(24, 16)">
                                        <Col Span="24">
                                            <FormItem Label="More Info URL">
                                                <Input @bind-Value="@context.MoreInfo" 
                                                       Placeholder="https://docs.example.com/steps/custom-step" 
                                                       Size="@InputSize.Large"
                                                       Prefix="@linkIcon" />
                                                <div class="field-hint">
                                                    <Icon Type="info-circle" Style="margin-right: 4px;" />
                                                    <span>Optional link to detailed documentation or examples</span>
                                                </div>
                                            </FormItem>
                                        </Col>
                                    </Row>
                                </ChildContent>
                            </Card>
                        </div>
                    </TabPane>

                </Tabs>
            </ChildContent>
        </Form>
    </Content>
</Layout>

@code {
    private RenderFragment linkIcon = @<Icon Type="link" />;
}

<style>
    .step-form {
        background-color: #fff;
        padding: 20px;
        height: calc(100vh - 117px);
    }
    .main-splitter {
        height: calc(100vh - 180px);
        width: 100%;
        display: flex;
    }
    .left-panel {
        display: flex;
        flex-direction: column;
        height: 100%;
        width: 100%;
    }

    .monaco-container {
        flex: 1 1 auto;
        width: 100%;
        height: 100%;
        display: flex;
        overflow:hidden;
    }
    #step-code {
        width: 100% !important;
        height: 100% !important;
        box-sizing: border-box;
        display: block;
    }
    
    .code-toolbar {
        background-color:#EEE; 
        padding: 4px;
        margin-bottom: 10px;
        flex-shrink: 0;
    }

    /* Step Logs Styling - Following FlowLogs pattern */
    .step-logs-container {
        height: 100%;
        display: flex;
        flex-direction: column;
        background-color: #ffffff;
        overflow: hidden;
        flex: 1;
        min-height: 0;
        margin-top: 8px;
        border-radius: 6px;
        box-shadow: 0 1px 2px rgba(0,0,0,0.03);
    }

    .step-logs-toolbar {
        background-color: #fafafa;
        border-bottom: 1px solid #f0f0f0;
        padding: 6px 12px;
        flex-shrink: 0;
        min-height: 32px;
    }

    .step-logs-content {
        flex: 1;
        overflow: hidden;
        position: relative;
        min-height: 0;
        display: flex;
        flex-direction: column;
        background-color: #ffffff;
    }

    .step-logs-textarea {
        border: none !important;
        box-shadow: none !important;
        background-color: #ffffff !important;
        padding: 12px !important;
        line-height: 1.4 !important;
        font-size: 12px !important;
        flex: 1 !important;
        min-height: 0 !important;
        height: auto !important;
    }

    .step-logs-textarea:focus {
        border: none !important;
        box-shadow: none !important;
    }

    .step-logs-empty {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #ffffff;
        flex: 1;
        padding: 16px;
    }

    .step-logs-empty-content {
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        max-width: 280px;
    }

    .step-logs-empty-title {
        font-size: 14px;
        font-weight: 500;
        color: #666;
        margin-bottom: 4px;
        line-height: 1.4;
    }

    .step-logs-empty-subtitle {
        font-size: 12px;
        color: #999;
        line-height: 1.4;
        text-align: center;
    }

    .toolbar-btn {
        color: #666 !important;
        border: none !important;
        background: transparent !important;
        transition: all 0.2s ease;
    }

    .toolbar-btn:hover {
        color: #1890ff !important;
        background-color: rgba(24, 144, 255, 0.08) !important;
    }

    .toolbar-btn-active {
        color: #1890ff !important;
        background-color: rgba(24, 144, 255, 0.12) !important;
        border: none !important;
    }

    .toolbar-btn-active:hover {
        color: #1890ff !important;
        background-color: rgba(24, 144, 255, 0.16) !important;
    }

    .variables-panel {
        height: 100%;
        width: 100%;
        overflow-y: auto;
        box-sizing: border-box;
    }
    .variables-collapse-panel {
        background-color: #efefef;
        border-radius: 2px;
        margin: 5px 0 10px 0;
        border-radius: 5px;
    }
    .scrollable-list {
        overflow-x: hidden;
        overflow-y: auto;
        max-height: 250px;
        padding-right: 30px;
    }
    .scrollable-list .variable {
        margin: 6px 0 0 0;
    }

    .ant-splitter-panel {
        display: flex;
        flex-direction: column;
        min-height: 0;
        height: 100%;
    }
    
    .editor-panel {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }

    .right-panel { 
        padding: 0 0 0 10px;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    /* Fix for right panel tabs scrolling */
    .right-panel-container {
        height: 100%;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .right-panel .ant-tabs {
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .right-panel .ant-tabs-nav {
        flex-shrink: 0;
        margin-bottom: 0;
        position: sticky;
        top: 0;
        background: white;
        z-index: 10;
    }

    .right-panel .ant-tabs-content-holder {
        flex: 1 1 auto;
        overflow: hidden;
        min-height: 0;
    }

    .right-panel .ant-tabs-content {
        height: 100%;
    }

    .right-panel .ant-tabs-tabpane {
        height: 100%;
        overflow: hidden;
    }

    .tab-content-scrollable {
        height: 100%;
        overflow-y: auto;
        overflow-x: hidden;
    }

    /* Ensure StepAiChatPanel takes full height */
    .tab-content-scrollable .ai-chat-panel {
        height: 100%;
        min-height: 0;
    }

    /* Settings Tab Styling */
    .settings-container {
        padding: 24px;
        max-width: 1000px;
        margin: 0 auto;
    }

    .settings-card {
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.09);
        border: 1px solid #f0f0f0;
        border-radius: 8px;
    }

    .settings-card .ant-card-head {
        border-bottom: 1px solid #f0f0f0;
        background: #fafafa;
    }

    .settings-card .ant-card-head-title {
        font-size: 18px;
        font-weight: 600;
        color: #262626;
    }

    .settings-card .ant-card-body {
        padding: 32px;
    }

    .field-hint {
        display: flex;
        align-items: center;
        margin-top: 6px;
        font-size: 12px;
        color: #8c8c8c;
        line-height: 1.4;
    }

    .field-hint .anticon {
        font-size: 12px;
        color: #1890ff;
    }

    /* Documentation link in breadcrumb */
    .docs-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        padding: 4px;
        border-radius: 4px;
        vertical-align: middle;
        line-height: 1;
    }

    .docs-link:hover {
        background-color: rgba(24, 144, 255, 0.1);
    }

