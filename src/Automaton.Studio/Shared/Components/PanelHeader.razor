@using AntDesign
@using Microsoft.AspNetCore.Components

<div class="panel-header">
    <div class="title">@Title</div>
    <div class="header-actions">
        @if (ShowClearButton)
        {
            <Tooltip Title="@ClearTooltip">
                <Button Type="ButtonType.Text" 
                        Icon="delete" 
                        OnClick="OnClearClick" 
                        Disabled="@ClearDisabled">
                </Button>
            </Tooltip>
        }
        @if (ShowPinButton)
        {
            <Tooltip Title="@PinTooltip">
                <Button Type="ButtonType.Text" 
                        Icon="pushpin" 
                        OnClick="OnPinClick">
                </Button>
            </Tooltip>
        }
        @if (ShowCloseButton)
        {
            <Tooltip Title="@CloseTooltip">
                <Button Type="ButtonType.Text" 
                        Icon="close" 
                        OnClick="OnCloseClick">   
                </Button>
            </Tooltip>
        }
        @if (AdditionalActions != null)
        {
            @AdditionalActions
        }
    </div>
</div>

<style>

/* Panel Header Styles */
.panel-header {
    background-color: #fafafa;
    border-bottom: 1px solid #f0f0f0;
    padding: 12px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
    min-height: 48px;
}

.panel-header .title {
    font-weight: 600;
    font-size: 14px;
    color: #262626;
}

.panel-header .header-actions {
    display: flex;
    gap: 4px;
}

/* Responsive adjustments */
@@media (max-width: 768px) {
    .panel-header {
        padding: 8px 12px;
    }
    
    .panel-header .title {
        font-size: 13px;
    }
}
</style>