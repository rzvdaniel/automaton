@using Automaton.Studio.Shared.Components

@* Example usage for a Properties panel - only pin and close buttons *@
<PanelHeader Title="Step Properties"
             ShowClearButton="false"
             ShowPinButton="true"
             ShowCloseButton="true"
             OnCloseClick="HandleClose"
             PinTooltip="Pin properties panel"
             CloseTooltip="Close properties" />

@* Example usage for an AI Chat panel - all buttons including clear *@
<PanelHeader Title="AI Code Generation"
             ShowClearButton="true"
             OnClearClick="HandleClear"
             ClearDisabled="@isProcessing"
             ClearTooltip="Clear conversation history"
             ShowPinButton="true"
             ShowCloseButton="true"
             OnPinClick="HandlePin"
             OnCloseClick="HandleClose"
             PinTooltip="Pin chat panel"
             CloseTooltip="Close chat" />

@* Example usage with additional custom actions *@
<PanelHeader Title="Advanced Panel"
             ShowClearButton="true"
             OnClearClick="HandleClear"
             ShowPinButton="true"
             ShowCloseButton="true">
    <AdditionalActions>
        <Button Type="ButtonType.Text" Icon="setting" OnClick="HandleSettings" Title="Settings" />
        <Button Type="ButtonType.Text" Icon="download" OnClick="HandleExport" Title="Export" />
    </AdditionalActions>
</PanelHeader>

@code {
    private bool isProcessing = false;

    private async Task HandleClear()
    {
        // Clear logic here
        await Task.CompletedTask;
    }

    private async Task HandlePin()
    {
        // Pin logic here
        await Task.CompletedTask;
    }

    private async Task HandleClose()
    {
        // Close logic here
        await Task.CompletedTask;
    }

    private async Task HandleSettings()
    {
        // Settings logic here
        await Task.CompletedTask;
    }

    private async Task HandleExport()
    {
        // Export logic here
        await Task.CompletedTask;
    }
}