@* AI Integration Visual Mockup Component *@

<div class="ai-visual-mockup">
    <div class="ai-brain">
        <div class="brain-icon">🤖</div>
        <div class="neural-network">
            <div class="neural-line line-1"></div>
            <div class="neural-line line-2"></div>
            <div class="neural-line line-3"></div>
            <div class="neural-node node-1"></div>
            <div class="neural-node node-2"></div>
            <div class="neural-node node-3"></div>
        </div>
    </div>
    <div class="ai-providers">
        <div class="provider-card openai">
            <span class="provider-icon">◯</span>
            <span class="provider-name">OpenAI</span>
        </div>
        <div class="provider-card anthropic">
            <span class="provider-icon">◐</span>
            <span class="provider-name">Anthropic</span>
        </div>
        <div class="provider-card google">
            <span class="provider-icon">◑</span>
            <span class="provider-name">Google</span>
        </div>
    </div>
</div>

<style>
    .ai-visual-mockup {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 24px;
        padding: 32px 24px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        backdrop-filter: blur(10px);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        animation: fadeIn 0.8s ease;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: scale(0.95); }
        to { opacity: 1; transform: scale(1); }
    }

    .ai-brain {
        position: relative;
        width: 100px;
        height: 100px;
        display: flex;
        align-items: center;
        justify-content: center;
        animation: float 3s ease-in-out infinite;
    }

    @@keyframes float {
        0%, 100% { transform: translateY(0) rotate(0deg); }
        50% { transform: translateY(-10px) rotate(5deg); }
    }

    .brain-icon {
        font-size: 48px;
        z-index: 2;
        filter: drop-shadow(0 4px 12px rgba(168, 85, 247, 0.4));
        animation: glow 2s ease-in-out infinite;
    }

    @@keyframes glow {
        0%, 100% { filter: drop-shadow(0 4px 12px rgba(168, 85, 247, 0.4)); }
        50% { filter: drop-shadow(0 4px 20px rgba(168, 85, 247, 0.8)); }
    }

    .neural-network {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
    }

    .neural-line {
        position: absolute;
        width: 2px;
        background: linear-gradient(180deg, rgba(168, 85, 247, 0.6), rgba(147, 51, 234, 0.6));
        transform-origin: top center;
    }

    .line-1 {
        top: 50%;
        left: 30%;
        height: 40px;
        transform: rotate(-30deg);
        animation: pulse 2s ease-in-out infinite;
    }

    .line-2 {
        top: 50%;
        left: 50%;
        height: 45px;
        transform: rotate(0deg);
        animation: pulse 2s ease-in-out infinite 0.3s;
    }

    .line-3 {
        top: 50%;
        right: 30%;
        height: 40px;
        transform: rotate(30deg);
        animation: pulse 2s ease-in-out infinite 0.6s;
    }

    @@keyframes pulse {
        0%, 100% { opacity: 0.4; }
        50% { opacity: 1; }
    }

    .neural-node {
        position: absolute;
        width: 8px;
        height: 8px;
        background: rgba(168, 85, 247, 0.8);
        border-radius: 50%;
        box-shadow: 0 0 8px rgba(168, 85, 247, 0.6);
        animation: pulse-node 2s ease-in-out infinite;
    }

    .node-1 {
        bottom: 10px;
        left: 25%;
        animation-delay: 0s;
    }

    .node-2 {
        bottom: 5px;
        left: 50%;
        animation-delay: 0.3s;
    }

    .node-3 {
        bottom: 10px;
        right: 25%;
        animation-delay: 0.6s;
    }

    @@keyframes pulse-node {
        0%, 100% { transform: scale(1); opacity: 0.6; }
        50% { transform: scale(1.5); opacity: 1; }
    }

    .ai-providers {
        width: 100%;
        display: flex;
        gap: 12px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .provider-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        padding: 12px 16px;
        background: rgba(255, 255, 255, 0.95);
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
        animation: slideUp 0.6s ease forwards;
        opacity: 0;
        min-width: 90px;
    }

    .provider-card:nth-child(1) { animation-delay: 0.2s; }
    .provider-card:nth-child(2) { animation-delay: 0.3s; }
    .provider-card:nth-child(3) { animation-delay: 0.4s; }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .provider-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    }

    .provider-icon {
        font-size: 24px;
        font-weight: bold;
    }

    .provider-name {
        font-size: 12px;
        font-weight: 600;
        color: #1e293b;
    }

    .openai .provider-icon { color: #10a37f; }
    .anthropic .provider-icon { color: #d4822a; }
    .google .provider-icon { color: #4285f4; }

    @@media (max-width: 768px) {
        .ai-visual-mockup {
            padding: 24px 16px;
        }

        .ai-brain {
            width: 80px;
            height: 80px;
        }

        .brain-icon {
            font-size: 36px;
        }

        .provider-card {
            min-width: 75px;
            padding: 10px 12px;
        }

        .provider-icon {
            font-size: 20px;
        }

        .provider-name {
            font-size: 10px;
        }
    }
</style>
