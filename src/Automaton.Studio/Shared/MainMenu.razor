@using Automaton.Studio.Services
@using Automaton.Studio.Enums;
@inject OnboardingService OnboardingService

<ProjectSwitcher />

<Menu Mode="MenuMode.Vertical" 
      Theme="MenuTheme.Dark" 
      Selectable="true" 
      DefaultSelectedKeys=@(new[] { "0" })>

    <MenuItem Key="0" Icon="home" RouterLink="/">
        <b>Home</b>
    </MenuItem>

    @if (showDevTools)
    {
        <MenuItem Key="1" Icon="team" RouterLink="/projects">
            <b>Projects</b>
        </MenuItem>
    
        <MenuItem Key="2" Icon="appstore" RouterLink="/apps">
            <b>Apps</b>
        </MenuItem>
        <MenuItem Key="3" Icon="profile" RouterLink="/flows">
            <b>Flows</b>
        </MenuItem>
        <MenuItem Key="4" Icon="play-square" RouterLink="/runners">
            <b>Runners</b>
        </MenuItem>
        <MenuItem Key="5" Icon="experiment" RouterLink="/customsteps/">
            <b>Steps</b>
        </MenuItem>
        <MenuItem Key="6" Icon="key" RouterLink="/apikeys">
            <b>API Keys</b>
        </MenuItem>
        <MenuItem Key="7" Icon="robot" RouterLink="/ai-keys">
            <b>AI Keys</b>
        </MenuItem>
        <MenuItem Key="8" Icon="setting" RouterLink="/settings">
            <b>Settings</b>
        </MenuItem>
        <MenuItem Key="9" Icon="download" RouterLink="/downloads">
            <b>Downloads</b>
        </MenuItem>
        <MenuItem Key="10" Icon="book" RouterLink="/docs">
            <b>Docs</b>
        </MenuItem>

        @if (shouldShowOnboarding)
        {
            <MenuItem Key="11" Icon="question-circle" RouterLink="/onboarding" Class="get-started-item">
                <b>Get Started</b>
            </MenuItem>
        }
    }

    <AuthorizeView Roles="Admin">
        <Authorized>
            <MenuItem Key="14" Icon="control" RouterLink="/admin" Class="admin-menu-item">
                <b>Admin</b>
            </MenuItem>
        </Authorized>
    </AuthorizeView>

    <MenuItem Key="12" Icon="user" RouterLink="/account/">
        <b>Account</b>
    </MenuItem>
    <MenuItem Key="13" Icon="poweroff" OnClick="Logout">
        <b>Logout</b>
    </MenuItem>
</Menu>

@code {
    private bool shouldShowOnboarding = false;

    protected override async Task OnInitializedAsync()
    {
        await CheckOnboardingStatus();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CheckOnboardingStatus();
        }
    }

    private async Task CheckOnboardingStatus()
    {
        try
        {
            shouldShowOnboarding = await OnboardingService.TryShouldShowOnboardingAsync();
            StateHasChanged();
        }
        catch
        {
            shouldShowOnboarding = false;
        }
    }
}