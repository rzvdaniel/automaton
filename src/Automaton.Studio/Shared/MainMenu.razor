@using Automaton.Studio.Services
@inject OnboardingService OnboardingService

<Menu Mode="MenuMode.Vertical" 
      Theme="MenuTheme.Dark" 
      Selectable="true" 
      DefaultSelectedKeys=@(new[] { "0" })>

    <MenuItem Key="0" Icon="home" RouterLink="/">
        <b>Home</b>
    </MenuItem>
    <MenuItem Key="1" Icon="profile" RouterLink="/flows">
        <b>Flows</b>
    </MenuItem>
    <MenuItem Key="2" Icon="play-square" RouterLink="/runners">
        <b>Runners</b>
    </MenuItem>
    <MenuItem Key="3" Icon="experiment" RouterLink="/customsteps/">
        <b>Steps</b>
    </MenuItem>
    <MenuItem Key="4" Icon="key" RouterLink="/apikeys">
        <b>API Keys</b>
    </MenuItem>
    <MenuItem Key="5" Icon="download" RouterLink="/downloads-hub">
        <b>Downloads</b>
    </MenuItem>
    <MenuItem Key="6" Icon="setting" RouterLink="/settings">
        <b>Settings</b>
    </MenuItem>
    @if (shouldShowOnboarding)
    {
        <MenuItem Key="7" Icon="question-circle" RouterLink="/onboarding" Class="get-started-item">
            <b>Get Started</b>
        </MenuItem>
    }
    <MenuItem Key="8" Icon="user" RouterLink="/account/">
        <b>Account</b>
    </MenuItem>
    <MenuItem Key="9" Icon="poweroff" OnClick="Logout">
        <b>Logout</b>
    </MenuItem>
</Menu>

@code {
    private bool shouldShowOnboarding = false;

    protected override async Task OnInitializedAsync()
    {
        await CheckOnboardingStatus();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CheckOnboardingStatus();
        }
    }

    private async Task CheckOnboardingStatus()
    {
        try
        {
            shouldShowOnboarding = await OnboardingService.TryShouldShowOnboardingAsync();
            StateHasChanged();
        }
        catch
        {
            shouldShowOnboarding = false;
        }
    }
}