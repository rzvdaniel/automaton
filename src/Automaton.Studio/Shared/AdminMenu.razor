@using Automaton.Studio.Services

<div class="admin-menu-title">
    <Icon Type="setting" />
    <span>Administration</span>
</div>

<Menu Mode="MenuMode.Vertical"
      Theme="MenuTheme.Dark"
      Selectable="true"
      Class="admin-menu">

    <MenuItem Key="admin-dashboard" Icon="dashboard" RouterLink="/admin">
        <b>Dashboard</b>
    </MenuItem>

    <SubMenu Key="admin-ai" Title="AI Providers">
        <MenuItem Key="admin-ai-providers" RouterLink="/admin/ai-providers">
            Providers
        </MenuItem>
        <MenuItem Key="admin-ai-models" RouterLink="/admin/ai-models">
            Models
        </MenuItem>
    </SubMenu>

    <SubMenu Key="admin-system" Title="System">
        <MenuItem Key="admin-settings" RouterLink="/admin/settings">
            Settings
        </MenuItem>
        <MenuItem Key="admin-users" RouterLink="/admin/users">
            Users
        </MenuItem>
    </SubMenu>
</Menu>

<style>
    .admin-menu-title {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px;
        color: #fff;
        font-size: 16px;
        font-weight: 600;
        border-bottom: 1px solid #303030;
        margin-bottom: 8px;
    }

    .admin-menu-title .anticon {
        font-size: 18px;
        color: #1890ff;
    }

    .admin-menu {
        background: transparent;
    }

    .admin-menu .ant-menu-item,
    .admin-menu .ant-menu-submenu-title {
        margin: 4px 8px;
        border-radius: 6px;
    }

    .admin-menu .ant-menu-item:hover,
    .admin-menu .ant-menu-submenu-title:hover {
        background: rgba(255, 255, 255, 0.08);
    }

    .admin-menu .ant-menu-item-selected {
        background: #1890ff !important;
    }
</style>
