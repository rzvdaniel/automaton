@using Automaton.Studio.Services
@using Automaton.Studio.Models
@using Automaton.Studio.Enums
@inject ProjectContextService ProjectContext
@inject NavigationManager Navigation

<div class="project-switcher">
    @if (ProjectContext.CurrentProject != null)
    {
        <div class="current-project-indicator">
            <Icon Type="team" />
            <Dropdown>
                <Overlay>
                    <Menu>
                        <MenuItem Icon="user" OnClick="@(() => SwitchToPersonal())">
                            <span style="margin-left: 12px;">Personal Workspace</span>
                        </MenuItem>
                        <MenuDivider />
                        @foreach (var project in ProjectContext.GetProjects())
                        {
                            <MenuItem Icon="team" OnClick="@(() => SwitchProject(project.Id))" Disabled="@(project.Id == ProjectContext.CurrentProject?.Id)">
                                <span style="margin-left: 12px;">@project.DisplayName</span>
                                @if (project.Id == ProjectContext.CurrentProject?.Id)
                                {
                                    <Icon Type="check" style="margin-left: auto; color: #52c41a;" />
                                }
                            </MenuItem>
                        }
                        @if (ProjectContext.GetProjects().Any())
                        {
                            <MenuDivider />
                        }
                        <MenuItem Icon="setting" OnClick="@(() => Navigation.NavigateTo("/projects"))">
                            <span style="margin-left: 12px;">Manage Projects</span>
                        </MenuItem>
                    </Menu>
                </Overlay>
                <ChildContent>
                    <a class="ant-dropdown-link" @onclick:preventDefault>
                        <span class="project-name">@ProjectContext.CurrentProject.DisplayName</span>
                        <Icon Type="caret-down" />
                    </a>
                </ChildContent>
            </Dropdown>
        </div>
    }
    else
    {
        <div class="no-project-indicator">
            <Icon Type="user" />
            <Dropdown>
                <Overlay>
                    <Menu>
                        <MenuItem Icon="user"  Disabled>
                            <span style="margin-left: 12px;">Personal Workspace</span>
                            <Icon Type="check" style="margin-left: auto; color: #52c41a;" />
                        </MenuItem>
                        @if (ProjectContext.GetProjects().Any())
                        {
                            <MenuDivider />
                            @foreach (var project in ProjectContext.GetProjects())
                            {
                                <MenuItem Icon="team" OnClick="@(() => SwitchProject(project.Id))">
                                    <span style="margin-left: 12px;">@project.DisplayName</span>
                                </MenuItem>
                            }
                        }
                        <MenuDivider />
                        <MenuItem Icon="plus-circle"  OnClick="@(() => Navigation.NavigateTo("/projects"))">
                            <span style="margin-left: 12px;">Create or Join Project</span>
                        </MenuItem>
                    </Menu>
                </Overlay>
                <ChildContent>
                    <a class="ant-dropdown-link" @onclick:preventDefault>
                        <span class="workspace-name">Personal</span>
                        <Icon Type="caret-down" />
                    </a>
                </ChildContent>
            </Dropdown>
        </div>
    }
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await ProjectContext.LoadProjectsAsync();
    }

    private async Task SwitchProject(Guid projectId)
    {
        await ProjectContext.SetCurrentProjectAsync(projectId);
        // force navigation to dashboard so pages reload based on new context
        Navigation.NavigateTo("/", false);
    }

    private async Task SwitchToPersonal()
    {
        await ProjectContext.SetCurrentProjectAsync(null);
        // force navigation to dashboard so pages reload based on personal mode
        Navigation.NavigateTo("/", false);
    }

    private string GetRoleColor(ProjectRole? role)
    {
        return role switch
        {
            ProjectRole.ProjectAdmin => "red",
            ProjectRole.Developer => "blue",
            ProjectRole.AppUser => "green",
            ProjectRole.Viewer => "default",
            _ => "default"
        };
    }
}
