@inherits LayoutComponentBase

@using Microsoft.AspNetCore.Components

<Layout Class="main-layout" Id="main-layout">

    <AuthorizeView>
        <Sider Collapsed="MenuCollapsed" Theme="SiderTheme.Light" Class="menu-sider">
            <div class="menu-header">
                <a href="/" class="menu-link">
                    @* <img src="images/logo64x64.png" alt="Logo" class="logo" /> *@
                    <Icon Type="home" Class="logo"></Icon>
                    <span class="menu-title">Automaton</span>
                </a>
            </div>
            <NavMenu @ref="NavigationMenu" />
        </Sider>
    </AuthorizeView>

    <Layout>
        <Content>
            <AuthorizeView>
                <Row Class="main-header">
                    @* <Col Flex=@("none")>
                    <Space Size="@AntSizeLDSType.Default">
                        <SpaceItem>
                            <Button Type="@ButtonType.Text" OnClick="ToggleCollapsed">
                                @if (MenuCollapsed)
                                {
                                    <Icon Type="menu-unfold"></Icon>
                                }
                                else
                                {
                                    <Icon Type="menu-fold"></Icon>
                                }
                            </Button>
                        </SpaceItem>
                    </Space>

                    </Col>

                    <Col Class="right-actions">
                        <Space Class="right-header-items">
                            <SpaceItem>
                                <Button Icon="fullscreen" Type="@ButtonType.Text" OnClick="ToggleFullScreen"></Button>
                            </SpaceItem>
                        </Space>
                    </Col> *@
                </Row>
            </AuthorizeView>

            <div class="site-layout-content" tabindex="0" @onkeydown="(e)=>OnKeyDown(e)" @onkeyup="(e)=>OnKeyUp(e)">
                @Body
            </div>

        </Content>
    </Layout>
</Layout>

<style>
    
    .main-header {
        background-color: #1890ff;
    }

    .menu-header {
        height: 48px;
        display: flex;
        align-items: center; /* Center items vertically */
        color: white;
        background-color: #1890ff;
    }

    .menu-link {
        display: flex;
        align-items: center; /* Center items vertically within the link */
        color: white;
        text-decoration: none; /* Remove underline from the link */
    }

    .menu-title {
        font-size: medium;
    }

    .menu-sider {
        background-color: #fafafa;
    }

    .logo {
        margin-right: 14px; /* Add some space between the image and the text */
        margin-left: 16px;
    }
</style>

