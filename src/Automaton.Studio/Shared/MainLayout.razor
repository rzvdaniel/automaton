@inherits LayoutComponentBase

@using Microsoft.AspNetCore.Components

<Layout Class="main-layout" Id="main-layout">

    <AuthorizeView>
        <Sider Collapsed="MenuCollapsed" Class="menu-sider">
            <div style="flex: 1 1 auto; overflow-y: auto; overflow-x: hidden; height: 100%;">
                <MainMenu Collapsed="MenuCollapsed" />
            </div>
        </Sider>
    </AuthorizeView>

    <Layout>
        <Content>

            <div class="site-layout-content" tabindex="0" @onkeydown="(e)=>OnKeyDown(e)" @onkeyup="(e)=>OnKeyUp(e)">
                @Body
            </div>

        </Content>
    </Layout>
</Layout>

<style>
    .ant-layout-sider-children {
        display: flex;
        flex-direction: column;
    }
    
    .main-header {
        background-color: #1890ff;
    }

    .menu-header {
        height: 48px;
        display: flex;
        align-items: center; /* Center items vertically */
        color: white;
        background-color: #1890ff;
    }

    .menu-link {
        display: flex;
        align-items: center; /* Center items vertically within the link */
        color: white;
        text-decoration: none; /* Remove underline from the link */
    }

    .menu-title {
        font-size: medium;
    }

    .menu-sider {
        background-color: #fafafa;
    }

    .logo {
        margin-right: 14px; /* Add some space between the image and the text */
        margin-left: 16px;
    }
</style>

