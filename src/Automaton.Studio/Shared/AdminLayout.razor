@inherits LayoutComponentBase

@using Microsoft.AspNetCore.Components
@using Automaton.Studio.Services

<Layout Class="admin-layout" Id="admin-layout">
    <AuthorizeView Roles="Admin">
        <Authorized>
            <Sider Collapsed="MenuCollapsed" Class="admin-sider" Width="220">
                <div class="admin-menu-header">
                    <a href="/" class="admin-back-link">
                        <Icon Type="arrow-left" />
                        <span class="admin-back-text">Back to App</span>
                    </a>
                </div>
                <div class="admin-menu-container">
                    <AdminMenu />
                </div>
            </Sider>

            <Layout Class="admin-content-layout">
                <Content Class="admin-content">
                    <div class="admin-content-inner">
                        @Body
                    </div>
                </Content>
            </Layout>
        </Authorized>

        <NotAuthorized>
            <Layout>
                <Content>
                    <div class="admin-access-denied">
                        <Result Status="ResultStatus.Http403"
                                Title="Access Denied"
                                SubTitle="You need Admin privileges to access this area.">
                            <Extra>
                                <Button Type="@ButtonType.Primary" OnClick="@NavigateToHome">
                                    Go to Home
                                </Button>
                            </Extra>
                        </Result>
                    </div>
                </Content>
            </Layout>
        </NotAuthorized>
    </AuthorizeView>
</Layout>


@code {
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private bool MenuCollapsed { get; set; } = false;

    private void NavigateToHome()
    {
        NavigationManager.NavigateTo("/");
    }
}

<style>
    #admin-layout {
        height: 100vh;
        width: 100vw;
        overflow: hidden;
    }

    #admin-layout.ant-layout {
        height: 100vh;
        overflow: hidden;
    }

    .admin-sider {
        background: #1f1f1f;
    }

    .admin-menu-header {
        height: 48px;
        display: flex;
        align-items: center;
        padding: 0 16px;
        background: #141414;
        border-bottom: 1px solid #303030;
    }

    .admin-back-link {
        display: flex;
        align-items: center;
        color: #fff;
        text-decoration: none;
        gap: 8px;
    }

    .admin-back-link:hover {
        color: #1890ff;
    }

    .admin-back-text {
        font-size: 14px;
    }

    .admin-menu-container {
        height: calc(100vh - 48px);
        overflow-y: auto;
        overflow-x: hidden;
    }

    .admin-menu-container::-webkit-scrollbar {
        width: 6px;
    }

    .admin-menu-container::-webkit-scrollbar-track {
        background: transparent;
    }

    .admin-menu-container::-webkit-scrollbar-thumb {
        background-color: rgba(255, 255, 255, 0.2);
        border-radius: 3px;
    }

    .admin-content-layout {
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .admin-content {
        height: 100vh;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        background: #f0f2f5;
    }

    .admin-content-inner {
        height: 100vh;
        overflow-y: auto;
        overflow-x: hidden;
        flex: 1;
        padding: 24px;
    }

    .admin-content-inner::-webkit-scrollbar {
        width: 8px;
    }

    .admin-content-inner::-webkit-scrollbar-track {
        background: #f0f0f0;
    }

    .admin-content-inner::-webkit-scrollbar-thumb {
        background-color: rgba(0, 0, 0, 0.3);
        border-radius: 4px;
    }

    .admin-access-denied {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
    }
</style>
