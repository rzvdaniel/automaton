@using Automaton.Studio.Services
@using Automaton.Studio.Models
@inject DashboardContextService DashboardContext
@inject NavigationManager NavigationManager

<PageHeader Title="Dashboard" Subtitle="Overview of your work">
    <Extra>
        @if (DashboardContext.CurrentProject != null)
        {
            <Tag Color="blue">@DashboardContext.CurrentProject.DisplayName</Tag>
        }
        else
        {
            <Tag>Personal Workspace</Tag>
        }
    </Extra>
</PageHeader>

@if (DashboardContext.IsLoading)
{
    <div class="loading-container">
        <Spin Size="SpinSize.Large" />
        <p>Loading dashboard...</p>
    </div>
}
else
{
    <div class="creator-dashboard">
        <!-- Stats Cards -->
        <Row Gutter="(16, 16)" Style="margin-bottom: 24px;">
            <Col Xs="24" Sm="12" Md="6">
                <Card>
                    <Statistic Title="Total Apps" 
                              Value="@DashboardContext.TotalApps" 
                              Prefix="@IconType.Outline.AppstoreAdd" 
                              ValueStyle="@("color: #3f8600")" />
                </Card>
            </Col>
            <Col Xs="24" Sm="12" Md="6">
                <Card>
                    <Statistic Title="Total Flows" 
                              Value="@DashboardContext.TotalFlows" 
                              Prefix="@IconType.Outline.ApiOutlined" 
                              ValueStyle="@("color: #1890ff")" />
                </Card>
            </Col>
            <Col Xs="24" Sm="12" Md="6">
                <Card>
                    <Statistic Title="Projects" 
                              Value="@DashboardContext.TotalProjects" 
                              Prefix="@IconType.Outline.Team" 
                              ValueStyle="@("color: #722ed1")" />
                </Card>
            </Col>
            <Col Xs="24" Sm="12" Md="6">
                <Card>
                    <Statistic Title="Runners" 
                              Value="@DashboardContext.TotalRunners" 
                              Prefix="@IconType.Outline.CloudServer" 
                              ValueStyle="@("color: #eb2f96")" />
                </Card>
            </Col>
        </Row>

        <!-- Quick Actions -->
        <Card Title="Quick Actions" Style="margin-bottom: 24px;">
            <Body>
                <Space Size="@SpaceSize.Middle">
                    <SpaceItem>
                        <Button Type="@ButtonType.Primary" Icon="@IconType.Outline.AppstoreAdd" OnClick="@(() => NavigationManager.NavigateTo("/appdesigner"))">
                            Create App
                        </Button>
                    </SpaceItem>
                    <SpaceItem>
                        <Button Icon="@IconType.Outline.Plus" OnClick="@(() => NavigationManager.NavigateTo("/flow/designer"))">
                            Create Flow
                        </Button>
                    </SpaceItem>
                    <SpaceItem>
                        <Button Icon="@IconType.Outline.Team" OnClick="@(() => NavigationManager.NavigateTo("/projects"))">
                            Manage Projects
                        </Button>
                    </SpaceItem>
                    <SpaceItem>
                        <Button Icon="@IconType.Outline.Setting" OnClick="@(() => NavigationManager.NavigateTo("/settings"))">
                            Settings
                        </Button>
                    </SpaceItem>
                </Space>
            </Body>
        </Card>

        <!-- Recent Activity -->
        <Row Gutter="(16, 16)">
            <Col Xs="24" Lg="12">
                <Card Title="Recent Apps">
                    <Body>
                        @if (DashboardContext.RecentApps.Any())
                        {
                        <AntList DataSource="@DashboardContext.RecentApps" Size="@ListSize.Small">
                                <ChildContent Context="app">
                                    <ListItem>
                                        <a href="/appdesigner/@app.WebAppId">
                                            <Icon Type="appstore" Theme="outline" Style="margin-right: 8px;" />
                                            @app.AppName
                                        </a>
                                    </ListItem>
                                </ChildContent>
                            </AntList>
                        }
                        else
                        {
                            <Empty Description="@string.Empty" Simple="true" />
                        }
                    </Body>
                </Card>
            </Col>
            <Col Xs="24" Lg="12">
                <Card Title="Getting Started">
                    <Body>
                        <Steps Direction="@StepsDirection.Vertical" Size="@StepsSize.Small" Current="0">
                            <Step Title="Create your first app" Description="Build a web application" />
                            <Step Title="Design a workflow" Description="Automate tasks with flows" />
                            <Step Title="Invite team members" Description="Collaborate on projects" />
                            <Step Title="Deploy a runner" Description="Execute workflows" />
                        </Steps>
                    </Body>
                </Card>
            </Col>
        </Row>
    </div>
}

<style>
    .loading-container {
        text-align: center;
        padding: 80px 0;
    }

    .loading-container p {
        margin-top: 16px;
        color: rgba(0, 0, 0, 0.45);
    }

    .creator-dashboard {
        padding: 24px 0;
    }
</style>
