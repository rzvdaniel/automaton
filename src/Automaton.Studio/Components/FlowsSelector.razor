@using AntDesign
@using Automaton.Studio.Models
@using Automaton.Studio.Services

@namespace Automaton.Studio.Components

@if (isLoading)
{
	<div style="display:inline-flex; align-items:center; gap:8px;">
		<Spin />
		<span class="flow-placeholder">Loading flows...</span>
	</div>
}
else if (AvailableFlows == null || !AvailableFlows.Any())
{
	<span class="flow-placeholder">No flows available</span>
}
else if (Multiple)
{
	<Select Mode="SelectMode.Multiple"
			Placeholder="@Placeholder"
			DataSource="AvailableFlows"
			TItem="FlowInfo"
			TItemValue="Guid"
			ValueProperty="f => f.Id"
			LabelProperty="f => f.Name"
			@bind-Values="BoundValues"
			AllowClear="@AllowClear"
			Style="@Style">
		<ItemTemplate Context="flowContext">
			<span class="flow-item">
				<Icon Type="partition" class="flow-icon" />
				<span class="flow-label">@flowContext.Name</span>
			</span>
		</ItemTemplate>
		<LabelTemplate Context="flowContext">
			<span class="flow-label-inline">
				<Icon Type="partition" class="flow-icon" />
				<span class="flow-label">@flowContext.Name</span>
			</span>
		</LabelTemplate>
	</Select>
}
else
{
	<Select Mode="SelectMode.Default"
			Placeholder="@Placeholder"
			DataSource="AvailableFlows"
			TItem="FlowInfo"
			TItemValue="Guid?"
			ValueProperty="f => f.Id"
			LabelProperty="f => f.Name"
			@bind-Value="SelectedValue"
			AllowClear="@AllowClear"
			Style="@Style">
		<ItemTemplate Context="flowContext">
			<span class="flow-item">
				<Icon Type="partition" class="flow-icon" />
				<span class="flow-label">@flowContext.Name</span>
			</span>
		</ItemTemplate>
		<LabelTemplate Context="flowContext">
			<span class="flow-label-inline">
				<Icon Type="partition" class="flow-icon" />
				<span class="flow-label">@flowContext.Name</span>
			</span>
		</LabelTemplate>
	</Select>
}

@code {
	private IEnumerable<FlowInfo> AvailableFlows { get; set; } = new List<FlowInfo>();

	private Guid? _selectedValue;

	// Internal mutable copy used for binding
	private List<Guid> _boundValues = new();

	private IEnumerable<Guid> BoundValues
	{
		get => _boundValues;
		set
		{
			var newList = (value ?? Enumerable.Empty<Guid>()).ToList();
			if (!_boundValues.SequenceEqual(newList))
			{
				_boundValues = newList;
				// notify parent
				_ = SelectedValuesChanged.InvokeAsync(_boundValues);
			}
		}
	}

	[Inject] private Automaton.Studio.Services.FlowsService FlowsService { get; set; }

	/// <summary>
	/// Optional external data source for flows. If provided, the component will use this instead of loading from service.
	/// </summary>
	[Parameter]
	public IEnumerable<FlowInfo>? Flows { get; set; }

	[Parameter] 
	public bool Multiple { get; set; } = false;

	[Parameter]
	public Guid? SelectedValue
	{
		get => _selectedValue;
		set
		{
			if (!EqualityComparer<Guid?>.Default.Equals(_selectedValue, value))
			{
				_selectedValue = value;
				_ = SelectedValueChanged.InvokeAsync(value);
			}
		}
	}

	[Parameter]
	public EventCallback<Guid?> SelectedValueChanged { get; set; }

	// Multiple-selection API for parent
	[Parameter] public IEnumerable<Guid>? SelectedValues { get; set; }
	[Parameter] public EventCallback<IEnumerable<Guid>> SelectedValuesChanged { get; set; }

	[Parameter] public string Placeholder { get; set; } = "Select flows...";
	[Parameter] public string Style { get; set; } = "width:200px";
	[Parameter] public bool AllowClear { get; set; } = true;

	private bool isLoading = false;

	protected override void OnParametersSet()
	{
		// sync incoming values into internal copy
		var incoming = SelectedValues?.ToList() ?? new List<Guid>();
		if (!_boundValues.SequenceEqual(incoming))
		{
			_boundValues = incoming;
		}
	}

	protected override async Task OnInitializedAsync()
	{
		await LoadFlowsAsync();
	}

	public async Task LoadFlowsAsync()
	{
		// If external data source provided, use it instead of loading from service
		if (Flows != null)
		{
			AvailableFlows = Flows;
			return;
		}

		try
		{
			isLoading = true;
			StateHasChanged();

			var list = await FlowsService.List();
			AvailableFlows = list ?? new List<FlowInfo>();
		}
		catch
		{
			AvailableFlows = new List<FlowInfo>();
		}
		finally
		{
			isLoading = false;
			await InvokeAsync(StateHasChanged);
		}
	}
}

<style>
	.flow-icon {
		color: #52c41a;
	}

	.flow-item {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

	.flow-label-inline {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

	.flow-label {
		vertical-align: middle;
	}

	.flow-placeholder {
		color: #8c8c8c;
		font-size: 13px;
	}
</style>
