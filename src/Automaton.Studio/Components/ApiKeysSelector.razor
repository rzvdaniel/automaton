@using AntDesign
@using Automaton.Studio.Models
@using Automaton.Studio.Services

@namespace Automaton.Studio.Components

@if (isLoading)
{
	<div style="display:inline-flex; align-items:center; gap:8px;">
		<Spin />
		<span class="apikey-placeholder">Loading API keys...</span>
	</div>
}
else if (AvailableApiKeys == null || !AvailableApiKeys.Any())
{
	<span class="apikey-placeholder">No API keys available</span>
}
else if (Multiple)
{
	<Select Mode="SelectMode.Multiple"
			Placeholder="@Placeholder"
			DataSource="AvailableApiKeys"
			TItem="ApiKeyResponse"
			TItemValue="Guid"
			ValueProperty="k => k.Id"
			LabelProperty="k => k.Name"
			DisabledPredicate="k => !k.IsActive"
			@bind-Values="BoundValues"
			AllowClear="@AllowClear"
			Style="@Style">
		<ItemTemplate Context="keyContext">
			<span class="apikey-item">
				<Icon Type="@(keyContext.IsActive ? "key" : "lock")" class="apikey-icon" />
				<span class="apikey-label">@keyContext.Name</span>
			</span>
		</ItemTemplate>
		<LabelTemplate Context="keyContext">
			<span class="apikey-label-inline">
				<Icon Type="@(keyContext.IsActive ? "key" : "lock")" class="apikey-icon" />
				<span class="apikey-label">@keyContext.Name</span>
			</span>
		</LabelTemplate>
	</Select>
}
else
{
	<Select Mode="SelectMode.Default"
			Placeholder="@Placeholder"
			DataSource="AvailableApiKeys"
			TItem="ApiKeyResponse"
			TItemValue="Guid?"
			ValueProperty="k => k.Id"
			LabelProperty="k => k.Name"
			DisabledPredicate="k => !k.IsActive"
			@bind-Value="SelectedValue"
			AllowClear="@AllowClear"
			Style="@Style">
		<ItemTemplate Context="keyContext">
			<span class="apikey-item">
				<Icon Type="@(keyContext.IsActive ? "key" : "lock")" class="apikey-icon" />
				<span class="apikey-label">@keyContext.Name</span>
			</span>
		</ItemTemplate>
		<LabelTemplate Context="keyContext">
			<span class="apikey-label-inline">
				<Icon Type="@(keyContext.IsActive ? "key" : "lock")" class="apikey-icon" />
				<span class="apikey-label">@keyContext.Name</span>
			</span>
		</LabelTemplate>
	</Select>
}

@code {
	private IEnumerable<ApiKeyResponse> AvailableApiKeys { get; set; } = new List<ApiKeyResponse>();

	private Guid? _selectedValue;

	// Internal mutable copy used for binding
	private List<Guid> _boundValues = new();

	private IEnumerable<Guid> BoundValues
	{
		get => _boundValues;
		set
		{
			var newList = (value ?? Enumerable.Empty<Guid>()).ToList();
			if (!_boundValues.SequenceEqual(newList))
			{
				_boundValues = newList;
				// notify parent
				_ = SelectedValuesChanged.InvokeAsync(_boundValues);
			}
		}
	}

	[Inject] private Automaton.Studio.Services.ApiKeysService ApiKeysService { get; set; }

	/// <summary>
	/// Optional external data source for API keys. If provided, the component will use this instead of loading from service.
	/// </summary>
	[Parameter]
	public IEnumerable<ApiKeyResponse>? ApiKeys { get; set; }

	[Parameter] 
	public bool Multiple { get; set; } = false;

	[Parameter]
	public Guid? SelectedValue
	{
		get => _selectedValue;
		set
		{
			if (!EqualityComparer<Guid?>.Default.Equals(_selectedValue, value))
			{
				_selectedValue = value;
				_ = SelectedValueChanged.InvokeAsync(value);
			}
		}
	}

	[Parameter]
	public EventCallback<Guid?> SelectedValueChanged { get; set; }

	// Multiple-selection API for parent
	[Parameter] public IEnumerable<Guid>? SelectedValues { get; set; }
	[Parameter] public EventCallback<IEnumerable<Guid>> SelectedValuesChanged { get; set; }

	[Parameter] public string Placeholder { get; set; } = "Select API keys...";
	[Parameter] public string Style { get; set; } = "width:200px";
	[Parameter] public bool AllowClear { get; set; } = true;

	private bool isLoading = false;

	protected override void OnParametersSet()
	{
		// sync incoming values into internal copy
		var incoming = SelectedValues?.ToList() ?? new List<Guid>();
		if (!_boundValues.SequenceEqual(incoming))
		{
			_boundValues = incoming;
		}
	}

	protected override async Task OnInitializedAsync()
	{
		await LoadApiKeysAsync();
	}

	public async Task LoadApiKeysAsync()
	{
		// If external data source provided, use it instead of loading from service
		if (ApiKeys != null)
		{
			AvailableApiKeys = ApiKeys;
			return;
		}

		try
		{
			isLoading = true;
			StateHasChanged();

			var list = await ApiKeysService.GetApiKeysAsync();
			AvailableApiKeys = list ?? new List<ApiKeyResponse>();
		}
		catch
		{
			AvailableApiKeys = new List<ApiKeyResponse>();
		}
		finally
		{
			isLoading = false;
			await InvokeAsync(StateHasChanged);
		}
	}
}

<style>
	.apikey-icon {
		color: #faad14;
	}

	.apikey-item {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

	.apikey-label-inline {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

	.apikey-label {
		vertical-align: middle;
	}

	.apikey-placeholder {
		color: #8c8c8c;
		font-size: 13px;
	}
</style>
