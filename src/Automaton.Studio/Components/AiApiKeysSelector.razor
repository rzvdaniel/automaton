@using AntDesign
@using Automaton.Mcp.Enums
@using Automaton.Studio.Models
@using Automaton.Studio.Services

@namespace Automaton.Studio.Components

@if (isLoading)
{
	<div style="display:inline-flex; align-items:center; gap:8px;">
		<Spin />
		<span class="aiapikey-placeholder">Loading AI API keys...</span>
	</div>
}
else if (AvailableAiApiKeys == null || !AvailableAiApiKeys.Any())
{
	<span class="aiapikey-placeholder">No AI API keys available</span>
}
else if (Multiple)
{
	<Select Mode="SelectMode.Multiple"
			Placeholder="@Placeholder"
			DataSource="AvailableAiApiKeys"
			TItem="AiApiKeyModel"
			TItemValue="Guid"
			ValueProperty="k => k.Id"
			LabelProperty="k => k.Name"
			DisabledPredicate="k => !k.IsActive"
			@bind-Values="BoundValues"
			AllowClear="@AllowClear"
			Style="@Style">
		<ItemTemplate Context="keyContext">
			<span class="aiapikey-item">
				<Icon Type="@GetProviderIcon(keyContext.Provider)" class="aiapikey-icon" />
				<span class="aiapikey-label">@keyContext.Name</span>
				<Tag Color="@GetProviderColor(keyContext.Provider)" Style="margin-left: 8px;">@keyContext.Provider</Tag>
			</span>
		</ItemTemplate>
		<LabelTemplate Context="keyContext">
			<span class="aiapikey-label-inline">
				<Icon Type="@GetProviderIcon(keyContext.Provider)" class="aiapikey-icon" />
				<span class="aiapikey-label">@keyContext.Name</span>
			</span>
		</LabelTemplate>
	</Select>
}
else
{
	<Select Mode="SelectMode.Default"
			Placeholder="@Placeholder"
			DataSource="AvailableAiApiKeys"
			TItem="AiApiKeyModel"
			TItemValue="Guid?"
			ValueProperty="k => k.Id"
			LabelProperty="k => k.Name"
			DisabledPredicate="k => !k.IsActive"
			@bind-Value="SelectedValue"
			AllowClear="@AllowClear"
			Style="@Style">
		<ItemTemplate Context="keyContext">
			<span class="aiapikey-item">
				<Icon Type="@GetProviderIcon(keyContext.Provider)" class="aiapikey-icon" />
				<span class="aiapikey-label">@keyContext.Name</span>
				<Tag Color="@GetProviderColor(keyContext.Provider)" Style="margin-left: 8px;">@keyContext.Provider</Tag>
			</span>
		</ItemTemplate>
		<LabelTemplate Context="keyContext">
			<span class="aiapikey-label-inline">
				<Icon Type="@GetProviderIcon(keyContext.Provider)" class="aiapikey-icon" />
				<span class="aiapikey-label">@keyContext.Name</span>
			</span>
		</LabelTemplate>
	</Select>
}

@code {
	private IEnumerable<AiApiKeyModel> AvailableAiApiKeys { get; set; } = new List<AiApiKeyModel>();

	private Guid? _selectedValue;

	// Internal mutable copy used for binding
	private List<Guid> _boundValues = new();

	private IEnumerable<Guid> BoundValues
	{
		get => _boundValues;
		set
		{
			var newList = (value ?? Enumerable.Empty<Guid>()).ToList();
			if (!_boundValues.SequenceEqual(newList))
			{
				_boundValues = newList;
				// notify parent
				_ = SelectedValuesChanged.InvokeAsync(_boundValues);
			}
		}
	}

	[Inject] private Automaton.Studio.Services.AiApiKeyService AiApiKeyService { get; set; }

	/// <summary>
	/// Optional external data source for AI API keys. If provided, the component will use this instead of loading from service.
	/// </summary>
	[Parameter]
	public IEnumerable<AiApiKeyModel>? AiApiKeys { get; set; }

	[Parameter] 
	public bool Multiple { get; set; } = false;

	[Parameter]
	public Guid? SelectedValue
	{
		get => _selectedValue;
		set
		{
			if (!EqualityComparer<Guid?>.Default.Equals(_selectedValue, value))
			{
				_selectedValue = value;
				_ = SelectedValueChanged.InvokeAsync(value);
			}
		}
	}

	[Parameter]
	public EventCallback<Guid?> SelectedValueChanged { get; set; }

	// Multiple-selection API for parent
	[Parameter] public IEnumerable<Guid>? SelectedValues { get; set; }
	[Parameter] public EventCallback<IEnumerable<Guid>> SelectedValuesChanged { get; set; }

	[Parameter] public string Placeholder { get; set; } = "Select AI API keys...";
	[Parameter] public string Style { get; set; } = "width:200px";
	[Parameter] public bool AllowClear { get; set; } = true;

	private bool isLoading = false;

	protected override void OnParametersSet()
	{
		// sync incoming values into internal copy
		var incoming = SelectedValues?.ToList() ?? new List<Guid>();
		if (!_boundValues.SequenceEqual(incoming))
		{
			_boundValues = incoming;
		}
	}

	protected override async Task OnInitializedAsync()
	{
		await LoadAiApiKeysAsync();
	}

	public async Task LoadAiApiKeysAsync()
	{
		// If external data source provided, use it instead of loading from service
		if (AiApiKeys != null)
		{
			AvailableAiApiKeys = AiApiKeys;
			return;
		}

		try
		{
			isLoading = true;
			StateHasChanged();

			var list = await AiApiKeyService.GetAiApiKeysAsync();
			AvailableAiApiKeys = list ?? new List<AiApiKeyModel>();
		}
		catch
		{
			AvailableAiApiKeys = new List<AiApiKeyModel>();
		}
		finally
		{
			isLoading = false;
			await InvokeAsync(StateHasChanged);
		}
	}

	private string GetProviderIcon(AiProviderType provider) => provider switch
	{
		AiProviderType.OpenAI => "robot",
		AiProviderType.Anthropic => "thunderbolt",
		AiProviderType.Google => "google",
		AiProviderType.Custom => "api",
		_ => "api",
	};

	private string GetProviderColor(AiProviderType provider) => provider switch
	{
		AiProviderType.OpenAI => "green",
		AiProviderType.Anthropic => "orange",
		AiProviderType.Google => "blue",
		AiProviderType.Custom => "purple",
		_ => "default",
	};
}

<style>
	.aiapikey-icon {
		color: #13c2c2;
	}

	.aiapikey-item {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

	.aiapikey-label-inline {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

	.aiapikey-label {
		vertical-align: middle;
	}

	.aiapikey-placeholder {
		color: #8c8c8c;
		font-size: 13px;
	}
</style>
