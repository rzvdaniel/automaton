@using AntDesign
@using Automaton.Studio.Domain
@using Automaton.Studio.Services

@namespace Automaton.Studio.Components

@if (isLoading)
{
	<div style="display:inline-flex; align-items:center; gap:8px;">
		<Spin />
		<span class="step-placeholder">Loading custom steps...</span>
	</div>
}
else if (AvailableCustomSteps == null || !AvailableCustomSteps.Any())
{
	<span class="step-placeholder">No custom steps available</span>
}
else if (Multiple)
{
	<Select Mode="SelectMode.Multiple"
			Placeholder="@Placeholder"
			DataSource="AvailableCustomSteps"
			TItem="CustomStep"
			TItemValue="Guid"
			ValueProperty="s => s.Id"
			LabelProperty="s => s.DisplayName"
			@bind-Values="BoundValues"
			AllowClear="@AllowClear"
			Style="@Style">
		<ItemTemplate Context="stepContext">
			<span class="step-item">
				<Icon Type="code" class="step-icon" />
				<span class="step-label">@stepContext.DisplayName</span>
			</span>
		</ItemTemplate>
		<LabelTemplate Context="stepContext">
			<span class="step-label-inline">
				<Icon Type="code" class="step-icon" />
				<span class="step-label">@stepContext.DisplayName</span>
			</span>
		</LabelTemplate>
	</Select>
}
else
{
	<Select Mode="SelectMode.Default"
			Placeholder="@Placeholder"
			DataSource="AvailableCustomSteps"
			TItem="CustomStep"
			TItemValue="Guid?"
			ValueProperty="s => s.Id"
			LabelProperty="s => s.DisplayName"
			@bind-Value="SelectedValue"
			AllowClear="@AllowClear"
			Style="@Style">
		<ItemTemplate Context="stepContext">
			<span class="step-item">
				<Icon Type="code" class="step-icon" />
				<span class="step-label">@stepContext.DisplayName</span>
			</span>
		</ItemTemplate>
		<LabelTemplate Context="stepContext">
			<span class="step-label-inline">
				<Icon Type="code" class="step-icon" />
				<span class="step-label">@stepContext.DisplayName</span>
			</span>
		</LabelTemplate>
	</Select>
}

@code {
	private IEnumerable<CustomStep> AvailableCustomSteps { get; set; } = new List<CustomStep>();

	private Guid? _selectedValue;

	// Internal mutable copy used for binding
	private List<Guid> _boundValues = new();

	private IEnumerable<Guid> BoundValues
	{
		get => _boundValues;
		set
		{
			var newList = (value ?? Enumerable.Empty<Guid>()).ToList();
			if (!_boundValues.SequenceEqual(newList))
			{
				_boundValues = newList;
				// notify parent
				_ = SelectedValuesChanged.InvokeAsync(_boundValues);
			}
		}
	}

	[Inject] private Automaton.Studio.Services.CustomStepsService CustomStepsService { get; set; }

	/// <summary>
	/// Optional external data source for custom steps. If provided, the component will use this instead of loading from service.
	/// </summary>
	[Parameter]
	public IEnumerable<CustomStep>? CustomSteps { get; set; }

	[Parameter] 
	public bool Multiple { get; set; } = false;

	[Parameter]
	public Guid? SelectedValue
	{
		get => _selectedValue;
		set
		{
			if (!EqualityComparer<Guid?>.Default.Equals(_selectedValue, value))
			{
				_selectedValue = value;
				_ = SelectedValueChanged.InvokeAsync(value);
			}
		}
	}

	[Parameter]
	public EventCallback<Guid?> SelectedValueChanged { get; set; }

	// Multiple-selection API for parent
	[Parameter] public IEnumerable<Guid>? SelectedValues { get; set; }
	[Parameter] public EventCallback<IEnumerable<Guid>> SelectedValuesChanged { get; set; }

	[Parameter] public string Placeholder { get; set; } = "Select custom steps...";
	[Parameter] public string Style { get; set; } = "width:200px";
	[Parameter] public bool AllowClear { get; set; } = true;

	private bool isLoading = false;

	protected override void OnParametersSet()
	{
		// sync incoming values into internal copy
		var incoming = SelectedValues?.ToList() ?? new List<Guid>();
		if (!_boundValues.SequenceEqual(incoming))
		{
			_boundValues = incoming;
		}
	}

	protected override async Task OnInitializedAsync()
	{
		await LoadCustomStepsAsync();
	}

	public async Task LoadCustomStepsAsync()
	{
		// If external data source provided, use it instead of loading from service
		if (CustomSteps != null)
		{
			AvailableCustomSteps = CustomSteps;
			return;
		}

		try
		{
			isLoading = true;
			StateHasChanged();

			var list = await CustomStepsService.List();
			AvailableCustomSteps = list ?? new List<CustomStep>();
		}
		catch
		{
			AvailableCustomSteps = new List<CustomStep>();
		}
		finally
		{
			isLoading = false;
			await InvokeAsync(StateHasChanged);
		}
	}
}

<style>
	.step-icon {
		color: #722ed1;
	}

	.step-item {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

	.step-label-inline {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

	.step-label {
		vertical-align: middle;
	}

	.step-placeholder {
		color: #8c8c8c;
		font-size: 13px;
	}
</style>
