@using Automaton.Studio.Components.AiChat.ToolResults
@using Automaton.Studio.Components.AiChat.ToolResults.Processors
@using System.Net

@if (!string.IsNullOrEmpty(Result.Summary))
{
    <div class="expandable-section">
        <button class="expand-trigger" @onclick="ToggleExecutionResult">
            <span class="trigger-icon @(showExecutionResult ? "expanded" : "")">›</span>
            <span class="trigger-label">Execution Output</span>
        </button>
        
        @if (showExecutionResult)
        {
            <div class="expand-content">
                <div class="output-block">
                    @((MarkupString)FormatSummaryForDisplay(Result.Summary))
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] 
    public ToolResultViewModel Result { get; set; } = default!;
    
    private bool showExecutionResult = false;

    private void ToggleExecutionResult()
    {
        showExecutionResult = !showExecutionResult;
    }

    private string FormatSummaryForDisplay(string summary)
    {
        return summary
            .Replace("**", "<strong>", StringComparison.Ordinal)
            .Replace("**", "</strong>", StringComparison.Ordinal)
            .Replace("`", "<code>", StringComparison.Ordinal)
            .Replace("`", "</code>", StringComparison.Ordinal)
            .Replace("\n", "<br>", StringComparison.Ordinal);
    }
}

<style>
    .expandable-section {
        margin-top: 6px;
    }

    .expand-trigger {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 8px;
        background: transparent;
        border: none;
        color: #64748b;
        font-size: 12px;
        cursor: pointer;
        border-radius: 4px;
        transition: all 0.15s ease;
    }

    .expand-trigger:hover {
        background: #e2e8f0;
        color: #475569;
    }

    .trigger-icon {
        font-size: 14px;
        font-weight: 600;
        transition: transform 0.2s ease;
        display: inline-block;
    }

    .trigger-icon.expanded {
        transform: rotate(90deg);
    }

    .trigger-label {
        font-weight: 500;
    }

    .expand-content {
        margin-top: 8px;
        animation: slideDown 0.15s ease-out;
    }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-4px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .output-block {
        background: #1e293b;
        color: #e2e8f0;
        padding: 12px 14px;
        border-radius: 6px;
        font-family: 'SF Mono', Consolas, 'Liberation Mono', monospace;
        font-size: 12px;
        line-height: 1.5;
        white-space: pre-wrap;
        word-wrap: break-word;
        overflow-x: auto;
    }

    .output-block ::deep strong {
        color: #93c5fd;
        font-weight: 500;
    }

    .output-block ::deep code {
        color: #fbbf24;
    }
</style>