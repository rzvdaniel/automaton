@using Automaton.Studio.Components.AiChat.ToolResults
@using Automaton.Studio.Components.AiChat.ToolResults.Processors
@using System.Net

<style>
    .execution-result-btn, .raw-result-btn {
        background: none;
        border: none;
        color: #6c757d;
        font-size: 0.875rem;
        padding: 0.25rem 0.5rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        margin-top: 0.5rem;
        text-decoration: none;
    }

    .execution-result-btn:hover, .raw-result-btn:hover {
        color: #495057;
        background-color: #f8f9fa;
        border-radius: 0.25rem;
    }

    .execution-result-btn .execution-icon, .raw-result-btn .raw-icon {
        font-size: 0.875rem;
    }

    .execution-result-collapsible, .raw-result-collapsible {
        margin-top: 0.5rem;
        border: 1px solid #dee2e6;
        border-radius: 0.375rem;
        overflow: hidden;
    }

    .execution-result-content, .raw-result-content {
        /* No background or padding */
    }

    .execution-result-content .execution-result, .raw-result-content .raw-result {
        margin: 0;
        background-color: white;
        border: 1px solid #dee2e6;
        border-radius: 0.25rem;
        padding: 0.75rem;
        font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
        font-size: 0.875rem;
        line-height: 1.4;
        white-space: pre-wrap;
        word-wrap: break-word;
    }
</style>

@if (!string.IsNullOrEmpty(Result.Summary))
{
    <button class="execution-result-btn" @onclick="ToggleExecutionResult" title="View Execution Result">
        <span class="execution-icon">⚡</span> Execution Result
    </button>
    
    @if (showExecutionResult)
    {
        <div class="execution-result-collapsible">
            <div class="execution-result-content">
                <div class="execution-result">@((MarkupString)FormatSummaryForDisplay(Result.Summary))</div>
            </div>
        </div>
    }
}

@code {
    [Parameter, EditorRequired] 
    public ToolResultViewModel Result { get; set; } = default!;
    
    private bool showExecutionResult = false;
    private bool showRawResult = false;

    private void ToggleExecutionResult()
    {
        showExecutionResult = !showExecutionResult;
    }

    private void ToggleRawResult()
    {
        showRawResult = !showRawResult;
    }

    private string FormatSummaryForDisplay(string summary)
    {
        return summary
            .Replace("**", "<strong>", StringComparison.Ordinal)
            .Replace("**", "</strong>", StringComparison.Ordinal)
            .Replace("`", "<code>", StringComparison.Ordinal)
            .Replace("`", "</code>", StringComparison.Ordinal)
            .Replace("\n", "<br>", StringComparison.Ordinal);
    }
}