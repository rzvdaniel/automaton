@using AntDesign
@using System.Globalization

<div class="tool-header @GetStatusClass()">
    <span class="header-icon" role="img" aria-label="@GetStatusAria(Status)">
        <Icon Type="@GetIconType(Status)" Theme="IconThemeType.Outline" />
    </span>
    <span class="header-text">@Title</span>
    @if (ShowTimestamp && Timestamp.HasValue)
    {
        <span class="header-time">@Timestamp.Value.ToString("HH:mm")</span>
    }
</div>

@code {
    [Parameter]
    public string StatusText { get; set; } = "Unknown";

    [Parameter]
    public string Status { get; set; } = "unknown";

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public DateTime? Timestamp { get; set; }

    [Parameter]
    public bool ShowTimestamp { get; set; } = true;

    private string GetStatusClass()
    {
        return Status?.ToLowerInvariant() switch
        {
            "executing" => "status-executing",
            "success" => "status-success",
            "error" or "failed" => "status-error",
            _ => "status-default"
        };
    }

    private string GetIconType(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "executing" => "loading",
            "success" => "check",
            "error" or "failed" => "close",
            _ => "setting"
        };
    }

    private string GetStatusAria(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "executing" => "Running",
            "success" => "Success",
            "error" or "failed" => "Error",
            _ => "Status"
        };
    }
}

<style>
    .tool-header {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 4px 0;
        font-size: 13px;
        font-weight: 500;
    }

    .header-icon {
        width: 20px;
        height: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .header-text {
        flex: 1;
        color: #475569;
    }

    .header-time {
        font-size: 11px;
        color: #94a3b8;
        font-family: monospace;
    }
</style>