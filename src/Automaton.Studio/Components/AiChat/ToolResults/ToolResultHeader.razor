@using System.Globalization

<div class="tool-chip @GetStatusClass()">
    <span class="chip-icon">@StatusIcon</span>
    <span class="chip-text">@Title</span>
    @if (ShowTimestamp && Timestamp.HasValue)
    {
        <span class="chip-time">@Timestamp.Value.ToString("HH:mm:ss")</span>
    }
</div>

@code {
    [Parameter] 
    public string StatusIcon { get; set; } = "🔧";
    
    [Parameter] 
    public string StatusText { get; set; } = "Unknown";
    
    [Parameter] 
    public string Status { get; set; } = "unknown";
    
    [Parameter] 
    public string? Title { get; set; }
    
    [Parameter] 
    public DateTime? Timestamp { get; set; }
    
    [Parameter] 
    public bool ShowTimestamp { get; set; } = true;
    
    private string GetStatusClass()
    {
        return Status?.ToLowerInvariant() switch
        {
            "executing" => "chip-executing",
            "success" => "chip-success",
            "error" or "failed" => "chip-error",
            _ => "chip-default"
        };
    }
}

<style>
    .tool-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        border-radius: 16px;
        font-size: 12px;
        font-weight: 500;
        transition: all 0.15s ease;
    }

    .chip-icon {
        font-size: 11px;
    }

    .chip-text {
        color: inherit;
    }

    .chip-time {
        font-size: 10px;
        opacity: 0.7;
        font-family: 'SF Mono', Consolas, monospace;
    }

    .chip-executing {
        background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
        color: #92400e;
    }

    .chip-success {
        background: linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%);
        color: #065f46;
    }

    .chip-error {
        background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
        color: #991b1b;
    }

    .chip-default {
        background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
        color: #475569;
    }
</style>