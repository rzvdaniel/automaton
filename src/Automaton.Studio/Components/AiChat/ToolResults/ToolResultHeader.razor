@using System.Globalization

<div class="tool-header @GetStatusClass()">
    <span class="header-icon">@StatusIcon</span>
    <span class="header-text">@Title</span>
    @if (ShowTimestamp && Timestamp.HasValue)
    {
        <span class="header-time">@Timestamp.Value.ToString("HH:mm")</span>
    }
</div>

@code {
    [Parameter] 
    public string StatusIcon { get; set; } = "•";
    
    [Parameter] 
    public string StatusText { get; set; } = "Unknown";
    
    [Parameter] 
    public string Status { get; set; } = "unknown";
    
    [Parameter] 
    public string? Title { get; set; }
    
    [Parameter] 
    public DateTime? Timestamp { get; set; }
    
    [Parameter] 
    public bool ShowTimestamp { get; set; } = true;
    
    private string GetStatusClass()
    {
        return Status?.ToLowerInvariant() switch
        {
            "executing" => "status-executing",
            "success" => "status-success",
            "error" or "failed" => "status-error",
            _ => "status-default"
        };
    }
}

<style>
    .tool-header {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 4px 0;
        font-size: 13px;
        font-weight: 500;
    }

    .header-icon {
        font-size: 12px;
        width: 18px;
        height: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
    }

    .status-executing .header-icon {
        background: #fef3c7;
        color: #d97706;
    }

    .status-success .header-icon {
        background: #d1fae5;
        color: #059669;
    }

    .status-error .header-icon {
        background: #fee2e2;
        color: #dc2626;
    }

    .status-default .header-icon {
        background: #e2e8f0;
        color: #64748b;
    }

    .header-text {
        flex: 1;
        color: #475569;
    }

    .header-time {
        font-size: 11px;
        color: #94a3b8;
        font-family: 'SF Mono', Consolas, monospace;
    }
</style>