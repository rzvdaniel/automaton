@using Automaton.Studio.Components.AiChat.ToolResults
@using Automaton.Studio.Components.AiChat.ToolResults.Processors
@using System.Net

<style>
    .view-code-btn, .raw-result-btn {
        background: none;
        border: none;
        color: #6c757d;
        font-size: 0.875rem;
        padding: 0.25rem 0.5rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        margin-top: 0.5rem;
        text-decoration: none;
    }

    .view-code-btn:hover, .raw-result-btn:hover {
        color: #495057;
        background-color: #f8f9fa;
        border-radius: 0.25rem;
    }

    .view-code-btn .code-icon, .raw-result-btn .raw-icon {
        font-size: 0.875rem;
    }

    .code-collapsible, .raw-result-collapsible {
        margin-top: 0.5rem;
        border: 1px solid #dee2e6;
        border-radius: 0.375rem;
        overflow: hidden;
    }

    .code-content, .raw-result-content {
        /* No background or padding */
    }

    .code-content .code-result, .raw-result-content .raw-result {
        margin: 0;
        background-color: white;
        border: 1px solid #dee2e6;
        border-radius: 0.25rem;
        padding: 0.75rem;
        font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
        font-size: 0.875rem;
        line-height: 1.4;
        white-space: pre-wrap;
        word-wrap: break-word;
    }
</style>

<div class="tool-result-container">
    <button class="view-code-btn" @onclick="ToggleCodeView" title="View Code">
        <span class="code-icon">📄</span> View Code (@(Result.LineCount ?? 0) lines)
    </button>
    
    @if (showCode)
    {
        <div class="code-collapsible">
            <div class="code-content">
                <pre class="code-result"><code class="language-@(Result.Language?.ToLowerInvariant() ?? "python")">@Result.CodeContent</code></pre>
            </div>
        </div>
    }
    
    @if (!string.IsNullOrEmpty(Result.RawResult))
    {
        <button class="raw-result-btn" @onclick="ToggleRawResult" title="View Raw Result">
            <span class="raw-icon">🔍</span> Raw Result
        </button>
        
        @if (showRawResult)
        {
            <div class="raw-result-collapsible">
                <div class="raw-result-content">
                    <pre class="raw-result">@Result.RawResult</pre>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] 
    public ToolResultViewModel Result { get; set; } = default!;
    
    private bool showCode = false;
    private bool showRawResult = false;
    
    private void ToggleCodeView()
    {
        showCode = !showCode;
    }
    
    private void ToggleRawResult()
    {
        showRawResult = !showRawResult;
    }
}