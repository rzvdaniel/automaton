@using Automaton.Studio.Components.AiChat.ToolResults
@using Automaton.Studio.Components.AiChat.ToolResults.Processors
@using System.Net

@if (!string.IsNullOrEmpty(Result.Summary))
{
    <div class="expandable-section">
        <button class="expand-trigger" @onclick="ToggleVariablesResult">
            <span class="trigger-icon @(showVariablesResult ? "expanded" : "")">›</span>
            <span class="trigger-label">Variables</span>
            <span class="var-count">@GetVariableCount()</span>
        </button>
        
        @if (showVariablesResult)
        {
            <div class="expand-content">
                <div class="variables-block">
                    @((MarkupString)FormatSummaryForDisplay(Result.Summary))
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] 
    public ToolResultViewModel Result { get; set; } = default!;
    
    private bool showVariablesResult = false;

    private void ToggleVariablesResult()
    {
        showVariablesResult = !showVariablesResult;
    }

    private string GetVariableCount()
    {
        if (string.IsNullOrEmpty(Result.Summary)) return "";
        var lines = Result.Summary.Split('\n', StringSplitOptions.RemoveEmptyEntries);
        var count = lines.Count(l => l.Contains(':') || l.Contains('='));
        return count > 0 ? count.ToString() : "";
    }

    private string FormatSummaryForDisplay(string summary)
    {
        return summary
            .Replace("**", "<strong>", StringComparison.Ordinal)
            .Replace("**", "</strong>", StringComparison.Ordinal)
            .Replace("`", "<code>", StringComparison.Ordinal)
            .Replace("`", "</code>", StringComparison.Ordinal)
            .Replace("\n", "<br>", StringComparison.Ordinal);
    }
}

<style>
    .expandable-section {
        margin-top: 6px;
    }

    .expand-trigger {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 8px;
        background: transparent;
        border: none;
        color: #64748b;
        font-size: 12px;
        cursor: pointer;
        border-radius: 4px;
        transition: all 0.15s ease;
    }

    .expand-trigger:hover {
        background: #e2e8f0;
        color: #475569;
    }

    .trigger-icon {
        font-size: 14px;
        font-weight: 600;
        transition: transform 0.2s ease;
        display: inline-block;
    }

    .trigger-icon.expanded {
        transform: rotate(90deg);
    }

    .trigger-label {
        font-weight: 500;
    }

    .var-count {
        background: #e2e8f0;
        color: #475569;
        padding: 1px 6px;
        border-radius: 10px;
        font-size: 10px;
        font-weight: 600;
    }

    .expand-content {
        margin-top: 8px;
        animation: slideDown 0.15s ease-out;
    }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-4px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .variables-block {
        background: #e2e8f0;
        padding: 12px 14px;
        border-radius: 6px;
        font-family: 'SF Mono', Consolas, monospace;
        font-size: 12px;
        line-height: 1.6;
        white-space: pre-wrap;
        word-wrap: break-word;
    }

    .variables-block ::deep strong {
        color: #334155;
        font-weight: 600;
    }

    .variables-block ::deep code {
        background: #cbd5e1;
        color: #334155;
        padding: 1px 4px;
        border-radius: 3px;
    }
</style>