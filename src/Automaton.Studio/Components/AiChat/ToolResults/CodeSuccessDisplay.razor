@using Automaton.Studio.Components.AiChat.ToolResults.Processors
@using Automaton.Studio.Components.AiChat.ToolResults.Utilities
@using System.Net

<div class="code-result-card">
    <div class="card-content">
        @((MarkupString)FormatContentForDisplay())
    </div>
    
    @if (!string.IsNullOrEmpty(CodeId) && OnApplyCode.HasDelegate)
    {
        <div class="card-actions">
            <button class="action-btn primary" @onclick="HandleApplyCode" disabled="@IsApplyDisabled">
                <span class="btn-icon">?</span>
                Apply Changes
            </button>
        </div>
    }
</div>

@code {
    [Parameter] 
    public string? FullResponse { get; set; }
    
    [Parameter] 
    public string? Language { get; set; }
    
    [Parameter] 
    public string? CodeId { get; set; }
    
    [Parameter] 
    public bool IsApplyDisabled { get; set; } = false;
    
    [Parameter] 
    public EventCallback<string> OnApplyCode { get; set; }
    
    private async Task HandleApplyCode()
    {
        if (!string.IsNullOrEmpty(CodeId) && OnApplyCode.HasDelegate)
        {
            await OnApplyCode.InvokeAsync(CodeId);
        }
    }
    
    private string FormatContentForDisplay()
    {
        if (string.IsNullOrEmpty(FullResponse))
            return string.Empty;
            
        return CodeExtractionUtility.FormatResponseForDisplay(FullResponse, Language ?? "python");
    }
}

<style>
    .code-result-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
    }

    .card-content {
        padding: 14px 16px;
        color: #374151;
        font-size: 13px;
        line-height: 1.6;
    }

    .card-content ::deep strong {
        font-weight: 600;
        color: #111827;
    }

    .card-content ::deep ul,
    .card-content ::deep ol {
        margin: 8px 0;
        padding-left: 18px;
    }

    .card-content ::deep li {
        margin: 4px 0;
    }

    .card-content ::deep code {
        background: #f3f4f6;
        padding: 2px 5px;
        border-radius: 4px;
        font-size: 0.9em;
        font-family: 'SF Mono', Consolas, monospace;
    }

    .card-actions {
        padding: 10px 16px;
        background: #f9fafb;
        border-top: 1px solid #e5e7eb;
        display: flex;
        justify-content: flex-end;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.15s ease;
        border: none;
    }

    .action-btn.primary {
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        color: white;
    }

    .action-btn.primary:hover:not(:disabled) {
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
        transform: translateY(-1px);
        box-shadow: 0 2px 8px rgba(37, 99, 235, 0.3);
    }

    .action-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        transform: none;
    }

    .btn-icon {
        font-size: 11px;
    }
</style>