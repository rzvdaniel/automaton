@using Automaton.Studio.Components.AiChat.ToolResults.Processors
@using Automaton.Studio.Components.AiChat.ToolResults.Utilities
@using System.Net

<div class="code-result-content">
    <div class="content-body">
        @((MarkupString)FormatContentForDisplay())
    </div>
    
    @if (!string.IsNullOrEmpty(CodeId) && OnApplyCode.HasDelegate)
    {
        <div class="content-actions">
            <button class="action-btn primary" @onclick="HandleApplyCode" disabled="@IsApplyDisabled">
                <span class="btn-icon">?</span>
                Apply Changes
            </button>
        </div>
    }
</div>

@code {
    [Parameter] 
    public string? FullResponse { get; set; }
    
    [Parameter] 
    public string? Language { get; set; }
    
    [Parameter] 
    public string? CodeId { get; set; }
    
    [Parameter] 
    public bool IsApplyDisabled { get; set; } = false;
    
    [Parameter] 
    public EventCallback<string> OnApplyCode { get; set; }
    
    private async Task HandleApplyCode()
    {
        if (!string.IsNullOrEmpty(CodeId) && OnApplyCode.HasDelegate)
        {
            await OnApplyCode.InvokeAsync(CodeId);
        }
    }
    
    private string FormatContentForDisplay()
    {
        if (string.IsNullOrEmpty(FullResponse))
            return string.Empty;
            
        return CodeExtractionUtility.FormatResponseForDisplay(FullResponse, Language ?? "python");
    }
}

<style>
    .code-result-content {
        width: 100%;
    }

    .content-body {
        color: #475569;
        font-size: 13px;
        line-height: 1.6;
    }

    .content-body ::deep strong {
        font-weight: 600;
        color: #334155;
    }

    .content-body ::deep ul,
    .content-body ::deep ol {
        margin: 8px 0;
        padding-left: 18px;
    }

    .content-body ::deep li {
        margin: 4px 0;
    }

    .content-body ::deep code {
        background: #e2e8f0;
        padding: 2px 5px;
        border-radius: 4px;
        font-size: 0.9em;
        font-family: 'SF Mono', Consolas, monospace;
    }

    .content-actions {
        padding-top: 10px;
        margin-top: 10px;
        border-top: 1px solid #e2e8f0;
        display: flex;
        justify-content: flex-start;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.15s ease;
        border: none;
    }

    .action-btn.primary {
        background: #475569;
        color: white;
    }

    .action-btn.primary:hover:not(:disabled) {
        background: #334155;
    }

    .action-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .btn-icon {
        font-size: 11px;
    }
</style>