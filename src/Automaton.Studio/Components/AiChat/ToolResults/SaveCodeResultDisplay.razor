@using Automaton.Studio.Components.AiChat.ToolResults
@using Automaton.Studio.Components.AiChat.ToolResults.Processors

@if (!string.IsNullOrEmpty(Result.Summary))
{
    <div class="result-summary">
        @((MarkupString)FormatSummaryForDisplay(Result.Summary))
    </div>
}

@code {
    [Parameter, EditorRequired] 
    public ToolResultViewModel Result { get; set; } = default!;

    private string FormatSummaryForDisplay(string summary)
    {
        return summary
            .Replace("**", "<strong>", StringComparison.Ordinal)
            .Replace("**", "</strong>", StringComparison.Ordinal)
            .Replace("`", "<code>", StringComparison.Ordinal)
            .Replace("`", "</code>", StringComparison.Ordinal)
            .Replace("\n", "<br>", StringComparison.Ordinal);
    }
}

<style>
    .result-summary {
        padding: 6px 0;
        font-size: 13px;
        line-height: 1.5;
        color: #475569;
    }

    .result-summary ::deep strong {
        font-weight: 600;
        color: #334155;
    }

    .result-summary ::deep code {
        background: #e2e8f0;
        padding: 2px 5px;
        border-radius: 3px;
        font-size: 0.9em;
        font-family: 'SF Mono', Consolas, monospace;
        color: #475569;
    }
</style>