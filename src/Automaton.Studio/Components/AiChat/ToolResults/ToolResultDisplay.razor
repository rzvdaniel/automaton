@using Automaton.Studio.Components.AiChat.ToolResults
@using Automaton.Studio.Components.AiChat.ToolResults.Processors
@using AntDesign
@using System.Net

<div class="tool-result-content">
    <ToolResultHeader Status="@Status"
                      Title="@Result.Description"
                      Timestamp="@Timestamp"
                      ShowTimestamp="@ShowTimestamp" />

    <div class="result-body">
        @switch (Result.ResultType)
        {            
            case ToolResultType.Execution:
                <ExecutionResultDisplay Result="Result" />
                break;
                
            case ToolResultType.Variables:
                <VariablesResultDisplay Result="Result" />
                break;
                
            case ToolResultType.SaveCode:
                <SaveCodeResultDisplay Result="Result" />
                break;
                
            case ToolResultType.Generic:
            default:
                @if (!string.IsNullOrEmpty(Result.ErrorMessage))
                {
                    <div class="error-block">
                        <span class="error-icon" role="img" aria-label="Error"><Icon Type="close" Theme="IconThemeType.Outline" /></span>
                        <span class="error-text">@Result.ErrorMessage</span>
                    </div>
                }
                else
                {
                    <GenericResultDisplay Result="Result" />
                }
                break;
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] 
    public ToolResultViewModel Result { get; set; } = default!;
    
    [Parameter] 
    public string Status { get; set; } = "unknown";
    
    [Parameter] 
    public DateTime? Timestamp { get; set; }
    
    [Parameter] 
    public bool ShowTimestamp { get; set; } = true;
}

<style>
    .tool-result-content {
        width: 100%;
    }

    .result-body {
        margin-top: 4px;
    }

    .error-block {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        padding: 10px 12px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 6px;
        margin-top: 8px;
    }

    .error-icon {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #dc2626;
    }

    .error-text {
        color: #991b1b;
        font-size: 13px;
        line-height: 1.4;
    }
</style>