@using Automaton.Studio.Components.AiChat.MessageComponents
@using Automaton.Studio.Components.AiChat.ToolResults.Processors
@using MessageType = Automaton.Studio.Components.AiChat.ToolResults.Processors.MessageType

<div class="chat-message @GetMessageAlignment()">
    @if (IsUserMessage)
    {
        <!-- User message: Right-aligned bubble -->
        <div class="message-bubble user-bubble">
            <div class="bubble-content">
                @Message.Content
            </div>
            <div class="bubble-timestamp">@Message.Time.ToString("HH:mm")</div>
        </div>
    }
    else
    {
        <!-- AI message: Left-aligned bubble -->
        <div class="message-bubble ai-bubble">
            @switch (Message.Type)
            {
                case MessageType.Generating:
                    <GeneratingMessageComponent Content="@Message.Content" />
                    break;

                case MessageType.ToolExecution:
                    <ToolExecutionMessageComponent 
                        Description="@Message.Content"
                        Status="@(Message.ToolStatus ?? "unknown")"
                        ResultViewModel="@Message.ToolResultViewModel"
                        ErrorMessage="@Message.ToolError"
                        Timestamp="@Message.Time" />
                    break;

                case MessageType.CodeSuccess:
                    <CodeSuccessMessageComponent 
                        GeneratedCode="@Message.GeneratedCode"
                        Language="@Language"
                        CodeId="@Message.CodeId"
                        IsApplyDisabled="@IsGeneratingCode"
                        OnApplyCode="@OnApplyCode" />
                    break;

                case MessageType.CodeError:
                    <CodeErrorMessageComponent ErrorMessage="@Message.Content" />
                    break;

                case MessageType.System:
                    <SystemMessageComponent Content="@Message.Content" />
                    break;

                case MessageType.Reasoning:
                    <ReasoningMessageComponent 
                        Content="@Message.Content" 
                        Timestamp="@Message.Time"
                        InitiallyCollapsed="false" />
                    break;

                case MessageType.Text:
                default:
                    <TextMessageComponent Content="@Message.Content" Timestamp="@Message.Time" />
                    break;
            }
        </div>
    }
    
    @if (ShowThinkingDots)
    {
        <div class="thinking-indicator">
            <span></span>
            <span></span>
            <span></span>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public ChatMessage Message { get; set; } = default!;

    [Parameter, EditorRequired]
    public string Language { get; set; } = string.Empty;

    [Parameter]
    public bool IsLast { get; set; }

    [Parameter]
    public bool IsGeneratingCode { get; set; }

    [Parameter]
    public EventCallback<string> OnApplyCode { get; set; }

    private bool IsUserMessage => Message.Role?.Equals("user", StringComparison.OrdinalIgnoreCase) == true;

    private bool ShowThinkingDots
    {
        get
        {
            var hasOwnIndicator = Message.Type == MessageType.Generating || Message.ToolStatus == "executing";
            return !hasOwnIndicator && IsGeneratingCode && IsLast && !IsUserMessage;
        }
    }

    private string GetMessageAlignment()
    {
        return IsUserMessage ? "align-right" : "align-left";
    }
}

<style>
    .chat-message {
        display: flex;
        flex-direction: column;
        margin: 6px 0;
    }

    .chat-message.align-right {
        align-items: flex-end;
    }

    .chat-message.align-left {
        align-items: flex-start;
    }

    /* Common bubble styles */
    .message-bubble {
        max-width: 85%;
        padding: 10px 14px;
        border-radius: 16px;
        font-size: 14px;
        line-height: 1.5;
    }

    /* User bubble - right aligned */
    .user-bubble {
        background: #e0e7ef;
        color: #1e293b;
        border-bottom-right-radius: 4px;
    }

    .user-bubble .bubble-timestamp {
        text-align: right;
        font-size: 11px;
        color: #64748b;
        margin-top: 4px;
    }

    /* AI bubble - left aligned */
    .ai-bubble {
        background: #f1f5f9;
        color: #334155;
        border-bottom-left-radius: 4px;
    }

    .bubble-content {
        word-wrap: break-word;
        overflow-wrap: break-word;
    }

    /* Thinking indicator */
    .thinking-indicator {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 8px 14px;
        background: #f1f5f9;
        border-radius: 16px;
        border-bottom-left-radius: 4px;
        margin-top: 6px;
    }

    .thinking-indicator span {
        width: 6px;
        height: 6px;
        background: #94a3b8;
        border-radius: 50%;
        animation: pulse-dot 1.4s infinite ease-in-out both;
    }

    .thinking-indicator span:nth-child(1) {
        animation-delay: -0.32s;
    }

    .thinking-indicator span:nth-child(2) {
        animation-delay: -0.16s;
    }

    @@keyframes pulse-dot {
        0%, 80%, 100% {
            opacity: 0.4;
            transform: scale(0.8);
        }
        40% {
            opacity: 1;
            transform: scale(1);
        }
    }
</style>
