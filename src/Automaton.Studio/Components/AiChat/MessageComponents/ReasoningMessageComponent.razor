@using Automaton.Studio.Services

<div class="reasoning-card">
    <div class="reasoning-header" @onclick="ToggleCollapsed">
        <span class="reasoning-icon">💭</span>
        <span class="reasoning-title">AI Activity</span>
        @if (!string.IsNullOrEmpty(Summary))
        {
            <span class="reasoning-preview">@Summary</span>
        }
        <span class="toggle-icon @(IsCollapsed ? "" : "expanded")">›</span>
    </div>
    
    @if (!IsCollapsed)
    {
        <div class="reasoning-body markdown-content">
            @((MarkupString)FormattingService.FormatReasoningTextWithCode(Content))
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Content { get; set; } = string.Empty;
    
    [Parameter]
    public bool InitiallyCollapsed { get; set; } = false;
    
    [Parameter]
    public EventCallback<bool> OnCollapsedChanged { get; set; }

    [Inject]
    private IAiMessageFormattingService FormattingService { get; set; } = default!;

    private const int MaxSummaryLength = 50;
    
    private bool IsCollapsed { get; set; }
    
    private string Summary 
    { 
        get 
        {
            if (string.IsNullOrWhiteSpace(Content)) return string.Empty;
            
            var firstLine = Content.Split('\n').FirstOrDefault()?.Trim() ?? "";
            if (firstLine.Length > MaxSummaryLength)
            {
                return firstLine.Substring(0, MaxSummaryLength - 3) + "...";
            }
            return firstLine;
        } 
    }

    protected override void OnInitialized()
    {
        IsCollapsed = InitiallyCollapsed;
    }

    private async Task ToggleCollapsed()
    {
        IsCollapsed = !IsCollapsed;
        if (OnCollapsedChanged.HasDelegate)
        {
            await OnCollapsedChanged.InvokeAsync(IsCollapsed);
        }
    }
}

<style>
    .reasoning-card {
        background: #ffffff;
        border: 1px solid #dbeafe;
        border-radius: 8px;
        overflow: hidden;
        margin: 4px 0;
    }

    .reasoning-header {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
        background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
        cursor: pointer;
        transition: background 0.15s ease;
    }

    .reasoning-header:hover {
        background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
    }

    .reasoning-icon {
        font-size: 14px;
    }

    .reasoning-title {
        font-weight: 600;
        font-size: 13px;
        color: #1e40af;
    }

    .reasoning-preview {
        flex: 1;
        font-size: 12px;
        color: #64748b;
        font-style: italic;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .toggle-icon {
        font-size: 14px;
        font-weight: 600;
        color: #3b82f6;
        transition: transform 0.2s ease;
    }

    .toggle-icon.expanded {
        transform: rotate(90deg);
    }

    .reasoning-body {
        padding: 14px;
        font-size: 13px;
        line-height: 1.6;
        color: #374151;
        border-top: 1px solid #e0f2fe;
        background: #fafbff;
    }

    /* Markdown styles for reasoning content */
    .reasoning-body.markdown-content ::deep h2 {
        margin: 12px 0 8px 0;
        font-weight: 600;
        color: #1e40af;
        font-size: 1.1em;
    }

    .reasoning-body.markdown-content ::deep p {
        margin: 0 0 8px 0;
    }

    .reasoning-body.markdown-content ::deep ul,
    .reasoning-body.markdown-content ::deep ol {
        margin: 8px 0;
        padding-left: 18px;
    }

    .reasoning-body.markdown-content ::deep li {
        margin: 3px 0;
    }

    .reasoning-body.markdown-content ::deep strong {
        font-weight: 600;
        color: #1e3a8a;
    }

    .reasoning-body.markdown-content ::deep code {
        background: #e0f2fe;
        padding: 2px 5px;
        border-radius: 4px;
        font-family: 'SF Mono', Consolas, monospace;
        font-size: 0.9em;
        color: #0369a1;
    }

    .reasoning-body.markdown-content ::deep pre {
        background: #1e293b;
        color: #e2e8f0;
        border-radius: 6px;
        padding: 12px;
        margin: 10px 0;
        overflow-x: auto;
    }

    .reasoning-body.markdown-content ::deep pre code {
        background: transparent;
        padding: 0;
        color: inherit;
    }
</style>
