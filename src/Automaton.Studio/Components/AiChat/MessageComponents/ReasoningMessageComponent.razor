@using Automaton.Studio.Services

<div class="reasoning-message">
    <div class="reasoning-header" @onclick="ToggleCollapsed">
        <span class="reasoning-icon">@(IsCollapsed ? "▶" : "▼")</span>
        <span class="reasoning-label">💭 AI Activity</span>
        @if (!string.IsNullOrEmpty(Summary))
        {
            <span class="reasoning-summary">@Summary</span>
        }
    </div>
    
    @if (!IsCollapsed)
    {
        <div class="reasoning-content markdown-content">
            @((MarkupString)FormattingService.FormatReasoningTextWithCode(Content))
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Content { get; set; } = string.Empty;
    
    [Parameter]
    public bool InitiallyCollapsed { get; set; } = false;
    
    [Parameter]
    public EventCallback<bool> OnCollapsedChanged { get; set; }

    [Inject]
    private IAiMessageFormattingService FormattingService { get; set; } = default!;

    private const int MaxSummaryLength = 60;
    private const int SummaryTruncateLength = 57;
    
    private bool IsCollapsed { get; set; }
    
    private string Summary 
    { 
        get 
        {
            // Generate a short summary from the first line or MaxSummaryLength characters
            if (string.IsNullOrWhiteSpace(Content)) return string.Empty;
            
            var firstLine = Content.Split('\n').FirstOrDefault()?.Trim() ?? "";
            if (firstLine.Length > MaxSummaryLength)
            {
                // Use Substring for simplicity - performance is acceptable for UI display
                // The summary is only computed when rendering, not during data processing
                return firstLine.Substring(0, SummaryTruncateLength) + "...";
            }
            return firstLine;
        } 
    }

    protected override void OnInitialized()
    {
        IsCollapsed = InitiallyCollapsed;
    }

    private async Task ToggleCollapsed()
    {
        IsCollapsed = !IsCollapsed;
        if (OnCollapsedChanged.HasDelegate)
        {
            await OnCollapsedChanged.InvokeAsync(IsCollapsed);
        }
    }
}

<style>
    .reasoning-message {
        background: #f0f7ff;
        border: 1px solid #b3d9ff;
        border-radius: 6px;
        margin: 4px 0;
        overflow: hidden;
    }

    .reasoning-header {
        padding: 8px 12px;
        cursor: pointer;
        user-select: none;
        display: flex;
        align-items: center;
        gap: 8px;
        background: #e6f3ff;
        transition: background-color 0.2s;
    }

    .reasoning-header:hover {
        background: #d9edff;
    }

    .reasoning-icon {
        font-size: 10px;
        color: #0066cc;
        transition: transform 0.2s;
        display: inline-block;
        width: 12px;
    }

    .reasoning-label {
        font-weight: 600;
        font-size: 12px;
        color: #0066cc;
    }

    .reasoning-summary {
        font-size: 11px;
        color: #666;
        font-style: italic;
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .reasoning-content {
        padding: 12px;
        line-height: 1.6;
        color: #333;
        font-size: 13px;
        background: #f0f7ff;
    }

    /* Essential Markdown styles */
    .reasoning-content.markdown-content :deep(h2) {
        margin: 16px 0 8px 0;
        font-weight: 600;
        color: #1f2937;
        font-size: 1.1em;
    }

    .reasoning-content.markdown-content :deep(p) {
        margin: 0 0 8px 0;
    }

    .reasoning-content.markdown-content :deep(ul),
    .reasoning-content.markdown-content :deep(ol) {
        margin: 8px 0;
        padding-left: 20px;
    }

    .reasoning-content.markdown-content :deep(li) {
        margin: 4px 0;
    }

    .reasoning-content.markdown-content :deep(strong) {
        font-weight: 600;
    }

    .reasoning-content.markdown-content :deep(code) {
        background: #e5e7eb;
        padding: 2px 4px;
        border-radius: 3px;
        font-family: 'Consolas', monospace;
        font-size: 0.9em;
    }

    .reasoning-content.markdown-content :deep(pre) {
        background: #1e1e1e;
        color: #d4d4d4;
        border-radius: 6px;
        padding: 12px;
        margin: 12px 0;
        overflow-x: auto;
    }

    .reasoning-content.markdown-content :deep(pre code) {
        background: transparent;
        padding: 0;
    }
</style>
