@using AntDesign
@using Automaton.Studio.Components.AiChat.ToolResults

<div class="tool-message">
    @if (Status == "executing")
    {
        <div class="tool-inline">
            <div class="pulse-dot"></div>
            <span class="tool-text">@Description</span>
        </div>
    }
    else if (Status == "completed")
    {
        <div class="tool-inline">
            <span class="tool-text">@Description</span>
        </div>
        <div class="message-footer">
            <span class="timestamp">@Timestamp.ToString("HH:mm")</span>
        </div>
    }
    else if (ResultViewModel != null)
    {
        <ToolResultDisplay Result="@ResultViewModel" 
                          Status="@Status"
                          Timestamp="@Timestamp"
                          ShowTimestamp="true" />
    }
    else
    {
        <div class="tool-inline">
            <span class="tool-text">@Description</span>
            @if (Status == "error" && !string.IsNullOrEmpty(ErrorMessage))
            {
                <span class="error-hint">@ErrorMessage</span>
            }
        </div>
        <div class="message-footer">
            <span class="timestamp">@Timestamp.ToString("HH:mm")</span>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Description { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Status { get; set; } = string.Empty;

    [Parameter]
    public ToolResultViewModel? ResultViewModel { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public DateTime Timestamp { get; set; }
}

<style>
    .tool-message {
        transition: all 0.2s ease;
    }

    .tool-inline {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        padding: 4px 0;
    }

    .pulse-dot {
        width: 8px;
        height: 8px;
        background: #94a3b8;
        border-radius: 50%;
        animation: pulse 1.5s ease-in-out infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
            transform: scale(1);
        }
        50% {
            opacity: 0.5;
            transform: scale(0.8);
        }
    }

    .tool-text {
        color: #475569;
        font-weight: 500;
    }

    .error-hint {
        color: #dc2626;
        font-size: 12px;
        margin-left: 4px;
    }

    .message-footer {
        margin-top: 6px;
        display: flex;
        align-items: center;
    }

    .timestamp {
        font-size: 11px;
        color: #94a3b8;
        font-family: monospace;
    }
</style>
