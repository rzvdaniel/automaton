@using AntDesign
@using Automaton.Studio.Components.AiChat.ToolResults

<div class="tool-execution-message" data-status="@Status">
    @if (Status == "executing")
    {
        <!-- Executing state: Clean design with spinner -->
        <div class="tool-header-executing">
            <span class="tool-description">@Description</span>
            <Spin Size="SpinSize.Small" Style="margin-left: auto;" />
        </div>
    }
    else if (Status == "completed")
    {
        <!-- Completed state: Show checkmark to indicate operation finished -->
        <div class="tool-header-completed">
            <span class="tool-description">@Description</span>
            <Icon Type="check-circle" Style="margin-left: auto; color: #22c55e; font-size: 16px;" />
        </div>
    }
    else if (ResultViewModel != null)
    {
        <!-- Result state with detailed result data: Show full result display -->
        <ToolResultDisplay Result="@ResultViewModel" 
                          Status="@Status"
                          Timestamp="@Timestamp"
                          ShowTimestamp="true" />
    }
    else
    {
        <!-- Result state without result data: Show simple status message -->
        <div class="tool-header-simple">
            <span class="tool-description">@Description</span>
            <span class="tool-status @(Status == "success" ? "status-success" : "status-error")">
                @if (Status == "success")
                {
                    <Icon Type="check-circle" Style="color: #22c55e; font-size: 14px; margin-right: 4px;" />
                    <span>Success</span>
                }
                else if (Status == "error")
                {
                    <Icon Type="close-circle" Style="color: #dc3545; font-size: 14px; margin-right: 4px;" />
                    <span>Failed</span>
                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <span class="error-message">: @ErrorMessage</span>
                    }
                }
                else
                {
                    <span>@Status</span>
                }
            </span>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Description { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Status { get; set; } = string.Empty;

    [Parameter]
    public ToolResultViewModel? ResultViewModel { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public DateTime Timestamp { get; set; }
}

<style>
    .tool-execution-message {
        background: #ffffff;
        border: 1px solid #e1e4e8;
        border-left: 3px solid #0969da;
        border-radius: 6px;
        padding: 12px;
        margin: 4px 0;
        transition: all 0.2s ease;
    }

    .tool-execution-message[data-status="executing"] {
        background: #f6f8fa;
        border-left-color: #8b949e;
    }

    .tool-execution-message[data-status="completed"] {
        background: #f6faf8;
        border-left-color: #22c55e;
    }

    .tool-execution-message[data-status="success"] {
        border-left-color: #1a7f37;
    }

    .tool-header-executing {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: #24292f;
    }

    .tool-header-completed {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: #24292f;
    }

    .tool-description {
        flex: 1;
    }

    .tool-header-simple {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: #24292f;
    }

    .tool-status {
        display: flex;
        align-items: center;
        margin-left: auto;
    }

    .status-success {
        color: #22c55e;
    }

    .status-error {
        color: #dc3545;
    }

    .error-message {
        color: #dc3545;
    }

    .tool-error {
        margin-top: 8px;
        padding: 8px;
        background: #fff5f5;
        border-radius: 4px;
        display: flex;
        align-items: center;
        color: #dc3545;
        font-size: 13px;
    }
</style>
