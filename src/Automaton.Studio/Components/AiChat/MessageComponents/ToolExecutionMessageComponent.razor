@using AntDesign
@using Automaton.Studio.Components.AiChat.ToolResults

<div class="tool-message @GetStatusClass()">
    @if (Status == "executing")
    {
        <div class="tool-inline">
            <div class="pulse-dot"></div>
            <span class="tool-text">@Description</span>
        </div>
    }
    else if (Status == "completed")
    {
        <div class="tool-inline">
            <span class="status-icon success">?</span>
            <span class="tool-text">@Description</span>
        </div>
    }
    else if (ResultViewModel != null)
    {
        <ToolResultDisplay Result="@ResultViewModel" 
                          Status="@Status"
                          Timestamp="@Timestamp"
                          ShowTimestamp="true" />
    }
    else
    {
        <div class="tool-inline">
            @if (Status == "success")
            {
                <span class="status-icon success">?</span>
            }
            else if (Status == "error")
            {
                <span class="status-icon error">?</span>
            }
            else
            {
                <span class="status-icon default">?</span>
            }
            <span class="tool-text">@Description</span>
            @if (Status == "error" && !string.IsNullOrEmpty(ErrorMessage))
            {
                <span class="error-hint">@ErrorMessage</span>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Description { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Status { get; set; } = string.Empty;

    [Parameter]
    public ToolResultViewModel? ResultViewModel { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public DateTime Timestamp { get; set; }

    private string GetStatusClass()
    {
        return Status?.ToLowerInvariant() switch
        {
            "executing" => "status-executing",
            "completed" or "success" => "status-success",
            "error" => "status-error",
            _ => "status-default"
        };
    }
}

<style>
    .tool-message {
        margin: 6px 0;
        transition: all 0.2s ease;
    }

    .tool-inline {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        font-size: 13px;
    }

    .tool-message.status-executing .tool-inline {
        background: linear-gradient(135deg, #fefce8 0%, #fef9c3 100%);
        border-color: #fde047;
    }

    .tool-message.status-success .tool-inline {
        background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
        border-color: #86efac;
    }

    .tool-message.status-error .tool-inline {
        background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
        border-color: #fca5a5;
    }

    .pulse-dot {
        width: 8px;
        height: 8px;
        background: #eab308;
        border-radius: 50%;
        animation: pulse 1.5s ease-in-out infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
            transform: scale(1);
        }
        50% {
            opacity: 0.5;
            transform: scale(0.8);
        }
    }

    .status-icon {
        font-size: 12px;
        font-weight: 600;
        width: 18px;
        height: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
    }

    .status-icon.success {
        background: #22c55e;
        color: white;
    }

    .status-icon.error {
        background: #ef4444;
        color: white;
    }

    .status-icon.default {
        background: #94a3b8;
        color: white;
    }

    .tool-text {
        color: #374151;
        font-weight: 500;
    }

    .error-hint {
        color: #dc2626;
        font-size: 12px;
        margin-left: 4px;
    }
</style>
