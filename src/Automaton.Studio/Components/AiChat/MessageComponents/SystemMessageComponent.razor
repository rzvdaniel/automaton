@using AntDesign

<div class="system-message">
    <Icon Type="info-circle" Style="margin-right: 6px; color: #94a3b8;" />
    <span>@Content</span>
</div>

@code {
    [Parameter, EditorRequired]
    public string Content { get; set; } = string.Empty;
}

<style>
    .system-message {
        color: #64748b;
        font-style: italic;
        display: flex;
        align-items: center;
        font-size: 13px;
    }
</style>
