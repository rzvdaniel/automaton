@using AntDesign

<div class="system-message">
    <span>@Content</span>
</div>

@code {
    [Parameter, EditorRequired]
    public string Content { get; set; } = string.Empty;
}

<style>
    .system-message {
        color: #64748b;
        font-style: italic;
        font-size: 13px;
    }
</style>
