@using AntDesign

<div class="generating-indicator">
    <div class="pulse-dot"></div>
    <span class="generating-text">@Content</span>
</div>

@code {
    [Parameter, EditorRequired]
    public string Content { get; set; } = string.Empty;
}

<style>
    .generating-indicator {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: #64748b;
        font-style: italic;
    }

    .generating-text {
        color: #64748b;
    }

    .pulse-dot {
        width: 8px;
        height: 8px;
        background: #94a3b8;
        border-radius: 50%;
        animation: pulse 1.5s ease-in-out infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
            transform: scale(1);
        }
        50% {
            opacity: 0.5;
            transform: scale(0.8);
        }
    }
</style>
