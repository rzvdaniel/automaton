@using Automaton.Studio.Services

<div class="text-message markdown-content">
    @((MarkupString)FormattingService.FormatReasoningTextWithCode(Content))
</div>

@code {
    [Parameter, EditorRequired]
    public string Content { get; set; } = string.Empty;

    [Inject]
    private IAiMessageFormattingService FormattingService { get; set; } = default!;
}

<style>
    .text-message {
        line-height: 1.6;
    }

    /* Essential Markdown styles only */
    .text-message.markdown-content ::deep h2 {
        margin: 16px 0 8px 0;
        font-weight: 600;
        color: #1f2937;
        font-size: 1.2em;
        border-bottom: 1px solid #e5e7eb;
        padding-bottom: 4px;
    }

    .text-message.markdown-content ::deep h2:first-child {
        margin-top: 0;
    }

    .text-message.markdown-content ::deep p {
        margin: 0 0 8px 0;
    }

    .text-message.markdown-content ::deep ul,
    .text-message.markdown-content ::deep ol {
        margin: 8px 0;
        padding-left: 20px;
    }

    .text-message.markdown-content ::deep li {
        margin: 4px 0;
    }

    .text-message.markdown-content ::deep strong {
        font-weight: 600;
        color: #111827;
    }

    .text-message.markdown-content ::deep code {
        background: #f3f4f6;
        padding: 2px 6px;
        border-radius: 4px;
        font-family: 'Consolas', monospace;
        font-size: 0.875em;
    }

    .text-message.markdown-content ::deep pre {
        background: #1e1e1e;
        color: #d4d4d4;
        border-radius: 6px;
        padding: 12px;
        margin: 12px 0;
        overflow-x: auto;
    }

    .text-message.markdown-content ::deep pre code {
        background: transparent;
        padding: 0;
    }

    .text-message.markdown-content ::deep table {
        width: 100%;
        border-collapse: collapse;
        margin: 12px 0;
    }

    .text-message.markdown-content ::deep th,
    .text-message.markdown-content ::deep td {
        padding: 8px 12px;
        border: 1px solid #e5e7eb;
        text-align: left;
    }

    .text-message.markdown-content ::deep th {
        background: #f9fafb;
        font-weight: 600;
    }
</style>
