@using Automaton.Studio.Services

<div class="text-message markdown-content">
    @((MarkupString)FormattingService.FormatReasoningTextWithCode(Content))
</div>
<div class="message-footer">
    <span class="timestamp">@Timestamp.ToString("HH:mm")</span>
</div>

@code {
    [Parameter, EditorRequired]
    public string Content { get; set; } = string.Empty;

    [Parameter]
    public DateTime Timestamp { get; set; }

    [Inject]
    private IAiMessageFormattingService FormattingService { get; set; } = default!;
}

<style>
    .text-message {
        line-height: 1.6;
    }

    .message-footer {
        margin-top: 6px;
        display: flex;
        align-items: center;
    }

    .timestamp {
        font-size: 11px;
        color: #94a3b8;
        font-family: 'SF Mono', Consolas, monospace;
    }

    /* Essential Markdown styles only */
    .text-message.markdown-content ::deep h2 {
        margin: 12px 0 8px 0;
        font-weight: 600;
        color: #334155;
        font-size: 1.1em;
    }

    .text-message.markdown-content ::deep h2:first-child {
        margin-top: 0;
    }

    .text-message.markdown-content ::deep p {
        margin: 0 0 8px 0;
    }

    .text-message.markdown-content ::deep ul,
    .text-message.markdown-content ::deep ol {
        margin: 8px 0;
        padding-left: 20px;
    }

    .text-message.markdown-content ::deep li {
        margin: 4px 0;
    }

    .text-message.markdown-content ::deep strong {
        font-weight: 600;
        color: #1e293b;
    }

    .text-message.markdown-content ::deep code {
        background: #e2e8f0;
        padding: 2px 6px;
        border-radius: 4px;
        font-family: 'Consolas', monospace;
        font-size: 0.875em;
    }

    .text-message.markdown-content ::deep pre {
        background: #1e293b;
        color: #e2e8f0;
        border-radius: 6px;
        padding: 12px;
        margin: 12px 0;
        overflow-x: auto;
    }

    .text-message.markdown-content ::deep pre code {
        background: transparent;
        padding: 0;
    }

    .text-message.markdown-content ::deep table {
        width: 100%;
        border-collapse: collapse;
        margin: 12px 0;
    }

    .text-message.markdown-content ::deep th,
    .text-message.markdown-content ::deep td {
        padding: 8px 12px;
        border: 1px solid #e2e8f0;
        text-align: left;
    }

    .text-message.markdown-content ::deep th {
        background: #f1f5f9;
        font-weight: 600;
    }
</style>
