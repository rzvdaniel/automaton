@using AntDesign

<div class="error-message">
    <Icon Type="close-circle" Style="color: #ef4444; margin-right: 6px; flex-shrink: 0;" />
    <div class="error-content">
        <strong>Error</strong>
        <span>@ErrorMessage</span>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public string ErrorMessage { get; set; } = string.Empty;
}

<style>
    .error-message {
        background: #fef2f2;
        padding: 10px 12px;
        border-radius: 6px;
        border-left: 3px solid #ef4444;
        display: flex;
        align-items: flex-start;
        gap: 6px;
    }

    .error-content {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .error-content strong {
        color: #dc2626;
        font-size: 13px;
    }

    .error-content span {
        color: #991b1b;
        font-size: 13px;
    }
</style>
