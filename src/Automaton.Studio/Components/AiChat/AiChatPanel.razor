@using AntDesign
@using System.Collections.Generic
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@using Automaton.Studio.Models
@using Automaton.Studio.Services
@using Automaton.Studio.Shared.Components
@using Automaton.Mcp.Client
@using Automaton.Studio.Components.AiChat.ToolResults
@using Automaton.Studio.Components.AiChat.ToolResults.Processors
@using Automaton.Studio.Components.AiChat.Contexts

@implements IDisposable

<div class="ai-chat-panel">
	<!-- Session Management Toolbar -->
	<div class="session-toolbar">
		<div class="session-controls">
			@if (currentSession != null)
			{
				<Select @key="@($"{currentSessionId}_{currentSession.Title}")"
						@bind-Value="@currentSessionId"
						TItemValue="Guid"
						TItem="Guid"
						Size="@InputSize.Small"
						Style="flex: 1; max-width: 350px;"
						Placeholder="Select session"
						AllowClear="false"
						Disabled="@isGeneratingCode"
						OnSelectedItemChanged="OnSessionSelectedAsync">
					<SelectOptions>
						@foreach (var session in availableSessions.OrderByDescending(s => s.UpdatedAt))
						{
							// Show full timestamp with seconds to debug the issue
							var label = $"{session.Title} • {session.UpdatedAt:MMM dd, HH:mm:ss}";
							<SelectOption @key="session.Id"
										  TItemValue="Guid"
										  TItem="Guid"
										  Value="@session.Id"
										  Label="@label" />
						}
					</SelectOptions>
				</Select>
			}

			<Button Icon="plus"
					Size="@ButtonSize.Small"
					OnClick="CreateNewSessionAsync"
					Disabled="@isGeneratingCode"
					Title="New Session" />

			<Button Icon="history"
					Size="@ButtonSize.Small"
					OnClick="() => showSessionDrawer = true"
					Disabled="@isGeneratingCode"
					Title="View All Sessions" />
		</div>
	</div>

	<div class="ai-chat-body" @ref="messagesContainer" id="ai-chat-messages">
		<div class="messages">
			@for (int i = 0; i < messages.Count; i++)
			{
				var msg = messages[i];
				var isLast = i == messages.Count - 1;
				
				<ChatMessageComponent 
					Message="@msg" 
					Language="@Context.Language"
					IsLast="@isLast"
					IsGeneratingCode="@isGeneratingCode"
					OnApplyCode="@(async (codeId) => await ApplyCodeFromButton(codeId))" />
			}
		</div>
	</div>

	<div class="ai-chat-input">
		<div class="input-area">
			<textarea @bind="promptText"
					  @bind:event="oninput"
					  class="prompt-textarea"
					  placeholder="@Context.InputPlaceholder"
					  disabled="@isGeneratingCode"
					  rows="3"
					  @onkeydown="OnKeyDown"></textarea>
		</div>

		<div class="input-controls">
			<div class="left-controls">
				@if (Context.ShowAgentSelector)
				{
					<Select @bind-Value="selectedAgent"
							TItemValue="string"
							TItem="string"
							Size="@InputSize.Small"
							Style="width: 80px;"
							Disabled="@isGeneratingCode">
						<SelectOptions>
							<SelectOption Value="@Ask" Label="Ask" />
							<SelectOption TItemValue="string" TItem="string" Value="@Agent" Label="Agent" />
						</SelectOptions>
					</Select>
				}

				<Select @bind-Value="selectedProviderModel"
						TItemValue="string"
						TItem="string"
						Size="@InputSize.Small"
						Style="width: 180px;"
						Placeholder="Select model"
						AllowClear="false"
						Disabled="@isGeneratingCode">
					<SelectOptions>
						@if (availableProviders?.Any() != true)
						{
							<SelectOption TItemValue="string" TItem="string" Value="@("none")" Label="No providers configured" Disabled="true" />
						}
						else
						{
							@foreach (var provider in availableProviders)
							{
								@if (provider.SupportedModels?.Any() == true)
								{
									@foreach (var model in provider.SupportedModels)
									{
										var value = $"{provider.ProviderName}:{model}";
										var label = $"{model}";
										var isDisabled = !provider.HasStoredKeys && !provider.HasEnvironmentKey;

										<SelectOption TItemValue="string" TItem="string"
													  Value="@value"
													  Label="@label"
													  Disabled="@isDisabled" />
									}
								}
							}
						}
					</SelectOptions>
				</Select>
			</div>

			<div class="right-controls">
				<Button Icon="@(isGeneratingCode ? "loading" : "caret-right")"
						Type="@ButtonType.Primary"
						Size="@ButtonSize.Small"
						Shape="@ButtonShape.Circle"
						OnClick="SendPrompt"
						Disabled="@(!IsReadyToSendRealtime)"
						Loading="@isGeneratingCode"
						Style="width: 28px; height: 28px; display: flex; align-items: center; justify-content: center;">
				</Button>
			</div>
		</div>

		@if (showNoProvidersMessage)
		{
			<div class="no-providers-message">
				<Alert Type="@AlertType.Warning"
					   Message="No AI providers configured"
					   Description="Configure your API keys in Settings to start using AI code generation with MCP tools."
					   ShowIcon="true"
					   Style="margin: 8px 0 0 0;" />
			</div>
		}
	</div>

	<!-- Session History Drawer -->
	<Drawer Closable="true"
			Visible="@showSessionDrawer"
			Width="400"
			Title="@("Chat Sessions")"
			OnClose="() => showSessionDrawer = false">
		<ChildContent>
			<div class="sessions-list">
				@foreach (var session in availableSessions.OrderByDescending(s => s.UpdatedAt))
				{
					<div @key="session.Id" class="session-item @(session.Id == currentSession?.Id ? "active" : "")">
						<div class="session-info" @onclick="() => SelectAndCloseDrawerAsync(session.Id)">
							<div class="session-title">@session.Title</div>
							<div class="session-meta">
								<span class="session-date">@session.UpdatedAt.ToString("MMM dd, HH:mm")</span>
								@if (session.Provider != null && session.Model != null)
								{
									<span class="session-model">@session.Model</span>
								}
							</div>
						</div>
						<div class="session-actions">
							<Button Icon="edit"
									Size="@ButtonSize.Small"
									Type="@ButtonType.Text"
									OnClick="() => StartRenameSession(session.Id, session.Title)">
								Rename
							</Button>
							<Popconfirm Title="@("Delete this session?")"
										OnConfirm="async () => await DeleteSessionAsync(session.Id)"
										OkText="@("Delete")"
										CancelText="@("Cancel")">
								<Button Icon="delete"
										Size="@ButtonSize.Small"
										Type="@ButtonType.Text"
										Danger="true">
									Delete
								</Button>
							</Popconfirm>
						</div>
					</div>
				}

				@if (!availableSessions.Any())
				{
					<Empty>
						<DescriptionTemplate>No sessions yet</DescriptionTemplate>
					</Empty>
				}
			</div>
		</ChildContent>
	</Drawer>

	<!-- Rename Session Modal -->
	<Modal Title="@("Rename Session")"
		   Visible="@showRenameModal"
		   OnOk="SaveRenameSessionAsync"
		   OnCancel="() => showRenameModal = false"
		   OkText="@("Save")"
		   CancelText="@("Cancel")">
		<Input @bind-Value="@renameSessionTitle" Placeholder="Enter session title" />
	</Modal>
</div>

<script>
	// Simple function to set the component reference
	window.setAiChatPanelRef = function(componentRef) {
		window.aiChatPanelInstance = componentRef;
	};
</script>

<style>
	.ai-chat-panel {
		display: flex;
		flex-direction: column;
		height: 100%;
		min-height: 0;
	}

	.ai-chat-body {
		flex: 1 1 auto;
		flex: 1;
		overflow-y: auto;
		overflow-x: hidden;
		padding: 10px;
		background: #fff;
		min-height: 0;
	}

	.messages {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.ai-chat-input {
		border-top: 1px solid #e8e8e8;
		background: #ffffff;
		display: flex;
		flex-direction: column;
		flex-shrink: 0;
		position: sticky;
		bottom: 0;
		z-index: 10;
	}

	.input-area {
		background: #ffffff;
		border-bottom: 1px solid #f0f0f0;
	}

	.prompt-textarea {
		padding: 12px;
		width: 100%;
		border: none !important;
		box-shadow: none !important;
		background: transparent !important;
		resize: none !important;
		outline: none;
		font-family: inherit;
		font-size: inherit;
	}

	.input-controls {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 6px 12px;
		background: #fafafa;
		border-top: 1px solid #f0f0f0;
	}

	.left-controls {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.right-controls {
		display: flex;
		align-items: center;
	}

	.language-badge, .step-badge {
		padding: 2px 6px;
		background: #e3f2fd;
		border: 1px solid #bbdefb;
		border-radius: 12px;
		font-size: 11px;
		color: #1565c0;
	}

	.step-badge {
		background: #f0f9ff;
		border: 1px solid #93c5fd;
		color: #1e40af;
	}

	.no-providers-message {
		flex-shrink: 0;
		position: sticky;
		bottom: 0;
		background: #fafafa;
		z-index: 10;
	}

	/* VS-style send button */
	.right-controls .ant-btn-circle {
		min-width: 28px !important;
		width: 28px !important;
		height: 28px !important;
		padding: 0 !important;
		display: flex !important;
		align-items: center !important;
		justify-content: center !important;
	}

		.right-controls .ant-btn-circle .anticon {
			font-size: 12px;
		}

	/* Small select styling to match VS */
	.left-controls .ant-select-small {
		font-size: 11px;
	}

		.left-controls .ant-select-small .ant-select-selector {
			border: 1px solid #d9d9d9;
			border-radius: 4px;
			height: 24px !important;
			min-height: 24px !important;
		}

		.left-controls .ant-select-small .ant-select-selection-item {
			line-height: 22px !important;
			font-size: 11px;
		}

	/* Session Management Toolbar */
	.session-toolbar {
		display: flex;
		align-items: center;
		padding: 8px 12px;
		background: #fafafa;
		border-bottom: 1px solid #e8e8e8;
		flex-shrink: 0;
	}

	.session-controls {
		display: flex;
		align-items: center;
		gap: 8px;
		width: 100%;
	}

	/* Session List in Drawer */
	.sessions-list {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.session-item {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 12px;
		border: 1px solid #e8e8e8;
		border-radius: 4px;
		cursor: pointer;
		transition: all 0.2s;
	}

		.session-item:hover {
			background: #f5f5f5;
			border-color: #d9d9d9;
		}

		.session-item.active {
			background: #e6f7ff;
			border-color: #1890ff;
		}

	.session-info {
		flex: 1;
		min-width: 0;
	}

	.session-title {
		font-weight: 500;
		color: #262626;
		margin-bottom: 4px;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.session-meta {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 12px;
		color: #8c8c8c;
	}

	.session-date {
		font-size: 11px;
	}

	.session-model {
		padding: 2px 6px;
		background: #f0f0f0;
		border-radius: 3px;
		font-size: 10px;
	}

	.session-actions {
		display: flex;
		align-items: center;
		gap: 4px;
		opacity: 0;
		transition: opacity 0.2s;
	}

	.session-item:hover .session-actions {
		opacity: 1;
	}
</style>
