@using AntDesign
@using Automaton.Studio.Models
@using Automaton.Studio.Services

@namespace Automaton.Studio.Components

@if (isLoading)
{
	<div style="display:inline-flex; align-items:center; gap:8px;">
		<Spin />
		<span class="app-placeholder">Loading apps...</span>
	</div>
}
else if (AvailableApps == null || !AvailableApps.Any())
{
	<span class="app-placeholder">No apps available</span>
}
else if (Multiple)
{
	<Select Mode="SelectMode.Multiple"
			Placeholder="@Placeholder"
			DataSource="AvailableApps"
			TItem="AppListItem"
			TItemValue="Guid"
			ValueProperty="a => a.Id"
			LabelProperty="a => a.DisplayName"
			@bind-Values="BoundValues"
			AllowClear="@AllowClear"
			Style="@Style">
		<ItemTemplate Context="appContext">
			<span class="app-item">
				<Icon Type="@(appContext.IsPublished ? "check-circle" : "file")" class="app-icon" />
				<span class="app-label">@appContext.DisplayName</span>
			</span>
		</ItemTemplate>
		<LabelTemplate Context="appContext">
			<span class="app-label-inline">
				<Icon Type="@(appContext.IsPublished ? "check-circle" : "file")" class="app-icon" />
				<span class="app-label">@appContext.DisplayName</span>
			</span>
		</LabelTemplate>
	</Select>
}
else
{
	<Select Mode="SelectMode.Default"
			Placeholder="@Placeholder"
			DataSource="AvailableApps"
			TItem="AppListItem"
			TItemValue="Guid?"
			ValueProperty="a => a.Id"
			LabelProperty="a => a.DisplayName"
			@bind-Value="SelectedValue"
			AllowClear="@AllowClear"
			Style="@Style">
		<ItemTemplate Context="appContext">
			<span class="app-item">
				<Icon Type="@(appContext.IsPublished ? "check-circle" : "file")" class="app-icon" />
				<span class="app-label">@appContext.DisplayName</span>
			</span>
		</ItemTemplate>
		<LabelTemplate Context="appContext">
			<span class="app-label-inline">
				<Icon Type="@(appContext.IsPublished ? "check-circle" : "file")" class="app-icon" />
				<span class="app-label">@appContext.DisplayName</span>
			</span>
		</LabelTemplate>
	</Select>
}

@code {
	private IEnumerable<AppListItem> AvailableApps { get; set; } = new List<AppListItem>();

	private Guid? _selectedValue;

	// Internal mutable copy used for binding
	private List<Guid> _boundValues = new();

	private IEnumerable<Guid> BoundValues
	{
		get => _boundValues;
		set
		{
			var newList = (value ?? Enumerable.Empty<Guid>()).ToList();
			if (!_boundValues.SequenceEqual(newList))
			{
				_boundValues = newList;
				// notify parent
				_ = SelectedValuesChanged.InvokeAsync(_boundValues);
			}
		}
	}

	[Inject] private Automaton.Studio.Services.AppsService AppsService { get; set; }

	/// <summary>
	/// Optional external data source for apps. If provided, the component will use this instead of loading from service.
	/// </summary>
	[Parameter]
	public IEnumerable<AppListItem>? Apps { get; set; }

	[Parameter] 
	public bool Multiple { get; set; } = false;

	[Parameter]
	public Guid? SelectedValue
	{
		get => _selectedValue;
		set
		{
			if (!EqualityComparer<Guid?>.Default.Equals(_selectedValue, value))
			{
				_selectedValue = value;
				_ = SelectedValueChanged.InvokeAsync(value);
			}
		}
	}

	[Parameter]
	public EventCallback<Guid?> SelectedValueChanged { get; set; }

	// Multiple-selection API for parent
	[Parameter] public IEnumerable<Guid>? SelectedValues { get; set; }
	[Parameter] public EventCallback<IEnumerable<Guid>> SelectedValuesChanged { get; set; }

	[Parameter] public string Placeholder { get; set; } = "Select apps...";
	[Parameter] public string Style { get; set; } = "width:200px";
	[Parameter] public bool AllowClear { get; set; } = true;

	private bool isLoading = false;

	protected override void OnParametersSet()
	{
		// sync incoming values into internal copy
		var incoming = SelectedValues?.ToList() ?? new List<Guid>();
		if (!_boundValues.SequenceEqual(incoming))
		{
			_boundValues = incoming;
		}
	}

	protected override async Task OnInitializedAsync()
	{
		await LoadAppsAsync();
	}

	public async Task LoadAppsAsync()
	{
		// If external data source provided, use it instead of loading from service
		if (Apps != null)
		{
			AvailableApps = Apps;
			return;
		}

		try
		{
			isLoading = true;
			StateHasChanged();

			var list = await AppsService.List();
			AvailableApps = list ?? new List<AppListItem>();
		}
		catch
		{
			AvailableApps = new List<AppListItem>();
		}
		finally
		{
			isLoading = false;
			await InvokeAsync(StateHasChanged);
		}
	}
}

<style>
	.app-icon {
		color: #1890ff;
	}

	.app-item {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

	.app-label-inline {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

	.app-label {
		vertical-align: middle;
	}

	.app-placeholder {
		color: #8c8c8c;
		font-size: 13px;
	}
</style>
