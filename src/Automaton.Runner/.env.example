# Automaton Runner Docker Configuration
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED SETTINGS
# ============================================

# API Key for authentication (get from Automaton Studio -> Settings -> API Keys)
# Create a runner-scoped API key in the Studio UI
AUTOMATON_API_KEY=ak_runner_your_api_key_here

# Automaton Studio server URL
# Use your Studio server URL (e.g., https://studio.yourdomain.com)
AUTOMATON_SERVER_URL=https://api.automaton.monster

# ============================================
# OPTIONAL SETTINGS
# ============================================

# Custom runner name (defaults to docker-runner-<hostname>)
AUTOMATON_RUNNER_NAME=docker-runner-01

# Data directories (for bind mounts)
# These are used for persistent storage on the host
DATA_DIR=./data
LOGS_DIR=./logs
CONFIG_DIR=./config

# ============================================
# USAGE INSTRUCTIONS
# ============================================
#
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your values
# 3. Start the runner: docker-compose -f docker-compose.production.yml up -d
# 4. View logs: docker-compose -f docker-compose.production.yml logs -f
# 5. Stop runner: docker-compose -f docker-compose.production.yml down
#
# For Hetzner or other cloud deployments:
# - Store .env securely (don't commit to git)
# - Use Docker secrets for production API keys
# - Configure appropriate firewall rules
# - Set up monitoring and log aggregation
