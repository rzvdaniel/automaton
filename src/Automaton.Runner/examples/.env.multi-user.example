# Multi-User Automaton Runner Configuration
# Copy this to .env and fill in your API keys

# Shared Automaton Studio server URL
AUTOMATON_SERVER_URL=https://your-studio-server.com

# User 1 API Key (create in Studio: Settings → API Keys → Runner scope)
USER1_API_KEY=ak_runner_user1_key_here

# User 2 API Key
USER2_API_KEY=ak_runner_user2_key_here

# User 3 API Key
USER3_API_KEY=ak_runner_user3_key_here

# Usage:
# 1. Copy this file: cp .env.multi-user.example .env
# 2. Edit .env with your API keys
# 3. Start all runners: docker-compose -f docker-compose.multi-user.yml up -d
# 4. View logs: docker-compose -f docker-compose.multi-user.yml logs -f
# 5. Check status: docker-compose -f docker-compose.multi-user.yml ps
#
# To add more users:
# 1. Add a new service in docker-compose.multi-user.yml (copy/paste existing)
# 2. Add corresponding volumes
# 3. Add API key variable here
# 4. Restart: docker-compose -f docker-compose.multi-user.yml up -d
