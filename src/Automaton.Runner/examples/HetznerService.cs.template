using System.Net.Http.Json;
using System.Text.Json;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.Logging;

namespace Automaton.Studio.Server.Services;

/// <summary>
/// Service for managing Hetzner Cloud servers for Automaton Runners
/// This is a template/example implementation
/// </summary>
public class HetznerService
{
    private readonly HttpClient _httpClient;
    private readonly IConfiguration _configuration;
    private readonly ILogger<HetznerService> _logger;
    private readonly string _apiToken;
    private readonly string _defaultServerType;
    private readonly string _defaultLocation;

    public HetznerService(
        HttpClient httpClient,
        IConfiguration configuration,
        ILogger<HetznerService> logger)
    {
        _httpClient = httpClient;
        _configuration = configuration;
        _logger = logger;

        // Load configuration
        _apiToken = configuration["Hetzner:ApiToken"] 
            ?? throw new InvalidOperationException("Hetzner API token not configured");
        _defaultServerType = configuration["Hetzner:DefaultServerType"] ?? "cx11";
        _defaultLocation = configuration["Hetzner:DefaultLocation"] ?? "nbg1";

        // Configure HTTP client
        _httpClient.BaseAddress = new Uri("https://api.hetzner.cloud/v1/");
        _httpClient.DefaultRequestHeaders.Add("Authorization", $"Bearer {_apiToken}");
    }

    /// <summary>
    /// Creates a new Hetzner server with Automaton Runner pre-configured
    /// </summary>
    public async Task<HetznerServerResponse> CreateRunnerServerAsync(
        string runnerName,
        string apiKey,
        string serverUrl,
        string? serverType = null,
        string? location = null)
    {
        _logger.LogInformation("Creating Hetzner server for runner: {RunnerName}", runnerName);

        var cloudInit = GenerateCloudInitScript(runnerName, apiKey, serverUrl);
        var serverName = $"automaton-{runnerName}-{DateTimeOffset.UtcNow.ToUnixTimeSeconds()}";

        var request = new
        {
            name = serverName,
            server_type = serverType ?? _defaultServerType,
            image = "ubuntu-22.04",
            location = location ?? _defaultLocation,
            start_after_create = true,
            user_data = cloudInit
        };

        var response = await _httpClient.PostAsJsonAsync("servers", request);
        
        if (!response.IsSuccessStatusCode)
        {
            var error = await response.Content.ReadAsStringAsync();
            _logger.LogError("Failed to create Hetzner server: {Error}", error);
            throw new Exception($"Failed to create Hetzner server: {error}");
        }

        var result = await response.Content.ReadFromJsonAsync<HetznerApiResponse>();
        
        _logger.LogInformation(
            "Hetzner server created: ID={ServerId}, IP={IpAddress}", 
            result!.Server.Id, 
            result.Server.PublicNet.Ipv4.Ip);

        return new HetznerServerResponse
        {
            ServerId = result.Server.Id.ToString(),
            ServerName = serverName,
            IpAddress = result.Server.PublicNet.Ipv4.Ip,
            Status = result.Server.Status
        };
    }

    /// <summary>
    /// Gets the status of a Hetzner server
    /// </summary>
    public async Task<ServerStatus> GetServerStatusAsync(string serverId)
    {
        var response = await _httpClient.GetAsync($"servers/{serverId}");
        
        if (!response.IsSuccessStatusCode)
        {
            return ServerStatus.Unknown;
        }

        var result = await response.Content.ReadFromJsonAsync<HetznerApiResponse>();
        
        return result!.Server.Status switch
        {
            "running" => ServerStatus.Running,
            "starting" => ServerStatus.Starting,
            "stopping" => ServerStatus.Stopping,
            "off" => ServerStatus.Off,
            _ => ServerStatus.Unknown
        };
    }

    /// <summary>
    /// Deletes a Hetzner server
    /// </summary>
    public async Task<bool> DeleteServerAsync(string serverId)
    {
        _logger.LogInformation("Deleting Hetzner server: {ServerId}", serverId);

        var response = await _httpClient.DeleteAsync($"servers/{serverId}");
        
        if (response.IsSuccessStatusCode)
        {
            _logger.LogInformation("Hetzner server deleted: {ServerId}", serverId);
            return true;
        }

        var error = await response.Content.ReadAsStringAsync();
        _logger.LogError("Failed to delete Hetzner server: {Error}", error);
        return false;
    }

    /// <summary>
    /// Generates cloud-init script for automatic runner setup
    /// </summary>
    private string GenerateCloudInitScript(string runnerName, string apiKey, string serverUrl)
    {
        var repoUrl = _configuration["AutoDeploy:DockerImageRepository"] 
            ?? "https://raw.githubusercontent.com/rzvdaniel/automaton/main";

        return $@"#cloud-config
package_update: true
package_upgrade: true

packages:
  - docker.io
  - curl

runcmd:
  - systemctl start docker
  - systemctl enable docker
  - mkdir -p /opt/automaton-runner
  - cd /opt/automaton-runner
  - curl -L -o Dockerfile.production {repoUrl}/src/Automaton.Runner/Dockerfile.production
  - curl -L -o docker-compose.production.yml {repoUrl}/src/Automaton.Runner/docker-compose.production.yml
  - curl -L -o docker-entrypoint.sh {repoUrl}/src/Automaton.Runner/docker-entrypoint.sh
  - chmod +x docker-entrypoint.sh
  - |
    cat > .env << 'EOF'
    AUTOMATON_API_KEY={apiKey}
    AUTOMATON_SERVER_URL={serverUrl}
    AUTOMATON_RUNNER_NAME={runnerName}
    DATA_DIR=/opt/automaton-runner/data
    LOGS_DIR=/opt/automaton-runner/logs
    CONFIG_DIR=/opt/automaton-runner/config
    EOF
  - mkdir -p data logs config
  - cd ..
  - docker build -f Automaton.Runner/Dockerfile.production -t automaton-runner:latest Automaton.Runner
  - cd Automaton.Runner
  - docker-compose -f docker-compose.production.yml up -d
  - docker update --restart=unless-stopped automaton-runner
";
    }
}

// Response models
public class HetznerServerResponse
{
    public string ServerId { get; set; } = string.Empty;
    public string ServerName { get; set; } = string.Empty;
    public string IpAddress { get; set; } = string.Empty;
    public string Status { get; set; } = string.Empty;
}

public enum ServerStatus
{
    Unknown,
    Starting,
    Running,
    Stopping,
    Off
}

// Hetzner API response models
internal class HetznerApiResponse
{
    public required ServerData Server { get; set; }
}

internal class ServerData
{
    public required long Id { get; set; }
    public required string Status { get; set; }
    public required PublicNetData PublicNet { get; set; }
}

internal class PublicNetData
{
    public required Ipv4Data Ipv4 { get; set; }
}

internal class Ipv4Data
{
    public required string Ip { get; set; }
}
