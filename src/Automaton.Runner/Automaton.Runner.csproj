<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Automaton.Runner.Console</RootNamespace>
    <AssemblyName>automaton-runner</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>automaton-runner</ToolCommandName>
    <PackageId>Automaton.Runner</PackageId>
    <VersionPrefix>1.0</VersionPrefix>
    <Version Condition="'$(Version)' == ''">$(VersionPrefix).$([System.DateTime]::UtcNow.ToString("yyyyMMdd")).$([System.DateTime]::UtcNow.ToString("HHmmss"))</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Authors>Automaton</Authors>
    <Description>Automaton Runner native console host for advanced local and machine-level execution.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README-NUGET.md</PackageReadmeFile>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <EnableCompressionInSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</EnableCompressionInSingleFile>
    <UserSecretsId>94fcdced-d08b-48ea-a56e-fbfc17fdd073</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="9.0.10" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.10" />
    <PackageReference Include="Polly" Version="8.5.0" />
    <PackageReference Include="RabbitMQ.Client" Version="7.2.0" />
    <PackageReference Include="Serilog" Version="4.1.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="8.0.4" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageReference Include="System.Text.Json" Version="9.0.10" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Automaton.Runner.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Automaton.Core\Automaton.Core.csproj" />
    <ProjectReference Include="..\Automaton.Messaging\Automaton.Messaging.csproj" />
    <ProjectReference Include="..\Automaton.Steps\Automaton.Steps.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="fastapi_server\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="README-NUGET.md" Pack="true" PackagePath="\" />
    <Content Include="..\..\system-apps\automaton-infrastructure\actions\**\action.yaml;..\..\system-apps\automaton-infrastructure\actions\**\main.py"
             Link="SystemApps\automaton-infrastructure\actions\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Pack="false"
             ExcludeFromSingleFile="true" />
    <Content Remove="..\..\system-apps\automaton-infrastructure\actions\enforce-hosted-runner-storage\action.yaml;
                    ..\..\system-apps\automaton-infrastructure\actions\infrastructure-runner-info\action.yaml;
                    ..\..\system-apps\automaton-infrastructure\actions\inspect-runner-host-storage-devices\action.yaml;
                    ..\..\system-apps\automaton-infrastructure\actions\migrate-hosted-runner-storage\action.yaml;
                    ..\..\system-apps\automaton-infrastructure\actions\prepare-hosted-runner-storage\action.yaml;
                    ..\..\system-apps\automaton-infrastructure\actions\prepare-runner-host-storage\action.yaml;
                    ..\..\system-apps\automaton-infrastructure\actions\reconcile-hosted-runner-storage\action.yaml;
                    ..\..\system-apps\automaton-infrastructure\actions\reconcile-runner-host-storage\action.yaml;
                    ..\..\system-apps\automaton-infrastructure\actions\reset-legacy-hosted-runner\action.yaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\system-apps\automaton-infrastructure\actions\validate-runner-host\main.sh"
             Link="SystemApps\automaton-infrastructure\actions\validate-runner-host\main.sh"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Pack="false"
             ExcludeFromSingleFile="true" />
    <Folder Include="Handlers\" />
  </ItemGroup>

</Project>
