#!/usr/bin/env bash
set -euo pipefail

if ! command -v nsenter >/dev/null 2>&1; then
  echo "automaton-host-exec requires nsenter (install util-linux)." >&2
  exit 127
fi

if [ "$(id -u)" -ne 0 ]; then
  echo "automaton-host-exec must run as root inside an infrastructure Runner." >&2
  exit 126
fi

if [ "$#" -eq 0 ]; then
  echo "usage: automaton-host-exec COMMAND [ARG...]" >&2
  exit 2
fi

exec nsenter --target 1 --mount --uts --ipc --net --pid -- "$@"
