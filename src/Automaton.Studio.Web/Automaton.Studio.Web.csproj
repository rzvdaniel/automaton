<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <UseRazorSourceGenerator>false</UseRazorSourceGenerator>
    <UserSecretsId>01ebaacb-ff1e-48d5-8fc1-90716a5376a1</UserSecretsId>
  </PropertyGroup>
    <PropertyGroup>
		<HotReloadAutoRestart>true</HotReloadAutoRestart>
	</PropertyGroup>
	<ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="8.0.11" />
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.6.7" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Automaton.Studio\Automaton.Studio.csproj" />
  </ItemGroup>
  
  <!-- Automatically copy shared site.css from Automaton.Studio before build -->
  <Target Name="CopySharedCSS" BeforeTargets="Build">
    <Copy SourceFiles="..\Automaton.Studio\wwwroot\css\site.css" DestinationFiles="wwwroot\css\site.css" />
  </Target>
</Project>