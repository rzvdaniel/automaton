<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <IsShippingPackage>false</IsShippingPackage>
	  <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
	<PropertyGroup>
		<HotReloadAutoRestart>true</HotReloadAutoRestart>
	</PropertyGroup>
	<PropertyGroup>
    <UseRazorSourceGenerator>false</UseRazorSourceGenerator>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Icon.ico" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Pages\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BlazorMonaco" Version="3.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="8.0.100" />
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.6.7" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Automaton.Studio\Automaton.Studio.csproj" />
  </ItemGroup>
  
  <!-- Automatically copy shared site.css from Automaton.Studio before build -->
  <Target Name="CopySharedCSS" BeforeTargets="Build">
    <Copy SourceFiles="..\Automaton.Studio\wwwroot\css\site.css" DestinationFiles="wwwroot\css\site.css" />
  </Target>
</Project>