<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\shared\ai-guidance\llms.txt">
      <LogicalName>Automaton.AiGuidance.references.llms.txt</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\shared\ai-guidance\llms-full.txt">
      <LogicalName>Automaton.AiGuidance.references.llms-full.txt</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\shared\ai-guidance\llms\**\*">
      <LogicalName>Automaton.AiGuidance.references.llms.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\shared\ai-guidance\templates\**\*">
      <LogicalName>Automaton.AiGuidance.templates.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
