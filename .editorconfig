root = true

[*.cs]
# Numeric thresholds are in src/CodeMetricsConfig.txt. These rules are errors
# so normal builds report cleanup debt directly to developers and coding agents.
dotnet_diagnostic.CA1502.severity = error
dotnet_diagnostic.CA1506.severity = error
dotnet_diagnostic.CA1501.severity = warning

# Sonar's cognitive complexity rule complements CA1502's cyclomatic metric.
dotnet_diagnostic.S3776.severity = error

# Clear correctness defects: the full-solution baseline has no findings for
# these rules. New violations fail ordinary Debug and Release builds.
dotnet_diagnostic.S1764.severity = error
dotnet_diagnostic.S2757.severity = error

# Reviewed critical security and lifecycle findings, cleared across the solution.
dotnet_diagnostic.S4830.severity = error
dotnet_diagnostic.S5445.severity = error
dotnet_diagnostic.S4502.severity = error
dotnet_diagnostic.S2930.severity = error
dotnet_diagnostic.S2190.severity = error
