server {
    listen 80;
    server_name __APPS_DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name __APPS_DOMAIN__;

    ssl_certificate /etc/letsencrypt/live/__CERT_NAME__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__CERT_NAME__/privkey.pem;

    root /var/www/automaton-apps;
    index index.html;

    location = / {
        return 404;
    }

    location ~ /\.(?:staging|disabled)(?:/|$) {
        return 404;
    }

    location /runtime/ {
        alias /var/www/automaton-app-runtime/;
        add_header Cache-Control "public, max-age=300" always;
        try_files $uri =404;
    }

    location ~ ^/([^/]+)$ {
        return 301 /$1/;
    }

    location ~ ^/[^/]+/assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location ~ ^/[^/]+/manifest\.webmanifest$ {
        add_header Cache-Control "public, max-age=300" always;
        try_files $uri =404;
    }

    location ~ ^/[^/]+/automaton-config\.js$ {
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    location ~ ^/([^/]+)/ {
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /$1/index.html;
    }
}
