server {
    listen 80;
    server_name __APPS_DOMAIN__ *.__APPS_DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name __APPS_DOMAIN__ *.__APPS_DOMAIN__;

    ssl_certificate /etc/letsencrypt/live/__CERT_NAME__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__CERT_NAME__/privkey.pem;

    set $api_upstream http://api_live;
    set $runtime_backend_upstream http://traefik:80;

    root /var/www/automaton-apps;
    index index.html;

    location ~ /\.(?!well-known(?:/|$)) {
        return 404;
    }

    location ~* ^/(?:docker-compose(?:\.[^.]+)?\.ya?ml|package(?:-lock)?\.json|tsconfig(?:\.[^.]+)?\.json|vite\.config\.[^.]+|web\.config|appsettings(?:\.[^.]+)?\.json|composer\.(?:json|lock)|pnpm-lock\.yaml|yarn\.lock|bun\.lockb|requirements(?:\.[^.]+)?\.txt|pipfile(?:\.lock)?|poetry\.lock|cargo\.(?:toml|lock)|go\.(?:mod|sum)|makefile|dockerfile|\.env(?:\..*)?|id_[^/]+)$ {
        return 404;
    }

    location ~* \.(?:bak|sql|log|ya?ml|toml|ini|env|pem|key|crt|pfx|p12|ps1|sh|cmd|bat|config|lock)$ {
        return 404;
    }

    location = / {
        return 404;
    }

    location ~ /\.(?:staging|disabled)(?:/|$) {
        return 404;
    }

    location ^~ /runtime/ {
        alias /var/www/automaton-app-runtime/;
        add_header Cache-Control "public, max-age=300" always;
    }

    location ^~ /private/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    location = /internal/runtime/auth {
        internal;
        proxy_pass $api_upstream/internal/runtime/auth;
        proxy_http_version 1.1;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-App-Id $runtime_app_id;
        proxy_set_header X-Automaton-Runtime-Auth __RUNTIME_PROXY_AUTH_KEY__;
    }

    location ~ ^/a/(?<runtime_app_id>[0-9a-fA-F-]{36})$ {
        return 301 /a/$runtime_app_id/;
    }

    location ~ ^/a/(?<runtime_app_id>[0-9a-fA-F-]{36})/api(?:/|$) {
        auth_request /internal/runtime/auth;
        proxy_pass $runtime_backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    location ~ ^/a/(?<runtime_app_id>[0-9a-fA-F-]{36})/$ {
        auth_request /internal/runtime/auth;
        root /var/www/automaton-private-runtime;
        add_header Cache-Control "no-cache" always;
        try_files /apps/$runtime_app_id/index.html =404;
    }

    location ~ ^/a/(?<runtime_app_id>[0-9a-fA-F-]{36})/(?<runtime_asset_path>.+)$ {
        auth_request /internal/runtime/auth;
        root /var/www/automaton-private-runtime;
        add_header Cache-Control "no-cache" always;

        if ($runtime_asset_path ~ "(?:^|/)\.") {
            return 404;
        }

        if ($runtime_asset_path ~ "(?:^|/)\.\.(?:/|$)") {
            return 404;
        }

        if ($runtime_asset_path ~* "(?:^|/)(?:source|backend|data|logs|versions)(?:/|$)") {
            return 404;
        }

        if ($runtime_asset_path ~* "\.(?:bak|sql|log|ya?ml|toml|ini|env|pem|key|crt|pfx|p12|ps1|sh|cmd|bat|config|lock)$") {
            return 404;
        }

        try_files /apps/$runtime_app_id/$runtime_asset_path /apps/$runtime_app_id/index.html =404;
    }

    location /a/ {
        return 404;
    }

    location ^~ /api/web-apps/app/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    location ~ ^/([^/]+)$ {
        return 301 /$1/;
    }

    location ~ ^/[^/]+/assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location ~ ^/[^/]+/manifest\.webmanifest$ {
        add_header Cache-Control "public, max-age=300" always;
        try_files $uri =404;
    }

    location ~ ^/[^/]+/automaton-config\.js$ {
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    location ~ ^/([^/]+)/ {
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /$1/index.html;
    }
}
