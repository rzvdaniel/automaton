server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${LOCAL_RUNTIME_APPS_DOMAIN};

    ssl_certificate /etc/nginx/certs/${LOCAL_RUNTIME_CERT_FILE};
    ssl_certificate_key /etc/nginx/certs/${LOCAL_RUNTIME_CERT_KEY_FILE};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    root /var/www/automaton-apps;
    index index.html;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok";
    }

    location ^~ /runtime/ {
        alias /var/www/automaton-app-runtime/;
        try_files $uri =404;
        access_log off;
        add_header Cache-Control "no-store";
    }

    location ~ ^/a/(?<runtime_app_id>[0-9a-fA-F-]+)/api(?:/.*)?$ {
        auth_request /internal/runtime/auth;
        auth_request_set $auth_status $upstream_status;
        auth_request_set $auth_status_override $auth_status_override;
        error_page 401 = @runtime_unauthorized;
        error_page 403 = @runtime_forbidden;
        proxy_pass http://runtime_traefik;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
    }

    location /internal/runtime/auth {
        internal;
        proxy_pass http://api_live/internal/runtime/auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-App-Id $runtime_app_id;
        proxy_set_header X-Automaton-Runtime-Auth ${LOCAL_RUNTIME_PROXY_AUTH_KEY};
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Host ${LOCAL_RUNTIME_API_DOMAIN};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
    }

    location @runtime_unauthorized {
        return 401;
    }

    location @runtime_forbidden {
        return 403;
    }

    location ~ /\.(?!well-known) {
        return 404;
    }

    location ~* /(source|backend|data|logs|versions|workspace)(?:/|$) {
        return 404;
    }

    location ~* \.(py|cs|csproj|sln|db|sqlite|sqlite3|log|env|config|jsonl?)$ {
        return 404;
    }

    location ~ ^/a/(?<runtime_app_id>[0-9a-fA-F-]+)(?<runtime_path>/.*)?$ {
        auth_request /internal/runtime/auth;
        auth_request_set $auth_status $upstream_status;
        auth_request_set $auth_status_override $auth_status_override;
        error_page 401 = @runtime_unauthorized;
        error_page 403 = @runtime_forbidden;

        root /var/www/automaton-private-runtime/apps;
        try_files /$runtime_app_id$runtime_path /$runtime_app_id/index.html =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
