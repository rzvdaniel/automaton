upstream api_live {
    server api:8080;
}

upstream studio_live {
    server studio:80;
}

upstream website_live {
    server website:80;
}

upstream runtime_traefik {
    server traefik:80;
}

map $host $api_upstream {
    default api_live;
    ${LOCAL_RUNTIME_API_DOMAIN} api_live;
}

map $host $website_upstream {
    default website_live;
    ${LOCAL_RUNTIME_WEBSITE_DOMAIN} website_live;
}

map $upstream_http_x_runtime_auth_status $auth_status_override {
    default $upstream_http_x_runtime_auth_status;
    "" $upstream_status;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok";
    }

    location / {
        return 301 https://$host:${LOCAL_RUNTIME_HTTPS_PORT}$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;

    ssl_certificate /etc/nginx/certs/${LOCAL_RUNTIME_CERT_FILE};
    ssl_certificate_key /etc/nginx/certs/${LOCAL_RUNTIME_CERT_KEY_FILE};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    client_max_body_size 50m;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok";
    }

    location / {
        return 404;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${LOCAL_RUNTIME_API_DOMAIN};

    ssl_certificate /etc/nginx/certs/${LOCAL_RUNTIME_CERT_FILE};
    ssl_certificate_key /etc/nginx/certs/${LOCAL_RUNTIME_CERT_KEY_FILE};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    client_max_body_size 50m;

    location = /healthz {
        proxy_pass http://$api_upstream/healthz;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
    }

    location / {
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

