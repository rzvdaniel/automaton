# Build the Vue Studio from local source and serve it with nginx.

FROM node:22-alpine AS build

WORKDIR /app

ARG VITE_API_BASE_URL=http://localhost:7091
ARG VITE_GITHUB_AUTH_API_BASE_URL=http://localhost:7091
ARG VITE_APP_TITLE="Automaton Studio (Docker Local)"
ARG VITE_ENABLE_MOCK_API=false
ARG VITE_SUBSCRIPTIONS_ENABLED=true
ARG VITE_BASE_PATH=/
ARG VITE_PUBLIC_APPS_BASE_URL=http://localhost:5173

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_GITHUB_AUTH_API_BASE_URL=$VITE_GITHUB_AUTH_API_BASE_URL
ENV VITE_APP_TITLE=$VITE_APP_TITLE
ENV VITE_ENABLE_MOCK_API=$VITE_ENABLE_MOCK_API
ENV VITE_SUBSCRIPTIONS_ENABLED=$VITE_SUBSCRIPTIONS_ENABLED
ENV VITE_BASE_PATH=$VITE_BASE_PATH
ENV VITE_PUBLIC_APPS_BASE_URL=$VITE_PUBLIC_APPS_BASE_URL

COPY src/automaton-studio-vue/package*.json ./
RUN npm ci

COPY src/automaton-studio-vue/ ./
# Local container smoke test: build the Vite bundle even while vue-tsc debt exists.
# Production CI should use `npm run build` once the existing type errors are fixed.
RUN npx vite build

FROM nginx:1.27-alpine AS final

COPY docker/nginx/spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
