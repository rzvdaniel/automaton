# Build the public app store and serve it with nginx.
# Installed servers mount runtime-config.js with their public URLs.

FROM node:22-alpine AS build

WORKDIR /app

COPY src/automaton-store-vue/package*.json ./
RUN npm ci --ignore-scripts

COPY src/automaton-store-vue/ ./
RUN npm run build

FROM nginx:1.27-alpine AS final

COPY docker/nginx/spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
