# Build the public app store and serve it with nginx.
# Installed servers mount runtime-config.js with their public URLs.

FROM node:22-alpine AS build

WORKDIR /app/src/automaton-store-vue

COPY src/automaton-store-vue/package*.json ./
RUN npm ci --ignore-scripts

COPY src/automaton-store-vue/ ./
COPY shared/site-nav/ /app/shared/site-nav/
RUN npm run build

FROM nginx:1.29-alpine-slim AS final

COPY docker/nginx/spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/src/automaton-store-vue/dist /usr/share/nginx/html

EXPOSE 80
