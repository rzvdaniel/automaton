# Installed by Automaton (fail2ban.sh); rewritten on every update. Put your own changes in a separate file.
# [DEFAULT] ignoreip below is only a fallback: your jail.local is read later and replaces it.
# The jails extend the ignoreip you set in [DEFAULT] of jail.local (%(known/ignoreip)s), so a reload picks up changes; sshd also gets the address the installer was run from over SSH.
# Traefik publishes ports through Docker, so bans go into the DOCKER-USER chain (chain is a jail setting;
# parameters written after the action name are ignored when fail2ban expands banaction).
[DEFAULT]
ignoreip = 127.0.0.1/8 ::1

[sshd]
enabled = true
ignoreip = %(known/ignoreip)s 127.0.0.1/8 ::1 @ADMIN_IPS@

[automaton-scanner]
enabled = true
filter = automaton-scanner
logpath = @TRAEFIK_LOG@
port = http,https,5671
banaction = iptables-multiport
chain = DOCKER-USER
maxretry = 20
findtime = 60
bantime = 1h
bantime.increment = true
bantime.factor = 4
bantime.maxtime = 1w
ignoreip = %(known/ignoreip)s 127.0.0.1/8 ::1

[automaton-signin]
enabled = true
filter = automaton-signin
logpath = @TRAEFIK_LOG@
port = http,https
banaction = iptables-multiport
chain = DOCKER-USER
maxretry = 10
findtime = 600
bantime = 1h
bantime.increment = true
bantime.factor = 4
bantime.maxtime = 1w
ignoreip = %(known/ignoreip)s 127.0.0.1/8 ::1
