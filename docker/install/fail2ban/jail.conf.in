# Installed by Automaton (fail2ban.sh); rewritten on every update. Put your own changes in a separate file.
# Addresses never banned come from your ignoreip in jail.local or jail.conf (merged on every update); sshd is left as you set it.
# Traefik publishes ports through Docker, so bans go into the DOCKER-USER chain.
[sshd]
enabled = true

[automaton-scanner]
enabled = true
filter = automaton-scanner
logpath = @TRAEFIK_LOG@
port = http,https,5671
banaction = iptables-multiport[chain=DOCKER-USER]
maxretry = 20
findtime = 60
bantime = 1h
bantime.increment = true
bantime.factor = 4
bantime.maxtime = 1w
ignoreip = @IGNOREIP@

[automaton-signin]
enabled = true
filter = automaton-signin
logpath = @TRAEFIK_LOG@
port = http,https
banaction = iptables-multiport[chain=DOCKER-USER]
maxretry = 10
findtime = 600
bantime = 1h
bantime.increment = true
bantime.factor = 4
bantime.maxtime = 1w
ignoreip = @IGNOREIP@
