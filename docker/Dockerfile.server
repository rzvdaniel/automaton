# Build Automaton Studio Server from local source.

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build

WORKDIR /src

COPY src/Automaton.Api/*.csproj ./Automaton.Api/
COPY src/Automaton.Messaging/*.csproj ./Automaton.Messaging/
COPY src/Automaton.Infrastructure/*.csproj ./Automaton.Infrastructure/
COPY src/Automaton.Identity/*.csproj ./Automaton.Identity/
COPY src/Automaton.Core/*.csproj ./Automaton.Core/
COPY src/Automaton.Ai/*.csproj ./Automaton.Ai/
COPY src/Automaton.AiGuidance/*.csproj ./Automaton.AiGuidance/
COPY src/Automaton.Mcp/*.csproj ./Automaton.Mcp/

RUN dotnet restore Automaton.Api/Automaton.Api.csproj

COPY src/Automaton.Api/ ./Automaton.Api/
COPY src/Automaton.Messaging/ ./Automaton.Messaging/
COPY src/Automaton.Infrastructure/ ./Automaton.Infrastructure/
COPY src/Automaton.Identity/ ./Automaton.Identity/
COPY src/Automaton.Core/ ./Automaton.Core/
COPY src/Automaton.Ai/ ./Automaton.Ai/
COPY src/Automaton.AiGuidance/ ./Automaton.AiGuidance/
COPY src/Automaton.Mcp/ ./Automaton.Mcp/
COPY system-apps/ /system-apps/
COPY shared/ai-guidance/ /shared/ai-guidance/

RUN dotnet publish Automaton.Api/Automaton.Api.csproj \
    -c Release \
    -o /app/publish \
    -p:UseAppHost=false \
    -p:DebugType=none \
    -p:GenerateDocumentationFile=false \
    -p:SatelliteResourceLanguages=en

FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine AS final

# Identical in server and worker so the layer is shared. bash runs the compose
# health check, tzdata serves IANA time zones. The alpine image runs with
# invariant globalization (no ICU): the code uses no culture-specific APIs.
RUN apk add --no-cache bash tzdata

WORKDIR /app

ENV ASPNETCORE_URLS=http://+:8080
ARG SERVER_VERSION
ENV Installation__Version=${SERVER_VERSION}

COPY --from=build /app/publish .

RUN mkdir -p /app/AppData/apps /app/logs

EXPOSE 8080

ENTRYPOINT ["dotnet", "Automaton.Api.dll"]
