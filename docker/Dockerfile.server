# Build Automaton Studio Server from local source.

FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build

WORKDIR /src

COPY src/Automaton.Studio.Server/*.csproj ./Automaton.Studio.Server/
COPY src/Automaton.Core/*.csproj ./Automaton.Core/
COPY src/Automaton.Core.Scripting/*.csproj ./Automaton.Core.Scripting/
COPY src/Automaton.Steps/*.csproj ./Automaton.Steps/
COPY src/Automaton.Mcp/*.csproj ./Automaton.Mcp/

RUN dotnet restore Automaton.Studio.Server/Automaton.Studio.Server.csproj

COPY src/Automaton.Studio.Server/ ./Automaton.Studio.Server/
COPY src/Automaton.Core/ ./Automaton.Core/
COPY src/Automaton.Core.Scripting/ ./Automaton.Core.Scripting/
COPY src/Automaton.Steps/ ./Automaton.Steps/
COPY src/Automaton.Mcp/ ./Automaton.Mcp/

RUN dotnet publish Automaton.Studio.Server/Automaton.Studio.Server.csproj \
    -c Release \
    -o /app/publish \
    -p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS final

WORKDIR /app

ENV ASPNETCORE_URLS=http://+:8080

COPY --from=build /app/publish .

RUN mkdir -p /app/AppData/apps /app/Logs

EXPOSE 8080

ENTRYPOINT ["dotnet", "Automaton.Studio.Server.dll"]
