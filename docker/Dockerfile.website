# Build the public Vue website from local source and serve it with nginx.

FROM node:22-alpine AS build

WORKDIR /app

COPY src/automaton-vue/package*.json src/automaton-vue/
WORKDIR /app/src/automaton-vue
RUN npm ci

WORKDIR /app
COPY src/automaton-vue/ src/automaton-vue/
COPY shared/ai-guidance/ shared/ai-guidance/

WORKDIR /app/src/automaton-vue
RUN npm run build

FROM nginx:1.27-alpine AS final

COPY docker/nginx/spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/src/automaton-vue/dist /usr/share/nginx/html

EXPOSE 80
