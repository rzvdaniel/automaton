# Build the public Vue website from local source and serve it with nginx.
# The website bundles a small set of portable CLI downloads in public/cli.

FROM mcr.microsoft.com/dotnet/sdk:9.0-alpine AS cli-build

WORKDIR /src

RUN apk add --no-cache zip tar

COPY src/Automaton.Cli/Automaton.Cli.csproj src/Automaton.Cli/
RUN dotnet restore src/Automaton.Cli/Automaton.Cli.csproj

COPY src/Automaton.Cli/ src/Automaton.Cli/

RUN set -eux; \
		mkdir -p /cli-dist; \
		while read -r runtime archive_type; do \
			[ -n "$runtime" ] || continue; \
			output_dir="/tmp/automaton-cli/$runtime"; \
			package_base="/cli-dist/automaton-cli-$runtime"; \
			rm -rf "$output_dir"; \
			mkdir -p "$output_dir"; \
			dotnet publish src/Automaton.Cli/Automaton.Cli.csproj \
				--configuration Release \
				--runtime "$runtime" \
				--self-contained true \
				--output "$output_dir" \
				-p:PublishSingleFile=true \
				-p:EnableCompressionInSingleFile=true \
				-p:PublishTrimmed=false; \
			if [ "$archive_type" = "zip" ]; then \
				(cd "$output_dir" && zip -rq "$package_base.zip" .); \
			else \
				tar -C "$output_dir" -czf "$package_base.tar.gz" .; \
			fi; \
		done <<'EOF'
	win-x64 zip
	linux-x64 tar.gz
	osx-arm64 tar.gz
EOF

RUN cd /cli-dist && sha256sum * > checksums.txt

FROM node:22-alpine AS build

WORKDIR /app

COPY src/automaton-vue/package*.json ./
RUN npm ci

COPY src/automaton-vue/ ./
RUN mkdir -p ./public/cli
COPY --from=cli-build /cli-dist/ ./public/cli/
RUN npm run build

FROM nginx:1.27-alpine AS final

COPY docker/nginx/spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
