# Build the public Vue website from local source and serve it with nginx.
# CLI downloads are supplied by a separately built image so normal website
# rebuilds do not also republish the CLI.

ARG CLI_ARTIFACTS_IMAGE=automaton-website-cli:latest
FROM ${CLI_ARTIFACTS_IMAGE} AS cli-artifacts

FROM node:22-alpine AS build

WORKDIR /app

COPY src/automaton-vue/package*.json ./
RUN npm ci

COPY src/automaton-vue/ ./
RUN mkdir -p ./public/cli
COPY --from=cli-artifacts /cli-dist/ ./public/cli/
RUN npm run build

FROM nginx:1.27-alpine AS final

COPY docker/nginx/spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
