# Automaton Runner - Environment Configuration
# Copy this file to .env.runner and fill in the values.
# DO NOT commit .env.runner to version control!

# =============================================================================
# Required Settings
# =============================================================================

# The URL of your Automaton Studio Server
# Development: Use host.docker.internal to access host machine from Docker (Windows/Mac)
# Production:  Use your actual server URL (e.g., https://automaton.example.com)
AUTOMATON_SERVER_URL=https://host.docker.internal:7091

# API Key for runner authentication
# Generate this in Automaton Studio: Settings > API Keys > Create Key (scope: Runner)
#
# Quick start:
#   1. Start Automaton Studio Server locally
#   2. Go to Settings > API Keys
#   3. Click "Create API Key"
#   4. Select scope: Runner (or All)
#   5. Copy the key and paste it below
AUTOMATON_API_KEY=ak_your_api_key_here

# =============================================================================
# Optional Settings
# =============================================================================

# Runner display name (shown in Studio UI)
# If not set, defaults to Service-{container-hostname}
AUTOMATON_RUNNER_NAME=Docker-Dev-Runner

# Log level: Trace, Debug, Information, Warning, Error, Critical
# Set via Serilog configuration in appsettings.json or override:
# Serilog__MinimumLevel__Default=Debug

