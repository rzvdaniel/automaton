# Automaton Development Environment Configuration
# Copy this file to .env and fill in the values.
# DO NOT commit .env to version control!

# =============================================================================
# MySQL Database Configuration
# =============================================================================
# These settings have sensible defaults - you only need to change them if needed.

# MySQL Root Password
MYSQL_ROOT_PASSWORD=AutomatonRoot123!

# MySQL Database Name
MYSQL_DATABASE=automaton

# MySQL User (non-root user for application)
MYSQL_USER=automaton_user

# MySQL User Password
MYSQL_PASSWORD=AutomatonPass123!

# MySQL Port (host machine port mapping)
MYSQL_PORT=3306

# Connection String for Automaton.Api (for reference)
# Use this in your appsettings.Development.json or user secrets:
# ConnectionStrings__MySqlConnection=Server=localhost;Port=3306;Database=automaton;User=automaton_user;Password=AutomatonPass123!;

# =============================================================================
# RabbitMQ Configuration
# =============================================================================
# These settings are used by the standalone RabbitMQ compose file and the local
# full-stack Docker setup.

# RabbitMQ Username
RABBITMQ_USER=automaton

# RabbitMQ Password
RABBITMQ_PASSWORD=AutomatonRabbit123!

# RabbitMQ AMQP Port (host machine port mapping)
RABBITMQ_PORT=5672

# RabbitMQ Management UI Port (host machine port mapping)
RABBITMQ_MANAGEMENT_PORT=15672

# Local connection values for Automaton.Api / Automaton.Worker:
# RabbitMq__Host=localhost
# RabbitMq__Username=automaton
# RabbitMq__Password=AutomatonRabbit123!

# =============================================================================
# Automaton Runner Configuration (Development)
# =============================================================================
# Note: For production, the Docker image defaults to https://api.automaton.monster
# These settings are for local development only.

# The URL of your local Automaton Studio Server
# This overrides the production default in the Docker image
AUTOMATON_SERVER_URL=https://host.docker.internal:7091

# API Key for runner authentication (REQUIRED)
# Generate this in Automaton Studio: Settings > API Keys > Create Key (scope: Runner)
#
# Quick start:
#   1. Start Automaton Studio Server locally
#   2. Go to Settings > API Keys
#   3. Click "Create API Key"
#   4. Select scope: Runner (or All)
#   5. Copy the key and paste it below
AUTOMATON_API_KEY=ak_your_api_key_here

# Runner display name (shown in Studio UI)
# If not set, defaults to Service-{container-hostname}
AUTOMATON_RUNNER_NAME=Docker-Dev-Runner

# Log level: Trace, Debug, Information, Warning, Error, Critical
# Serilog__MinimumLevel__Default=Debug

# Set to Development ONLY when connecting to a local server with a self-signed certificate.
# Leave unset (or Production) for all other deployments.
# DOTNET_ENVIRONMENT=Development

# ── Runner ────────────────────────────────────────────────────────────────────
# Runners are deployed independently via docker-compose.runner.yml or
# the pre-built image: https://hub.docker.com/r/rzvdaniel/automaton-runner
# Runner API keys are configured in the runner's own .env, not here.
#
# After an API blue/green switch, the old API color asks connected runners to
# reconnect to the new live color once they become idle. This value controls
# how long deploy scripts wait before stopping the previous API color.

RUNNER_RECONNECT_GRACE_SECONDS=180
