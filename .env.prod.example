# ============================================================================
# Automaton Production Environment Variables
# ============================================================================
# Copy this file to .env on the Hetzner server:
#   cp .env.prod.example .env
#
# NEVER commit .env to the repository — it contains secrets.
# .env is already listed in .gitignore.
# ============================================================================


# ── Domains ──────────────────────────────────────────────────────────────────
# Set these to your actual domain names (no trailing slash, no https://)

API_DOMAIN=api.automaton.monster
STUDIO_DOMAIN=studio.automaton.monster
WEBSITE_DOMAIN=automaton.monster
APPS_DOMAIN=apps.automaton.monster
# The DNS provider must also point *.apps.automaton.monster at the production edge.


# ── TLS / Let's Encrypt ───────────────────────────────────────────────────────
# Email address for Let's Encrypt certificate notifications

ACME_EMAIL=your-email@example.com
CF_DNS_API_TOKEN=your-cloudflare-zone-dns-edit-token

# Optional: name of the certificate folder under .prod-runtime/letsencrypt/live/
# Default: WEBSITE_DOMAIN
# CERT_NAME=automaton.monster

# Shared secret used by nginx auth_request and Automaton.Api /internal/runtime/auth.
# Keep this in .env so the app-host nginx template and the API container read the same value.
RUNTIME_PROXY_AUTH_KEY=ChangeMe_RuntimeProxyAuthKey_32chars!


# ── MySQL ─────────────────────────────────────────────────────────────────────
# Use strong, unique passwords. Never reuse dev passwords in production.

MYSQL_ROOT_PASSWORD=ChangeMe_RootPassword_32chars!
MYSQL_DATABASE=automaton
MYSQL_USER=automaton_user
MYSQL_PASSWORD=ChangeMe_UserPassword_32chars!

# =============================================================================
# RabbitMQ Configuration
# =============================================================================

RABBITMQ_USER=automaton
RABBITMQ_PASSWORD=ChangeMe_RabbitPassword_32chars!


# ── API Secrets ───────────────────────────────────────────────────────────────
# RSA keys, HMAC key, encryption key, email, Stripe, etc. go in
# /opt/automaton/config/appsettings.Production.json on the server (never in the repo).
# See appsettings.Production.example.json for the structure.
# To generate new RSA keys run: python chatgpt/GenerateRsaKeysASXml.py


# ── Runner ────────────────────────────────────────────────────────────────────
# Runners are deployed independently via docker-compose.runner.yml or
# the pre-built image: https://hub.docker.com/r/rzvdaniel/automaton-runner
# Runner API keys are configured in the runner's own .env, not here.
#
# After an API blue/green switch, the old API color asks connected runners to
# reconnect to the new live color once they become idle. This value controls
# how long deploy scripts wait before stopping the previous API color.

RUNNER_RECONNECT_GRACE_SECONDS=20

# ── Blue/Green Cutover Smoothing ─────────────────────────────────────────────
# After a new color becomes healthy, wait a short warm-up period before nginx
# switches traffic to it. After cutover, keep the previous color alive briefly
# before stopping it. This helps absorb transient CDN/origin reconnects.

CUTOVER_WARMUP_SECONDS=10
PREVIOUS_COLOR_OVERLAP_SECONDS=20
