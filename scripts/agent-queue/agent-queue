#!/usr/bin/env bash
# agent-queue: one task queue and one worker for Claude agent tasks.
#   add <name> [prompt-file]   queue a task (prompt from file or stdin)
#   status                     queue, running task, worker and pause
#   cancel <name>              drop a pending task or stop the running one
#   worker                     run pending tasks one at a time (held by flock)
#   stalled [minutes]          list running tasks with no log output for N minutes (default 30)
#   requeue <name> [note]      stop a running task and queue it again (note is appended to its prompt)
#   pause | resume             create/remove the pause file (worker and orchestrator wait)
# The worker is the only process that starts claude-task. It waits on flock, never on pgrep.
set -euo pipefail
Q=${AGENT_QUEUE_HOME:-$HOME/agent-queue}
RUNNER=${AGENT_QUEUE_RUNNER:-claude-task}   # command run as: $RUNNER <name> < prompt
# epoch of the reset named in "... resets 11am (UTC)"; one hour from now when it cannot be read
limit_reset() {
  local at t now; now=$(date +%s)
  at=$(sed -E 's/.*resets ([^(]*)\((.*)\).*/\1 \2/; s/([0-9])(am|pm)/\1 \2/' <<< "$1")
  t=$(date -d "$at" +%s 2>/dev/null) || t=$(( now + 3600 ))
  (( t < now )) && t=$(( t + 86400 ))
  echo "$t"
}
# when to resume after a usage limit: the reset plus 5 minutes, never more than 6 hours from now
limit_deadline() {
  local t d now; now=$(date +%s); t=$(limit_reset "$1"); d=$(( t + 300 ))
  (( d > now + 21600 )) && d=$(( now + 21600 ))
  echo "$d"
}
mkdir -p "$Q"/{pending,running,done,failed,cancelled,logs}
die() { echo "agent-queue: $*" >&2; exit 1; }
valid() { [[ $1 =~ ^[A-Za-z0-9._-]+$ ]] || die "bad task name '$1' (letters, digits . _ -)"; }
now() { date +%s; }
# find <dir> <name>: exact task file match (names may contain '-')
find_task() { local f b; for f in "$Q/$1"/*.task; do b=${f##*/}; [[ ${b#*-} == "$2.task" ]] && { echo "$f"; return 0; }; done; return 1; }

cmd=${1:-status}; shift || true
case $cmd in
add)
  name=${1:?usage: agent-queue add <name> [prompt-file]}; valid "$name"
  shopt -s nullglob
  find_task pending "$name" >/dev/null && die "$name is already queued"
  find_task running "$name" >/dev/null && die "$name is already running"
  # impl-<N> / impl-apps-<N>: refuse an issue that isn't shaped yet (needs-shape label, no Done when).
  if [[ $name =~ ^impl-(apps-)?([0-9]+)(-|$) ]] && command -v "${AGENT_QUEUE_GH:-gh}" >/dev/null; then
    num=${BASH_REMATCH[2]} repo=rzvdaniel/automaton; [[ -n ${BASH_REMATCH[1]} ]] && repo=rzvdaniel/automaton-apps
    shape=$("${AGENT_QUEUE_GH:-gh}" issue view "$num" -R "$repo" --json labels,body \
      --jq '([.labels[].name]|index("needs-shape")!=null), (.body|test("(^|\\n)\\W*Done when"; "i"))' 2>/dev/null | tr '\n' ' ')
    [[ $shape == "true "* ]] && die "$repo#$num has needs-shape: add a Done when first"
    [[ $shape == *" false " ]] && die "$repo#$num has no Done when section"
  fi
  seq=$(date +%s%N)
  if [[ -n ${2:-} ]]; then cp "$2" "$Q/pending/$seq-$name.task.tmp"; else cat > "$Q/pending/$seq-$name.task.tmp"; fi
  [[ -s $Q/pending/$seq-$name.task.tmp ]] || { rm -f "$Q/pending/$seq-$name.task.tmp"; die "empty prompt"; }
  t="$Q/pending/$seq-$name.task.tmp"
  if [[ $name == verify* ]]; then
    pre="Rules: follow AGENTS.md and .agents/skills/automaton-verify-release/SKILL.md. Never touch production. Never print credentials. End with the proof per issue and a PASS/FAIL summary."
  else
    pre="Rules: follow AGENTS.md and .agents/skills/automaton-implement-issue/SKILL.md end to end (tests, PR, independent Opus review and security pass per pr-review, merge-gate.py); start reviews and security passes as subagent_type automaton-reviewer, never a generic agent. If the issue has the needs-shape label, do not build: report what is missing. Merge only if the task says so; a tier-high PR stops at the handoff and names that the Desktop orchestrator posts the separate security pass; never release, upgrade or deploy unless it says so. Test scripts that delete, uninstall, restore or prune only in a throwaway container or on runner-02, never on a host with a live server. If a command changes or breaks anything outside the task, say so first in the handoff. Never touch production. Never print credentials. End with the implement-issue handoff."
  fi
  { printf '%s\n\n' "$pre"; cat "$t"; } > "$t.2" && mv "$t.2" "$t"
  mv "$t" "$Q/pending/$seq-$name.task"
  echo "queued $name" ;;
status)
  echo "worker:  $(flock -n "$Q/worker.lock" true 2>/dev/null && echo 'not running' || echo running)"
  echo "paused:  $([[ -e $Q/PAUSE ]] && echo yes || echo no)"
  echo "running:"
  shopt -s nullglob
  for f in "$Q"/running/*.task; do
    b=${f##*/}; n=${b#*-}; n=${n%.task}; l=$Q/logs/$n.log
    idle=$(( $(now) - $(stat -c %Y "$l" 2>/dev/null || stat -c %Y "$f") ))
    echo "  $n (log idle ${idle}s)"
  done
  echo "pending:"
  for f in "$Q"/pending/*.task; do b=${f##*/}; n=${b#*-}; echo "  ${n%.task}"; done
  echo "finished (last 5):"
  fin=("$Q"/done/*.task "$Q"/failed/*.task "$Q"/cancelled/*.task)
  (( ${#fin[@]} )) && mapfile -t fin < <(ls -t "${fin[@]}" | head -5)
  for f in "${fin[@]}"; do
    b=${f##*/}; n=${b#*-}; echo "  ${n%.task}: $(basename "$(dirname "$f")")"
  done ;;
cancel)
  name=${1:?usage: agent-queue cancel <name>}; valid "$name"; shopt -s nullglob
  if f=$(find_task pending "$name"); then mv "$f" "$Q/cancelled/"; echo "cancelled $name (was pending)"; exit 0; fi
  if f=$(find_task running "$name"); then
    touch "$Q/running/.cancel-$name"
    [[ -f $Q/running/.pid-$name ]] && kill -- "-$(cat "$Q/running/.pid-$name")" 2>/dev/null || true
    echo "cancelling running $name"; exit 0
  fi
  die "no pending or running task named $name" ;;
stalled)
  min=${1:-30}; shopt -s nullglob
  for f in "$Q"/running/*.task; do
    b=${f##*/}; n=${b#*-}; n=${n%.task}; l=$Q/logs/$n.log
    idle=$(( $(now) - $(stat -c %Y "$l" 2>/dev/null || stat -c %Y "$f") ))
    (( idle >= min * 60 )) && echo "$n ${idle}s"
  done; true ;;
requeue)
  name=${1:?usage: agent-queue requeue <name> [note]}; valid "$name"; shopt -s nullglob
  if f=$(find_task running "$name"); then
    cp "$f" "$Q/.requeue-$name"
    [[ -n ${2:-} ]] && printf '\n\nNote from orchestrator: %s\n' "$2" >> "$Q/.requeue-$name"
    touch "$Q/running/.requeue-$name"
    [[ -f $Q/running/.pid-$name ]] && kill -- "-$(cat "$Q/running/.pid-$name")" 2>/dev/null || true
    echo "requeueing $name"; exit 0
  fi
  die "no running task named $name" ;;
pause) touch "$Q/PAUSE"; echo paused ;;
resume) rm -f "$Q/PAUSE"; echo resumed ;;
worker)
  exec 9> "$Q/worker.lock"
  flock -n 9 || die "a worker is already running"
  shopt -s nullglob
  # a dead worker leaves its task in running/: we hold the lock, so nobody is running it; start it again
  for f in "$Q"/running/*.task; do
    printf '\n\nNote from agent-queue: the worker died during the previous run. Continue from the current git and GitHub state; do not redo finished steps.\n' >> "$f"
    mv "$f" "$Q/pending/"
  done
  rm -f "$Q"/running/.cancel-* "$Q"/running/.requeue-* "$Q"/running/.pid-* "$Q"/.requeue-*
  while true; do
    [[ -e $Q/PAUSE ]] && { sleep 10; continue; }
    files=("$Q"/pending/*.task)
    if (( ${#files[@]} == 0 )); then
      [[ ${AGENT_QUEUE_ONCE:-} == 1 ]] && exit 0
      sleep 10; continue
    fi
    f=${files[0]}; b=${f##*/}; n=${b#*-}; n=${n%.task}
    mv "$f" "$Q/running/$b"; rm -f "$Q/running/.cancel-$n" "$Q/running/.requeue-$n" "$Q/.requeue-$n"; l=$Q/logs/$n.log; : > "$l"
    echo "$(date -Is) start $n" >> "$Q/worker.log"
    # own process group so cancel/requeue can stop the whole task
    set +e
    setsid bash -c 'echo $$ > "$1"; exec 9>&-; exec env AGENT_TASK_LOG="$4" "$2" "$3" < "$5"' _ "$Q/running/.pid-$n" "$RUNNER" "$n" "$l" "$Q/running/$b" >> "$l" 2>&1
    rc=$?
    set -e
    rm -f "$Q/running/.pid-$n"
    # usage limit: put the task back at the front and wait for the reset instead of failing the queue
    lim=$(tail -n 20 "$l" | grep -m1 -o "hit your .*limit.*resets [^)]*)" || true)
    if [[ -n $lim && ! -e $Q/running/.cancel-$n ]]; then
      grep -qF 'Note from agent-queue: the previous run stopped at the usage limit.' "$Q/running/$b" ||
        printf '\n\nNote from agent-queue: the previous run stopped at the usage limit. Continue from the current git and GitHub state; do not redo finished steps.\n' >> "$Q/running/$b"
      mv "$Q/running/$b" "$Q/pending/0$(date +%s%N | cut -c2-)-$n.task"; rm -f "$Q/running/.requeue-$n" "$Q/.requeue-$n"
      t=$(limit_deadline "$lim")
      echo "$(date -Is) end $n usage-limit; waiting until $(date -Is -d @$t)" >> "$Q/worker.log"
      while (( $(date +%s) < t )); do sleep 60; done
      continue
    fi
    if [[ -e $Q/running/.cancel-$n ]]; then rm -f "$Q/running/.cancel-$n" "$Q/running/.requeue-$n" "$Q/.requeue-$n"; mv "$Q/running/$b" "$Q/cancelled/$b"; st=cancelled
    elif [[ -e $Q/running/.requeue-$n ]]; then
      rm -f "$Q/running/.requeue-$n"; rm -f "$Q/running/$b"
      cp "$Q/.requeue-$n" "$Q/pending/$(date +%s%N)-$n.task"; rm -f "$Q/.requeue-$n"; st=requeued
    elif (( rc == 0 )); then mv "$Q/running/$b" "$Q/done/$b"; st=done
    else mv "$Q/running/$b" "$Q/failed/$b"; st="failed($rc)"; fi
    echo "$(date -Is) end $n $st" >> "$Q/worker.log"
  done ;;
*) die "unknown command '$cmd'" ;;
esac
