#!/usr/bin/env bash
# agent-cleanup: keep agent machines from running out of disk.
#   worktrees   remove git worktrees of merged/closed work (never one with uncommitted or unpushed work)
#   caches      clear NuGet and npm caches when free space is under AGENT_CLEAN_MIN_GIB (default 15)
#   disk        print "free disk: N GiB (path)" for the morning report
#   all         worktrees, then caches
# Repos checked for worktrees: AGENT_CLEAN_REPOS (default "$HOME/automaton $HOME/automaton-apps").
# AGENT_CLEAN_DRY=1 only prints what would be removed. GH overrides the gh command (tests).
set -uo pipefail
GH=${GH:-gh}
REPOS=${AGENT_CLEAN_REPOS:-"$HOME/automaton $HOME/automaton-apps"}
MIN_GIB=${AGENT_CLEAN_MIN_GIB:-15}
DISK_PATH=${AGENT_CLEAN_DISK_PATH:-$HOME}
free_gib() { df -BG --output=avail "$DISK_PATH" | tail -n1 | tr -dc '0-9'; }

# Succeeds when the worktree at $2 (repo $1) on branch $3 is safe to remove; prints why not otherwise.
removable() {
  local repo=$1 wt=$2 br=$3 head state
  [[ -n $br ]] || { echo "detached HEAD"; return 1; }
  [[ $br == main || $br == master ]] && { echo "main branch"; return 1; }
  [[ -z $(git -C "$wt" status --porcelain 2>/dev/null) ]] || { echo "uncommitted changes"; return 1; }
  head=$(git -C "$wt" rev-parse HEAD) || { echo "unreadable"; return 1; }
  # PRs for this branch: an open one means the work is still going
  local prs; prs=$(cd "$repo" && $GH pr list --head "$br" --state all --json state,headRefOid -q '.[] | "\(.state) \(.headRefOid)"' 2>/dev/null) || { echo "gh failed"; return 1; }
  grep -q '^OPEN ' <<< "$prs" && { echo "PR still open"; return 1; }
  [[ -n $prs ]] || { echo "no PR for the branch"; return 1; }
  # nothing unpushed: every commit is on a remote branch, or was exactly the head of a merged/closed PR
  if [[ -n $(git -C "$wt" rev-list HEAD --not --remotes 2>/dev/null | head -n1) ]]; then
    grep -q "^[A-Z]* $head\$" <<< "$prs" || { echo "unpushed commits"; return 1; }
  fi
  return 0
}

worktrees() {
  local repo wt br why n=0
  for repo in $REPOS; do
    [[ -d $repo/.git ]] || continue
    git -C "$repo" fetch -q --prune origin 2>/dev/null || true
    git -C "$repo" worktree prune
    # first entry of the list is the main worktree: never touched
    while IFS=$'\t' read -r wt br; do
      [[ $wt == "$repo" ]] && continue
      if why=$(removable "$repo" "$wt" "$br"); then
        if [[ ${AGENT_CLEAN_DRY:-} == 1 ]]; then echo "would remove $wt ($br)"
        elif git -C "$repo" worktree remove "$wt"; then echo "removed $wt ($br)"; git -C "$repo" branch -D "$br" >/dev/null 2>&1; n=$((n+1))
        else echo "kept $wt: remove failed"; fi
      else echo "kept $wt: $why"; fi
    done < <(git -C "$repo" worktree list --porcelain | awk '/^worktree /{if(w!="")print w "\t" b; w=substr($0,10); b=""} /^branch refs\/heads\//{b=substr($0,19)} END{if(w!="")print w "\t" b}')
  done
  echo "worktrees removed: $n"
}

caches() {
  local f; f=$(free_gib)
  if (( f >= MIN_GIB )); then echo "free ${f} GiB, caches left alone (limit ${MIN_GIB})"; return 0; fi
  echo "free ${f} GiB under ${MIN_GIB}: clearing caches"
  [[ ${AGENT_CLEAN_DRY:-} == 1 ]] && return 0
  command -v dotnet >/dev/null && dotnet nuget locals all --clear >/dev/null 2>&1
  command -v npm >/dev/null && npm cache clean --force >/dev/null 2>&1
  echo "free now $(free_gib) GiB"
}

case ${1:-all} in
worktrees) worktrees ;;
caches) caches ;;
disk) echo "free disk: $(free_gib) GiB ($DISK_PATH)" ;;
all) worktrees; caches ;;
*) echo "usage: agent-cleanup worktrees|caches|disk|all" >&2; exit 1 ;;
esac
