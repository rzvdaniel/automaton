#!/usr/bin/env bash
# Run one Claude task: claude-task <name> < prompt. Output goes to stdout (the worker logs it).
# Settings: CLAUDE_CONFIG_DIR (default ~/.claude-second), AGENT_MODEL (sonnet), AGENT_EFFORT (low),
# AGENT_WORKDIR (~/automaton).
set -euo pipefail
: "${1:?task name}"
export PATH=$HOME/.local/bin:$HOME/.dotnet/tools:$PATH DOTNET_ROOT=$HOME/.dotnet
export CLAUDE_CONFIG_DIR=${CLAUDE_CONFIG_DIR:-$HOME/.claude-second}
export CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0  # headless runs wait for background subagents (2026-11-17)
cd "${AGENT_WORKDIR:-$HOME/automaton}"
# Start every task on the latest main, so the repo's agent types, hooks and skills apply.
if [ -z "$(git status --porcelain)" ]; then
  git fetch -q origin main && git checkout -q main && git merge -q --ff-only origin/main \
    || echo "claude-task: could not update to origin/main; running on $(git rev-parse --short HEAD)" >&2
else
  echo "claude-task: working tree not clean; running on $(git rev-parse --abbrev-ref HEAD) $(git rev-parse --short HEAD)" >&2
fi
exec claude -p "$(cat)" --model "${AGENT_MODEL:-sonnet}" --effort "${AGENT_EFFORT:-low}" --dangerously-skip-permissions < /dev/null
