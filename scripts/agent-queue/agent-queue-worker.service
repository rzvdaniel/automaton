# User unit for the agent-queue worker: restarts it after an error. Install:
#   cp agent-queue-worker.service ~/.config/systemd/user/ && systemctl --user enable --now agent-queue-worker
# (needs `loginctl enable-linger <user>`; then drop the @reboot cron line so only one worker starts).
[Unit]
Description=agent-queue worker

[Service]
Environment=PATH=%h/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin AGENT_QUEUE_RUNNER=%h/bin/claude-task
# Environment=AGENT_BOARD=rzvdaniel/17
ExecStart=%h/bin/agent-queue worker
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
